begin
  Result := inherited;

  AMPanel := Result.GetChild('am_panel'); 

  Result.BuildButton('open_settings', [100,100], [50,50], 'Settings');
  TButton(Result.GetChild('open_settings')).setAlign(alBottom);
  TButton(Result.GetChild('open_settings')).setOnClick(@OpenSettingsTab);

  Result.BuildLabel('break_label', [200,35], 'Breaks', 12);
  Result.BuildButton('break', [225,35], [120,25], 'Custom');
  TButton(Result.GetChild('break')).setOnClick(@Self.OnBreakButtonClick);

  Result.BuildLabel('break_after_label', [260,35], 'Break after (minutes):', 9);
  Result.BuildEdit('break_after', [275,35], [150,25], ToStr(Random(20, 100)));

  Result.BuildLabel('break_for_label', [305,35], 'Break for (minutes):', 9);
  Result.BuildEdit('break_for', [320,35], [150,25], ToStr(Random(10, 30)));

  Result.BuildLabel('sleep_setting', [200,250], 'Sleep', 12);
  Result.BuildButton('sleep', [225,250], [120,25], 'On');
  TButton(Result.GetChild('sleep')).setOnClick(@Self.OnSleepButtonClick);

  Result.BuildLabel('sleep_at_label', [260,250], 'Sleep at (24HR HH:MM:SS):', 9);
  Result.BuildEdit('sleep_at', [275,250], [150,25], ToStr(Random(10, 23)) + ':' + ToStr(Random(10,59)) + ':00');

  Result.BuildLabel('sleep_for_label', [305,250], 'Sleep for (hours):', 9);
  Result.BuildEdit('sleep_for', [320,250], [150,25], ToStr(Random(1, 24)));

end;

procedure TMoleForm.Setup(caption: String = 'Script Form'; size: TPoint = [750, 500]; allowResize: Boolean = False); override;
begin
  caption := 'Giant Mole Fighter'; size := [750,600];
  inherited;


  Self.CreateAccountManager;

  Self.SettingsTab.Init(nil);
  Self.AddTab(Self.SettingsTab);
  Self.SettingsTab.BuildSettings;

  Self.Start.setVisible(False);
end;

begin
  //WaspClient.CheckSubscription(True);
  SettingsHandler.CheckGPUPlugin();
  MoleForm.Setup;
  MoleForm.Run;

  {$IFNDEF SRL_DISABLE_REMOTEINPUT}
  if WLSettings.GetObject('remote_input').getBoolean('enabled', True) and (not GameClient.RemoteInput.IsSetup()) then GameClient.RemoteInput.Setup();
  {$ENDIF}

  MoleFighter.Init(MoleForm.MoleConfig);
  MoleFighter.Run;
end.
