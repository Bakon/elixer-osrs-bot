    'Off': Button.setCaption('Random');
    'Random': Button.setCaption('Custom');
  end;

  TLabel(Parent.GetChild('break_after_label')).setVisible(Button.getCaption = 'Custom');
  TLabel(Parent.GetChild('break_after')).setVisible(Button.getCaption = 'Custom');
  TLabel(Parent.GetChild('break_for_label')).setVisible(Button.getCaption = 'Custom');
  TLabel(Parent.GetChild('break_for')).setVisible(Button.getCaption = 'Custom');
end;

