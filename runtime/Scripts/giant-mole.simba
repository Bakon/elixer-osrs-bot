function TEquipment.AccurateDiscover(Slot : EEquipmentSlot): TItem;
var
  Discovered : TItemArray;
  Text : String;
  I : Int32;
begin
  if not ChooseOption.Close then
    Exit;

  Discovered := Equipment.Discover(Slot);
  if Length(Discovered) = 0 then
    Exit;

  Result := ToStr(Discovered[0]).SentenceCase;

  if Length(Discovered) = 1 then
    Exit;

  Mouse.Move(Equipment.GetSlotBoxes[Slot], True);

  if SRL.Dice(50) then
    Text := MainScreen.GetUpText
  else if ChooseOption.Open and (ChooseOption.CountOption('Remove') > 0) then begin
    Text := ChooseOption.GetOptions[0].Text;
  end else
    Exit;

  for I := 0 to High(Discovered) do
    if ToStr(Discovered[I]).SentenceCase in Text then
      Exit(ToStr(Discovered[I]).SentenceCase);
end;

function TInventory.AccurateDiscover(Slot : Int32): TItem;
var
  Discovered : TItemArray;
  Text : String;
  I : Int32;
begin
  if not (ChooseOption.Close and Inventory.Open) then
    Exit;

  Discovered := Inventory.Discover(Slot);
  if Length(Discovered) = 0 then
    Exit;

  Result := ToStr(Discovered[0]).SentenceCase;

  if Length(Discovered) = 1 then
    Exit;

  Mouse.Move(Inventory.GetSlotBox(Slot), True);

  if SRL.Dice(50) then
    Text := MainScreen.GetUpText
  else if ChooseOption.Open and (ChooseOption.CountOption('Examine') > 0) then begin
    Text := ChooseOption.GetOptions[0].Text;
  end else
    Exit;

  for I := 0 to High(Discovered) do
    if ToStr(Discovered[I]).SentenceCase in Text then
      Exit(ToStr(Discovered[I]).SentenceCase);
end;

function TChatButtons.GameChatVisible(): Boolean;
var
  Active: EChatButton := Self.GetActive;
begin
  Result := (Active = EChatButton.ALL_CHAT) or
            (Active = EChatButton.GAME_CHAT);
end;

function TMinimap.HasDots(Dot : EMinimapDot): Boolean;
var
  Dots : TPointArray := Self.GetDots(Dot);
begin
  Result := Dots.Len > 0;
end;

function TChat.GetPlayerChat(): TStringArray;
var
  I : Int32;
  Text : String;
begin
  for I := 0 to CHAT_INPUT_LINE - 1 do begin
    if (SRL.CountColor(CHAT_COLOR_BLUE, Chat.LineBoxes[I]) > 0) and (SRL.CountColor(CHAT_COLOR_BLUE, Chat.LineBoxes[I]) > 0) then begin
      Text := Chat.GetMessage(I, [0, 16711680]);
      if Text <> '' then
        Result.Append(Text);
    end;
  end;
end;

procedure TMinimap.FacePointEx(P: TPoint; Randomness: Int32 = 0; MinDistance : Int32 = 30);
var
  Angle: Double;
  CurrentAngle: Double;
  Distance : Double;
begin
  Angle := P.AngleBetween(Minimap.Center);
  Angle += Random(-Randomness, Randomness);

  CurrentAngle := Minimap.GetCompassAngle;

  Angle := FixD(-(Angle - CurrentAngle));

  Distance := Abs(Angle - CurrentAngle);

  if Distance > MinDistance then
    Minimap.SetCompassAngle(Angle);
end;

function TMinimap.EnablePrayer(): Boolean; override;
var
  MouseMiss : Double;
  MouseIdle : Boolean;
begin
  MouseMiss := Mouse.MissChance;
  MouseIdle := Mouse.CanIdle;
  Mouse.MissChance := 0;
  Mouse.CanIdle := False;
  try
    Result := inherited;
  finally
    Mouse.MissChance := MouseMiss;
    Mouse.CanIdle := MouseIdle;
  end;
end;

function TMinimap.EnableSpec(minSpec: Int32): Boolean; override;
var
  MouseMiss : Double;
  MouseIdle : Boolean;
begin
  MouseMiss := Mouse.MissChance;
  MouseIdle := Mouse.CanIdle;
  Mouse.MissChance := 0;
  Mouse.CanIdle := False;
  try
    Result := inherited;
  finally
    Mouse.MissChance := MouseMiss;
    Mouse.CanIdle := MouseIdle;
  end;
end;

type
  TMoleCrashDetection = record
    Points : Double;
    ChatHistory : TStringArray;
    RunCountdown : TCountdown;
    PointRegenTimer : TStopwatch;
    PlayerName : String;
    DisplayNamebox : TBox;
  end;

procedure TMoleCrashDetection.DebugLn(Text : String); begin
  WriteLn(SRL.TimeStamp() + ':[Crash Detection]: ' + Text);
end;

procedure TMoleCrashDetection.Init(); begin
  Self.Points := 50;
  Self.ChatHistory := [];
  Self.RunCountdown.Init(5*ONE_SECOND);
  Self.PointRegenTimer.Start;
end;

function TMoleCrashDetection.ShouldHopWorlds(): Boolean; begin
  Result := Self.Points < 1;
end;

procedure TMoleCrashDetection.RegenPoints(); begin
  Self.Points := Min(100, Self.Points + 0.2 * Self.PointRegenTimer.ElapsedTime / ONE_SECOND);
  Self.PointRegenTimer.Reset;
end;

