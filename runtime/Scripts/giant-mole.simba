  Parent : TTabSheet := Button.getParent;
begin
  case Button.getCaption of
    'Off': Button.setCaption('On');
    'On': Button.setCaption('Off');
  end;

  TLabel(Parent.GetChild('sleep_at_label')).setVisible(Button.getCaption = 'On');
  TLabel(Parent.GetChild('sleep_at')).setVisible(Button.getCaption = 'On');
  TLabel(Parent.GetChild('sleep_for_label')).setVisible(Button.getCaption = 'On');
  TLabel(Parent.GetChild('sleep_for')).setVisible(Button.getCaption = 'On');
end;

