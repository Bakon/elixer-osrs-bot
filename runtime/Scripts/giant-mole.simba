  TButton(Self.GetChild('attack_speed_inc')).getFont.setSize(14);
  TButton(Self.GetChild('attack_speed_inc')).setOnClick(@Self.OnAttackSpeedButtonClick);

  Self.BuildLabel('attack_range_label', [160, 335],  'Attack Range', 12);
  Self.BuildLabel('attack_range', [180, 370],  '10',           14);

  Self.BuildButton('attack_range_dec', [180,340], [20,20], '-');
  TButton(Self.GetChild('attack_range_dec')).getFont.setStyle([fsBold]);
  TButton(Self.GetChild('attack_range_dec')).getFont.setSize(14);
  TButton(Self.GetChild('attack_range_dec')).setOnClick(@Self.OnAttackRangeButtonClick);

  Self.BuildButton('attack_range_inc', [180,400], [20,20], '+');
  TButton(Self.GetChild('attack_range_inc')).getFont.setStyle([fsBold]);
  TButton(Self.GetChild('attack_range_inc')).getFont.setSize(14);
  TButton(Self.GetChild('attack_range_inc')).setOnClick(@Self.OnAttackRangeButtonClick);

  Self.BuildLabel('food_label', [7, 460], 'Food (blank if none)', 12);
  Self.BuildEdit('food', [25,460], [170,25], '');

  Self.BuildLabel('max_runtime_label', [70, 460], 'Max Runtime (minutes)', 12);
  Self.BuildEdit('max_runtime', [88,460], [170,25], '500');

  Self.BuildLabel('max_kill_count_label', [133, 460], 'Max Kill Count', 12);
  Self.BuildEdit('max_kill_count', [151,460], [170,25], '500');

  Self.BuildButton('start_script', [100,100], [50,50], 'Start');
  TButton(Self.GetChild('start_script')).setAlign(alBottom);
  TButton(Self.GetChild('start_script')).setOnClick(@Self.StartScript);
end;

