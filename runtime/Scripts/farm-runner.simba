    end;

    WaitUntil(Bank.IsOpen(), 115, 12500);

    Bank.DepositRandomItems(['Rune pouch', 'Divine rune pouch']);
  end;

  'Catherby':
  begin
    bankTimeout.Init(45000);

    while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
    begin
      Bot.clickBankBooth();
    end;

    WaitUntil(Bank.IsOpen(), 115, 12500);

    Bank.DepositRandomItems(['Rune pouch', 'Divine rune pouch', 'Catherby teleport', 'Camelot teleport', 'Water rune', 'Astral rune', 'Law rune', 'Escape crystal']);
  end;

  'Crafting guild':
  begin
    bankTimeout.Init(45000);

    while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
    begin
      Bot.clickBankBooth();
    end;

    WaitUntil(Bank.IsOpen(), 115, 12500);

    Bank.DepositRandomItems(['Rune pouch', 'Divine rune pouch', 'Crafting cape', 'Crafting cape(t)', 'Escape crystal']);
  end;

  'Farming guild':
  begin
    while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
    begin
      Bot.clickBankChest();
    end;

    WaitUntil(Bank.IsOpen(), 115, 12500);

    Bank.DepositRandomItems(['Rune pouch', 'Divine rune pouch', 'Farming cape', 'Farming cape(t)', 'Skills necklace(6)', 'Skills necklace(5)', 'Skills necklace(4)', 'Skills necklace(3)', 'Skills necklace(2)', 'Skills necklace(1)']);
  end;
  end;

  Wait(500,750);

  if Bot.ringofdueling then
  begin
    Bot.WithdrawHelper('Ring of dueling(8)', 1);

    if Inventory.ContainsItem('Ring of dueling(8)') then
    begin
     Bot.WriteMsg('Equipping ring');
     Inventory.ClickItem('Ring of dueling(8)', 'Wear');
     WaitUntil(not Inventory.ContainsItem('Ring of dueling(8)'), 115, 5000);
    end;

    Bot.ringofdueling := False;
  end;

  for I := 0 to High(Antiban.tasks) do
    Antiban.Tasks[I].Countdown.Resume;
end;

function TScript.ringoflifeCheck(): Boolean;
begin
   Result := (('saves you' in Chat.GetMessage(7, [0])) or ('saves you' in Chat.GetMessage(6, [0])) or ('saves you' in Chat.GetMessage(5, [0])));
   if Result then
   begin
    Logout.ClickLogout();
    TerminateScript('Ring of life activated');
   end;
end;

procedure TScript.EndScript
begin
  Logout.ClickLogout();
  TerminateScript('Time to shutdown');
end;

procedure TScript.Init();
var
  z: Int32;
begin
  if (not GameClient.IsLoggedIn) then
    Login.LoginPlayer(False);

  Self.VarrockTeleportSetup := False;
  Self.InfiniteAir        := False;
  Self.InfiniteWater      := False;
  Self.InfiniteEarth      := False;
  Self.InfiniteFire       := False;
  Self.JustGiantSeaweed   := False;

  Stats.Setup();
  Stats.GetLevel(ESkill.AGILITY);

  if (GameClient.Mode <> EClientMode.FIXED) then
    TerminateScript("Client must be in fixed-classic");

  if Self.DoBHRuns then
    BirdhouseRunner.Init();

  ChatButtons.Open(EChatButton.GAME_CHAT);

  ChatButtons.ChangeState(EChatButton.GAME_CHAT, EChatButtonState.ENABLED);
  ChatButtons.Open(EChatButton.GAME_CHAT);

  RSW.Setup('world');

  case Bot.Location of
  'Varrock west':
  begin
    Self.BankTile := [8124, 2708];
    Self.BankObj.Setup(4, [[8136, 2704], [8136, 2696], [8136, 2688]]);
    Self.BankObj.SetupUpText(['Bank', 'booth']);
    Self.BankObj.Finder.Colors += CTS2(2973293, 4, 0.13, 3.23);
  end;

  'Varrock east':
  begin
    Self.BankTile := [8400, 2764];
    Self.BankObj.Setup(4, [[8400, 2772], [8404, 2772], [8396, 2772]]);
    Self.BankObj.SetupUpText(['Bank', 'booth']);
    Self.BankObj.Finder.Colors += CTS2(3300715, 3, 0.10, 1.84);
  end;

  'Ardougne':
  begin
    Self.BankTile := [6004,3312];
    Self.BankObj.Setup(4, [[6016,3316], [6016,3304]]);
    Self.BankObj.SetupUpText(['Bank', 'booth']);
    Self.BankObj.Finder.Colors += CTS2(7640998, 6, 0.11, 0.75);
  end;

  'Falador':
  begin
    Self.BankTile := [7172,2968];
    Self.BankObj.Setup(4, [[7172,2980], [7176,2980], [7180,2980]]);
    Self.BankObj.SetupUpText(['Bank boo']);
    Self.BankObj.Finder.Colors += CTS2(4679036, 2, 0.18, 2.06);
  end;

  'Castle wars':
  begin
    Self.BankTile := [5164,4116];
    Self.BankObj.Setup(4, [[5168,4116]]);
    Self.BankObj.SetupUpText(['Bank', 'chest']);
    Self.BankObj.Finder.Colors += CTS2(3820384, 8, 0.03, 0.11);
  end;

  'Ferox':
  begin
    Self.BankTile := [7920,1928];
    Self.BankObj.Setup(4, [[7912,1920]]);
    Self.BankObj.SetupUpText(['Bank', 'chest']);
    Self.BankObj.Finder.Colors += CTS2(1855325, 6, 0.07, 0.49);
  end;

  'Catherby':
  begin
    Self.BankTile := [6628,2688];
    Self.BankObj.Setup(4, [[6628,2680], [6632,2680], [6636,2680]]);
    Self.BankObj.SetupUpText(['Bank', 'chest']);
    Self.BankObj.Finder.Colors += CTS2(6119782, 3, 1.28, 1.21);
  end;

  'Crafting guild':
  begin
    Self.BankTile := [7138,3316];
    Self.BankObj.Setup(4, [[7138,3328]]);
    Self.BankObj.SetupUpText(['Bank', 'chest']);
    Self.BankObj.Finder.Colors += CTS2(2251377, 7, 0.08, 0.38);
  end;

  'Farming guild':
  begin
    Self.BankTile := [389,1501];
    Self.BankObj.Setup(4, [[405,1493], [405,1491]]);
    Self.BankObj.SetupUpText(['Bank', 'chest']);
    Self.BankObj.Finder.Colors += CTS2(1658202, 7, 0.07, 0.84);
  end;

  'JUST Giant Seaweed':
  begin;
    Self.BankTile := [9478,704];
    Self.BankObj.Setup(4, [[9486,704]]);
    Self.BankObj.SetupUpText(['Bank', 'Chest']);
    Self.BankObj.Finder.Colors += CTS2(1449292, 8, 0.30, 6.10);

    Self.ChainUp.Setup(4, [[1271,5580]]);
    Self.ChainUp.SetupUpText(['Climb', 'Anchor']);
    Self.ChainUp.Finder.Colors += CTS2(7566955, 6, 0.83, 0.26);

    Self.JustGiantSeaweed   := True;
  end;
  end;

  Self.IncludeEquipmentSetup();
  XPbar.TotalEarnedXP();

  Self.Version            := 'Rev '+{$MACRO SCRIPT_REVISION};
  Mouse.Speed             := SRL.NormalRange(18, 21);
  Mouse.MissChance        := 3;
  Mouse.Distribution      := MOUSE_DISTRIBUTION_GAUSS;
  MyPos := Self.RSW.GetMyPos();

  z := Options.GetZoomLevel();
  if (not InRange(z, 0, 5)) then
    Options.SetZoomLevel(SRL.TruncatedGauss(0,5))
  else
    MM2MS.ZoomLevel := z;

  RSW.EnableRunAtEnergy      := 35;
  RSW.ScreenWalk             := True;

  Options.SetNPCAttackOption(EAttackOption.ALWAYS_RIGHT_CLICK);
  Combat.SetAutoRetaliate(False);

  if not Self.RSW.AtTile(Self.BankTile, 16) then
    Self.StartAtBank();

  if Self.DoFarmRuns then
    FarmRunner.Init();
end;

function TScript.GetState(): EState;
begin
  if GameClient.IsLoggedIn() and (ChatButtons.GetState(EChatButton.GAME_CHAT) <> EChatButtonState.ENABLED) then
    Exit(EState.CHANGE_CHAT_FILTER);

  if GameClient.IsLoggedIn() and not ChatButtons.IsActive(EChatButton.GAME_CHAT) then
    Exit(EState.OPEN_CHAT);

  if Self.DoFarmRuns and Self.farmtimerisReady then
    Exit(EState.DO_FARM_RUN);

  if Self.DoBHRuns and Self.bhtimerisReady then
    Exit(EState.DO_BH_RUN);

  Exit(EState.WAIT_FOR_NEXT);
end;

procedure TScript.Run();
begin
  while true do
  begin
    if (Self.ShutdownTime > 0) and (GetTimeRunning() > Self.ShutdownTime) then
      Self.EndScript();

    Self.State := Self.GetState();
    case Self.State of
      EState.OPEN_CHAT: ChatButtons.Open(EChatButton.GAME_CHAT);
      EState.CHANGE_CHAT_FILTER: ChatButtons.ChangeState(EChatButton.GAME_CHAT, EChatButtonState.ENABLED);
      EState.DO_FARM_RUN: begin Self.StartAtBank(); FarmRunner.DoFarmRun; XPbar.TotalEarnedXP(); end;
      EState.DO_BH_RUN: begin Self.StartAtBank(); BirdHouseRunner.DoBirdHouseRun(); XPbar.TotalEarnedXP(); end;
      EState.WAIT_FOR_NEXT: begin Self.StartAtBank(); Self.WaitForNext(); end;
      EState.END_SCRIPT: Self.EndScript();
    end;
  end;
end;

begin
  SettingsHandler.CheckGPUPlugin();

  if (not DirectoryExists(AppPath+'\Resources\')) then
    CreateDirectory(AppPath+'\Resources');

  if FileExists(AppPath+'\Configs/StudentsSettings') then
  SoloFBH.Init();

  GUI.Setup('Farm Runner', [750,466]);
  GUI.PageControl.SetAllChildsFontColor($000000);
  GUI.Run;

  {$IFNDEF SRL_DISABLE_REMOTEINPUT}
  if WLSettings.GetObject('remote_input').getBoolean('enabled', True) and (not GameClient.RemoteInput.IsSetup()) then GameClient.RemoteInput.Setup();
  {$ENDIF}

  SoloFBH.Write();

  Bot.Init();
  Bot.Run();
end.
