function TScript.handleWalking(Destination: String; Force:Boolean=False): Boolean;
begin
  case Destination of
  'Bank':
  begin
    if (not Self.RSW.AtTile(Self.BankTile, 24)) or Force  then
        Result := Self.RSW.WebWalk(Self.BankTile, 24);
  end;
  end;
end;

function TScript.clickBankChest(): Boolean;
var
  attempt: Int32;
begin
  if (Self.BankObj.UpText.Len > 0) then
    Bank.WalkOpen(Self.BankObj)
  else
  begin
    for attempt := 0 to 5 do
    begin
      Self.handleWalking('Bank');

      if (Self.RSW.AtTile(Self.BankTile, 24)) then
        Bank.WalkOpen(Self.BankObj);

      Bank.IsOpen(10000);
      Break;
    end;
  end;

  Result := Bank.IsOpen(3500, 125);
  if Result then Exit;
end;

function TScript.clickBankBooth(): Boolean;
var
  attempt: Int32;
begin
  if GameInterface.IsOpen(EInterfaceType.ANY) then
    GameInterface.Close();

  for attempt := 0 to 8 do
  begin
    Self.handleWalking('Bank');

    if (Self.RSW.AtTile(Self.BankTile, 24)) then
      Bank.WalkOpen(Self.BankObj);

    Bank.IsOpen(10000);
    Break;
  end;

  Result := Bank.IsOpen(3500, 125);
  if Result then Exit;
end;

function TScript.WithdrawHelper(item : TItem; quant : Int32) : Boolean;
var
  withdrawItem : TBankItem;
  attempts : int32;
  I : Int32;
begin
  if Inventory.ContainsItem(item) then
    Exit(True);

  Bot.WriteMsg('Withdrawing ' + item);

  for I := 0 to High(Self.BankItems) do
  begin
    if Self.BankItems[I].Item = item then
    begin
      withdrawItem := Self.BankItems[I];
      Break;
    end;
  end;

  if withdrawItem.Item <> item then
  begin
    withdrawItem := TBankItem.Setup(item, quant, False);
    Self.BankItems += withdrawItem;
  end;

  withdrawItem.Quantity := quant;

  for attempts := 0 to 8 do
  begin
    withdrawItem := TBankItem.Setup(item, quant, False);
    Bank.WithdrawItem(withdrawItem, False);
    Result := Waituntil(Inventory.ContainsItem(item), 315, 3000);

    if Inventory.ContainsItem(item) then
      Break;

    if (attempts > 7) and not Inventory.ContainsItem(item) then
    begin
      Logout.ClickLogout();
      TerminateScript('Did not find ' + item);
    end;
  end;

end;

procedure TScript.EndOfBHRun();
begin
  if Inventory.ContainsItem('Coin pouch') then
  begin
    Inventory.ClickItem('Coin pouch', 'Open-all');
    WaitUntil(Inventory.ContainsItem('Coins'), 115, 5000);
  end;

  case Bot.Location of
  'Varrock west', 'Varrock east':
    Bot.VarrockTeleport();

  'Ardougne':
    Bot.ArdougneTeleport();

  'Falador':
    Bot.FaladorTeleport();

  'Castle wars':
    Bot.CastleWarsTeleport();

  'Ferox':
    Bot.FeroxEnclaveTeleport();

  'Catherby':
    Bot.CatherbyTeleport();

  'Crafting guild':
    Bot.CraftingGuildTeleport();

  'Farming guild':
    Bot.FarmingGuildTeleport();
  end;

  Wait(500,750);
end;

procedure TScript.StartAtBank();
begin
  if Inventory.ContainsItem('Coin pouch') then
  begin
    Inventory.ClickItem('Coin pouch', 'Open-all');
    WaitUntil(Inventory.ContainsItem('Coins'), 115, 5000);
  end;

  case Bot.Location of
  'Varrock west':
  begin
    Bot.VarrockTeleport();

    Bot.handleWalking('Bank');
  end;

  'Varrock east':
  begin
    Bot.VarrockTeleport();

    Bot.handleWalking('Bank');
  end;

  'Ardougne':
  begin
    Bot.ArdougneTeleport();

    Bot.handleWalking('Bank');
  end;

  'Falador':
  begin
    Bot.FaladorTeleport();

    Bot.handleWalking('Bank');
  end;

  'Castle wars':
  begin
    Bot.CastleWarsTeleport();
  end;

  'Ferox':
  begin
    Bot.FeroxEnclaveTeleport();
  end;

  'Catherby':
  begin
    Bot.CatherbyTeleport();

    Bot.handleWalking('Bank');
   end;

  'Crafting guild':
  begin
    Bot.CraftingGuildTeleport();
  end;

  'Farming guild':
  begin
    Bot.FarmingGuildTeleport();

    Bot.handleWalking('Bank');
  end;
  end;

  Wait(500,750);
end;

procedure TFarmRun.OnStart(); override;
var
  I: Int32;
  bankTimeout: TCountdown;
begin
  for I := 0 to High(Antiban.tasks) do
    Antiban.Tasks[I].Countdown.Pause;

  begin
    Bot.StartAtBank();

    bankTimeout.Init(45000);

    while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
    begin
      if Bot.Location.ContainsAny(['Castle', 'Ferox', 'Catherby', 'Crafting']) then
        Bot.clickBankBooth();

      if Bot.Location.ContainsAny(['Varrock', 'Ardougne', 'Falador', 'Crafting']) then
        Bank.WalkOpen(Bot.BankObj);

      if Bot.Location.ContainsAny(['Farming', 'JUST', 'Falador', 'Crafting']) then
        Bot.clickbankChest();
    end;

    Wait(500,750);

    Bank.DepositRandomItems(['Rune pouch', 'Divine rune pouch', 'Magic secateurs', 'Bottomless compost bucket', 'Seed dibber',
                             'Spade', 'Air rune', 'Water rune', 'Earth rune', 'Law rune', 'Fire rune', 'Escape crystal',
                             'Ardougne cloak 1', 'Ardougne cloak 2', 'Ardougne cloak 3', 'Ardougne cloak 4',
                             "Explorer's ring 1", "Explorer's ring 2", "Explorer's ring 3", "Explorer's ring 4",
                             'Potato seed', 'Onion seed', 'Cabbage seed', 'Tomato seed', 'Sweetcorn seed',
                             'Strawberry seed', 'Watermelon seed', 'Snape grass seed', 'Limpwurt seed',
                             'Guam seed', 'Marrentill seed', 'Tarromin seed', 'Harralander seed', 'Ranarr seed',
                             'Toadflax seed', 'Irit seed', 'Avantoe seed', 'Kwuarm seed', 'Snapdragon seed',
                             'Cadantine seed', 'Lantadyme seed', 'Dwarf weed seed', 'Torstol seed',
                             "Xeric's talisman", 'Hosidius teleport', 'Teleport to house',
                             'Icy basalt', 'Stony basalt', 'Nature rune', 'Astral rune', 'Volcanic ash',
                             'Skills necklace(6)', 'Seaweed spore', 'Digsite Pendant (5)',
                             'Construct. cape', 'Construct. cape(t)', 'Farming cape', 'Farming cape(t)',
                             'Crafting cape', 'Crafting cape(t)', 'Catherby teleport', 'Camelot teleport',
                             'Ardougne teleport', 'Falador teleport', 'Hosidius teleport', 'Varrock teleport',
                             'Civitas illa fortis teleport'
                            ]);

    if Bot.ringofdueling then
    begin
      Bot.WithdrawHelper('Ring of dueling(8)', 1);

      if Inventory.ContainsItem('Ring of dueling(8)') then
      begin
        Bot.WriteMsg('Equipping ring');
        Inventory.ClickItem('Ring of dueling(8)', 'Wear');
        WaitUntil(not Inventory.ContainsItem('Ring of dueling(8)'), 115, 5000);
      end;

      Bot.ringofdueling := False;
    end;
  end;

  inherited;
end;

procedure TFarmRun.OnComplete(); override;
var
  bankTimeout: TCountdown;
  I, attempts: Int32;
  MyPos: TPoint;
begin
  if chat.HasContinue then
    Chat.ClickContinue();

  Bot.StartAtBank();

  case Bot.Location of
  'Varrock west':
  begin
    bankTimeout.Init(45000);

    while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
    begin
      Bank.WalkOpen(Bot.BankObj);
    end;

    WaitUntil(Bank.IsOpen(), 115, 12500);

    if Bot.DoFarmRuns and not Bot.DoBHRuns then
    begin
      Bank.DepositRandomItems(['Rune pouch', 'Divine rune pouch', 'Varrock teleport', 'Magic secateurs', 'Compost', 'Supercompost', 'Ultracompost', 'Bottomless compost bucket', 'Seed dibber',
      'Spade', 'Air rune', 'Water rune', 'Earth rune', 'Law rune', 'Fire rune', 'Escape crystal', 'Ardougne cloak 1', 'Ardougne cloak 2', 'Ardougne cloak 3', 'Ardougne cloak 4',
      "Explorer's ring 1", "Explorer's ring 2", "Explorer's ring 3", "Explorer's ring 4", 'Potato seed', 'Onion seed', 'Cabbage seed', 'Tomato seed', 'Sweetcorn seed',
      'Strawberry seed', 'Watermelon seed', 'Snape grass seed', 'Limpwurt seed', 'Huasca seed', 'Guam seed', 'Marrentill seed', 'Tarromin seed','Harralander seed', 'Ranarr seed',
      'Toadflax seed', 'Irit seed', 'Avantoe seed', 'Kwuarm seed', 'Snapdragon seed', 'Cadantine seed', 'Lantadyme seed', 'Dwarf weed seed', 'Torstol seed', "Xeric's talisman",
      'Hosidius teleport', 'Teleport to house', 'Icy basalt', 'Stony basalt', 'Nature rune', 'Astral rune', 'Volcanic ash']);
    end
    else
    begin
      Bank.DepositRandomItems(['Law rune', 'Fire rune', 'Air rune', 'Varrock teleport', 'Rune pouch', 'Divine rune pouch']);
    end;
  end;

  'Varrock east':
  begin
    bankTimeout.Init(45000);

    while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
    begin
      Bank.WalkOpen(Bot.BankObj);
    end;

    WaitUntil(Bank.IsOpen(), 115, 12500);

    if Bot.DoFarmRuns and not Bot.DoBHRuns then
    begin
      Bank.DepositRandomItems(['Rune pouch', 'Divine rune pouch', 'Varrock teleport', 'Magic secateurs', 'Compost', 'Supercompost', 'Ultracompost', 'Bottomless compost bucket', 'Seed dibber',
      'Spade', 'Air rune', 'Water rune', 'Earth rune', 'Law rune', 'Fire rune', 'Ardougne cloak 1', 'Ardougne cloak 2', 'Ardougne cloak 3', 'Ardougne cloak 4',
      "Explorer's ring 1", "Explorer's ring 2", "Explorer's ring 3", "Explorer's ring 4", 'Potato seed', 'Onion seed', 'Cabbage seed', 'Tomato seed', 'Sweetcorn seed',
      'Strawberry seed', 'Watermelon seed', 'Snape grass seed', 'Limpwurt seed', 'Huasca seed', 'Guam seed', 'Marrentill seed', 'Tarromin seed','Harralander seed', 'Ranarr seed',
      'Toadflax seed', 'Irit seed', 'Avantoe seed', 'Kwuarm seed', 'Snapdragon seed', 'Cadantine seed', 'Lantadyme seed', 'Dwarf weed seed', 'Torstol seed', "Xeric's talisman",
      'Hosidius teleport', 'Teleport to house', 'Icy basalt', 'Stony basalt', 'Nature rune', 'Astral rune', 'Volcanic ash']);
    end
    else
    begin
      Bank.DepositRandomItems(['Law rune', 'Fire rune', 'Air rune', 'Varrock teleport', 'Rune pouch', 'Divine rune pouch']);
    end;
  end;

  'Ardougne':
  begin
    bankTimeout.Init(45000);

    while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
    begin
      Bank.WalkOpen(Bot.BankObj);
    end;

    WaitUntil(Bank.IsOpen(), 115, 12500);

    if Bot.DoFarmRuns and not Bot.DoBHRuns then
