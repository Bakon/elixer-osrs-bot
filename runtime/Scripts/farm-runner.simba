function TMM2MSProjector.Run(Coords: Vector3Array; Rotation: Vector3): TPointArray; override;
var
  I: Int32;
begin
  if not Self.Calculated then
  begin
    Self.Zoom := TMM2MSProjector.TransformZoom(Self.ZoomLevel);
    Self.ScaleMin := Self.SCALE_MIN * MainScreen.Height / 503; // fixed client height
    Self.ScaleMax := Self.SCALE_MAX * MainScreen.Height / 503; // fixed client height
    if GameClient.Mode = EClientMode.FIXED then
      Self.ViewMatrix := TMatrix4.LookAtRH([0, EYE_Y_FIXED[Self.ZoomLevel], EYE_Z_FIXED[Self.ZoomLevel]], [0, 0, 1.0], Vector3_UnitY)
    else
      Self.ViewMatrix := TMatrix4.LookAtRH([0, EYE_Y_RESIZABLE[Self.ZoomLevel], EYE_Z_RESIZABLE[Self.ZoomLevel]], [0, 0, 1.0], Vector3_UnitY);
    Self.ProjMatrix := TMatrix4.PerspectiveFovRH(Sqrt(2), 765 / 503 *1.03, 0.01, 1.0);           // fixed client width & height

    Self.WorldMatrix := TMatrix4.RotationYawPitchRoll(Rotation.Y, Rotation.X, Rotation.Z) * Matrix_Identity;
    Self.TransMatrix := Self.WorldMatrix * Self.ViewMatrix * Self.ProjMatrix;

    Self.Calculated := True;
  end;

  SetLength(Result, Length(Coords));

  for I := 0 to High(Coords) do
    with Self.Transform(Coords[I], Self.TransMatrix) do
    begin
      Result[I].X := Round(X);
      Result[I].Y := Round(Y);
    end;
end;

type
   EState = (
    OPEN_CHAT, CHANGE_CHAT_FILTER, DO_FARM_RUN, DO_BH_RUN, PROGRESS_REPORT, WAIT_FOR_NEXT, END_SCRIPT
  );

type
  TScript = record
    tpa                 : TPointArray;
    MyPos               : TPoint;
    State               : EState;
    Version,
    Location,
    TeleportMethod,
    RPouchMethod        : String;
    ArdyDiary,
    VarrockDiary,
    RunCount            : Int32;
    BankTile            : TPoint;
    BankObj,
    ChainUp             : TGameObject;
    WalkSearch,
    TakeBreaks,
    TakeSleeps,
    DoFarmRuns,
    DoBHRuns,
    InfiniteAir,
    InfiniteWater,
    InfiniteEarth,
    InfiniteFire,
    VarrockTeleportSetup,
    ringofdueling,
    JustGiantSeaweed    : Boolean;
    Transport           : TUniversalTransport;
    RSW                 : TWalker;
    ShutdownTime        : Int64;
    BankItems           : TBankItemArray;
  end;

  TIniConfig = record
    frunEnabled,       // farm run
    brunEnabled,       // bh run
    startfarmEnabled,  // start with a farm run
    tbreakenabled,      // take breaks
    tsleepenabled,      // take sleeps
    bhusebestlogEnabled, // best log BH
    bhcraftclockworksEnabled: Boolean; // clockworks BH
    banklocationint,   // bank
    runepouchint,      // rune pouch
    teleportmethodint, // tp method
    bhlogint,          // blog type BH
    bhrunint,          // run interval BH
    maxrunforint,      // max run for
    breakintervalint,  // break interval
    breaklengthint,    // break length
    sleeplengthint,    // sleep length
    returnint,         // return option
    loginindexint: int32;     // LoginIndex
    bhseed, // string BH
    sleepintervalstr  : string; //sleep interval string
  end;

var
  SoloFBH: TIniConfig;
  Bot : TScript;
  GUI: TScriptForm;

procedure TScript.WriteMsg(Message: String);
begin
  WriteLn('[Bot]: '+Message);
end;

procedure TIniConfig.Init();
var
  frun, brun, tbreak, tsleep,
  bhbestlog, bhclockworks : string;
begin
   frun := ReadINI('SoloFBH General', 'Farm runs', AppPath+'Configs/StudentsSettings');
   self.frunEnabled := StrToBoolDef(frun, False);

   brun := ReadINI('SoloFBH General', 'BH runs', AppPath+'Configs/StudentsSettings');
   self.brunEnabled := StrToBoolDef(brun, False);

   tbreak := ReadINI('SoloFBH General', 'Take breaks', AppPath+'Configs/StudentsSettings');
   self.tbreakenabled := StrToBoolDef(tbreak, False);

   tsleep := ReadINI('SoloFBH General', 'Take sleeps', AppPath+'Configs/StudentsSettings');
   self.tsleepenabled := StrToBoolDef(tsleep, False);

   SoloFBH.banklocationint := StrToIntDef(ReadINI('SoloFBH General', 'Bank location', AppPath+'Configs/StudentsSettings'), 0);
   SoloFBH.teleportmethodint := StrToIntDef(ReadINI('SoloFBH General', 'Teleport method', AppPath+'Configs/StudentsSettings'), 0);
   SoloFBH.maxrunforint := StrToIntDef(ReadINI('SoloFBH General', 'Max run for', AppPath+'Configs/StudentsSettings'), 600);
   SoloFBH.breakintervalint := StrToIntDef(ReadINI('SoloFBH General', 'Break interval', AppPath+'Configs/StudentsSettings'), 60);
   SoloFBH.breaklengthint := StrToIntDef(ReadINI('SoloFBH General', 'Break length', AppPath+'Configs/StudentsSettings'), 15);
   SoloFBH.sleepintervalstr := ReadINI('SoloFBH General', 'Sleep interval', AppPath+'Configs/StudentsSettings');
   SoloFBH.sleeplengthint := StrToIntDef(ReadINI('SoloFBH General', 'Sleep length', AppPath+'Configs/StudentsSettings'), 8);

   SoloFBH.bhlogint := StrToIntDef(ReadINI('SoloFBH BH Tab', 'BH logs', AppPath+'Configs/StudentsSettings'), 0);
   BHIncludeGUILogType := ELogType(SoloFBH.bhlogint);

   SoloFBH.bhseed := ReadINI('SoloFBH BH Tab', 'BH seed', AppPath+'Configs/StudentsSettings');
   BHIncludeGUISeed := SoloFBH.bhseed;

   SoloFBH.bhrunint := StrToIntDef(ReadINI('SoloFBH BH Tab', 'BH runtime', AppPath+'Configs/StudentsSettings'), 0);
   BHIncludeGUIRunIntervalMinutes := Round(SoloFBH.bhrunint / 60000);

   bhbestlog := ReadINI('SoloFBH BH Tab', 'BH best log', AppPath+'Configs/StudentsSettings');
   self.bhusebestlogEnabled := StrToBoolDef(bhbestlog, False);
   BHIncludeGUIUseBestLog := SoloFBH.bhusebestlogEnabled;

   bhclockworks := ReadINI('SoloFBH BH Tab', 'BH clockworks', AppPath+'Configs/StudentsSettings');
   self.bhcraftclockworksEnabled := StrToBoolDef(bhclockworks, False);
   BHIncludeGUICraftWhileNav := SoloFBH.bhcraftclockworksEnabled;

   SoloFBH.loginindexint := StrToIntDef(ReadINI('SoloFBH Account Tab', 'Login index', AppPath+'Configs/StudentsSettings'), 0);
   Login.PlayerIndex := SoloFBH.loginindexint;
end;

procedure TIniConfig.Write();
begin
  WriteIni('SoloFBH General', 'Farm runs', ToStr(self.frunEnabled), AppPath+'Configs/StudentsSettings');
  WriteIni('SoloFBH General', 'BH runs', ToStr(self.brunEnabled), AppPath+'Configs/StudentsSettings');
  WriteIni('SoloFBH General', 'Max run for', ToStr(self.maxrunforint), AppPath+'Configs/StudentsSettings');
  WriteIni('SoloFBH General', 'Take breaks', ToStr(self.tbreakenabled), AppPath+'Configs/StudentsSettings');
  WriteIni('SoloFBH General', 'Take sleeps', ToStr(self.tsleepenabled), AppPath+'Configs/StudentsSettings');
  WriteIni('SoloFBH General', 'Bank location', ToStr(self.banklocationint), AppPath+'Configs/StudentsSettings');
  WriteIni('SoloFBH General', 'Teleport method', ToStr(self.teleportmethodint), AppPath+'Configs/StudentsSettings');
  WriteIni('SoloFBH General', 'Break interval', ToStr(self.breakintervalint), AppPath+'Configs/StudentsSettings');
  WriteIni('SoloFBH General', 'Break length', ToStr(self.breaklengthint), AppPath+'Configs/StudentsSettings');
  WriteIni('SoloFBH General', 'Sleep interval', Self.sleepintervalstr, AppPath+'Configs/StudentsSettings');
  WriteIni('SoloFBH General', 'Sleep length', ToStr(self.sleeplengthint), AppPath+'Configs/StudentsSettings');

  WriteIni('SoloFBH BH Tab', 'BH logs', ToStr(Ord(BirdHouseRunner.LogType)), AppPath+'Configs/StudentsSettings');
  WriteIni('SoloFBH BH Tab', 'BH seed', BirdHouseRunner.Seed, AppPath+'Configs/StudentsSettings');
  WriteIni('SoloFBH BH Tab', 'BH runtime', ToStr(BirdHouseRunner.TaskInterval), AppPath+'Configs/StudentsSettings');
  WriteIni('SoloFBH BH Tab', 'BH best log', ToStr(BirdHouseRunner.AlwaysUseBestLog), AppPath+'Configs/StudentsSettings');
  WriteIni('SoloFBH BH Tab', 'BH clockworks', ToStr(BirdHouseRunner.NeedClockworks), AppPath+'Configs/StudentsSettings');

  WriteIni('SoloFBH Account Tab', 'Login index', ToStr(Login.PlayerIndex), AppPath+'Configs/StudentsSettings');

  // ... any other things you stored on TIniConfig
end;

procedure TScriptForm.StartScript(Sender: TObject); override;
var
  MaxRun: Int32;
  e_Run, e_BA, e_BF, e_SA, e_SF: TEdit;
  cb_Breaks,cb_Sleeps, FarmRuns, BHRuns: TCheckBox;
  Loc, teleportmethodcb : TComboBox;

begin
  inherited;

  Self.Form.Close();
  Bot.WriteMsg('Starting script');

{ Time settings }
  e_Run            := Self.Form.GetChild('box_run_edit');
  MaxRun           := StrToInt(e_Run.getText);
  Bot.ShutdownTime := (MaxRun * 60000) + Random(- (MaxRun * 6000), (MaxRun * 6000));

  cb_Breaks        := Self.Form.GetChild('cb_breaks_checkbox');
  Bot.TakeBreaks   := cb_Breaks.IsChecked;

  if Bot.TakeBreaks then
  begin
    e_BA           := Self.Form.GetChild('box_ba_edit');
    e_BF           := Self.Form.GetChild('box_bf_edit');
    Antiban.AddBreak(ONE_MINUTE*StrToInt(e_BA.getText),ONE_MINUTE*StrToInt(e_BF.getText), 0.15, 1.0);
  end;

  cb_Sleeps        := Self.Form.GetChild('cb_sleeps_checkbox');
  Bot.TakeSleeps   := cb_Sleeps.IsChecked;
  if Bot.TakeSleeps then
  begin
    e_SA           := Self.Form.GetChild('box_sa_edit');
    e_SF           := Self.Form.GetChild('box_sf_edit');
    Antiban.AddSleep(e_SA.getText, StrToInt(e_SF.getText) * ONE_HOUR, 0.1, 1.0);
  end;

{ Script settings }
  Loc  := Self.Form.GetChild('lcb_loc_combobox');
  teleportmethodcb := Self.Form.GetChild('lcb_tpmethod_combobox');

  Bot.Location     := Loc.GetText;
  Bot.TeleportMethod := teleportmethodcb.getText;

  {  Farm GUI settings  }
  FarmRuns := Self.Form.GetChild('cb_farmruns_checkbox');
  BHRuns := Self.Form.GetChild('cb_bhruns_checkbox');

  Bot.DoFarmRuns  := (FarmRuns.GetState = cbChecked);
  Bot.DoBHRuns    := (BHRuns.getState = cbChecked);

  SoloFBH.banklocationint := Loc.getItemIndex();
  SoloFBH.teleportmethodint := teleportmethodcb.getItemIndex();

  SoloFBH.frunEnabled := Bot.DoFarmRuns;
  SoloFBH.brunEnabled := Bot.DoBHRuns;
  SoloFBH.maxrunforint := MaxRun;

  SoloFBH.tbreakenabled := Bot.TakeBreaks;
  SoloFBH.tsleepenabled := Bot.TakeSleeps;

  if Bot.TakeBreaks then
  begin
    SoloFBH.breakintervalint := StrToInt(e_BA.getText);
    SoloFBH.breaklengthint := StrToInt(e_BF.getText);
  end;

  if Bot.TakeSleeps then
  begin
    SoloFBH.sleepintervalstr := e_SA.getText;
    SoloFBH.sleeplengthint := StrToInt(e_SF.getText);
  end;
end;

function TScriptForm.CreateSettingsTab(): TTabSheet;
type
  TScriptForm = TScriptForm;

procedure TScriptForm.UpdateSList({$H-}sender: TObject);{$H+}
var
  S, Loc, teleportmethodcb: TComboBox;
  LocCap: Tlabel;

begin
  teleportmethodcb  := Self.Form.GetChild('lcb_tpmethod_combobox');
  Loc  := Self.Form.GetChild('lcb_loc_combobox');
  LocCap := Self.Form.GetChild('lcb_loc_caption');

  Loc.SetFontColor(0);
  LocCap.SetFontColor(0); // Needed?
  teleportmethodcb.SetFontColor(0);
  teleportmethodcb.Clear;

  if Loc.getItemIndex = 0 then // Varrock west
  begin
    teleportmethodcb.AddItem('Varrock teleport (normal spellbook)', S);
    teleportmethodcb.AddItem('Varrock tablet', S);
  end;

  if Loc.getItemIndex = 1 then // Varrock east
  begin
    teleportmethodcb.AddItem('Varrock teleport (normal spellbook)', S);
    teleportmethodcb.AddItem('Varrock tablet', S);
  end;

  if Loc.getItemIndex = 2 then // Ardougne
  begin
    teleportmethodcb.AddItem('Ardougne teleport (normal spellbook)', S);
    teleportmethodcb.AddItem('Ardougne tablet', S);
  end;

  if Loc.getItemIndex = 3 then // Falador
  begin
    teleportmethodcb.AddItem('Falador teleport (normal spellbook)', S);
    teleportmethodcb.AddItem('Falador tablet', S);
  end;

  if Loc.getItemIndex = 4 then // Castle wars
  begin
    teleportmethodcb.AddItem('Ring of dueling', S);
  end;

  if Loc.getItemIndex = 5 then // Ferox Enclave
  begin
    teleportmethodcb.AddItem('Ring of dueling', S);
  end;

  if Loc.getItemIndex = 6 then // Catherby
  begin
    teleportmethodcb.AddItem('Choose in farm tab', S);
  end;

  if Loc.getItemIndex = 7 then // Crafting guild
  begin
    teleportmethodcb.AddItem('Crafting cape', S);
  end;

  if Loc.getItemIndex = 8 then // Farming guild
  begin
    teleportmethodcb.AddItem('Choose in farm tab', S);
  end;

  teleportmethodcb.setItemIndex(0);
end;

var
  lb_Time,lb_Script: TLabel;
  cb_Breaks,cb_Sleeps, cb_farmruns, cb_bhruns: TLabeledCheckBox;
  box_Run,box_BA,box_BF,
  box_SA,box_SF: TLabeledEdit;
  lcb_Loc, lcb_tpmethod: TLabeledComboBox;

begin
  Result.Init(nil);
  Result.SetCaption('Script settings');
  Result.SetName('Settings_Tab');

{ Setup time settings }
  with lb_Time do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(125));
    SetTop(TControl.AdjustToDPI(10));
    SetFontColor($000000);
    GetFont().SetSize(15);
    SetCaption('Time Settings');
  end;

  with box_Run do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(562));
    SetTop(TControl.AdjustToDPI(310));
    SetName('box_Run');
    SetCaption('Run for (mins)');
    SetToolTip('Time in minutes');
    SetText('300');
    SetMaxLength(5);
    SetFontColor($000000);
  end;

  with cb_Breaks do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(5));
    SetTop(TControl.AdjustToDPI(55));
    SetName('cb_breaks');
    SetCaption('Take breaks');
    SetFontColor($000000);
  end;

  with box_BA do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(5));
    SetTop(TControl.AdjustToDPI(75));
    SetName('box_ba');
    SetCaption('Break after');
    SetToolTip('Time in minutes');
    SetText('60');
    SetFontColor($000000);
  end;

  with box_BF do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(5));
    SetTop(TControl.AdjustToDPI(125));
    SetName('box_bf');
    SetCaption('Break for');
    SetToolTip('Time in minutes');
    SetText('15');
    SetFontColor($000000);
  end;

  with cb_Sleeps do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(200));
    SetTop(TControl.AdjustToDPI(55));
    SetName('cb_sleeps');
    SetCaption('Take sleeps');
    SetFontColor($000000);
  end;

  with box_SA do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(200));
    SetTop(TControl.AdjustToDPI(75));
    SetName('box_sa');
    SetCaption('Sleep at');
    SetToolTip('Time in 24Hr format');
    SetText('11:00:00');
    SetFontColor($000000);
  end;

  with box_SF do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(200));
    SetTop(TControl.AdjustToDPI(125));
    SetName('box_sf');
    SetCaption('Sleep for');
    SetToolTip('Time in hours');
    SetText('2');
    SetFontColor($000000);
  end;

{ Setup general settings }
  with lb_Script do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(562));
    SetTop(TControl.AdjustToDPI(10));
    SetFontColor($000000);
    GetFont().SetSize(15);
    SetCaption('General settings');
  end;

  with lcb_Loc do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(562));
    SetTop(TControl.AdjustToDPI(45));
    SetName('lcb_loc');
    SetCaption('Location');
    AddItemArray(['Varrock west', 'Varrock east', 'Ardougne', 'Falador', 'Castle wars', 'Ferox', 'Catherby', 'Crafting guild', 'Farming guild', 'JUST Giant Seaweed']);
    SetFontColor($000000);
    ComboBox.SetFontColor(0);
    SetStyle(csDropDownList);
    ComboBox.setItemIndex(SoloFBH.banklocationint);
    ComboBox.SetOnChange(@Self.UpdateSList);
  end;

  with lcb_tpmethod do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(562));
    SetTop(TControl.AdjustToDPI(90));
    SetName('lcb_tpmethod');
    SetCaption('Transport method');
    SetFontColor($000000);
    SetStyle(csDropDownList);
    ComboBox.SetFontColor(0);
  end;

  case lcb_Loc.GetItemIndex of
      0:  begin
            lcb_tpmethod.AddItem('Varrock teleport (normal spellbook)');
            lcb_tpmethod.AddItem('Varrock tablet');
          end;
      1:  begin
            lcb_tpmethod.AddItem('Varrock teleport (normal spellbook)');
            lcb_tpmethod.AddItem('Varrock tablet');
          end;
      2:  begin
            lcb_tpmethod.AddItem('Ardougne teleport (normal spellbook)');
            lcb_tpmethod.AddItem('Ardougne tablet');
          end;
      3:  begin
            lcb_tpmethod.AddItem('Falador teleport (normal spellbook)');
            lcb_tpmethod.AddItem('Falador tablet');
          end;
      4: lcb_tpmethod.AddItem('Ring of dueling');
      5: lcb_tpmethod.AddItem('Ring of dueling');
      6: lcb_tpmethod.AddItem('Choose in farm tab');
      7: lcb_tpmethod.AddItem('Crafting cape');
      8: lcb_tpmethod.AddItem('Choose in farm tab');
  end;

  lcb_tpmethod.SetItemIndex(SoloFBH.teleportmethodint);


  with cb_farmruns do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(562));
    SetTop(TControl.AdjustToDPI(185));
    SetName('cb_farmruns');
    SetFontColor($000000);
    SetCaption('Farm runs');
  end;

  with cb_bhruns do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(562));
    SetTop(TControl.AdjustToDPI(205));
    SetName('cb_bhruns');
    SetFontColor($000000);
    SetCaption('Birdhouse runs');
  end;

  lcb_Loc.SetItemIndex(SoloFBH.banklocationint);

  if (SoloFBH.maxrunforint <> 0) then
    box_Run.SetText(ToStr(SoloFBH.maxrunforint));

  if SoloFBH.brunEnabled then
    cb_bhruns.CheckBox.SetChecked(True);

  if SoloFBH.frunEnabled then
    cb_farmruns.CheckBox.SetChecked(True);

  if SoloFBH.tbreakenabled then
  begin
    cb_Breaks.CheckBox.SetChecked(True);
    box_BA.SetText(ToStr(SoloFBH.breakintervalint));
    box_BF.SetText(ToStr(SoloFBH.breaklengthint));
  end;

  if SoloFBH.tsleepenabled then
  begin
    cb_Sleeps.CheckBox.SetChecked(True);
    box_SA.SetText(SoloFBH.sleepintervalstr);
    box_SF.SetText(ToStr(SoloFBH.sleeplengthint));
  end;
end;

procedure TScriptForm.Setup(caption: String = 'Script Form'; size: TPoint = [750, 500]; allowResize: Boolean = False); override;
var
  Img: TPicture;
  BGImg: TImage;
  SButton: TButton;
begin
  inherited;

  Img.init();
  //Img.LoadFromFile('Resources\SSSFBGUI.png');
  with BGImg do
  begin
    Init(Self.PageControl);
    SetParent(Self.PageControl);
    SetBounds(0,0,Self.Form.getWidth,Self.Form.getHeight);
    SetPicture(Img);
  end;

  Self.Start.setVisible(False);
  with SButton do
  begin
    Create(Self.Form);
    SetBounds(Self.Form.GetRight-190, Self.Form.GetBottom-70, 180, 60);
    GetFont.SetName('Bahnschrift');
    GetFont.SetSize(15);
    SetCaption('Run');
    SetOnClick(@Self.StartScript);
  end;

  Self.AddTab(CreateSettingsTab());
  Self.CreateAccountManager();
  Self.CreateFarmRunSettingsTab();
  Self.CreateBirdhouseRunSettings();
end;

function TInventory.IsOpen(): Boolean; override;
begin
  Result := (GameTabs.GetCurrentTab() = EGameTab.INVENTORY);
  if (not Result) then Self.Open;
  Result := (GameTabs.GetCurrentTab() = EGameTab.INVENTORY);
end;

procedure TMinimap.RotateWithinAngles(min, max: Int32);
var
  minMaxAvg: Int32 := Floor((min + max) div 2);
  preferredAngle: Int32 := SRL.SkewedRand(minMaxAvg, min, max);
begin
  if preferredAngle < 0 then
    preferredAngle := preferredAngle + 360;

  Minimap.SetCompassAngle(preferredAngle);
end;

// Undo the bogged down version in WaspLib
function TChooseOption.Select(Text: TStringArray; MouseAction: Int32 = MOUSE_LEFT; CaseSensitive: Boolean = True; CloseIfNotFound: Boolean = True): Boolean; override;
var
  Choices: TChooseOption_OptionArray;
  I, J: Int32;
begin
  if Self.Open() then
  begin
    Wait(0, 750, wdLeft);

    Choices := GetOptions();

    for I := 0 to High(Choices) do
      for J := 0 to High(Text) do
        if (CaseSensitive and (Text[J] in Choices[I].Text)) or ((not CaseSensitive) and (Lowercase(Text[J]) in Lowercase(Choices[I].Text))) then
        begin
          Self.Select(Choices[I], MouseAction);
          Exit(True);
        end;

    if CloseIfNotFound then
    begin
      WaitEx(400, 150);

      Self.Close();
    end;
  end;
end;

procedure TScript.IncludeEquipmentSetup();
var
  Staff    : String;
  AllStaves: TStringArray := ['Staff of air','Staff of water','Staff of earth','Staff of fire',
                              'Air battlestaff','Water battlestaff', 'Earth battlestaff', 'Fire battlestaff',
                              'Mystic air staff', 'Mystic water staff', 'Mystic earth staff', 'Mystic fire staff',
                              'Mystic dust staff', 'Mystic mist staff', 'Mystic dust staff','Mystic steam staff', 'Mystic mud staff',
                              'Dust battlestaff', 'Mist battlestaff', 'Steam battlestaff', 'Smoke battlestaff', 'Lava battlestaff', 'Mud battlestaff',
                              'Mystic smoke staff', 'Mystic steam staff', 'Mystic lava staff',
                              'Kodai wand'];
  Hits     : TItemFinderMatchArray;
begin

  case Bot.Location of
  'Ferox enclave', 'Castle wars':
  begin
    if not Equipment.ContainsAny(getChargedJewelleryNames('Ring of dueling')) then
      Self.ringofdueling := True;
  end;
  end;

  ItemFinder.Similarity := 0.9999;

  for Staff in AllStaves do
  begin
    if not Equipment.Open() then
      Exit;

    Hits := ItemFinder.FindAll([Staff], Equipment.GetSlotBoxes, 1);
    if Length(Hits) > 0 then
    begin
      if Staff.ContainsAny(['Air', 'Dust', 'Mist', 'Smoke', 'air', 'dust', 'mist', 'smoke']) then
        Self.InfiniteAir := True;

      if Staff.ContainsAny(['Water', 'Mud', 'Mist', 'Steam', 'Kodai', 'water', 'mud', 'mist', 'Steam']) then
        Self.InfiniteWater := True;

      if Staff.ContainsAny(['Earth', 'Dust', 'Mud', 'Lava', 'earth', 'dust', 'mud', 'lava']) then
        Self.InfiniteEarth := True;

      if Staff.ContainsAny(['Fire', 'Smoke', 'Steam', 'Lava', 'fire', 'smoke', 'steam', 'lava']) then
        Self.InfiniteFire := True;
    end;
  end;

  ItemFinder.Similarity := 0.999;

  if Equipment.ContainsItem('Tome of water') then
    Self.InfiniteWater := True;

  if Equipment.ContainsItem('Tome of fire') then
    Self.InfiniteFire := True;

  if Equipment.ContainsItem('Tome of earth') then
    Self.InfiniteEarth := True;

  case Bot.TeleportMethod of
  'Varrock tablet':
  begin
    Self.VarrockDiary := Achievements.GetDiaryLevel(EAchievementDiary.VARROCK);
    Self.WriteMsg('Varrock diary ' + ToStr(VarrockDiary));

    if (Self.VarrockDiary = 0) or (Self.VarrockDiary = 1) then
      Self.VarrockTeleportSetup := True;

    if (Self.VarrockDiary = 2) or (Self.VarrockDiary = 3) or (Self.VarrockDiary = 4) then
      Self.VarrockTeleportSetup := False;
  end;
  end;
end;

function TScript.bhtimerisReady(): Boolean;
begin
  Result := BirdHouseRunner.ScriptIntervalTimer.IsFinished();
end;

function TScript.farmtimerisReady(): Boolean;
begin
  Result := FarmRunner.ReadyTimer.IsFinished;
end;

procedure TScript.WaitForNext();
begin
  Bot.WriteMsg('Wait for next');

  if Self.farmtimerisReady or Self.bhtimerisReady then
    Exit;

  XPbar.TotalEarnedXP();

  Self.Report();

  Antiban.DoAntiban();

  Bot.WriteMsg('Going AFK until our next run is ready');

  if GameClient.IsLoggedIn() then
      Logout.ClickLogout();

  repeat
    if Self.DoBHRuns then
      Bot.WriteMsg('Next BH run in ' + SRL.MsToTime(BirdHouseRunner.ScriptIntervalTimer.TimeRemaining, Time_Short));

    if Self.DoFarmRuns then
      Bot.WriteMsg('Next Farm run in ' + SRL.MsToTime(FarmRunner.ReadyTimer.TimeRemaining, Time_Short));

    Antiban.LoseFocus(300000);
  until Self.farmtimerisReady or Self.bhtimerisReady;

  if not GameClient.IsLoggedIn() then
      Login.LoginPlayer(False);
end;

procedure TScript.Report();
begin
  if self.DoBHRuns then
    BirdhouseRunner.PrintReport();

  if self.DoFarmRuns then
    FarmRunner.Report;

  WriteLn('|===================================|');
  WriteLn('|--------- ~ Farm Runner ~ ---------|');
  WriteLn('|===================================|');
  WriteLn(padR('| Runtime: ' + SRL.MsToTime(GetTimeRunning, Time_Short), 36, ' ') + '|');
  if Self.TakeBreaks then
    WriteLn(padR('| Next break: ' + SRL.MsToTime(Max(0, Round(Antiban.Breaks[0].NextAtTime - GetTimeRunning)), Time_Short), 36, ' ') + '|');
  if Self.TakeSleeps then
    WriteLn(padR('| Next sleep: ' + SRL.MsToTime(Max(0, Round(Antiban.Sleeps[0].NextAtTime - GetTimeRunning)), Time_Short), 36, ' ') + '|');
  if self.DoBHRuns then
    WriteLn(padR('| Next BH run: ' + SRL.MsToTime(BirdHouseRunner.ScriptIntervalTimer.TimeRemaining(), TTimeFormat.Time_Short), 36, ' ') + '|');
  if self.DoFarmRuns then
    WriteLn(padR('| Next farm run: ' + SRL.MsToTime(FarmRunner.ReadyTimer.TimeRemaining(), TTimeFormat.Time_Short), 36, ' ') + '|');
    WriteLn(padR('| Shutdown: ' + ToStr(SRL.MsToTime(Self.ShutdownTime - GetTimeRunning, Time_Short)), 36, ' ') + '|');
  WriteLn('|===================================|');
  WriteLn('|=-=-=-=-=- ~ Elixer ~ -=-=-=-=-=-=-|');
  WriteLn('|===================================|');
end;


function TScript.ringofduelingCheck(): Boolean;
begin
  if (('dueling crumbles to dust' in Chat.GetMessage(7, [CHAT_COLOR_PURPLE])) or ('dueling crumbles to dust' in Chat.GetMessage(6, [CHAT_COLOR_PURPLE])) or ('dueling crumbles to dust' in Chat.GetMessage(5, [CHAT_COLOR_PURPLE]))) then
    Exit(Self.ringofdueling := True);
end;

function TScript.handleTeleport(TTLocation: TTeleportLocation; useMagic: Boolean; telBox: TBox; locString: String; TTmethodString: String): Boolean;
var
  attempts : Int32;
begin
  writeln('Teleporting to ' +  locString);
  for attempts := 1 to 5 do
  begin
    Transport.run(TTLocation, useMagic);

     Result := WaitUntil((MyPos := RSW.GetMyPos()).InBox(telBox), 115, 10000);

    if Result then
      Break;

    if attempts = 4 then
    begin
      Logout.ClickLogout();
      TerminateScript('Could not find or use ' + TTmethodString);
    end;
  end;
end;

procedure TScript.VarrockTeleport();
var
  TabSlot : Int32;
begin
  if Self.RSW.AtTile(Self.BankTile, 16) or ((MyPos := RSW.GetMyPos()).InBox(varrockBox)) then
    Exit;

  case Bot.TeleportMethod of
  'Varrock tablet':
  begin
    if Inventory.FindItem('Varrock teleport', TabSlot) then begin
      if not Self.VarrockTeleportSetup then begin
        Inventory.ClickSlot(TabSlot, 'Toggle');
        if not WaitUntil(('portal' in Chat.GetChatTitle), 17, 3000) then
          Exit;

        if 'Grand' in Chat.GetChatTitle then begin
          Chat.ClickOption('Varrock');
          if not WaitUntil(Chat.FindMessage('central Varr'), 17, 3000) then
            Exit;
        end;
        Self.VarrockTeleportSetup := True;
      end;
    end;

    Self.handleTeleport(RSTeleports.VARROCK, False, varrockBox, 'Varrock', 'Varrock teleport tab');
  end;

  'Varrock teleport (normal spellbook)':
    Self.handleTeleport(RSTeleports.VARROCK, True, varrockBox, 'Varrock', 'teleport to Varrock');
  end;
end;

procedure TScript.ArdougneTeleport();
begin
  if Self.RSW.AtTile(Self.BankTile, 16) or ((MyPos := RSW.GetMyPos()).InBox(ardougneBox)) then
    Exit;

  case Bot.TeleportMethod of
