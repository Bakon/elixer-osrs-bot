  begin
    Bot.WithdrawHelper('Ring of dueling(8)', 1);

    if Inventory.ContainsItem('Ring of dueling(8)') then
    begin
     Bot.WriteMsg('Equipping ring');
     Inventory.ClickItem('Ring of dueling(8)', 'Wear');
     WaitUntil(not Inventory.ContainsItem('Ring of dueling(8)'), 115, 5000);
    end;

    Bot.ringofdueling := False;
  end;

  for I := 0 to High(Antiban.tasks) do
  Antiban.Tasks[I].Countdown.Resume;
end;

function TBirdHouseInclude.OnStart() : Boolean; override;
var
  bankTimeout : TCountdown;
  I: Int32;
begin
  for I := 0 to High(Antiban.tasks) do
    Antiban.Tasks[I].Countdown.Pause;

  if Self.AlwaysUseBestLog then
  begin
    Self.SuggestedLogType := BirdhouseRunner.GetLogForHunterLevel(Stats.GetLevel(ESkill.HUNTER));
    if Self.LogType <> Self.SuggestedLogType then
      Self.LogType := Self.SuggestedLogType;
  end;

  case Bot.Location of
  'Varrock west':
  begin
    bankTimeout.Init(45000);

    while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
    begin
      Bank.WalkOpen(Bot.BankObj);
    end;

    WaitUntil(Bank.IsOpen(), 115, 12500);

    Bank.DepositRandomItems(['Law rune', 'Fire rune', 'Air rune', 'Varrock teleport', 'Rune pouch', 'Divine rune pouch', 'Escape crystal']);

    case Bot.TeleportMethod of
    'Varrock tablet':
      Bot.WithdrawHelper('Varrock teleport', -1);

    'Varrock teleport (normal spellbook)':
      case Bot.RPouchMethod of
      'Not using/use runes':
      begin
        Bot.WithdrawHelper('Law rune', -1);
        if not Bot.InfiniteFire then
        Bot.WithdrawHelper('Fire rune', -1);
        if not Bot.InfiniteAir then
          Bot.WithdrawHelper('Air rune', -1);
      end;

      'Rune pouch':
      begin
        Bot.WithdrawHelper('Rune pouch', -1);
      end;

      'Divine rune pouch':
      begin
        Bot.WithdrawHelper('Divine rune pouch', -1);
      end;
      end;
    end;
  end;

  'Varrock east':
  begin
    bankTimeout.Init(45000);

    while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
    begin
      Bank.WalkOpen(Bot.BankObj);
    end;

    WaitUntil(Bank.IsOpen(), 115, 12500);

    Bank.DepositRandomItems(['Law rune', 'Fire rune', 'Air rune', 'Varrock teleport', 'Rune pouch', 'Divine rune pouch', 'Escape crystal']);

    case Bot.TeleportMethod of
    'Varrock tablet':
      Bot.WithdrawHelper('Varrock teleport', -1);

    'Varrock teleport (normal spellbook)':
      case Bot.RPouchMethod of
      'Not using/use runes':
      begin
        Bot.WithdrawHelper('Law rune', -1);
        if not Bot.InfiniteFire then
        Bot.WithdrawHelper('Fire rune', -1);
        if not Bot.InfiniteAir then
          Bot.WithdrawHelper('Air rune', -1);
      end;

      'Rune pouch':
      begin
        Bot.WithdrawHelper('Rune pouch', -1);
      end;

      'Divine rune pouch':
      begin
        Bot.WithdrawHelper('Divine rune pouch', -1);
      end;
      end;
    end;
  end;

  'Ardougne':
  begin
    bankTimeout.Init(45000);

    while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
    begin
      Bank.WalkOpen(Bot.BankObj);
    end;

    WaitUntil(Bank.IsOpen(), 115, 12500);

    Bank.DepositRandomItems(['Law rune', 'Water rune', 'Ardougne teleport', 'Rune pouch', 'Divine rune pouch', 'Escape crystal']);


    case Bot.TeleportMethod of
    'Ardougne tablet':
      Bot.WithdrawHelper('Ardougne teleport', -1);

    'Ardougne teleport (normal spellbook)':
      case Bot.RPouchMethod of
      'Not using/use runes':
      begin
        Bot.WithdrawHelper('Law rune', -1);
        if not Bot.InfiniteWater then
        Bot.WithdrawHelper('Water rune', -1);
      end;

      'Rune pouch':
      begin
        Bot.WithdrawHelper('Rune pouch', -1);
      end;

      'Divine rune pouch':
      begin
        Bot.WithdrawHelper('Divine rune pouch', -1);
      end;
      end;
    end;
  end;

  'Falador':
  begin
    bankTimeout.Init(45000);

    while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
    begin
      Bank.WalkOpen(Bot.BankObj);
    end;

    WaitUntil(Bank.IsOpen(), 115, 12500);

    Bank.DepositRandomItems(['Law rune', 'Water rune', 'Air rune', 'Falador teleport', 'Rune pouch', 'Divine rune pouch', 'Escape crystal']);

    case Bot.TeleportMethod of
    'Falador tablet':
      Bot.WithdrawHelper('Falador teleport', -1);

    'Falador teleport (normal spellbook)':
      case Bot.RPouchMethod of
      'Not using/use runes':
      begin
        Bot.WithdrawHelper('Law rune', -1);
        if not Bot.InfiniteWater then
          Bot.WithdrawHelper('Water rune', -1);
        if not Bot.InfiniteAir then
          Bot.WithdrawHelper('Air rune', -1);
      end;

      'Rune pouch':
      begin
        Bot.WithdrawHelper('Rune pouch', -1);
      end;

      'Divine rune pouch':
      begin
        Bot.WithdrawHelper('Divine rune pouch', -1);
      end;
      end;
    end;
  end;

  'Castle wars':
  begin
    bankTimeout.Init(45000);

    while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
    begin
      Bot.clickBankBooth();
    end;

    WaitUntil(Bank.IsOpen(), 115, 12500);

    Bank.DepositAll();
  end;

  'Ferox':
  begin
    bankTimeout.Init(45000);

    while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
    begin
      Bot.clickBankBooth();
    end;

    WaitUntil(Bank.IsOpen(), 115, 12500);

    Bank.DepositAll();
  end;

  'Catherby':
  begin
    bankTimeout.Init(45000);

    while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
    begin
      Bot.clickBankBooth();
    end;

    WaitUntil(Bank.IsOpen(), 115, 12500);

    Bank.DepositRandomItems(['Rune pouch', 'Divine rune pouch', 'Catherby teleport', 'Camelot teleport', 'Water rune', 'Astral rune', 'Law rune', 'Escape crystal']);

    case Bot.TeleportMethod of
    'Catherby TABLET':
      Bot.WithdrawHelper('Catherby teleport', -1);

    'Camelot TABLET':
      Bot.WithdrawHelper('Camelot teleport', -1);

    'Lunar spellbook TELEPORT':
      case Bot.RPouchMethod of
      'Not using/use runes':
      begin
        Bot.WithdrawHelper('Law rune', -1);
        if not Bot.InfiniteWater then
          Bot.WithdrawHelper('Water rune', -1);
          Bot.WithdrawHelper('Astral rune', -1);
      end;

      'Rune pouch':
      begin
        Bot.WithdrawHelper('Rune pouch', -1);
      end;

      'Divine rune pouch':
      begin
        Bot.WithdrawHelper('Divine rune pouch', -1);
      end;
      end;

    'Normal spellbook TELEPORT':
      case Bot.RPouchMethod of
      'Not using/use runes':
      begin
        Bot.WithdrawHelper('Law rune', -1);
        if not Bot.InfiniteAir then
          Bot.WithdrawHelper('Air rune', -1);
      end;

      'Rune pouch':
      begin
        Bot.WithdrawHelper('Rune pouch', -1);
      end;

      'Divine rune pouch':
      begin
        Bot.WithdrawHelper('Divine rune pouch', -1);
      end;
      end;
    end;
  end;

  'Crafting guild':
  begin
    bankTimeout.Init(45000);

    while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
    begin
      Bot.clickBankBooth();
    end;

    WaitUntil(Bank.IsOpen(), 115, 12500);

    Bank.DepositRandomItems(['Crafting cape', 'Crafting cape(t)','Rune pouch', 'Divine rune pouch', 'Escape crystal']);
  end;

  'Farming guild':
  begin
    while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
    begin
      Bot.clickBankChest();
    end;

    WaitUntil(Bank.IsOpen(), 115, 12500);

    Bank.DepositRandomItems(['Rune pouch', 'Divine rune pouch', 'Farming cape', 'Farming cape(t)', 'Escape crystal']);

    case FarmRunner.FarmGuildTP of
    'Farming cape UNTRIMMED':
    begin
    if not FarmRunner.FarmingCapeEquipped then
      Bot.WithdrawHelper('Farming cape', 1);
    end;

    'Farming cape TRIMMED':
    begin
    if not FarmRunner.FarmingCapeEquipped then
      Bot.WithdrawHelper('Farming cape(t)', 1);
    end;

    'Skills necklace':
    if not Inventory.ContainsAny(['Skills necklace(6)', 'Skills necklace(5)', 'Skills necklace(4)', 'Skills necklace(3)', 'Skills necklace(2)', 'Skills necklace(1)']) then
    begin
        if not Bot.Transport.withdrawTeleportItem(RSTeleports.FARMING_GUILD) then
          TerminateScript('Could not find the skills necklace');
    end;
    end;
  end;
  end;

  Wait(500,750);

  if Bot.ringofdueling then
  begin
    Bot.WithdrawHelper('Ring of dueling(8)', 1);

    if Inventory.ContainsItem('Ring of dueling(8)') then
    begin
     Bot.WriteMsg('Equipping ring');
     Inventory.ClickItem('Ring of dueling(8)', 'Wear');
     WaitUntil(not Inventory.ContainsItem('Ring of dueling(8)'), 115, 5000);
    end;

    Bot.ringofdueling := False;
  end;

  //If we can't get our stuff then bail
  if not Self.WithdrawNextRun() then
  begin
    Bank.Close();
    BirdhouseRunner.IsDisabled := true;
    Exit(false);
  end;

  Bank.Close();
  Result := true;
end;

procedure TBirdHouseInclude.OnComplete(); override;
var
  bankTimeout: TCountdown;
  I: Int32;
begin
  if chat.HasContinue then
    Chat.ClickContinue();

  ScriptWalker := @Bot.RSW;

  Bot.EndOfBHRun();

  Bot.handleWalking('Bank');

  case Bot.Location of
  'Varrock west':
  begin
    bankTimeout.Init(45000);

    while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
    begin
      Bank.WalkOpen(Bot.BankObj);
