    Item: TItem;
    HasSpec: Boolean;
    Low, High: Int32;
  end;

  TBot = record
    State:                                    EBotState;
    Transport:                                TUniversalTransport;
    StartingXp, PlanksMade, CurrentTree,
    ChopsDone, ButlerAttempts,
    PlanksPerInv:                             Int32;
    NeedsAmulet, ButlerTaskSet,
    NeedsRunes, NeedsPouch,
    HasAxeSpecial:                            Boolean;
    Trees:                                    array of TGameObject;
    PendantItem:                              TBankItem;
    Runtime:                                  TStopwatch;
    MaxRuntime, SpecTimer, ReportTimer,
    InactivityTimer, TreeTimer:               TCountdown;
    RSW:                                      TWalker;
    TreeType,
    ChopMethod:                               String;
    BargeGuard: TGameObject;
    Butler: TNPC;
    HouseTabs : Boolean;
    ShutdownTime        : Int64;
    BankItems           : TBankItemArray;
    MyPos               : TPoint;
    PlankLimit          : Int32;
    TakeBreaks,
    TakeSleeps,
    DoFarmRuns,
    DoBHRuns           : Boolean;
  end;


    TIniConfig = record
    frunEnabled,       // farm run
    brunEnabled,       // bh run
    tbreakenabled,      // take breaks
