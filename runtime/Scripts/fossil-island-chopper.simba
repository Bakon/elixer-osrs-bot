procedure TIniConfig.Init();
var
  frun, brun, tbreak, tsleep,
  bhbestlog, bhclockworks : string;
begin
   frun := ReadINI('SXJFIL General', 'Farm runs', AppPath+'Configs/StudentsSettings');
   self.frunEnabled := StrToBoolDef(frun, False);

   brun := ReadINI('SXJFIL General', 'BH runs', AppPath+'Configs/StudentsSettings');
   self.brunEnabled := StrToBoolDef(brun, False);

   tbreak := ReadINI('SXJFIL General', 'Take breaks', AppPath+'Configs/StudentsSettings');
   self.tbreakenabled := StrToBoolDef(tbreak, False);

   tsleep := ReadINI('SXJFIL General', 'Take sleeps', AppPath+'Configs/StudentsSettings');
   self.tsleepenabled := StrToBoolDef(tsleep, False);

   SXJFIL.methodint := StrToIntDef(ReadINI('SXJFIL General', 'Chop method', AppPath+'Configs/StudentsSettings'), 0);
   SXJFIL.ttypeint := StrToIntDef(ReadINI('SXJFIL General', 'Tree type', AppPath+'Configs/StudentsSettings'), 0);
   SXJFIL.planklimitint := StrToIntDef(ReadINI('SXJFIL General', 'Plank limit', AppPath+'Configs/StudentsSettings'), 0);

   SXJFIL.maxrunforint := StrToIntDef(ReadINI('SXJFIL General', 'Max run for', AppPath+'Configs/StudentsSettings'), 600);
   SXJFIL.breakintervalint := StrToIntDef(ReadINI('SXJFIL General', 'Break interval', AppPath+'Configs/StudentsSettings'), 60);
   SXJFIL.breaklengthint := StrToIntDef(ReadINI('SXJFIL General', 'Break length', AppPath+'Configs/StudentsSettings'), 15);
   SXJFIL.sleepintervalstr := ReadINI('SXJFIL General', 'Sleep interval', AppPath+'Configs/StudentsSettings');
   SXJFIL.sleeplengthint := StrToIntDef(ReadINI('SXJFIL General', 'Sleep length', AppPath+'Configs/StudentsSettings'), 8);

   SXJFIL.bhlogint := StrToIntDef(ReadINI('SXJFIL BH Tab', 'BH logs', AppPath+'Configs/StudentsSettings'), 0);
   BHIncludeGUILogType := ELogType(SXJFIL.bhlogint);

   SXJFIL.bhseed := ReadINI('SXJFIL BH Tab', 'BH seed', AppPath+'Configs/StudentsSettings');
   BHIncludeGUISeed := SXJFIL.bhseed;

   SXJFIL.bhrunint := StrToIntDef(ReadINI('SXJFIL BH Tab', 'BH runtime', AppPath+'Configs/StudentsSettings'), 0);
   BHIncludeGUIRunIntervalMinutes := Round(SXJFIL.bhrunint / 60000);

   bhbestlog := ReadINI('SXJFIL BH Tab', 'BH best log', AppPath+'Configs/StudentsSettings');
   self.bhusebestlogEnabled := StrToBoolDef(bhbestlog, False);
   BHIncludeGUIUseBestLog := SXJFIL.bhusebestlogEnabled;

   bhclockworks := ReadINI('SXJFIL BH Tab', 'BH clockworks', AppPath+'Configs/StudentsSettings');
   self.bhcraftclockworksEnabled := StrToBoolDef(bhclockworks, False);
   BHIncludeGUICraftWhileNav := SXJFIL.bhcraftclockworksEnabled;

   SXJFIL.loginindexint := StrToIntDef(ReadINI('SXJFIL Account Tab', 'Login index', AppPath+'Configs/StudentsSettings'), 0);
   Login.PlayerIndex := SXJFIL.loginindexint;
end;

procedure TIniConfig.Write();
begin
  WriteIni('SXJFIL General', 'Farm runs', ToStr(self.frunEnabled), AppPath+'Configs/StudentsSettings');
  WriteIni('SXJFIL General', 'BH runs', ToStr(self.brunEnabled), AppPath+'Configs/StudentsSettings');
  WriteIni('SXJFIL General', 'Max run for', ToStr(self.maxrunforint), AppPath+'Configs/StudentsSettings');
  WriteIni('SXJFIL General', 'Take breaks', ToStr(self.tbreakenabled), AppPath+'Configs/StudentsSettings');
  WriteIni('SXJFIL General', 'Take sleeps', ToStr(self.tsleepenabled), AppPath+'Configs/StudentsSettings');
  WriteIni('SXJFIL General', 'Break interval', ToStr(self.breakintervalint), AppPath+'Configs/StudentsSettings');
  WriteIni('SXJFIL General', 'Break length', ToStr(self.breaklengthint), AppPath+'Configs/StudentsSettings');
  WriteIni('SXJFIL General', 'Sleep interval', Self.sleepintervalstr, AppPath+'Configs/StudentsSettings');
  WriteIni('SXJFIL General', 'Sleep length', ToStr(self.sleeplengthint), AppPath+'Configs/StudentsSettings');
  WriteIni('SXJFIL General', 'Chop method', ToStr(self.methodint), AppPath+'Configs/StudentsSettings');
  WriteIni('SXJFIL General', 'Tree type', ToStr(self.ttypeint), AppPath+'Configs/StudentsSettings');
  WriteIni('SXJFIL General', 'Plank limit', ToStr(self.planklimitint), AppPath+'Configs/StudentsSettings');

  WriteIni('SXJFIL BH Tab', 'BH logs', ToStr(Ord(BirdHouseRunner.LogType)), AppPath+'Configs/StudentsSettings');
  WriteIni('SXJFIL BH Tab', 'BH seed', BirdHouseRunner.Seed, AppPath+'Configs/StudentsSettings');
  WriteIni('SXJFIL BH Tab', 'BH runtime', ToStr(BirdHouseRunner.TaskInterval), AppPath+'Configs/StudentsSettings');
  WriteIni('SXJFIL BH Tab', 'BH best log', ToStr(BirdHouseRunner.AlwaysUseBestLog), AppPath+'Configs/StudentsSettings');
  WriteIni('SXJFIL BH Tab', 'BH clockworks', ToStr(BirdHouseRunner.NeedClockworks), AppPath+'Configs/StudentsSettings');

  WriteIni('SXJFIL Account Tab', 'Login index', ToStr(Login.PlayerIndex), AppPath+'Configs/StudentsSettings');

  // ... any other things you stored on TIniConfig
end;

procedure TScriptForm.StartScript(Sender: TObject); override;
var
  MaxRun, PlankLimit: Int32;
  e_Run, e_BA, e_BF, e_SA, e_SF, p_lim: TEdit;
  cb_Breaks,cb_Sleeps, FarmRuns, BHRuns : TCheckBox;
  Method, TType : TComboBox;

begin
  inherited;

  Self.Form.Close();
  Bot.WriteMsg('Starting script');

{ Time settings }
  e_Run            := Self.Form.GetChild('box_run_edit');
  MaxRun           := StrToInt(e_Run.getText);
  Bot.ShutdownTime := (MaxRun * 60000) + Random(- (MaxRun * 6000), (MaxRun * 6000));

  cb_Breaks        := Self.Form.GetChild('cb_breaks_checkbox');
  Bot.TakeBreaks   := cb_Breaks.IsChecked;

  if Bot.TakeBreaks then
  begin
    e_BA           := Self.Form.GetChild('box_ba_edit');
    e_BF           := Self.Form.GetChild('box_bf_edit');
    Antiban.AddBreak(ONE_MINUTE*StrToInt(e_BA.getText),ONE_MINUTE*StrToInt(e_BF.getText), 0.15, 1.0);
  end;

  cb_Sleeps        := Self.Form.GetChild('cb_sleeps_checkbox');
  Bot.TakeSleeps   := cb_Sleeps.IsChecked;
  if Bot.TakeSleeps then
  begin
    e_SA           := Self.Form.GetChild('box_sa_edit');
    e_SF           := Self.Form.GetChild('box_sf_edit');
    Antiban.AddSleep(e_SA.getText, StrToInt(e_SF.getText) * ONE_HOUR, 0.1, 1.0);
  end;

  p_lim  := Self.Form.GetChild('box_pl_edit');
  PlankLimit := StrToInt(p_lim.getText);
  Bot.PlankLimit := (PlankLimit);

 { Script settings }
  Method := Self.Form.GetChild('lcb_method_combobox');
  TType  := Self.Form.GetChild('lcb_ttype_combobox');

  Bot.ChopMethod := Method.getText;
  Bot.TreeType := TType.getText;

  FarmRuns := Self.Form.GetChild('cb_farmruns_checkbox');
  BHRuns := Self.Form.GetChild('cb_bhruns_checkbox');
  Bot.DoFarmRuns  := (FarmRuns.GetState = cbChecked);
  Bot.DoBHRuns    := (BHRuns.getState = cbChecked);

  SXJFIL.methodint := Method.getItemIndex();
  SXJFIL.ttypeint := TType.getItemIndex();
  SXJFIL.planklimitint := PlankLimit;

  SXJFIL.frunEnabled := Bot.DoFarmRuns;
  SXJFIL.brunEnabled := Bot.DoBHRuns;
  SXJFIL.maxrunforint := MaxRun;

  SXJFIL.tbreakenabled := Bot.TakeBreaks;
  SXJFIL.tsleepenabled := Bot.TakeSleeps;

  if Bot.TakeBreaks then
  begin
    SXJFIL.breakintervalint := StrToInt(e_BA.getText);
    SXJFIL.breaklengthint := StrToInt(e_BF.getText);
  end;

  if Bot.TakeSleeps then
  begin
    SXJFIL.sleepintervalstr := e_SA.getText;
    SXJFIL.sleeplengthint := StrToInt(e_SF.getText);
  end;
end;

function TScriptForm.CreateSettingsTab(): TTabSheet;
type
  TScriptForm = TScriptForm;

procedure TScriptForm.UpdateSList({$H-}sender: TObject);{$H+}
var
   S, Method, TType: TComboBox;
   MethodCap, TTypeCap: TLabel;
begin
  S := Sender;


  Method := Self.Form.GetChild('lcb_method_combobox');
  Bot.ChopMethod := Method.getText;
  MethodCap := Self.Form.GetChild('lcb_method_caption');
  Method.SetFontColor(0);
  MethodCap.SetFontColor(0); // Needed?
  Method.Clear;
  Method.Refresh;

  TType := Self.Form.GetChild('lcb_ttype_combobox');
  Bot.TreeType := TType.getText;
  TTypeCap := Self.Form.GetChild('lcb_ttype_caption');
  TType.SetFontColor(0);
  TTypeCap.SetFontColor(0); // Needed?
  TType.Clear;
  TType.Refresh;
end;

var
  lb_Time,lb_Script: TLabel;
  cb_Breaks,cb_Sleeps, cb_farmruns, cb_bhruns: TLabeledCheckBox;
  box_Run,box_BA,box_BF,
  box_SA,box_SF,Box_PL: TLabeledEdit;
  lcb_method, lcb_ttype: TLabeledComboBox;

begin
  Result.Init(nil);
  Result.SetCaption('Script settings');
  Result.SetName('Settings_Tab');

  { Setup time settings }
  with lb_Time do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(125));
    SetTop(TControl.AdjustToDPI(10));
    SetFontColor($000000);
    GetFont().SetSize(15);
    SetCaption('Time Settings');
  end;

  with box_Run do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(562));
    SetTop(TControl.AdjustToDPI(310));
    SetName('box_Run');
    SetCaption('Run for (mins)');
    SetToolTip('Time in minutes');
    SetText('300');
    SetMaxLength(5);
    SetFontColor($000000);
  end;

  with cb_Breaks do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(5));
    SetTop(TControl.AdjustToDPI(55));
    SetName('cb_breaks');
    SetCaption('Take breaks');
    SetFontColor($000000);
  end;

  with box_BA do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(5));
    SetTop(TControl.AdjustToDPI(75));
    SetName('box_ba');
    SetCaption('Break after');
    SetToolTip('Time in minutes');
    SetText('60');
    SetFontColor($000000);
  end;

  with box_BF do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(5));
    SetTop(TControl.AdjustToDPI(125));
    SetName('box_bf');
    SetCaption('Break for');
    SetToolTip('Time in minutes');
    SetText('15');
    SetFontColor($000000);
  end;

  with cb_Sleeps do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(200));
    SetTop(TControl.AdjustToDPI(55));
    SetName('cb_sleeps');
    SetCaption('Take sleeps');
    SetFontColor($000000);
  end;

  with box_SA do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(200));
    SetTop(TControl.AdjustToDPI(75));
    SetName('box_sa');
    SetCaption('Sleep at');
    SetToolTip('Time in 24Hr format');
    SetText('11:00:00');
    SetFontColor($000000);
  end;

  with box_SF do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(200));
    SetTop(TControl.AdjustToDPI(125));
    SetName('box_sf');
    SetCaption('Sleep for');
    SetToolTip('Time in hours');
    SetText('2');
    SetFontColor($000000);
  end;

  with box_PL do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(562));
    SetTop(TControl.AdjustToDPI(270));
    SetName('box_pl');
    SetCaption('Chop limit');
    SetToolTip('How many logs do you want to stop at');
    SetText('20000');
    SetMaxLength(5);
    SetFontColor($000000);
  end;

  { Setup general settings }
  with lb_Script do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(562));
    SetTop(TControl.AdjustToDPI(10));
    SetFontColor($000000);
    GetFont().SetSize(15);
    SetCaption('General settings');
  end;

  with lcb_ttype do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(562));
    SetTop(TControl.AdjustToDPI(45));
    SetName('lcb_ttype');
    SetCaption('Tree type:');
    AddItemArray(['Teak tree', 'Mahogany tree', 'Camphor tree', 'Ironwood tree', 'Rosewood tree']);  SetFontColor($000000);
    ComboBox.SetFontColor(0);
    SetStyle(csDropDownList);
    ComboBox.setItemIndex(SXJFIL.ttypeint);
  end;

  with lcb_method do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(562));
    SetTop(TControl.AdjustToDPI(90));
    SetName('lcb_method');
    SetCaption('Method:');
    SetFontColor($000000);
    SetStyle(csDropDownList);
    AddItemArray(['Make planks', 'Powerchop', 'Bank']);
    SetItemIndex(0);
    SetHint('What are we doing');
    ComboBox.SetFontColor(0);
    ComboBox.setItemIndex(SXJFIL.methodint);
  end;

  with cb_farmruns do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(562));
    SetTop(TControl.AdjustToDPI(185));
    SetName('cb_farmruns');
    SetFontColor($000000);
    SetCaption('Farm runs');
  end;

  with cb_bhruns do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(562));
    SetTop(TControl.AdjustToDPI(205));
    SetName('cb_bhruns');
    SetFontColor($000000);
    SetCaption('Birdhouse runs');
  end;

  if (SXJFIL.planklimitint <> 0) then
    box_PL.SetText(ToStr(SXJFIL.planklimitint));

  if (SXJFIL.maxrunforint <> 0) then
    box_Run.SetText(ToStr(SXJFIL.maxrunforint));

  if SXJFIL.brunEnabled then
    cb_bhruns.CheckBox.SetChecked(True);

  if SXJFIL.frunEnabled then
    cb_farmruns.CheckBox.SetChecked(True);

  if SXJFIL.tbreakenabled then
  begin
    cb_Breaks.CheckBox.SetChecked(True);
    box_BA.SetText(ToStr(SXJFIL.breakintervalint));
    box_BF.SetText(ToStr(SXJFIL.breaklengthint));
  end;

  if SXJFIL.tsleepenabled then
  begin
    cb_Sleeps.CheckBox.SetChecked(True);
    box_SA.SetText(SXJFIL.sleepintervalstr);
    box_SF.SetText(ToStr(SXJFIL.sleeplengthint));
  end;
end;

procedure TScriptForm.Setup(caption: String = 'Script Form'; size: TPoint = [750, 500]; allowResize: Boolean = False); override;
var
  Img: TPicture;
  BGImg: TImage;
  SButton: TButton;
begin
  inherited;

  Img.init();

  with BGImg do
  begin
    Init(Self.PageControl);
    SetParent(Self.PageControl);
    SetBounds(0,0,Self.Form.getWidth,Self.Form.getHeight);
    SetPicture(Img);
  end;

  Self.Start.setVisible(False);
  with SButton do
  begin
    Create(Self.Form);
    SetBounds(Self.Form.GetRight-190, Self.Form.GetBottom-70, 180, 60);
    GetFont.SetName('Bahnschrift');
    GetFont.SetSize(15);
    SetCaption('Run');
    SetOnClick(@Self.StartScript);
  end;

  Self.AddTab(CreateSettingsTab());
  Self.CreateAccountManager();
  Self.CreateFarmRunSettingsTab;
  Self.CreateBirdhouseRunSettings();
end;

function TOptions.IsHouseOptionsOpen(): Boolean; override; begin
  Result := SRL.CountColor(CTS2(4630611, 23, 0.04, 0.79), Self.Bounds) > 115;
end;

function TOptions.CloseHouseOptions(): Boolean override; begin
  if not Self.IsHouseOptionsOpen then
    Exit(True);

  Mouse.Click([713,216,727,230], MOUSE_LEFT);

  Result := WaitUntil(not Self.IsHouseOptionsOpen, SRL.TruncatedGauss(50, 1500), 3000);
end;

function TChat.GetChat(): String; override;
var
  Option: TChatboxOption;
begin
  for Option in Self.GetOptions([CHAT_COLOR_BLACK, CHAT_COLOR_WHITE, 8388608]) do begin
    if Result <> '' then
      Result += LineEnding;
    Result += Option.Text;
  end;
end;

function TOptions.CallServant(): Boolean; override;
var
  s: String;
  t: TCountdown;
begin
  Result := False;
  t.Init(5000);
  repeat
    Mouse.Click([564,394,716,412], MOUSE_LEFT);
    Wait(180, 333);
    Result := (((s := Chat.GetChatTitle).Contains('Demon')) or (s.Contains('Repeat last task?')));
  until Result or t.IsFinished();
end;

procedure TBot.DebugLn(s: String); begin
  if DEBUG_MODE then WriteLn(s);
end;

function TLogin.LoginPlayer(): Boolean; override;
begin
  inherited;
  if Result then
    Bot.SetState(Bot.GetState());
end;

procedure TBot.Report();
var
  SArr: TStringArray;
  VArr: TVariantArray;
  XPGained: Int32;
begin
  XPGained := XPBar.Read() - Self.StartingXp;
  if Bot.ChopMethod.Contains('Make') then begin
    SArr := ['Runtime', 'Plank type', 'Planks made', 'Planks per hour', 'Xp gained', 'Xp per hour'];
    VArr := [
    {runtime}         SRL.MsToTime(Self.Runtime.ElapsedTime(), Time_Short),
    {plank type}      toStr(Self.TreeType),
    {planks made}     Self.PlanksMade,
    {planks per hour} NumberPerHour(Self.PlanksMade, Self.Runtime.ElapsedTime()),
    {xp gained}       ToStr(XPGained),
    {xp per hour}     NumberPerHour(XPGained, Self.Runtime.ElapsedTime())];
    if not DEBUG_MODE then ClearDebug();
  end;

  if Bot.ChopMethod.Contains('Powerchop') or Bot.ChopMethod.Contains('Bank') then begin
    SArr := ['Runtime', 'Plank type', 'Chops', 'Chops per hour', 'Xp gained', 'Xp per hour'];
    VArr := [
    {runtime}         SRL.MsToTime(Self.Runtime.ElapsedTime(), Time_Short),
    {plank type}      toStr(Self.TreeType),
    {chops}           Self.ChopsDone,
    {chops per hour}  NumberPerHour(Self.ChopsDone, Self.Runtime.ElapsedTime()),
    {xp gained}       ToStr(XPGained),
    {xp per hour}     NumberPerHour(XPGained, Self.Runtime.ElapsedTime())];
    if not DEBUG_MODE then ClearDebug();
  end;

  if Self.TakeBreaks then
  begin
    SArr += 'Until break';
    VArr += SRL.MsToTime(Max(0, Round(Antiban.Breaks[0].NextAtTime - Self.Runtime.ElapsedTime())), TIME_BARE);
  end;

  if Self.TakeSleeps then
  begin
    SArr += 'Until sleep';
    VArr += SRL.MsToTime(Max(0, Round(Antiban.Sleeps[0].NextAtTime - Self.Runtime.ElapsedTime())), TIME_BARE);
  end;

  if Self.DoFarmRuns then
  begin
    SArr += 'Next Farm run';
    VArr += SRL.MsToTime(FarmRunner.ReadyTimer.TimeRemaining, TTimeFormat.Time_Short);
  end;

  if Self.DoBHRuns then
  begin
    SArr += 'Next BH run';
    VArr += SRL.MsToTime(BirdHouseRunner.ScriptIntervalTimer.TimeRemaining, TTimeFormat.Time_Short);
  end;

  SArr += 'Shutdown';
  VArr +=  ToStr(SRL.MsToTime(Self.ShutdownTime - GetTimeRunning, Time_Short));

  ProgReport(1, 'Fossil Island Chopper','Elixer Scripts', 'Rev '+{$MACRO SCRIPT_REVISION}, SArr, VArr);
  Self.ReportTimer.Restart();
end;

procedure TBot.SetState(State: EBotState); begin
  if Self.State <> State then
    Self.DebugLn('State changed to ' + toStr(State));
  Self.State := State;
end;

procedure TBot.WriteMsg(Message: String);
begin
  WriteLn(SRL.TimeStamp() + '[Fossil Island Chopper]: '+ Message);
end;

procedure TBot.Terminate(Reason: String); begin
  Terminate(Reason);
end;

procedure TBot.DoAntiban(); begin
  Self.MaxRuntime.Pause();
  Self.InactivityTimer.Pause();
  Self.Runtime.Pause();
  Antiban.DoAntiban();
  Inventory.Open();
  Self.MaxRuntime.Resume();
  Self.InactivityTimer.Resume();
  Self.Runtime.Resume();
end;

