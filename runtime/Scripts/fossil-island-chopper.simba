    WAIT_CUTTING,
    CLICK_TREE,
    TELEPORT_HOME,
    CALL_BUTLER,
    HANDLE_DIALOGUE,
    TELE_DIGSITE,
    TRAVEL_TO_ISLAND,
    USE_BANK,
    USE_BANK_FROM_BOAT,
    ENTER_CAVE,
    DROP_LOGS,
    GET_STATE
  );

