{$UNDEF SCRIPT_REVISION}{$DEFINE SCRIPT_REVISION := '1'}
{$IFDEF WINDOWS}{$DEFINE SCRIPT_GUI}{$ENDIF}
{$I SRL-T/main.simba}
{$I WaspLib/main.simba}

(*
Elixer Shop Buyer
=================
Generic charter-ship shop buyer. Buys a configured item from Trader Stan's
Trading Post at a chosen charter dock, banks the bought stock, and repeats
until out of coins or the shop runs out of that item.

The trader is 'Trader Stan' at Port Sarim and 'Trader Crewmember' at every
other dock; every dock stocks the same items ('Bucket of sand', 'Soda ash',
'Seaweed' plus general-store goods), so any of them can be bought by name.
*)

type
  EShopLocation = (
    PORT_SARIM, CATHERBY, PORT_KHAZARD, PORT_PHASMATYS, PRIFDDINAS
  );

var
  ShopLocation: EShopLocation := EShopLocation.PORT_SARIM;
  BuyItemNames: String := 'Bucket of sand, Soda ash, Pineapple'; // comma-separated; bought in equal shares
  BuyQuantity: Int32 := 50;
  HopWorlds: String := '';  // comma-separated world numbers to hop between when the shop is empty

type
  EShopBuyerState = (
    OPEN_SHOP,
    BUY_ITEMS,
    HOP_WORLD,

    OPEN_BANK,
    DEPOSIT_ITEMS,

    CLOSE_INTERFACE,
    END_SCRIPT
  );

  TShopBuyer = record(TBaseBankScript)
    State: EShopBuyerState;

    BankObj: TGameObjectV2;

    BuyList: TItemArray;
    BuyOption: String;
    Worlds: TIntegerArray;

    HasBank, OutOfCoins, OutOfStock: Boolean;
  end;

procedure TAntiban.Setup(); override;
begin
  Self.Skills := [ESkill.TOTAL];
  Self.MinZoom := 20;
  Self.MaxZoom := 55;

  inherited;
end;


function TShopBuyer.TryGetObject(names: TStringArray; out obj: TGameObjectV2): Boolean;
var
  n: String;
begin
  for n in names do
    if Length(Objects.GetAll(n)) > 0 then
    begin
      obj := Objects.Get(n);
      Exit(True);
    end;
end;

procedure TShopBuyer.SetupLocation();
begin
  // Chunk indices are the world coordinate div 64 (same system the mining
  // script uses). Each box covers the dock and its banking spot; the trader
  // and bank object are then resolved from the loaded map data by name, with
  // real coordinates - WalkClick walks straight to them, no pixel hunting.
  case ShopLocation of
    EShopLocation.PORT_SARIM:     Map.SetupChunkEx([47, 49, 47, 50], [0]);
    EShopLocation.CATHERBY:       Map.SetupChunkEx([43, 53, 43, 53], [0]);
    EShopLocation.PORT_KHAZARD:   Map.SetupChunkEx([41, 49, 41, 49], [0]);
    EShopLocation.PORT_PHASMATYS: Map.SetupChunkEx([57, 54, 57, 54], [0]);
    EShopLocation.PRIFDDINAS:     Map.SetupChunkEx([33, 51, 33, 52], [0]);
  end;

  Objects.Setup(Map.Objects(), @Map.Walker);
  NPCs.Setup(Map.NPCs(), @Map.Walker);

  // The charter trader isn't in the static NPC data, so it's found live by its
  // minimap dot in OpenShop. Only the bank object comes from the map data.
  Self.HasBank := Self.TryGetObject(
    ['Bank chest', 'Bank booth', 'Bank deposit box', 'Bank Deposit Box'], Self.BankObj);
  if not Self.HasBank then
    TerminateScript('No bank chest / booth / deposit box in the map data for this dock.');
end;

procedure TShopBuyer.Init(maxActions: UInt32; maxTime: UInt64); override;
var
  s: String;
begin
  inherited;

  Self.BuyList := [];
  for s in BuyItemNames.Split(',') do
    if s.Trim() <> '' then
      Self.BuyList += s.Trim();
  if Self.BuyList = [] then
    Self.BuyList += 'Bucket of sand';

  Self.Worlds := [];
  for s in HopWorlds.Split(',') do
    if s.Trim() <> '' then
      Self.Worlds += StrToIntDef(s.Trim(), 0);

  case BuyQuantity of
    1:  Self.BuyOption := 'Buy 1';
    5:  Self.BuyOption := 'Buy 5';
    10: Self.BuyOption := 'Buy 10';
    else Self.BuyOption := 'Buy 50';
  end;

  Self.SetupLocation();

  if Antiban.BioDice() then
    Options.SetNPCAttackOption(EAttackOption.HIDDEN)
  else
    Options.SetNPCAttackOption(EAttackOption.ALWAYS_RIGHT_CLICK);
end;


function TShopBuyer.OpenShop(): Boolean;
var
  dots: TPointArray;
  dot: TPoint;
  rect: TRectangle;
  attempts: Int32;
begin
  dots := Minimap.GetDots(EMinimapDot.NPC).Sorted(Minimap.Center);
  if dots = [] then
    Exit;

  // Hover the on-screen NPC dots; the crewmember's default click is Talk-to,
  // so right-click and pick Trade once the uptext confirms who it is.
  for dot in dots do
  begin
    rect := Minimap.PointToMSRect(dot);
    if not MainScreen.Bounds.Contains(rect.Bounds()) then
      Continue;

    Inc(attempts);
    if attempts > 6 then
      Break;

    Mouse.Move(rect);
    if MainScreen.IsUpText(['Trader', 'Crewmember']) then
    begin
      Mouse.Click(MOUSE_RIGHT);
      if ChooseOption.Select(['Trade']) then
      begin
        Minimap.WaitMoving();
        Exit(Store.IsOpen(5000));
      end;
    end;
  end;

  // Not in reach from here: step toward the nearest NPC dot and retry.
  Mouse.Move(dots[0]);
  Mouse.Click(MOUSE_LEFT);
  Minimap.WaitMoving();
end;

function TShopBuyer.BuyItems(): Boolean;
var
  item: TItem;
  target, want, coinsBefore, itemBefore, bought, tries: Int32;
  opt: String;
begin
  // Split the inventory evenly across the configured items so a glassmaking
  // combo (sand + ash) comes back balanced.
  target := 28 div Length(Self.BuyList);
  if target < 1 then target := 1;

  for item in Self.BuyList do
  begin
    tries := 0;
    while Store.IsOpen() and not Inventory.IsFull()
          and (Inventory.CountItem(item) < target) do
    begin
      if Store.CountItemStack(item) <= 0 then
        Break; // this item is out of stock; try the next one

      want := Min(target - Inventory.CountItem(item), 28 - Inventory.Count());
      if want >= 50 then opt := 'Buy 50'
      else if want >= 10 then opt := 'Buy 10'
      else if want >= 5 then opt := 'Buy 5'
      else opt := 'Buy 1';

      coinsBefore := Inventory.CountItemStack('Coins');
      itemBefore  := Inventory.CountItem(item);

      if not Store.ClickItem(item, opt) then
      begin
        Inc(tries);
        if tries >= 3 then Break;
        Wait(300, 600);
        Continue;
      end;

      if WaitUntil((Inventory.CountItem(item) > itemBefore) or
                   (Inventory.CountItemStack('Coins') < coinsBefore), 100, 2500) then
      begin
        tries := 0;
        bought := Inventory.CountItem(item) - itemBefore;
        if bought > 0 then
        begin
          Self.TotalActions += bought;
          Result := True;
        end;
        WL.Activity.Restart();
      end
      else
      begin
        // A click that changed nothing: out of stock for this item, or broke.
        if Store.CountItemStack(item) > 0 then
          Self.OutOfCoins := True;
        Break;
      end;
    end;

    if Self.OutOfCoins then
      Break;
  end;

  // A whole pass that bought nothing (and didn't fill the inventory) means the
  // shop is empty -> hop to a fresh-stocked world instead of ending.
  if not Result and not Inventory.IsFull() and not Self.OutOfCoins then
    Self.OutOfStock := True;
end;

function TShopBuyer.HopWorld(): Boolean;
begin
  Store.Close();
  Self.OutOfStock := False;
  if Self.Worlds = [] then
  begin
    Self.DebugLn('Shop empty but no hop worlds configured - stopping.');
    Exit;
  end;
  Result := WorldHopper.Hop(Self.Worlds);
  Wait(1200, 2000);
end;

function TShopBuyer.OpenBank(): Boolean;
begin
  // Walk to the known object coordinate and click it - opens a bank chest,
  // booth or deposit box, whichever this dock has.
  if Self.BankObj.WalkClick() then
  begin
    Minimap.WaitMoving();
    Result := WaitUntil(Bank.IsOpen() or DepositBox.IsOpen(), 300, 12000);
  end;
end;

function TShopBuyer.Deposit(): Boolean;
begin
  if DepositBox.IsOpen() then
    Result := DepositBox.DepositItemArray(Self.BuyList, True)
  else
    Result := Bank.DepositItems(Self.BuyList, True);

  if Result then
  begin
    WaitUntil(not Inventory.ContainsAny(Self.BuyList), 300, 3000);
    WL.Activity.Restart();
  end;
end;


function TShopBuyer.GetState(): EShopBuyerState;
begin
  if WL.Activity.IsFinished() then
    Exit(EShopBuyerState.END_SCRIPT);

  // Shop empty: hop to a fresh-stocked world (keeping what we hold) instead
  // of stopping, as long as hop worlds are configured.
  if Self.OutOfStock and (Self.Worlds <> []) then
  begin
    if GameInterface.IsOpen() and not Store.IsOpen() then
      Exit(EShopBuyerState.CLOSE_INTERFACE);
    Exit(EShopBuyerState.HOP_WORLD);
  end;

  // Out of coins (or empty shop with no hop worlds): bank what we hold, stop.
  if Self.OutOfCoins or Self.OutOfStock then
  begin
    if Inventory.ContainsAny(Self.BuyList) then
    begin
      if Bank.IsOpen() or DepositBox.IsOpen() then
        Exit(EShopBuyerState.DEPOSIT_ITEMS);
      if GameInterface.IsOpen() then
        Exit(EShopBuyerState.CLOSE_INTERFACE);
      Exit(EShopBuyerState.OPEN_BANK);
    end;
    Exit(EShopBuyerState.END_SCRIPT);
  end;

  if Store.IsOpen() then
  begin
    if Inventory.IsFull() then
      Exit(EShopBuyerState.CLOSE_INTERFACE);
    Exit(EShopBuyerState.BUY_ITEMS);
  end;

  if Bank.IsOpen() or DepositBox.IsOpen() then
  begin
    if Inventory.ContainsAny(Self.BuyList) then
      Exit(EShopBuyerState.DEPOSIT_ITEMS);
    Exit(EShopBuyerState.CLOSE_INTERFACE);
  end;

  if GameInterface.IsOpen() then
    Exit(EShopBuyerState.CLOSE_INTERFACE);

  if Inventory.IsFull() then
    Exit(EShopBuyerState.OPEN_BANK);

  Exit(EShopBuyerState.OPEN_SHOP);
end;

procedure TShopBuyer.Run(maxActions: UInt32; maxTime: UInt64);
begin
  Self.Init(maxActions, maxTime);

  repeat
    Self.State := Self.GetState();
    Self.SetAction(ToStr(Self.State));

    case Self.State of
      EShopBuyerState.OPEN_SHOP:       Self.OpenShop();
      EShopBuyerState.BUY_ITEMS:       Self.BuyItems();
      EShopBuyerState.HOP_WORLD:       Self.HopWorld();
      EShopBuyerState.OPEN_BANK:       Self.OpenBank();
      EShopBuyerState.DEPOSIT_ITEMS:   Self.Deposit();
      EShopBuyerState.CLOSE_INTERFACE: GameInterface.Close();
      EShopBuyerState.END_SCRIPT:      Break;
    end;

    Self.DoAntiban();
  until Self.ShouldStop();

  if Self.OutOfCoins then
    WriteLn('Elixer Shop Buyer: out of coins, stopping.')
  else if Self.OutOfStock then
    WriteLn('Elixer Shop Buyer: shop out of stock, stopping.');
end;

var
  ShopBuyer: TShopBuyer;

{$IFDEF SCRIPT_GUI}
type
  TShopBuyerForm = record(TScriptForm)
    LocationSelector: TLabeledCombobox;
    ItemSelector: TLabeledCombobox;
    CustomItemName: TLabeledEdit;
    QuantitySelector: TLabeledCombobox;
    WorldsEdit: TLabeledEdit;
    Config: TConfigJSON;
  end;

procedure TShopBuyerForm.StartScript(sender: TObject); override;
begin
  ShopLocation := EShopLocation(Self.LocationSelector.GetItemIndex());

  case Self.ItemSelector.GetText() of
    'Glass (sand + ash + pineapple)': BuyItemNames := 'Bucket of sand, Soda ash, Pineapple';
    'Custom':                         BuyItemNames := Self.CustomItemName.GetText();
    else                              BuyItemNames := Self.ItemSelector.GetText();
  end;

  HopWorlds := Self.WorldsEdit.GetText();
  BuyQuantity := StrToIntDef(Self.QuantitySelector.GetText(), 50);

  Self.Config.Put('location', Self.LocationSelector.GetItemIndex());
  Self.Config.Put('item_selector', Self.ItemSelector.GetItemIndex());
  Self.Config.Put('custom', Self.CustomItemName.GetText());
  Self.Config.Put('worlds', HopWorlds);
  Self.Config.Put('quantity', Self.QuantitySelector.GetItemIndex());

  inherited;
end;

procedure TShopBuyerForm.ItemSelectorOnChange(sender: TObject);
begin
  Self.CustomItemName.SetVisible(TComboBox(sender).GetText() = 'Custom');
end;

procedure TShopBuyerForm.Run(); override;
var
  tab: TTabSheet;
begin
  Self.Setup('Elixer Shop Buyer');
  Self.Config.Setup('elixer-shop-buyer');
  Self.Start.setOnClick(@Self.StartScript);

  Self.AddTab('Script Settings');
  tab := Self.Tabs[High(Self.Tabs)];

  Self.CreateAccountManager(tab);

  with Self.LocationSelector do
  begin
    Create(tab);
    SetCaption('Charter dock:');
    SetLeft(TControl.AdjustToDPI(15));
    SetTop(TControl.AdjustToDPI(150));
    SetWidth(TControl.AdjustToDPI(200));
    SetStyle(csDropDownList);
    AddItemArray(['Port Sarim', 'Catherby', 'Port Khazard',
                  'Port Phasmatys', 'Prifddinas']);
    if Self.Config.Has('location') then
      SetItemIndex(Self.Config.GetInt('location'))
    else
      SetItemIndex(Ord(ShopLocation));
  end;

  with Self.ItemSelector do
  begin
    Create(tab);
    SetCaption('Item to buy:');
    SetLeft(Self.LocationSelector.GetLeft());
    SetTop(Self.LocationSelector.GetBottom() + TControl.AdjustToDPI(15));
    SetWidth(TControl.AdjustToDPI(200));
    SetStyle(csDropDownList);
    AddItemArray(['Glass (sand + ash + pineapple)', 'Bucket of sand', 'Soda ash', 'Seaweed', 'Custom']);
    Combobox.setOnChange(@Self.ItemSelectorOnChange);
    if Self.Config.Has('item_selector') then
      SetItemIndex(Self.Config.GetInt('item_selector'))
    else
      SetItemIndex(0);
  end;

  with Self.CustomItemName do
  begin
    Create(tab);
    SetCaption('Custom items (comma-separated exact names):');
    SetLeft(Self.ItemSelector.GetRight() + TControl.AdjustToDPI(20));
    SetTop(Self.ItemSelector.GetTop());
    SetWidth(TControl.AdjustToDPI(240));
    if Self.Config.Has('custom') then
      SetText(Self.Config.GetString('custom'))
    else
      SetText('Bucket of sand, Soda ash');
    SetVisible(Self.ItemSelector.GetText() = 'Custom');
  end;

  with Self.QuantitySelector do
  begin
    Create(tab);
    SetCaption('Buy quantity per click:');
    SetLeft(Self.ItemSelector.GetLeft());
    SetTop(Self.ItemSelector.GetBottom() + TControl.AdjustToDPI(15));
    SetWidth(TControl.AdjustToDPI(200));
    SetStyle(csDropDownList);
    AddItemArray(['1', '5', '10', '50']);
    if Self.Config.Has('quantity') then
      SetItemIndex(Self.Config.GetInt('quantity'))
    else
      SetItemIndex(3);
  end;

  with Self.WorldsEdit do
  begin
    Create(tab);
    SetCaption('Hop worlds when shop empties (comma-separated, blank = stop):');
    SetLeft(Self.QuantitySelector.GetLeft());
    SetTop(Self.QuantitySelector.GetBottom() + TControl.AdjustToDPI(15));
    SetWidth(TControl.AdjustToDPI(300));
    if Self.Config.Has('worlds') then
      SetText(Self.Config.GetString('worlds'))
    else
      SetText('');
  end;

  Self.CreateAntibanManager();
  Self.CreateWaspLibSettings();

  inherited;
end;

var
  ShopBuyerForm: TShopBuyerForm;
{$ENDIF}

begin
  {$IFDEF SCRIPT_GUI}
  Sync(@ShopBuyerForm.Run);
  {$ENDIF}

  {$IFNDEF SRL_DISABLE_REMOTEINPUT}
  if not GameClient.RemoteInput.IsSetup() then
    GameClient.RemoteInput.Setup();
  {$ENDIF}

  ShopBuyer.Run(WLSettings.MaxActions(), WLSettings.MaxTime());
end.
