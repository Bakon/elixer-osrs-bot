procedure TScript.WriteMsg(Message: String);
begin
  WriteLn(SRL.TimeStamp() + '[Collector]: '+ Message);
end;

procedure TIniConfig.Init();
var
  frun, brun, hcmode, tbreak, tsleep,
  bhbestlog, bhclockworks : string;
begin
   frun := ReadINI('Collector General', 'Farm runs', AppPath+'Configs/StudentsSettings');
   self.frunEnabled := StrToBoolDef(frun, False);

   brun := ReadINI('Collector General', 'BH runs', AppPath+'Configs/StudentsSettings');
   self.brunEnabled := StrToBoolDef(brun, False);

   hcmode := ReadINI('Collector General', 'HC mode', AppPath+'Configs/StudentsSettings');
   self.hcEnabled := StrToBoolDef(hcmode, False);

   tbreak := ReadINI('Collector General', 'Take breaks', AppPath+'Configs/StudentsSettings');
   self.tbreakenabled := StrToBoolDef(tbreak, False);

   tsleep := ReadINI('Collector General', 'Take sleeps', AppPath+'Configs/StudentsSettings');
   self.tsleepenabled := StrToBoolDef(tsleep, False);

   SCConfig.runepouchint := StrToIntDef(ReadINI('Collector General', 'RPouch', AppPath+'Configs/StudentsSettings'), 0);
   SCConfig.collectforint := StrToIntDef(ReadINI('Collector General', 'Collect for', AppPath+'Configs/StudentsSettings'), 0);
   SCConfig.methodint := StrToIntDef(ReadINI('Collector General', 'Method', AppPath+'Configs/StudentsSettings'), 0);
   SCConfig.bloomtoolint := StrToIntDef(ReadINI('Collector General', 'Bloom tool', AppPath+'Configs/StudentsSettings'), 0);
   SCConfig.breakintervalint := StrToIntDef(ReadINI('Collector General', 'Break interval', AppPath+'Configs/StudentsSettings'), 60);
   SCConfig.maxrunforint := StrToIntDef(ReadINI('Collector General', 'Max run for', AppPath+'Configs/StudentsSettings'), 600);
   SCConfig.collectcountint := StrToIntDef(ReadINI('Collector General', 'Collect how many', AppPath+'Configs/StudentsSettings'), 2000);

   SCConfig.breaklengthint := StrToIntDef(ReadINI('Collector General', 'Break length', AppPath+'Configs/StudentsSettings'), 15);
   SCConfig.sleepintervalstr := ReadINI('Collector General', 'Sleep interval', AppPath+'Configs/StudentsSettings');
   SCConfig.sleeplengthint := StrToIntDef(ReadINI('Collector General', 'Sleep length', AppPath+'Configs/StudentsSettings'), 8);

   SCConfig.bhlogint := StrToIntDef(ReadINI('Collector BH Tab', 'BH logs', AppPath+'Configs/StudentsSettings'), 0);
   BHIncludeGUILogType := ELogType(SCConfig.bhlogint);

   SCConfig.bhseed := ReadINI('Collector BH Tab', 'BH seed', AppPath+'Configs/StudentsSettings');
   BHIncludeGUISeed := SCConfig.bhseed;

   SCConfig.bhrunint := StrToIntDef(ReadINI('Collector BH Tab', 'BH runtime', AppPath+'Configs/StudentsSettings'), 0);
   BHIncludeGUIRunIntervalMinutes := Round(SCConfig.bhrunint / 60000);

   bhbestlog := ReadINI('Collector BH Tab', 'BH best log', AppPath+'Configs/StudentsSettings');
   self.bhusebestlogEnabled := StrToBoolDef(bhbestlog, False);
   BHIncludeGUIUseBestLog := SCConfig.bhusebestlogEnabled;

   bhclockworks := ReadINI('Collector BH Tab', 'BH clockworks', AppPath+'Configs/StudentsSettings');
   self.bhcraftclockworksEnabled := StrToBoolDef(bhclockworks, False);
   BHIncludeGUICraftWhileNav := SCConfig.bhcraftclockworksEnabled;

   SCConfig.loginindexint := StrToIntDef(ReadINI('Collector Account Tab', 'Login index', AppPath+'Configs/StudentsSettings'), 0);
   Login.PlayerIndex := SCConfig.loginindexint;
end;

procedure TIniConfig.Write();
begin
  WriteIni('Collector General', 'Farm runs', ToStr(self.frunEnabled), AppPath+'Configs/StudentsSettings');
  WriteIni('Collector General', 'BH runs', ToStr(self.brunEnabled), AppPath+'Configs/StudentsSettings');
  WriteIni('Collector General', 'HC mode', ToStr(self.hcEnabled), AppPath+'Configs/StudentsSettings');
  WriteIni('Collector General', 'Take breaks', ToStr(self.tbreakenabled), AppPath+'Configs/StudentsSettings');
  WriteIni('Collector General', 'Take sleeps', ToStr(self.tsleepenabled), AppPath+'Configs/StudentsSettings');
  WriteIni('Collector General', 'Break interval', ToStr(self.breakintervalint), AppPath+'Configs/StudentsSettings');
  WriteIni('Collector General', 'Break length', ToStr(self.breaklengthint), AppPath+'Configs/StudentsSettings');
  WriteIni('Collector General', 'Sleep interval', Self.sleepintervalstr, AppPath+'Configs/StudentsSettings');
  WriteIni('Collector General', 'Sleep length', ToStr(self.sleeplengthint), AppPath+'Configs/StudentsSettings');
  WriteIni('Collector General', 'Collect for', ToStr(Self.collectforint), AppPath+'Configs/StudentsSettings');
  WriteIni('Collector General', 'Method', ToStr(self.methodint), AppPath+'Configs/StudentsSettings');
  WriteIni('Collector General', 'Bloom tool', ToStr(self.bloomtoolint), AppPath+'Configs/StudentsSettings');
  WriteIni('Collector General', 'Max run for', ToStr(self.maxrunforint), AppPath+'Configs/StudentsSettings');
  WriteIni('Collector General', 'Collect how many', ToStr(self.collectcountint), AppPath+'Configs/StudentsSettings');
  WriteIni('Collector General', 'RPouch', ToStr(self.runepouchint), AppPath+'Configs/StudentsSettings');

  WriteIni('Collector BH Tab', 'BH logs', ToStr(Ord(BirdHouseRunner.LogType)), AppPath+'Configs/StudentsSettings');
  WriteIni('Collector BH Tab', 'BH seed', BirdHouseRunner.Seed, AppPath+'Configs/StudentsSettings');
  WriteIni('Collector BH Tab', 'BH runtime', ToStr(BirdHouseRunner.TaskInterval), AppPath+'Configs/StudentsSettings');
  WriteIni('Collector BH Tab', 'BH best log', ToStr(BirdHouseRunner.AlwaysUseBestLog), AppPath+'Configs/StudentsSettings');
  WriteIni('Collector BH Tab', 'BH clockworks', ToStr(BirdHouseRunner.NeedClockworks), AppPath+'Configs/StudentsSettings');

  WriteIni('Collector Account Tab', 'Login index', ToStr(Login.PlayerIndex), AppPath+'Configs/StudentsSettings');

  // ... any other things you stored on TIniConfig
end;

procedure TScriptForm.StartScript(Sender: TObject); override;
var
  MaxRun, ColLimit: Int32;
  e_Run,e_BA,e_BF,e_SA,e_SF, c_lim: TEdit;
  cb_Breaks,cb_Sleeps, Hardcore, FarmRuns, BHRuns: TCheckBox;
  Method, Bloom, Col, RPouch: TComboBox;

begin
  inherited;

  Self.Form.Close();
  Bot.WriteMsg('Starting script');

  c_Lim  := Self.Form.GetChild('box_cl_edit');
  ColLimit := StrToInt(C_lim.getText);
  Bot.Collectlimit := (ColLimit);

  { Time settings }
  e_Run            := Self.Form.GetChild('box_run_edit');
  MaxRun           := StrToInt(e_Run.getText);
  Bot.ShutdownTime := (MaxRun * 60000) + Random(- (MaxRun * 6000), (MaxRun * 6000));

  cb_Breaks        := Self.Form.GetChild('cb_breaks_checkbox');
  Bot.TakeBreaks   := cb_Breaks.IsChecked;
  if Bot.TakeBreaks then
  begin
    e_BA           := Self.Form.GetChild('box_ba_edit');
    e_BF           := Self.Form.GetChild('box_bf_edit');
    Antiban.AddBreak(ONE_MINUTE*StrToInt(e_BA.getText),ONE_MINUTE*StrToInt(e_BF.getText), 0.15, 1.0);
  end;

  cb_Sleeps        := Self.Form.GetChild('cb_sleeps_checkbox');
  Bot.TakeSleeps   := cb_Sleeps.IsChecked;
  if Bot.TakeSleeps then
  begin
    e_SA           := Self.Form.GetChild('box_sa_edit');
    e_SF           := Self.Form.GetChild('box_sf_edit');
    Antiban.AddSleep(e_SA.getText, StrToInt(e_SF.getText) * ONE_HOUR, 0.1, 1.0);
  end;

  { Script settings }
  Method  := Self.Form.GetChild('lcb_method_combobox');
  Bloom  := Self.Form.GetChild('lcb_bloom_combobox');
  Col  := Self.Form.GetChild('lcb_col_combobox');
  RPouch := Self.Form.GetChild('lcb_rpouch_combobox');

  Hardcore := Self.Form.GetChild('cb_hardcore_checkbox');
  FarmRuns := Self.Form.GetChild('cb_farmruns_checkbox');
  BHRuns := Self.Form.GetChild('cb_bhruns_checkbox');

  Bot.MethodItem  := Method.GetText;
  Bot.Bloomer     := Bloom.GetText;
  Bot.CollectItem := Col.GetText;
  Bot.RPouchMethod := RPouch.getText;

  Bot.isSafe      := (Hardcore.GetState = cbChecked);
  Bot.DoFarmRuns  := (FarmRuns.GetState = cbChecked);
  Bot.DoBHRuns    := (BHRuns.getState = cbChecked);

  SCConfig.collectforint := Col.getItemIndex();
  SCConfig.methodint := Method.getItemIndex();
  SCConfig.bloomtoolint := Bloom.getItemIndex();

  SCConfig.maxrunforint := MaxRun;
  SCConfig.collectcountint := ColLimit;

  SCConfig.tbreakenabled := Bot.TakeBreaks;
  SCConfig.tsleepenabled := Bot.TakeSleeps;

  if Bot.TakeBreaks then
  begin
    SCConfig.breakintervalint := StrToInt(e_BA.getText);
    SCConfig.breaklengthint := StrToInt(e_BF.getText);
  end;

  if Bot.TakeSleeps then
  begin
    SCConfig.sleepintervalstr := e_SA.getText;
    SCConfig.sleeplengthint := StrToInt(e_SF.getText);
  end;

  SCConfig.hcEnabled := Bot.isSafe;
  SCConfig.frunEnabled := Bot.DoFarmRuns;
  SCConfig.brunEnabled := Bot.DoBHRuns;

  SCConfig.runepouchint := RPouch.getItemIndex();
end;

function TScriptForm.CreateSettingsTab(): TTabSheet;
type
  TScriptForm = TScriptForm;

procedure TScriptForm.UpdateSList({$H-}sender: TObject);{$H+}
var
  S, Method, Bloom, Col: TComboBox;
  BloomCap, Hardcore: TLabel;
begin
  S := Sender;
  Method := Self.Form.GetChild('lcb_method_combobox');
  Bloom := Self.Form.GetChild('lcb_bloom_combobox');
  BloomCap := Self.Form.GetChild('lcb_bloom_caption');
  Col := Self.Form.GetChild('lcb_col_combobox');
  Hardcore := Self.Form.GetChild('cb_hardcore_panel');

  Method.SetFontColor(0);
  Bloom.SetFontColor(0);
  BloomCap.SetFontColor(0); // Needed?
  Col.SetFontColor(0);

  Method.Clear;
  Bloom.Clear;
  Method.Refresh;
  Bloom.Refresh;
  BloomCap.Refresh;

  case Col.getItemIndex of
  0:
  begin
    BloomCap.SetVisible(True);
    Bloom.SetVisible(True);
  end
  else
  begin
    Bloom.SetVisible(False);
    BloomCap.SetVisible(False);
  end;
  end;

  if Col.getItemIndex = 0 then // Mort myre fungus
  begin
    Method.AddItem('Drakans medallion', S);
    Method.AddItem('Fairy rings', S);
    Bloom.Additem('Silver sickle (b)', S);
    Bloom.Additem('Ivandis flail', S);
    Bloom.Additem('Blisterwood flail', S);
  end;

  if Col.getItemIndex = 1 then // Red spider egg
  begin
    Method.AddItem('Tower of Life', S);
  end;

  if Col.getItemIndex = 2 then // Zamorak wine
  begin
    Method.AddItem('Asgarnian Chaos Temple', S);
  end;

  if Col.getItemIndex = 3 then // Snape grass
  begin
    Method.AddItem('Peer the Seer', S);
    Method.AddItem('Lunar spells', S);
    Method.AddItem('Waterbirth Tablet', S);
    Method.AddItem('Hosidius', S);
  end;

  if Col.getItemIndex = 4 then // Blue dragon scale
  begin
    Method.AddItem('Myths guild', S);
    Method.AddItem('Taverly dungeon (Spellbook)', S);
    Method.AddItem('Taverly dungeon (Fally tablet)', S);
  end;

  if Col.getItemIndex = 5 then // Superantipoison(1)
  begin
    Method.AddItem('Castle wars', S);
  end;

  if Col.getItemIndex = 6 then // Logs
  begin
    Method.AddItem('Lumbridge castle roof', S);
  end;

  if Col.getItemIndex = 7 then // Planks
  begin
    Method.AddItem('Barbarian assault area', S);
  end;

  if Col.getItemIndex = 8 then // Seaweed spores
  begin
    Method.AddItem('Fossil island underwater', S);
  end;

  Method.setItemIndex(0);
  Bloom.setItemIndex(0);
end;

var
  lb_Time, lb_Script: TLabel;
  cb_Breaks, cb_Sleeps, cb_hardcore, cb_farmruns, cb_bhruns: TLabeledCheckBox;
  box_Run, box_BA, box_BF,
  box_SA, box_SF, box_CL: TLabeledEdit;
  lcb_Method, lcb_Col, lcb_bloom, lcb_rpouch: TLabeledComboBox;
begin
  Result.Init(nil);
  Result.SetCaption('Script settings');
  Result.SetName('Settings_Tab');

  { Setup time settings }
  with lb_Time do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(125));
    SetTop(TControl.AdjustToDPI(10));
    SetFontColor($000000);
    GetFont().SetSize(15);
    SetCaption('Time Settings');
  end;

