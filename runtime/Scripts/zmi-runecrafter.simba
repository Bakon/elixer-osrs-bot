function TMM2MSProjector.Run(Coords: Vector3Array; Rotation: Vector3): TPointArray; override;
var
  I: Int32;
begin
  if not Self.Calculated then
  begin
    Self.Zoom := TMM2MSProjector.TransformZoom(Self.ZoomLevel);
    Self.ScaleMin := Self.SCALE_MIN * MainScreen.Height / 503; // fixed client height
    Self.ScaleMax := Self.SCALE_MAX * MainScreen.Height / 503; // fixed client height
    if GameClient.Mode = EClientMode.FIXED then
      Self.ViewMatrix := TMatrix4.LookAtRH([0, EYE_Y_FIXED[Self.ZoomLevel], EYE_Z_FIXED[Self.ZoomLevel]], [0, 0, 1.0], Vector3_UnitY)
    else
      Self.ViewMatrix := TMatrix4.LookAtRH([0, EYE_Y_RESIZABLE[Self.ZoomLevel], EYE_Z_RESIZABLE[Self.ZoomLevel]], [0, 0, 1.0], Vector3_UnitY);
    Self.ProjMatrix := TMatrix4.PerspectiveFovRH(Sqrt(2), 765 / 503 *1.03, 0.01, 1.0);           // fixed client width & height

    Self.WorldMatrix := TMatrix4.RotationYawPitchRoll(Rotation.Y, Rotation.X, Rotation.Z) * Matrix_Identity;
    Self.TransMatrix := Self.WorldMatrix * Self.ViewMatrix * Self.ProjMatrix;

    Self.Calculated := True;
  end;

  SetLength(Result, Length(Coords));

  for I := 0 to High(Coords) do
    with Self.Transform(Coords[I], Self.TransMatrix) do
    begin
      Result[I].X := Round(X);
      Result[I].Y := Round(Y);
    end;
end;

var
  ZMIBot : TZMIBot;

procedure TAntiban.SmallRandomMouse(); override;
var
  b: TBox;
  P: TPoint;
  t: TCountDown;
begin
  Self.DebugLn('Random Mouse (Small)');

  b := Box(Mouse.Position(), 350, 350);
  t.Init(30000);
  repeat
    P := SRL.RandomPoint(b);
    if t.IsFinished() then
    begin
      WriteLn('Box: ', b);
      WriteLn('Point: ', P);
      Self.Fatal('Timed out!');
    end;
  until P.DistanceTo(b.Center()) < 50; // Make sure we move at least 50 distance
  Mouse.Move(P);
end;

operator in(Left: TBox; Right: TBoxArray): Boolean;
var
  I : Int32;
begin
  for I := 0 to High(Right) do
    if Left = Right[I] then
      Exit(True);
end;

operator in(Left: EZMIState; Right: array of EZMIState): Boolean;
var
  I : Int32;
begin
  for I := 0 to High(Right) do
    if Left = Right[I] then
      Exit(True);
end;

function TMagic.MouseSpell(spell: ESpell): Boolean; override;
var
  b: TBox;
  upText: String;
begin
  if (Self.SpellCache[spell].UpText <> '') and
     Self.SpellCache[spell].Box.Contains(Mouse.Position()) then
  begin
    upText := MainScreen.GetUpText().After('Cast').Before('/').Strip();
    if (upText = Self.SpellCache[spell].UpText) then
      Exit(True);
  end;

  Result := Self.Open() and Self.FindSpell(spell, b);

  if Result then
  begin
    Mouse.Move(b, True);

    if Self.SpellCache[spell].UpText = '' then
    begin
      upText := MainScreen.GetUpText().After('Cast').Before('/').Strip();
      Self.SpellCache[spell].UpText := upText;
    end;
  end;
end;

procedure TChooseOption.Select(option: TChooseOption_Option; mouseAction: Int32 = MOUSE_LEFT); override;
var
  from: TPoint;
  b: TBox;
  tmpMouse: TMouse;
begin
  b := option.Bounds;
  b := b.Expand(-1);

  from.X := b.X1;
  from.Y := b.Y1 + (b.Height() div 3);

  tmpMouse := Mouse;
  tmpMouse.MissChance := 0;
  tmpMouse.IdleInterval := 0;
  Dec(tmpMouse.Speed, Random(4, 7));
  tmpMouse.Move(SRL.RandomPointEx(from, b));

  if (mouseAction <> MOUSE_MOVE) then
    tmpMouse.Click(mouseAction);

  Wait(33, 180, wdMean);
end;

//Changes to PathRandomness in the TWalker.WebWalk call
function TGameObject.WalkHover(attempts: Int32 = 2; trackTarget: Boolean = TRACK_TARGET): Boolean; override;
var
  p: TPoint;
begin
  if ChooseOption.IsOpen() then
  begin
    if Self.Filter.UpText and ChooseOption.HasOption(Self.UpText) then
      Exit(True);
    ChooseOption.Close();
  end;

  if not Self.Filter.Walker then
    Exit;

  if Self.Filter.UpText then
    TWalkerObject.CurrentUpText := Self.UpText;

  p := ScriptWalker^.GetClosestPoint(Self.Coordinates);
  if not ScriptWalker^.MakePointVisible(p) and
     not ScriptWalker^.WebWalk(p, 30, 0.02) then
      Exit;

  Result := Self._WalkHoverHelper(attempts, trackTarget);
end;

//Remove waituntil randomness to prevent idling
function TWalker.WalkStep(playerPoint, walkerPoint: TPoint): Boolean; override;
var
  minimapPoint: TPoint;
  waitUntilDistance: Int32;
begin
  if not Self.WalkStepHelper(playerPoint, walkerPoint, minimapPoint) then
    Exit(not Self.Enabled);

  if (Minimap.Center.DistanceTo(minimapPoint) < 5) then
    Exit(True);

  Result := Self.Click(minimapPoint, Self.ClickRandomness);
  if Result then
  begin
    {if (Random() < 0.15) then // 15% chance of randomness else mean
      waitUntilDistance := Random(Distance(Minimap.Center(), minimapPoint))
    else}
      waitUntilDistance := SRL.NormalRange({0} 5, Distance(Minimap.Center, minimapPoint){ + 10});

    Self.WaitMoving(walkerPoint, waitUntilDistance);
  end;
end;

procedure TZMIBot.DebugLn(Text : String); begin
  WriteLn(SRL.TimeStamp() + ':[ZMI]: ' + Text);
end;

function TZMIBot.GetBehavior(Behavior : EZMIBehavior): Int32;
var
  n : Int32 := Ord(Behavior) + 1;
begin
  if Self.DevMode then
    Exit(9);

  if n > 15 then
    n := n mod 15;
  Result := BioHash.GetDigit(n);
end;

function TZMIBot.Dice(Behavior : EZMIBehavior): Boolean;
var
  B : Int32 := Self.GetBehavior(Behavior);
begin
  if Self.DevMode then
    Exit(True);

  if B <= 3 then
    Exit(False);

  Result := SRL.Dice(B * 10);
end;

function TZMIBot.WaitUntilInterval(): Int32; begin
  Result := 13 + Floor(100 / Self.GetBehavior(EZMIBehavior.WAIT_UNTIL_INTERVAL));
end;

function TZMIBot.IsBankPaymentBoxOpen(): Boolean;
var
  TPA : TPointArray;
  ATPA : T2DPointArray;
  I     : Int32;
  Title : String;
begin
  if SRL.FindColors(TPA, CTS2(4803917, 4, 1.78, 0.39), MainScreen.Bounds) = 0 then
    Exit;

  ATPA := TPA.Cluster(1);
  ATPA.FilterSize(10, 1000);
  if ATPA.Len < 1 then
    Exit;
  for I := 0 to High(ATPA) do begin
    Title := OCR.Recognize(ATPA[I].Bounds, TOCRColorFilter.Create([2070783]), FONT_BOLD_12);
    if 'Charge Selection' in Title then
      Exit(True);
  end;
end;

function TZMIBot.GetPaymentBox(Rune : EZMIBankPayment): TBox;
var
  TPA          : TPointArray;
  ATPA         : T2DPointArray;
  Text         : String;
  TL           : TPoint;
  I            : Int32;
  Boxes        : TBoxArray;
begin
  if SRL.FindColors(TPA, CTS2(4803917, 4, 1.78, 0.39), MainScreen.Bounds) = 0 then
    Exit;

  ATPA := TPA.Cluster(1);
  ATPA.FilterSize(1000, EComparator.__GT__);
  if ATPA.Len < 1 then
    Exit;
  for I := 0 to High(ATPA) do begin
    Text := OCR.Recognize(ATPA[I].Bounds, TOCRColorFilter.Create([2070783]), FONT_BOLD_12);
    if 'payment' in Text then begin
      TL := [ATPA[I].Bounds.X1, ATPA[I].Bounds.Y1];
      Break;
    end;
  end;

  if TL = [0, 0] then
    Exit;

  Boxes += Grid(2, 1, 35, 35, [54, 0], [TL.X + 107, TL.Y + 12]);
  Boxes += Grid(3, 1, 35, 35, [54, 0], [TL.X + 63, TL.Y + 55]);
  Boxes += Grid(4, 1, 35, 35, [53, 0], [TL.X + 19, TL.Y + 99]);
  Boxes += Grid(3, 1, 35, 35, [53, 0], [TL.X + 63, TL.Y + 143]);
  Boxes += Grid(2, 1, 35, 35, [53, 0], [TL.X + 107, TL.Y + 187]);
  Result := Boxes[Rune];
end;

procedure TZMIBot.MakeBankPayment({$H-}BankPayment:EZMIBankPayment);{$H+}
var
  PaymentBox : TBox;
begin
  PaymentBox := Self.GetPaymentBox(Self.BankPayment);
  if PaymentBox = [0, 0, 0, 0] then
    Exit;

  Mouse.Move(PaymentBox, True);

  if not (ToStr(Self.BankPayment).ToLower.Capitalize in MainScreen.GetUpText) then
    Exit;

  if SRL.GetItemAmount(PaymentBox) < 100 then
    TerminateScript('Not enough payment runes to continue running.');

  Mouse.Click(MOUSE_LEFT);
  WaitUntil(Bank.IsOpen, Self.WaitUntilInterval, 3000);
end;

function ProgReport(ResultType:int32; ScriptName, ScriptAuthor, ScriptVersion: String;
                    VarNames: TStringArray;
                    VarValues: TVariantArray
                    ): Variant;
var
  TSA        : TStringArray;
  s,s2       : String;
  s3         : String := '=';
  s4         : String := ' ';
  i, i2, L   : Int32;
begin
  if (ResultType = 2) then
    Result := '';

  if length(VarNames) <> Length(VarValues) then
  begin
    Writeln('VarNames and VarValues must be the same length');
    exit;
  end;
  SetLength(TSA, 3 + Length(VarNames) + 4);
  s2 := 'by '+ScriptAuthor;

  TSA[0] := s3;
  TSA[1] := ScriptName.Capitalize+' '+ScriptVersion;
  TSA[2] := s2;
  TSA[3] := s3;

  i2 := 3 + Length(VarNames);

  for i:= 4 to i2 do
    L := Max(L, Length(VarNames[i-4]));

  for i:= 4 to i2 do
  begin
    s := VarValues[i-4];
    TSA[i] := Padr((VarNames[i-4]).Capitalize, L)+' : '+ s.Capitalize;
  end;

  TSA[i2+1] := s3;
  TSA[i2+2] := ScriptName.Capitalize+' '+ScriptVersion;
  TSA[i2+3] := s3;

  i2 := 0;
  for i:= 0 to High(TSA) do
    i2 := Max(i2, Length(TSA[i]));

  TSA[0]           := s3.Replicate(i2 - 1);
  TSA[3]           := s3.Replicate(i2 - 1);
  TSA[High(TSA)-2] := s3.Replicate(i2 - 1);
  TSA[High(TSA)]   := s3.Replicate(i2 - 1);

  TSA[2] := s4.Replicate(round((i2 - Length(TSA[2]))/2)) + TSA[2]; //centering by ScriptAuthor
  TSA[High(TSA)-1] := s4.Replicate(round((i2 - Length(TSA[High(TSA)-1]))/2)) + TSA[High(TSA)-1];

  for i:= 0 to High(TSA) do
    if (TSA[i][1] = s3) then
      case ResultType of
        0 : writeln     ('[='+Padr(TSA[i], i2)+'=]');
        1 : writeln     ('[='+Padr(TSA[i], i2)+'=]');
        2 : Result := Result + '[='+Padr(TSA[i], i2)+'=]' + chr(13);
        else begin Writeln('Invalid Result Type'); exit; end;
      end
    else
      case ResultType of
        0 : writeln     ('[ '+Padr(TSA[i], i2)+' ]');
        1 : writeln     ('[ '+Padr(TSA[i], i2)+' ]');
        2 : Result := Result + '[ '+Padr(TSA[i], i2)+' ]' + chr(13);
        else begin Writeln('Invalid Result Type'); exit; end;
      end;

  if not ResultType = 2 then Result := true;
end;

procedure TZMIBot.Report();
var
  VarNames: TStringArray;
  VarValues: TVariantArray;
  XPGained : Int32;
begin
  VarNames  += 'Runtime';
  VarValues +=  SRL.MsToTime(Self.Runtime.ElapsedTime, Time_Short);

  XPGained := XPBar.Read - Self.StartingXP;
  VarNames  += 'XP';
  VarValues += ToStr(XPGained) + '(' + ToStr(NumberPerHour(XPGained, Self.Runtime.ElapsedTime)) + '/H)';

  VarNames += 'Essence used';
  VarValues += ToStr(Self.EssenceUsed) + '(' + ToStr(NumberPerHour(Self.EssenceUsed, Self.Runtime.ElapsedTime)) + '/H)';

  if Length(Antiban.Breaks) > 0 then begin
    VarNames  += 'Next break';
    VarValues += SRL.MsToTime(Max(0, Round(Antiban.Breaks[0].NextAtTime - GetTimeRunning())), Time_Short);
  end;

  if Length(Antiban.Sleeps) > 0 then begin
    VarNames  += 'Next sleep';
    VarValues += SRL.MsToTime(Max(0, Round(Antiban.Sleeps[0].NextAtTime - GetTimeRunning())), Time_Short);
  end;

  Self.DebugLn('');
  ProgReport(1, 'ZMI Runecrafter', 'Elixer', 'Rev '+{$MACRO SCRIPT_REVISION}, VarNames, VarValues);
end;

function TZMIBot.IsPouchDegraded(): Boolean;
var
  PouchSlot : Int32;
begin
  if not Inventory.FindItem('Colossal pouch', PouchSlot) then
    Exit;

  Result := SRL.CountColor(CTS2(6580875, 2, 0.20, 0.38), Inventory.GetSlotBox(PouchSlot)) > 5;
end;

procedure TZMIBot.UpdateMaxPouchEssence(); begin
  case Stats.GetLevel(ESkill.RUNECRAFTING, False) of
    25..49: Self.MaxEssence := 8;
    50..74: Self.MaxEssence := 16;
    75..84: Self.MaxEssence := 27;
    85..126: Self.MaxEssence := 40;
    else TerminateScript('Failed to read RC level or RC level is too low to use a colossal pouch.');
  end;
end;

function TZMIBot.ShouldRepairEarly(): Boolean; begin
  Result := (Self.EssenceTillDegrade < 41) and Self.Dice(EZMIBehavior.REPAIR_POUCH_EARLY);
end;

procedure TZMIBot.TeleportOurania();
var
  NextClick : TPoint;
begin
  if not Magic.CastSpell(ESpell.OURANIA_TELEPORT) then begin
    if Magic.CastSpell(ESpell.VILE_VIGOUR) then
      WaitUntil((Magic.GetSpellBook = ESpellBook.LUNAR), Self.WaitUntilInterval, 2*ONE_MINUTE);
    Exit;  
  end;
  
  Wait(37, Self.GetBehavior(EZMIBehavior.REACTION_TIME) * 60 + 37);
  
  if not InRange(Minimap.GetCompassAngle, 110, 135) then
    Mouse.Move(MainScreen.Bounds.Expand(-30));
  Minimap.SetCompassAngle(128, 20);

  if Self.Dice(EZMIBehavior.PRE_HOVER_LADDER_PATH) then begin
    NextClick := Self.RSW.GetTileMSEx(Point(5260, 3455).Random(0, 6), [5216, 3447]).Mean;
    if NextClick in MainScreen.Bounds then
      Mouse.Move(NextClick);
  end else if SRL.Dice(50) then
    Antiban.SmallRandomMouse;

  Self.Report;

  WaitUntil((Self.RSW.GetMyPos in UPPER_MAP), Self.WaitUntilInterval, 6000);
end;

procedure TZMIBot.OpenBank();
  function DepositAllVisible(): Boolean;
  begin
    if SRL.CountColor(CTS2(1717089, 13, 0.24, 1.71), Bank.GetButton(EBankDepositButton.INVENTORY).Bounds) > 180 then
        Result := Bank.IsOpen;
  end;
var
  I : Int32;
  T : TCountdown;
begin
  try
    if not Self.Eniola.WalkSelectOption(['ank'], 1) then
      Exit;
  except
    Self.DebugLn('Failure at Eniola.WalkSelectOption');
    if not (Self.RSW.GetMyPos in BANK_AREA) then
      Self.TeleportOurania;
    Exit;
  end;

  Wait(57, 107);

  if Self.UseDepositAll then begin
    if Self.Dice(EZMIBehavior.PRE_HOVER_DEPOSIT_ALL) then begin
      if Self.DepositAllBox <> [0, 0, 0, 0] then
        Mouse.Move(Self.DepositAllBox);
    end else if SRL.Dice(50) then
      Antiban.SmallRandomMouse;
  end else begin
    if Self.Dice(EZMIBehavior.PRE_HOVER_DEPOSIT_RUNES) then begin
      for I := Inventory.LOW_SLOT to Inventory.HIGH_SLOT do
        if SRL.CountColor(7697788, Inventory.GetSlotBox(I)) > 5 then begin
          Mouse.Move(Inventory.GetSlotBox(I));
          Break;
        end;
    end else if SRL.Dice(50) then
      Antiban.SmallRandomMouse;
  end;

  T.Init(3000);
  while not T.IsFinished do begin
    if not GameInterface.IsOpen(EInterfaceType.ANY) then
      Continue;

    if Self.UseDepositAll and (not DepositAllVisible) then
      Continue;

    Break;
  end;
end;

procedure TZMIBot.CloseBank();
var
  MinimapHover : TPoint;
begin
  if SRL.Dice(90) then
    GameInterface.Close(True)
  else
    GameInterface.ClickClose(Self.GetBehavior(EZMIBehavior.ESCAPE_CLOSE_INTERFACE) > 4);

  if Self.IsPouchDegraded and (Self.GetBehavior(EZMIBehavior.PRE_HOVER_MAGIC) > 4) then begin
    if Self.Dice(EZMIBehavior.PRE_HOVER_MAGIC) then
      Mouse.Move(GameTabs.Boxes[EGameTab.MAGIC].Expand(8));
  end else if Self.GetBehavior(EZMIBehavior.PRE_HOVER_MINIMAP) > 4 then begin
    if Self.Dice(EZMIBehavior.PRE_HOVER_MINIMAP) then begin
      MinimapHover := Self.RSW.WorldToMM([4942, 1318]);
      if MinimapHover in Minimap.Bounds then
        Mouse.Move(MinimapHover.Random(0, 3));
    end;
  end;

  WaitUntil(not GameInterface.IsOpen, Self.WaitUntilInterval, 2000);
end;

function TZMIBot.ContainsCraftedRunes(): Boolean;
var
  I : Int32;
  InventoryBoxes  : TBoxArray;
  Match           : TItemFinderMatch;
begin
  for I := Inventory.LOW_SLOT to Inventory.HIGH_SLOT do
    if SRL.CountColor(7697788, Inventory.GetSlotBox(I)) > 5 then
      InventoryBoxes += Inventory.GetSlotBox(I);

  Result := ItemFinder.Find(Self.DepositItems, InventoryBoxes, Match);
end;

procedure TZMIBot.DepositAll(); begin
  if Mouse.Position in Self.DepositAllBox then
    Wait(78, 136);

  if not Bank.DepositAll then
    Exit;

  if Self.DepositAllBox = [0, 0, 0, 0] then
    Self.DepositAllBox := Bank.GetButton(EBankDepositButton.INVENTORY).Bounds;

  if WaitUntil((not Inventory.ContainsRandomItems(Self.InventoryItems)), Self.WaitUntilInterval, 3000) then
    Self.DepositFails := 0
  else
    Inc(Self.DepositFails);
end;

procedure TZMIBot.DepositRandomItems();
var
  I               : Int32;
  RandomItemSlots : TIntegerArray;
begin
  RandomItemSlots := Inventory.FindRandomItems(Self.InventoryItems)
  if RandomItemSlots.Len = 0 then
    Exit;

  for I := 0 to High(RandomItemSlots) do begin
    if not Inventory.IsSlotUsed(RandomItemSlots[I]) then
      Continue;
    Bank.DepositHelper(Inventory.GetSlotBox(RandomItemSlots[I]), -1, True);
    Wait(113, 176);
  end;

  if WaitUntil((not Inventory.ContainsRandomItems(Self.InventoryItems)), Self.WaitUntilInterval, 2000) then
    Self.DepositFails := 0
  else
    Inc(Self.DepositFails);
end;

procedure TZMIBot.DepositRunes();
var
  I               : Int32;
  InventoryBoxes  : TBoxArray;
  Matches         : TItemFinderMatchArray;
  //RuneCount       : Int32;
begin
  for I := Inventory.LOW_SLOT to Inventory.HIGH_SLOT do
    if SRL.CountColor(7697788, Inventory.GetSlotBox(I)) > 5 then
      InventoryBoxes += Inventory.GetSlotBox(I);

  Matches := ItemFinder.FindAll(Self.DepositItems, InventoryBoxes, InventoryBoxes.Len);

  if Length(Matches) = 0 then
    Exit;

  for I := 0 to High(Matches) do begin
    Bank.DepositHelper(Matches[I].Box, -1, True);
    Wait(113, 176);
  end;

  Antiban.SmallRandomMouse;
  WaitUntil((not Self.ContainsCraftedRunes), Self.WaitUntilInterval, 2000);
end;

procedure TZMIBot.WithdrawEssence();
var
  Box : TBox;
begin
  if not Bank.FindItem(Self.Essence, Box) then
    TerminateScript('Out of essence');

  if Box.Y2 > 292 then begin
    Bank.RandomScroll(True);
    Exit;
  end;

  Bank.WithdrawHelper(Box, -1, False, True);
  Wait(13, 77);

  if Self.Dice(EZMIBehavior.PRE_HOVER_POUCH_FILL) then
    if Self.PouchEssence < Self.MaxEssence then
      Inventory.MouseItem('Colossal pouch')
  else if SRL.Dice(50) then
    Antiban.SmallRandomMouse;

  WaitUntil(Inventory.IsFull, Self.WaitUntilInterval, 1000);
end;

procedure TZMIBot.FillPouch(); var
  PouchSlot : Int32;
  EssInInventory : Int32;
  AmtFilled      : Int32;
  Match : TItemFinderMatch;
begin
  if not Inventory.FindItem('Colossal pouch', PouchSlot) then
    Exit;

  EssInInventory := Inventory.CountItem(Self.Essence.Item);

  Mouse.Move(Inventory.GetSlotBox(PouchSlot));

  if not ChooseOption.Open then begin
    Mouse.Move(MainScreen.Bounds);
    Exit;
  end;

  if ChooseOption.HasOption('Empty', True, False) then begin
    Wait(107, 387);
    Self.PouchEssence := Self.MaxEssence;
    Mouse.Move(MainScreen.Bounds);
    Exit;
  end;

  if not ChooseOption.Select('Fill') then begin
    Mouse.Move(MainScreen.Bounds);
    Exit;
  end;

  if Self.Dice(EZMIBehavior.PRE_HOVER_ESSENCE) then begin
    if (Self.PouchEssence + EssInInventory) < Self.MaxEssence then begin
      if ItemFinder.Find([Self.Essence.Item], Bank.FindItemBoundaries, Match) then
        Mouse.Move(Match.Box);
    end;
  end else if SRL.Dice(50) then
    Antiban.SmallRandomMouse;

  if not WaitUntil((Inventory.CountItem(Self.Essence.Item) < EssInInventory), Self.WaitUntilInterval, 2000) then
    Self.PouchEssence := Self.MaxEssence;

  AmtFilled := EssInInventory - Inventory.CountItem(Self.Essence.Item);
  PouchEssence += AmtFilled;
  if Stats.GetLevel(ESkill.RUNECRAFTING, True) < 99 then
    Dec(Self.EssenceTillDegrade, AmtFilled);
end;

procedure TZMIBot.WithdrawStamina();
var
  EmptySlots : TIntegerArray;
  Match : TItemFinderMatch;
  Box : TBox;
begin
  EmptySlots := Inventory.GetEmptySlots;
  if EmptySlots.Len = 0 then
    Exit;

  if not Bank.FindItem(Self.StaminaPotion, Box) then
    TerminateScript('Out of staminas');

  if Box.Y2 > 292 then begin
    Bank.RandomScroll(True);
    Exit;
  end;

  Bank.WithdrawHelper(Box, 1, False, False);

  if Self.Dice(EZMIBehavior.PRE_HOVER_CONSUMABLE) then
    Mouse.Move(Inventory.GetSlotBox(EmptySlots[0]))
  else if SRL.Dice(50) then
    Antiban.SmallRandomMouse;

  WaitUntil(ItemFinder.Find([Self.StaminaPotion.Item], [Inventory.GetSlotBox(EmptySlots[0])], Match), Self.WaitUntilInterval, 1200);
end;

procedure TZMIBot.ConsumeStamina();
var
  StaminaSlot  : Int32;
  Energy       : Int32;
begin
  Energy := Minimap.GetRunEnergy;

  if not Inventory.FindItem(Self.StaminaPotion.Item, StaminaSlot) then
    Exit;

  Mouse.Move(Inventory.GetSlotBox(StaminaSlot), True);

  if not ChooseOption.Open then
    Antiban.SmallRandomMouse;

  if not ChooseOption.Select('Drink') then
    Exit;

  if SRL.Dice(50) then
    Antiban.SmallRandomMouse;

  if WaitUntil(Minimap.HasStamina, Self.WaitUntilInterval, 1200) then
    Self.StaminaTimer.Restart;

end;

procedure TZMIBot.WithdrawFood();
var
  EmptySlots : TIntegerArray;
  Match : TItemFinderMatch;
  Box : TBox;
begin
  EmptySlots := Inventory.GetEmptySlots;
  if EmptySlots.Len = 0 then
    Exit;

  if not Bank.FindItem(Self.Food, Box) then
    TerminateScript('Out of food');

  if Box.Y2 > 292 then begin
    Bank.RandomScroll(True);
    Exit;
  end;

  Bank.WithdrawHelper(Box, -1, False, True);

  if Self.Dice(EZMIBehavior.PRE_HOVER_CONSUMABLE) then
    Mouse.Move(Inventory.GetSlotBox(EmptySlots[0]))
  else if SRL.Dice(50) then
    Antiban.SmallRandomMouse;

  WaitUntil(ItemFinder.Find([Self.Food.Item], [Inventory.GetSlotBox(EmptySlots[0])], Match), Self.WaitUntilInterval, 1200);
end;

procedure TZMIBot.ConsumeFood();
var
  FoodSlot  : Int32;
  HPPerc    : Int32;
  T         : TCountdown;
begin
  HPPerc := Minimap.GetHPPercent;

  if not Inventory.FindItem(Self.Food.Item, FoodSlot) then
    Exit;

  Mouse.Move(Inventory.GetSlotBox(FoodSlot), True);

  if not ChooseOption.Open then
    Antiban.SmallRandomMouse;

  if not ChooseOption.Select('Eat') then
    Exit;

  T.Init(Random(1207, 1506));

  if SRL.Dice(50) then
    Antiban.SmallRandomMouse;

  WaitUntil(((Minimap.GetHPPercent > HPPerc) and T.IsFinished), Self.WaitUntilInterval, 2000);
end;

procedure TZMIBot.CraftRunes();
var
  EssenceCount : Int32;
begin
  Self.RSW.ScreenWalk := False;

  EssenceCount := Inventory.CountItem(Self.Essence.Item);

  try
    if not Self.OuraniaAltar.WalkClick(True, 1) then
      Exit;
  except
    Self.DebugLn('Failure at OuraniaAltar.WalkClick');
    if not (Self.RSW.GetMyPos in LOWER_MAP) then
      Self.TeleportOurania;
    Exit;
  end;

  Self.RSW.ScreenWalk := True;

  if Self.PouchEssence > 0 then begin
    if Self.Dice(EZMIBehavior.PRE_HOVER_POUCH_EMPTY) then
      Inventory.MouseItem('Colossal pouch')
    else if SRL.Dice(50) then
      Antiban.SmallRandomMouse;
  end else begin
    if Self.Dice(EZMIBehavior.PRE_HOVER_MAGIC) then
      Mouse.Move(GameTabs.Boxes[EGameTab.MAGIC])
    else if SRL.Dice(50) then
      Antiban.SmallRandomMouse;
  end;

  if WaitUntil((not Inventory.ContainsItem(Self.Essence.Item)), Self.WaitUntilInterval, 3150) then begin
    Inc(Self.EssenceUsed, EssenceCount);
    Self.InactivityTimer.Restart;
  end;
end;

procedure TZMIBot.EmptyPouch();
var
  PouchSlot : Int32;
  CuboidArray : TCuboidExArray;
begin
  if not (ChooseOption.Close and Inventory.FindItem('Colossal pouch', PouchSlot)) then
    Exit;

  Mouse.Move(Inventory.GetSlotBox(PouchSlot).Expand(-3));
  Wait(1150,1450);

  if Mainscreen.IsUpText('Empty') then begin
    Mouse.Click(MOUSE_LEFT);
    WaitUntil(Inventory.ContainsAny([Self.Essence.Item]), 115, 2000);
  end
  else
  if not ChooseOption.Select('Empty') then begin
    Mouse.Move(MainScreen.Bounds);
    Exit;
  end;

  if Self.Dice(EZMIBehavior.PRE_HOVER_ALTAR) then begin
    CuboidArray := Self.OuraniaAltar.GetCuboidArray;
    if Length(CuboidArray) > 0 then
      Mouse.Move(CuboidArray[0].Center.Random(1, MainScreen.NormalizeDistance(20)));
  end else if SRL.Dice(50) then
    Mouse.Move(MainScreen.Bounds.Expand(-30));

  if not WaitUntil(Inventory.ContainsItem(Self.Essence.Item), Self.WaitUntilInterval, 2500) then
    Self.PouchEssence := 0;

  Dec(Self.PouchEssence, Inventory.CountItem(Self.Essence.Item));
  Self.PouchEssence := Max(Self.PouchEssence, 0);
end;

procedure TZMIBot.PrayAltar();
var
  PrayerPoints : Int32;
  CuboidArray : TCuboidExArray;
begin
  PrayerPoints := Minimap.GetPrayerLevel;

  if Self.RSW.GetMyPos.DistanceTo(Self.PrayerAltar.Coordinates[0]) > 30 then
    Self.RSW.WalkBlind([5216, 3452], 28);

  try
    if not Self.PrayerAltar.WalkClick then
      Exit;
  except
    Self.DebugLn('Failure at PrayerAltar.WalkClick');
    if not (Self.RSW.GetMyPos in UPPER_MAP) then
      Self.TeleportOurania;
    Exit;
  end;

  if Self.Dice(EZMIBehavior.PRE_HOVER_LADDER) then begin
    CuboidArray := Self.Ladder.GetCuboidArray;
    if Length(CuboidArray) > 0 then
      Mouse.Move(CuboidArray[0].Center.Random(1, MainScreen.NormalizeDistance(20)));
  end else if SRL.Dice(50) then
    Antiban.SmallRandomMouse;

  WaitUntil(((Minimap.GetPrayerLevel > PrayerPoints) or Chat.HasContinue), Self.WaitUntilInterval, 3000);
end;

procedure TZMIBot.ClimbDownLadder();
var
  BankTile : TRectangle;
begin
  if Self.RSW.GetMyPos.DistanceTo(Self.Ladder.Coordinates[0]) > 30 then
    Self.RSW.WalkBlind([5216, 3452], 28);

  try
    if not Self.Ladder.WalkClick then
      Exit;
  except
    Self.DebugLn('Failure at Ladder.WalkClick');
    if not (Self.RSW.GetMyPos in UPPER_MAP) then
      Self.TeleportOurania;
    Exit;
  end;

  if Self.Dice(EZMIBehavior.PRE_HOVER_BANK) then begin
    BankTile := Self.RSW.GetTileMSEx([4942, 1250], Self.Eniola.Coordinates[0]);
    Mouse.Move(BankTile.Bounds.Expand(MainScreen.NormalizeDistance(17)));
  end else if SRL.Dice(50) then
    Antiban.SmallRandomMouse;

  WaitUntil(((Self.RSW.GetMyPos in LOWER_MAP) or Chat.HasContinue), Self.WaitUntilInterval, 6000);
end;

procedure TZMIBot.RepairPouch();
begin
  if Magic.GetSpellBook <> ESpellBook.LUNAR then begin
    Self.InactivityTimer.Pause;
    if not WaitUntil((Magic.GetSpellBook = ESpellBook.LUNAR), 2000, 2*ONE_MINUTE) then begin
      TerminateScript('We''re on the wrong spellbook.');
    end;
    Wait(317, 902);
    Self.InactivityTimer.Resume;
  end;

  if not (Magic.MouseSpell(ESpell.NPC_CONTACT) and ChooseOption.Open) then
    Exit;

  if not ChooseOption.HasOption(['ark', 'age'], True, False) then
    TerminateScript('Make sure that you contact the dark mage once before starting the script.');

  if not ChooseOption.Select(['ark', 'age']) then begin
    Antiban.SmallRandomMouse;
    Exit;
  end;

  if SRL.Dice(66) then
    Inventory.Open;

  if not WaitUntil(Chat.HasContinue, Self.WaitUntilInterval, 8000) then
    Exit;

  while Chat.HasContinue do
    Chat.ClickContinue;

  Chat.ClickOption('repair my');

  if not WaitUntil(Chat.HasContinue, Self.WaitUntilInterval, 8000) then
    Exit;

  Chat.ChatToOption('hanks');
  Self.EssenceTillDegrade := 320;
end;

procedure TZMIBot.WithdrawBankPayment();
var
  Box : TBox;
begin
  if not Bank.WithdrawItem(Self.BankPaymentItem, False) then
    if not Bank.FindItem(Self.BankPaymentItem, Box) then
      TerminateScript('Failed to find anymore bank payment runes in bank.')
    else
      Exit;

  if not WaitUntil((Inventory.CountItemStack(Self.BankPaymentItem.Item) >= 2000), Self.WaitUntilInterval, 5000) then
    TerminateScript('Not enough bank payment runes found to continue.');
end;

procedure TZMIBot.StoreBankPayment();
var
  Count : Int32;
begin
  Bank.Close();

  Count := Inventory.CountItemStack(Self.BankPaymentItem.Item);

  if Count < 2000 then
    TerminateScript('Not enough bank payment runes to continue.');

  if Inventory.ContainsItem('Rune pouch') then
  begin
    if not Inventory.Use(Self.BankPaymentItem.Item, 'Rune pouch')  then
      TerminateScript('Failed to store bank payment runes.');

    if Count > 16000 then
      Count := 16000;
  end
  else
  if Inventory.ContainsItem('Divine rune pouch') then
  begin
    if not Inventory.Use(Self.BankPaymentItem.Item, 'Divine rune pouch')  then
      TerminateScript('Failed to store bank payment runes.');

    if Count > 16000 then
      Count := 16000;
  end;

  WaitUntil((Inventory.CountItemStack(Self.BankPaymentItem.Item) < Count), Self.WaitUntilInterval, 5000);

  Self.BankPaymentCount := Count;
end;

function TZMIBot.HasEnoughRunes(): Boolean;
begin
  Exit((Inventory.CountItemStack('Soul rune') >= 4) or (Inventory.CountItemStack('Aether rune') >= 3));
end;

procedure TZMIBot.HandleLadderStateWalking({$H-}Walker: PWalker; Position: TPoint; Destination: TPoint);{$H+}
var
  StaminaSlot : Int32;
begin

  if (Position.X > 5300) or (Position.Y > 3550) then begin
    Self.TeleportOurania;
    Walker^.Enabled := False;
    Exit;
  end;

  if SRL.CountColor([5926247], MainScreen.Bounds) > 50 then begin
    Walker^.Enabled := False;
    Exit;
  end;

  if (not Self.UseVV) and
     (not Minimap.HasStamina) and
     Inventory.FindItem(Self.StaminaPotion.item, StaminaSlot) then begin
    Inventory.ClickSlot(StaminaSlot);
    Exit;
  end;

  if (not Self.UseVV) or
     (not Self.VVTimer.IsFinished) or
     (Minimap.GetPrayerLevel = 0) or
     (Minimap.GetRunEnergy > 40) then begin
    if SRL.Dice(3) then
      Inventory.Open;
    Exit;
  end;

  case Magic.GetSpellBook of
    ESpellBook.LUNAR: begin
      if Self.CastSBSTimer.isFinished and
         Magic.CastSpell(ESpell.SPELLBOOK_SWAP, 'Arceuus') and
         Self.HasEnoughRunes then begin
          Self.CastSBSTimer.Restart;
          WaitUntil(Magic.IsSpellBook(ESpellBook.ARCEUUS), 115, 15000);
      end;
    end;

    ESpellBook.ARCEUUS: begin
      if Magic.CanActivate(ESpell.VILE_VIGOUR) then begin
        Magic.CastSpell(ESpell.VILE_VIGOUR);
        Self.VVTimer.Init(1*ONE_MINUTE);
      end;
    end;
  end;
end;

procedure TZMIBot.HandlerPrayAltarStateWalking({$H-}Walker: PWalker; Position: TPoint; Destination: TPoint);{$H+}
var
  StaminaSlot : Int32;
begin
  if (Position.X > 5300) or (Position.Y > 3550) then begin
    Self.TeleportOurania;
    Walker^.Enabled := False;
    Exit;
  end;

  if SRL.CountColor([5926247], MainScreen.Bounds) > 50 then begin
    Walker^.Enabled := False;
    Exit;
  end;

  if (not Self.UseVV) and
     (not Minimap.HasStamina) and
     Inventory.FindItem(Self.StaminaPotion.item, StaminaSlot) then begin
    Inventory.ClickSlot(StaminaSlot);
    Exit;
  end;

  if (not Self.UseVV) or
     (not Self.VVTimer.IsFinished) or
     (Minimap.GetPrayerLevel = 0) or
     (Minimap.GetRunEnergy > 40) then begin
    if SRL.Dice(3) then
      Inventory.Open;
    Exit;
  end;

  case Magic.GetSpellBook of
    ESpellBook.LUNAR: begin
      if Self.CastSBSTimer.isFinished and
         Magic.CastSpell(ESpell.SPELLBOOK_SWAP, 'Arceuus') and
         Self.HasEnoughRunes then begin
          Self.CastSBSTimer.Restart;
          WaitUntil(Magic.IsSpellBook(ESpellBook.ARCEUUS), 115, 15000);
      end;
    end;

    ESpellBook.ARCEUUS:
    begin
      if (Inventory.CountItem('Aether rune') >= 1) or
        (Inventory.CountItem('Soul rune') >= 1) then begin
        Magic.CastSpell(ESpell.VILE_VIGOUR);
        Self.VVTimer.Init(1*ONE_MINUTE);
      end;
    end;
  end;
end;

procedure TZMIBot.HandlerCraftRunesStateWalking(Walker: PWalker; Position: TPoint; Destination: TPoint);
var
  RandomItemSlots : TIntegerArray;
  StaminaSlot     : Int32;
begin

  if Position in ALTAR_AREA.Expand(20) then begin
    if Self.OuraniaAltar.Click(True, 1) then begin
      Wait(1250,1450);
      Walker^.Enabled := False;
      Exit;
    end;
  end;

  if Position.DistanceTo(Destination) < 14 then
    Exit;

  if (not Self.UseVV) and
     (not Minimap.HasStamina) and
     Inventory.FindItem(Self.StaminaPotion.Item, StaminaSlot) then begin
    Inventory.ClickSlot(StaminaSlot);
    Exit;
  end;

  if (Position.Y > 1438) and SRL.Dice(Self.GetBehavior(EZMIBehavior.FACE_ALTAR)*0.4) then
    if not InRange(Minimap.GetCompassAngle, 255, 285) then begin
      Minimap.SetCompassAngle(270, 20);
      Exit;
    end;

  RandomItemSlots := Inventory.FindRandomItems(Self.InventoryItems);
  if (RandomItemSlots.Len > 0) and ChooseOption.Close then begin
    Inventory.ShiftDrop([RandomItemSlots[0]]);
  end;
  Self.DepositFails := 0;

  if SRL.Dice(Self.GetBehavior(EZMIBehavior.LOSE_FOCUS_WALKING)*0.1) then
    Antiban.LoseFocus;
end;

procedure TZMIBot.OnWalking(Walker: PWalker; Position: TPoint; Destination: TPoint);
begin
  case Self.State of
    EZMIState.CLIMB_DOWN_LADDER: Self.HandleLadderStateWalking(Walker, Position, Destination);
    EZMIState.PRAY_ALTAR:        Self.HandlerPrayAltarStateWalking(Walker, Position, Destination);
    EZMIState.CRAFT_RUNES:       Self.HandlerCraftRunesStateWalking(Walker, Position, Destination);
  end;
end;

procedure BreakCombatCheck(Task: PBreakTask);
var
  T : TCountdown;
  Teleport : Boolean;
begin
  Task^.Length;
  T.Init(3*ONE_SECOND);

  repeat
    if Length(Mainscreen.FindHitsplats(MainScreen.GetPlayerBox)) > 1 then begin
      Teleport := True;
      Break;
    end;
  until T.IsFinished;

  if Teleport then begin
    repeat
      ZMIBot.TeleportOurania;
    until ZMIBot.RSW.GetMyPos in UPPER_MAP;
  end;
end;

procedure SleepCombatCheck(Task: PSleepTask);
var
  T : TCountdown;
  Teleport : Boolean;
begin
  Task^.Length;
  T.Init(3*ONE_SECOND);
  repeat
    if Length(Mainscreen.FindHitsplats(MainScreen.GetPlayerBox)) > 1 then begin
      Teleport := True;
      Break;
    end;
  until T.IsFinished;

  if Teleport then begin
    repeat
      ZMIBot.TeleportOurania;
    until ZMIBot.RSW.GetMyPos in UPPER_MAP;
  end;
end;

procedure TZMIBot.InitZMICrafter();
var
  I : Int32;
  Slot : Int32;
begin
  if not GameClient.IsLoggedIn then
    if not Login.LoginPlayer(False) then
      TerminateScript('Failed to login.');

  GameInterface.Close();
  Mouse.Speed := 15 + Self.GetBehavior(EZMIBehavior.MOUSE_SPEED);
  GameClient.RemoteInput.DisableRealInput;

  if ScriptWalker = nil then begin
    Self.RSW.SetupRegions([LOWER_MAP, UPPER_MAP]);
    Self.RSW.OnWalkingEvent := @Self.OnWalking;
  end else begin
    if not (UPPER_MAP in ScriptWalker^.Regions) then
      ScriptWalker^.AddRegion(UPPER_MAP);
    if not (LOWER_MAP in ScriptWalker^.Regions) then
      ScriptWalker^.AddRegion(LOWER_MAP);
    ScriptWalker^.OnWalkingEvent := @Self.OnWalking;
    Self.RSW := ScriptWalker^;
  end;

  Self.OuraniaAltar.ShapeArray += [[2.1, 2.1, 3], 0];
  Self.OuraniaAltar.SetupCoordinates([[5122, 1450]]);
  Self.OuraniaAltar.SetupUpText(['raft', 'ltar']);
  Self.OuraniaAltar.Filter.Walker := True;
  Self.OuraniaAltar.Filter.Finder := False;

  Self.PrayerAltar.ShapeArray += [[1.6, 1, 3], 0];
  Self.PrayerAltar.SetupCoordinates([[5210, 3525]]);
  //Self.PrayerAltar.SetupUpText(['ray', 'haos']);
  Self.PrayerAltar.Finder.Colors += CTS2(2110655, 6, 0.06, 0.34);
  //Self.PrayerAltar.Finder.Colors += CTS2(3371264, 1, 0.01, 0.01);
  //Self.PrayerAltar.Finder.Erode := 2;
  Self.PrayerAltar.Finder.Erode := 1;
  Self.PrayerAltar.Finder.Grow := 1;
  Self.PrayerAltar.Filter.Walker := True;
  Self.PrayerAltar.Filter.Finder := True;

  //Debug(Self.PrayerAltar);

  Self.Ladder.SetupCoordinates([[5200, 3524]]);
  //Self.Ladder.SetupUpText(['limb', 'adder']);
  //Self.Ladder.Finder.Colors += CTS2(3884882, 12, 0.32, 0.12);
  //Self.Ladder.Finder.Erode := 2;
  //Self.Ladder.Filter.Finder := True;
  Self.Ladder.Filter.Finder := False;
  Self.Ladder.Filter.Walker := True;

  Self.Eniola.ShapeArray += [[0.9, 0.9, 7], 0];
  Self.Eniola.SetupCoordinates([[4933, 1266]]);
  Self.Eniola.SetupUpText(['ank', 'Enio']);
  Self.Eniola.Filter.Walker := True;
  Self.Eniola.Filter.Finder := False;

  Self.RSW.ScreenWalk := False;
  Self.StartingXP := XPBar.Read;

  Antiban.MinZoom := 1;
  Antiban.MaxZoom := 10;
  Options.SetZoomLevel(0);
  Options.SetAttackOption(EOptionsDropDown.NPC_ATTACK_OPTIONS, EAttackOption.HIDDEN);

  Combat.SetAutoRetaliate(False);
  WL.GameSettings.MouseWheel := False;
  Self.UpdateMaxPouchEssence;

  Self.StaminaPotion := TBankItem.Setup('Stamina potion(1)', 1, False);

  Self.InventoryItems += ['Rune pouch', 'Divine rune pouch'];
  Self.InventoryItems += 'Colossal pouch';
  Self.InventoryItems += Self.Essence.Item;
  if not Self.UseVV then
    Self.InventoryItems += Self.StaminaPotion.Item;

  for I := 0 to High(RUNES) do begin
    if Inventory.ContainsItem(RUNES[I]) then
      Self.InventoryItems += RUNES[I]
    else
      Self.DepositItems += RUNES[I];
  end;

  Self.BankPaymentItem := TBankItem.Setup(ToStr(Self.BankPayment).Lower.Capitalize + ' rune');

  if not Inventory.ContainsItem(Self.BankPaymentItem.Item) then begin
    if not Inventory.ContainsAny(['Rune pouch', 'Divine rune pouch']) then
      TerminateScript('Failed to find rune pouch, start the script with your payment in the inventory or a rune pouch filled');
    Self.PaymentRunesInPouch := True;
  end;

  if Inventory.ContainsItem(Self.BankPaymentItem.Item) and Inventory.ContainsAny(['Rune pouch', 'Divine rune pouch']) then begin
    Self.StoreBankPayment();
  end;

  if Equipment.ContainsItem('Ring of endurance') then
    Self.StaminaTimer.Init(4*ONE_MINUTE)
  else
    Self.StaminaTimer.Init(2*ONE_MINUTE);

  Self.InactivityTimer.Init(2*ONE_MINUTE);
  Self.SBSTimer.Init(2*ONE_MINUTE);
  Self.VVTimer.Init(ONE_MINUTE);
  Self.CastSBSTimer.Init(5200);
  Self.EssenceTillDegrade := 320;

  Antiban.OnStartBreak := @BreakCombatCheck;
  Antiban.OnStartSleep := @SleepCombatCheck;
  Antiban.AddTask(1*ONE_HOUR, @Self.UpdateMaxPouchEssence, 0.5);

  Self.Web.LoadNodesFromString('');
  Self.Web.LoadPathsFromString('');
  Self.Web.LoadNamesFromString('');
  Self.RSW.WebGraph := Self.Web;

  if C_ENABLE_RECORDINGS then
    Recorder.Start(C_RECORDING_SECONDS, SIMBA_DATA_DIR + 'zmi-recordings' + DirectorySeparator, Chat.GetDisplayNameBox, XPBar.Bounds);

 // RunScriptOutputToFile('ZMI', '', WL.);

  if (Inventory.FindItem('Rune pouch', Slot) or Inventory.FindItem('Divine rune pouch', Slot)) and (Slot < 8) then
    if not Inventory.Drag(Slot, Random(24, 27)) then
      TerminateScript('Please move your rune pouch to the bottom of your inventory and away from your colossal pouch.');
end;

function TZMIBot.FindFenkenstrainGroundColors(): Boolean; begin
  Result := SRL.CountColor([5926247], MainScreen.Bounds) > 50;
end;

function TZMIBot.FindWaterbirthSeaColors(): Boolean;
var
  Color1, Color2 : TPointArray;
begin
  if (SRL.FindColors(Color1, 9402476, MainScreen.Bounds) = 0) or
     (SRL.FindColors(Color2, 9798777, MainScreen.Bounds) = 0) then
    Exit;

  Color1 := Color1.PointsInRangeOf(Color2, 1, 2);
  Result := Length(Color1.Cluster(2).Biggest) > 500;
end;

function TZMIBot.ShouldWithdrawStamina(): Boolean; begin
  if Inventory.IsFull then
    Exit;

  if (Self.StaminaTimer.TimeRemaining <= 15*ONE_SECOND) and (Minimap.GetRunEnergy < 65) then
    Exit(True);

  if (not Minimap.HasStamina) and (Minimap.GetRunEnergy < 80) then
    Exit(True);
end;

function TZMIBot.GetState(): EZMIState;
var
  PlayerPos : TPoint;
begin
  if Bank.IsOpen then begin
    //TODO Fix this you lazy POS
    //rune pouch interface is open
    if SRL.CountColor([2882086], Inventory.Bounds) > 0 then begin
      Mouse.Click([724, 215], MOUSE_LEFT);
      if not WaitUntil((SRL.CountColor([2882086], Inventory.Bounds) = 0), Self.WaitUntilInterval, 6000) then
        Exit;
    end;

    if Self.PaymentRunesInPouch and (Self.BankPaymentCount < 2000) then
      if Inventory.ContainsItem(Self.BankPaymentItem.Item) then
        Exit(EZMIState.STORE_BANK_PAYMENT)
      else
        Exit(EZMIState.WITHDRAW_BANK_PAYMENT);

    if Self.ContainsCraftedRunes and (Self.DepositFails < 2) then
      if Self.UseDepositAll then
        Exit(EZMIState.DEPOSIT_ALL)
      else
        Exit(EZMIState.DEPOSIT_RUNES);

    if Self.IsPouchDegraded then
      Exit(EZMIState.CLOSE_BANK);

    if Inventory.ContainsItem(Self.Food.Item) and (Minimap.GetHPPercent < 60) then
      Exit(EZMIState.CONSUME_FOOD);

    if (Minimap.GetHPPercent < 60) and (not Inventory.IsFull) then
      Exit(EZMIState.WITHDRAW_FOOD);

    if (not Self.UseVV) then begin
      if Inventory.ContainsItem(Self.StaminaPotion.Item) then begin
        if not Minimap.HasStamina then
          Exit(EZMIState.CONSUME_STAM);
      end else if Self.ShouldWithdrawStamina then
        Exit(EZMIState.WITHDRAW_STAM);
    end;

    if Inventory.ContainsRandomItems(Self.InventoryItems) and (Self.DepositFails < 2) then
      Exit(EZMIState.DEPOSIT_RANDOM_ITEMS);

    if Inventory.IsFull then
      if Self.PouchEssence < Self.MaxEssence then
        Exit(EZMIState.FILL_POUCH)
      else
        Exit(EZMIState.CLOSE_BANK);

    Exit(EZMIState.WITHDRAW_ESS);
  end;

  if Self.IsBankPaymentBoxOpen then
    Exit(EZMIState.MAKE_BANK_PAYMENT);

  if Self.FindFenkenstrainGroundColors or Self.FindWaterbirthSeaColors then
    Exit(EZMIState.TELEPORT_OURANIA);

  PlayerPos := Self.RSW.GetMyPos;

  if PlayerPos in BANK_AREA then begin
    if RunePouch.IsOpen then
      if Self.PaymentRunesInPouch and (Self.BankPaymentCount < 2000) then
        Exit(EZMIState.STORE_BANK_PAYMENT)
      else
        Exit(EZMIState.CLOSE_RUNE_POUCH);

    if Self.ShouldRepairEarly or Self.IsPouchDegraded then
      Exit(EZMIState.REPAIR_POUCH);

    if (not Inventory.IsFull) or (not Inventory.ContainsItem(Self.Essence.Item)) then
      Exit(EZMIState.OPEN_BANK);
  end;

  if PlayerPos in ALTAR_AREA then begin
    if Inventory.ContainsItem(Self.Essence.Item) then
      Exit(EZMIState.CRAFT_RUNES)
    else if Self.PouchEssence > 0 then
      Exit(EZMIState.EMPTY_POUCH)
    else
      Exit(EZMIState.TELEPORT_OURANIA);
  end;

  if PlayerPos in LOWER_MAP then
    Exit(EZMIState.CRAFT_RUNES);

  if PlayerPos in UPPER_MAP then begin
    if (PlayerPos.X > 5300) or (PlayerPos.Y > 3550) then
      Exit(EZMIState.TELEPORT_OURANIA)
    else if Minimap.GetPrayerPercent < 90 then
      Exit(EZMIState.PRAY_ALTAR)
    else
      Exit(EZMIState.CLIMB_DOWN_LADDER);
  end;

  Exit(EZMIState.UNKNOWN);
end;

procedure TZMIBot.RunZMICrafter();
var
  AntibanStates : array of EZMIState :=
    [ EZMIState.CLOSE_BANK,
      EZMIState.TELEPORT_OURANIA,
      EZMIState.PRAY_ALTAR,
      EZMIState.CLIMB_DOWN_LADDER
    ];

  RepeatedStateCount  : Int32;
  LastState           : EZMIState;
begin
  WriteLn('Starting ZMI Runecrafter!');

  Self.InitZMICrafter;
  Self.Runtime.Start;

  while Runtime.ElapsedTime < Self.MaxRuntime do begin
    if Self.InactivityTimer.IsFinished then
      TerminateScript('Terminating script due to inactivity.');

    if not GameClient.IsLoggedIn then begin
      Login.LoginPlayer(False);
      Continue;
    end;

    if XPBar.EarnedXP then
      Self.InactivityTimer.Restart;

    Self.State := Self.GetState;

    if Self.State = LastState then
      Inc(RepeatedStateCount)
    else
      RepeatedStateCount := 0;

    if Self.State = EZMIState.TELEPORT_OURANIA then
      if RepeatedStateCount >= 3 then
        TerminateScript('Stuck trying to teleport to ourania')
    else if RepeatedStateCount >= 8 then
      Self.State := EZMIState.TELEPORT_OURANIA;

    LastState := Self.State;

    Self.DebugLn('State: ' + ToStr(Self.State));

    case Self.State of
      EZMIState.OPEN_BANK:            Self.OpenBank;
      EZMIState.MAKE_BANK_PAYMENT:    Self.MakeBankPayment(Self.BankPayment);
      EZMIState.CLOSE_BANK:           Self.CloseBank;
      EZMIState.DEPOSIT_RUNES:        Self.DepositRunes;
      EZMIState.DEPOSIT_RANDOM_ITEMS: Self.DepositRandomItems;
      EZMIState.DEPOSIT_ALL:          Self.DepositAll;
      EZMIState.WITHDRAW_ESS:         Self.WithdrawEssence;
      EZMIState.FILL_POUCH:           Self.FillPouch;
      EZMIState.WITHDRAW_STAM:        Self.WithdrawStamina;
      EZMIState.CONSUME_STAM:         Self.ConsumeStamina;
      EZMIState.WITHDRAW_FOOD:        Self.WithdrawFood;
      EZMIState.CONSUME_FOOD:         Self.ConsumeFood;
      EZMIState.CRAFT_RUNES:          Self.CraftRunes;
      EZMIState.EMPTY_POUCH:          Self.EmptyPouch;
      EZMIState.TELEPORT_OURANIA:     Self.TeleportOurania;
      EZMIState.PRAY_ALTAR:           Self.PrayAltar;
      EZMIState.CLIMB_DOWN_LADDER:    Self.ClimbDownLadder;
      EZMIState.REPAIR_POUCH:         Self.RepairPouch;
      EZMIState.WITHDRAW_BANK_PAYMENT:Self.WithdrawBankPayment;
      EZMIState.OPEN_RUNE_POUCH:      RunePouch.Open;
      EZMIState.CLOSE_RUNE_POUCH:     RunePouch.ClickCloseButton;
      EZMIState.STORE_BANK_PAYMENT:   Self.StoreBankPayment;
    end;

    if Self.State in AntibanStates then begin
      Self.Runtime.Pause;
      if Antiban.DoAntiban then
        Self.InactivityTimer.Restart;
      Self.Runtime.Resume;
    end;
  end;

end;

procedure TZMIBot.RunDaeyaltMiner();
var
  TPA             : TPointArray;
  ATPA            : T2DPointArray;
  I,
  StartingShards,
  Mined           : Int32;
  MouseTimeout    : TCountdown;
  Runtime         : TStopWatch;

begin
  WriteLn('Starting Daeyalt Miner!');
  if not GameClient.IsLoggedIn then
    Login.LoginPlayer(False);
  Options.SetZoomLevel(0);

  Runtime.Start;
  StartingShards := Inventory.CountItemStack('Daeyalt shard');

  while Runtime.ElapsedTime < Self.MaxRuntime do begin
    Runtime.Pause;
    Antiban.DoAntiban;
    Runtime.Resume;

    if not GameClient.IsLoggedIn then begin
      Login.LoginPlayer(False);
      Continue;
    end;

    if SRL.FindColors(TPA, CTS2(4999690, 11, 0.05, 2.31), MainScreen.Bounds) = 0 then begin
      Antiban.RandomRotate;
      Continue;
    end;

    ATPA := TPA.Cluster(MainScreen.NormalizeDistance(42));
    ATPA := ATPA.SortFrom(MainScreen.Center);

    for I := High(ATPA) downto 0 do begin
      TPA := ATPA[I].Erode(MainScreen.NormalizeDistance(8));
      if SRL.GetPixelShift(TPA.Bounds, 300) > MainScreen.NormalizeDistance(50) then begin
        MouseTimeout.Init(ONE_SECOND);
        repeat
          if MouseTimeout.IsFinished then
            Continue(2);
          Mouse.Move(TPA.RandomValue);
        until MainScreen.IsUpText('Mine');

        Mouse.Click(MOUSE_LEFT);
        if MainScreen.DidYellowClick then begin
          Mouse.Click(MainScreen.GetPlayerBox, MOUSE_LEFT);
          Wait(Random(1, 5) * ONE_SECOND);
          Continue;
        end;
        WaitUntil(Minimap.IsPlayerMoving, Self.WaitUntilInterval, 1100);
        while Minimap.IsPlayerMoving do
          Wait(25, 99);
        Wait(900);
        if SRL.Dice(76) then
          Antiban.LoseFocus;

        repeat until not WaitUntil(XPBar.EarnedXP, 487, Random(3, 5) * ONE_SECOND);
        if SRL.Dice(3) then
          Wait(100, ONE_MINUTE);
        ClearDebug;
        Mined := Inventory.CountItemStack('Daeyalt shard') - StartingShards;
        WriteLn('~~~~Daeyalt Essence Miner~~~~');
        WriteLn('Runtime       : ' + SRL.MsToTime(Runtime.ElapsedTime, Time_Short));
        WriteLn('Essence mined : ' + ToStr(Mined));
        WriteLn('Essence/H     : ' + ToStr(NumberPerHour(Mined, Runtime.ElapsedTime)));
        Continue(2);
      end;
    end;
    Antiban.RandomRotate;
  end;
end;

{$IFNDEF SCRIPT_CHAIN}
var
  ZMIGUI: TScriptForm;

procedure TScriptForm.SetupRuntimeSettings();
var
  BreakType         : TButton;
  BreakAfter        : TEdit;
  BreakFor          : TEdit;
  BreakRandom       : TEdit;
  SleepAt           : TEdit;
  SleepFor          : TEdit;
  SleepRandom       : TEdit;
  MaxRuntime        : TEdit;
begin

  BreakType := Self.Form.GetChild('break_type');
  if BreakType.getCaption = 'Custom break settings' then begin
    BreakAfter := Self.Form.GetChild('break_after_edit');
    BreakFor := Self.Form.GetChild('break_for_edit');
    BreakRandom := Self.Form.getChild('break_random_edit');

    if (StrToInt(BreakRandom.GetText) < 0) or (StrToInt(BreakRandom.GetText) > 10) then
      TerminateScript('Break random must be between 0 and 10. 0 being no randomization, 10 being max randomization.');

    Antiban.AddBreak(StrToInt(BreakAfter.GetText) * ONE_MINUTE,
                     StrToInt(BreakFor.GetText) * ONE_MINUTE,
                     StrToInt(BreakRandom.GetText) / 10,
                     0.7);
  end else if BreakType.getCaption = 'Default WL breaks' then begin
    //Antiban.AddBreak(30  * ONE_MINUTE, 2  * ONE_MINUTE, 0.33, 0.4);
    //Antiban.AddBreak(45  * ONE_MINUTE, 4  * ONE_MINUTE, 0.33, 0.15);
    //Antiban.AddBreak(60  * ONE_MINUTE, 3 * ONE_MINUTE, 0.33, 0.2 + BioHash);
    //Antiban.AddBreak(120 * ONE_MINUTE, 3 * ONE_MINUTE, 0.33, 0.5 + BioHash);
    Antiban.SetupBreaks;
  end;

  SleepAt := Self.Form.GetChild('sleep_at_edit');
  SleepFor := Self.Form.GetChild('sleep_for_edit');
  SleepRandom := Self.Form.GetChild('sleep_random_edit');
  if (StrToInt(SleepRandom.GetText) < 0) or (StrToInt(SleepRandom.GetText) > 10) then
      TerminateScript('Sleep random must be between 0 and 10. 0 being no randomization, 10 being max randomization.');

  Antiban.AddSleep(SleepAt.GetText,
                   StrToInt(SleepFor.GetText) * ONE_HOUR,
                   StrToInt(SleepRandom.GetText) / 10,
                   1);

  MaxRuntime := Self.Form.GetChild('max_runtime_edit');
  ZMIBot.MaxRuntime := StrToInt(MaxRuntime.GetText) * ONE_MINUTE;
end;

procedure TScriptForm.StartZMICrafter({$H-}sender: TObject);{$H+}
var
  UseDepositAll     : TCheckBox;
  Essence           : TComboBox;
  EnergyRestore     : TComboBox;
  BankPaymentMethod : TComboBox;
  Food              : TEdit;
  WorldSelection    : TComboBox;
begin
  Self.SetupRuntimeSettings;

  UseDepositAll := Self.Form.GetChild('use_deposit_all_checkbox');
  Essence := Self.Form.GetChild('essence_combobox');
  EnergyRestore := Self.Form.GetChild('energy_restore_combobox');
  BankPaymentMethod := Self.Form.GetChild('bank_payment_combobox');
  Food := Self.Form.GetChild('food_edit');
  WorldSelection := Self.Form.GetChild('world_selection_combobox');

  ZMIBot.UseDepositAll := UseDepositAll.IsChecked;
  ZMIBot.Essence := TBankItem.Setup(Essence.GetText, -1, False);
  ZMIBot.UseVV := EnergyRestore.getText = 'Vile vigour';
  ZMIBot.Food := TBankItem.Setup(Food.GetText, -1, False);
  ZMIBot.ScriptMode := EScriptMode.ZMI_CRAFTER;

  case BankPaymentMethod.GetText of
    'Air rune': ZMIBot.BankPayment := EZMIBankPayment.AIR;
    'Water rune': ZMIBot.BankPayment := EZMIBankPayment.WATER;
    'Earth rune': ZMIBot.BankPayment := EZMIBankPayment.EARTH;
    'Fire rune': ZMIBot.BankPayment := EZMIBankPayment.FIRE;
    'Mind rune': ZMIBot.BankPayment := EZMIBankPayment.MIND;
    'Body rune': ZMIBot.BankPayment := EZMIBankPayment.BODY;
  end;

  if WorldSelection.getText <> 'Custom' then
    Login.Players[Login.PlayerIndex].Worlds := [WorldSelection.getText.ExtractNumber(480)];


  TScriptForm.Form.SetOnClose(nil);
  TScriptForm.Form.Close();
end;

procedure TScriptForm.StartDaeyaltMiner({$H-}sender: TObject);{$H+}

begin
  Self.SetupRuntimeSettings;
  ZMIBot.ScriptMode := EScriptMode.DAEYALT_MINER;
  TScriptForm.Form.SetOnClose(nil);
  TScriptForm.Form.Close();
end;

function TScriptForm.CreateZMISettingsTab(): TTabSheet;
type TScriptForm = TScriptForm;
const
  LEFT_FONT_COLOR : Int32 := 0;
  RIGHT_FONT_COLOR : Int32 := 0;
var
  ZMISettingsLabel  : TLabel;
  RuntimeSettings   : TLabel;
  UseDepositAll     : TLabeledCheckBox;
  BreakAfter        : TLabeledEdit;
  BreakFor          : TLabeledEdit;
  BreakRandom       : TLabeledEdit;
  BreakType         : TButton;
  SleepAt           : TLabeledEdit;
  SleepFor          : TLabeledEdit;
  SleepRandom       : TLabeledEdit;
  MaxRuntime        : TLabeledEdit;
  Essence           : TLabeledComboBox;
  EnergyRestore     : TLabeledComboBox;
  BankPaymentMethod : TLabeledComboBox;
  WorldSelection    : TLabeledComboBox;
  Food              : TLabeledEdit;

  procedure TScriptForm.OnBreakTypeClick({$H-}sender: TObject);{$H+}
  var
    Button : TButton;
  begin
    Button := Self.Form.GetChild('break_type');
    if Button.getCaption = 'Custom break settings' then
      Button.setCaption('Default WL breaks')
    else if Button.getCaption = 'Breaks disabled' then
      Button.setCaption('Custom break settings')
    else
      Button.setCaption('Breaks disabled');

    TEdit(Self.Form.GetChild('break_after_panel')).setVisible(Button.getCaption = 'Custom break settings');
    TEdit(Self.Form.GetChild('break_for_panel')).setVisible(Button.getCaption = 'Custom break settings');
    TEdit(Self.Form.GetChild('break_random_panel')).setVisible( Button.getCaption = 'Custom break settings');
  end;

begin
  Result.Init(nil);
  Result.SetCaption('Script settings');
  Result.SetName('settings_tab');

  ZMISettingsLabel.Create(Result);
  ZMISettingsLabel.SetLeft(TControl.AdjustToDPI(30));
  ZMISettingsLabel.SetTop(TControl.AdjustToDPI(10));
  ZMISettingsLabel.GetFont().SetSize(15);
  ZMISettingsLabel.SetCaption('ZMI Settings');
  ZMISettingsLabel.SetFontColor(LEFT_FONT_COLOR);


  RuntimeSettings.Create(Result);
  RuntimeSettings.SetLeft(TControl.AdjustToDPI(540));
  RuntimeSettings.SetTop(TControl.AdjustToDPI(10));
  RuntimeSettings.GetFont().SetSize(15);
  RuntimeSettings.SetCaption('Runtime Settings');
  RuntimeSettings.SetFontColor(RIGHT_FONT_COLOR);

  BreakType.Create(Result);
  BreakType.setWidth(140);
  BreakType.SetLeft(TControl.AdjustToDPI(555));
  BreakType.SetTop(TControl.AdjustToDPI(40));
  BreakType.SetName('break_type');
  BreakType.SetCaption(C_BREAK_TYPE);
  BreakType.setOnClick(@Self.OnBreakTypeClick);

  BreakAfter.Create(Result);
  BreakAfter.SetCaption('Break after');
  BreakAfter.SetWidth(80);
  BreakAfter.SetLeft(TControl.AdjustToDPI(545));
  BreakAfter.SetTop(TControl.AdjustToDPI(70));
  BreakAfter.SetHint('Take breaks after x minutes.');
  BreakAfter.SetText(ToStr(C_BREAK_AFTER));
  BreakAfter.Caption.SetFontColor(RIGHT_FONT_COLOR);
  BreakAfter.SetName('break_after');
  BreakAfter.SetVisible(C_CUSTOM_BREAKS);

  BreakFor.Create(Result);
