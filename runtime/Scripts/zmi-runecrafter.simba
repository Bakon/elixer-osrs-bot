  SleepAt.Create(Result);
  SleepAt.SetCaption('Sleep at');
  SleepAt.SetWidth(80);
  SleepAt.SetLeft(TControl.AdjustToDPI(545));
  SleepAt.SetTop(TControl.AdjustToDPI(170));
  SleepAt.SetHint('Take sleep at xx:xx:xx time (24hr format).');
  SleepAt.SetText(C_SLEEP_AT);
  SleepAt.Caption.SetFontColor(RIGHT_FONT_COLOR);
  //SleepAt.Caption.GetFont.SetStyle([fsBold]);
  SleepAt.SetName('sleep_at');

  SleepFor.Create(Result);
  SleepFor.SetCaption('Sleep for');
  SleepFor.SetWidth(80);
  SleepFor.SetLeft(TControl.AdjustToDPI(630));
  SleepFor.SetTop(TControl.AdjustToDPI(170));
  SleepFor.SetHint('Take sleep for x hours.');
  SleepFor.SetText(ToStr(C_SLEEP_FOR));
  SleepFor.Caption.SetFontColor(RIGHT_FONT_COLOR);
  //SleepFor.Caption.GetFont.SetStyle([fsBold]);
  SleepFor.SetName('sleep_for');

  SleepRandom.Create(Result);
  SleepRandom.SetCaption('Sleep random');
  SleepRandom.SetWidth(80);
  SleepRandom.SetLeft(TControl.AdjustToDPI(585));
  SleepRandom.SetTop(TControl.AdjustToDPI(210));
  SleepRandom.SetHint('0-10. 0 being no randomization, 10 being the most random');
  SleepRandom.SetText(ToStr(C_SLEEP_RANDOM));
  SleepRandom.Caption.SetFontColor(RIGHT_FONT_COLOR);
  //SleepRandom.Caption.GetFont.SetStyle([fsBold]);
  SleepRandom.SetName('sleep_random');

  MaxRuntime.Create(Result);
