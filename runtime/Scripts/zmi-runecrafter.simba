  MaxRuntime.SetText(ToStr(C_MAX_RUNTIME));
  MaxRuntime.Caption.SetFontColor(RIGHT_FONT_COLOR);
  //MaxRuntime.Caption.GetFont.SetStyle([fsBold]);
