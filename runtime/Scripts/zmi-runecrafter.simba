  BreakFor.SetVisible(C_CUSTOM_BREAKS);

  BreakRandom.Create(Result);
  BreakRandom.SetCaption('Break random');
  BreakRandom.SetWidth(80);
  BreakRandom.SetLeft(TControl.AdjustToDPI(585));
  BreakRandom.SetTop(TControl.AdjustToDPI(110));
  BreakRandom.SetHint('0-10. 0 being no randomization, 10 being the most random');
  BreakRandom.SetText(ToStr(C_BREAK_RANDOM));
  BreakRandom.Caption.SetFontColor(RIGHT_FONT_COLOR);
  //BreakRandom.Caption.GetFont.SetStyle([fsBold]);
  BreakRandom.SetName('break_random');
