  BreakFor.SetWidth(80);
  BreakFor.SetLeft(TControl.AdjustToDPI(630));
  BreakFor.SetTop(TControl.AdjustToDPI(70));
  BreakFor.SetHint('Take breaks for x minutes.');
  BreakFor.SetText(ToStr(C_BREAK_FOR));
  BreakFor.Caption.SetFontColor(RIGHT_FONT_COLOR);
  //BreakFor.Caption.GetFont.SetStyle([fsBold]);
