  Essence.Caption.SetFontColor(LEFT_FONT_COLOR);
  //Essence.Caption.GetFont.SetStyle([fsBold]);
  Essence.SetName('essence');
  Essence.ComboBox.setReadOnly(True);

  EnergyRestore.Create(Result);
  EnergyRestore.SetCaption('Energy restore method');
  EnergyRestore.SetLeft(TControl.AdjustToDPI(30));
  EnergyRestore.SetTop(TControl.AdjustToDPI(140));
  EnergyRestore.SetHint('Restore energy with Stamina potion(1) or Vile vigour spell.');
  EnergyRestore.AddItemArray(['Vile vigour', 'Stamina potion(1)']);
  EnergyRestore.SetText(C_ENERGY_RESTORE);
  EnergyRestore.Caption.SetFontColor(LEFT_FONT_COLOR);
  //EnergyRestore.Caption.GetFont.SetStyle([fsBold]);
  EnergyRestore.SetName('energy_restore');
  EnergyRestore.ComboBox.setReadOnly(True);

  BankPaymentMethod.Create(Result);
  BankPaymentMethod.SetCaption('Bank payment method');
  BankPaymentMethod.SetLeft(TControl.AdjustToDPI(30));
  BankPaymentMethod.SetTop(TControl.AdjustToDPI(95));
  BankPaymentMethod.SetHint('Type of rune to use as a payment for banking with Eniola.');
  BankPaymentMethod.AddItemArray(['Air rune', 'Water rune', 'Earth rune', 'Fire rune']);
  BankPaymentMethod.AddItemArray(['Mind rune', 'Body rune']);
  BankPaymentMethod.SetText(C_BANK_PAYMENT);
  BankPaymentMethod.Caption.SetFontColor(LEFT_FONT_COLOR);
  //BankPaymentMethod.Caption.GetFont.SetStyle([fsBold]);
  BankPaymentMethod.SetName('bank_payment');
  BankPaymentMethod.ComboBox.setReadOnly(True);

  Food.Create(Result);
  Food.SetCaption('Food');
  Food.SetLeft(TControl.AdjustToDPI(30));
  Food.SetTop(TControl.AdjustToDPI(185));
  Food.SetHint('Food to consume when health is low.');
  Food.SetText(C_FOOD);
  Food.Caption.SetFontColor(LEFT_FONT_COLOR);
  //Food.Caption.GetFont.SetStyle([fsBold]);
  Food.SetName('food');

  UseDepositAll.Create(Result);
  UseDepositAll.SetCaption('Use deposit all.');
  UseDepositAll.SetLeft(TControl.AdjustToDPI(30));
  UseDepositAll.SetTop(TControl.AdjustToDPI(285));
  UseDepositAll.SetHint('Use deposit all when banking. Requires proper placeholder setup.');
  UseDepositAll.Caption.SetFontColor(LEFT_FONT_COLOR);
  //UseDepositAll.Caption.GetFont.SetStyle([fsBold]);
  UseDepositAll.SetName('use_deposit_all');
  UseDepositAll.CheckBox.SetChecked(C_USE_DEPOSIT_ALL);

  WorldSelection.Create(Result);
  WorldSelection.SetCaption('World selection');
  WorldSelection.SetLeft(TControl.AdjustToDPI(30));
  WorldSelection.SetTop(TControl.AdjustToDPI(230));
  WorldSelection.SetHint('Choose a world to use');
  WorldSelection.AddItemArray(['US East (480)', 'German (327)', 'Custom']);
  WorldSelection.SetText(C_WORLD_SELECTION);
  WorldSelection.Caption.SetFontColor(LEFT_FONT_COLOR);
  //WorldSelection.Caption.GetFont.SetStyle([fsBold]);
  WorldSelection.SetName('world_selection');
  WorldSelection.ComboBox.setReadOnly(True);
end;

procedure TScriptForm.Setup(caption: String = 'Script Form'; size: TPoint = [750, 500]; allowResize: Boolean = False); override;
var
  ZMITab : TTabSheet;
  StartZMIButton      : TButton;
  StartDaeyaltButton  : TButton;

begin
  inherited;

  Self.Start.setVisible(False);

  StartZMIButton.Create(Self.Form);
  StartZMIButton.SetBounds(Self.Form.GetRight - 205, Self.Form.GetBottom - 100, 180, 40);
  StartZMIButton.GetFont.SetName('Bahnschrift');
  StartZMIButton.GetFont.SetSize(12);
  StartZMIButton.SetCaption('Start ZMI Crafter');
  StartZMIButton.SetOnClick(@Self.StartZMICrafter);

  StartDaeyaltButton.Create(Self.Form);
  StartDaeyaltButton.SetBounds(Self.Form.GetRight - 205, Self.Form.GetBottom - 50, 180, 40);
  StartDaeyaltButton.GetFont.SetName('Bahnschrift');
  StartDaeyaltButton.GetFont.SetSize(12);
  StartDaeyaltButton.SetCaption('Start Daeyalt Miner');
  StartDaeyaltButton.SetOnClick(@Self.StartDaeyaltMiner);

  ZMITab := Self.CreateZMISettingsTab;
  Self.AddTab(ZMITab);
  Self.CreateVersionPanel(ZMITab);
  Self.CreateAccountManager();
end;

begin
  //WaspClient.CheckSubscription(True);
  SettingsHandler.CheckGPUPlugin();

  if (not DirectoryExists(AppPath + '\Resources\')) then
    CreateDirectory(AppPath+'\Resources');

  ZMIGUI.Setup('ZMI Runecrafter and Daeyalt Essence Miner');
  ZMIGUI.Run;

  {$IFNDEF SRL_DISABLE_REMOTEINPUT}
  if WLSettings.GetObject('remote_input').getBoolean('enabled', True) and (not GameClient.RemoteInput.IsSetup()) then GameClient.RemoteInput.Setup();
  {$ENDIF}

  case ZMIBot.ScriptMode of
    EScriptMode.ZMI_CRAFTER :   ZMIBot.RunZMICrafter;
    EScriptMode.DAEYALT_MINER : ZMIBot.RunDaeyaltMiner;
  end;

end.
{$ENDIF}
