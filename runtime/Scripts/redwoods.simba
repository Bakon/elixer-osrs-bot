        Wait(300,500);
        if (MyPos := Bot.RSW.GetMyPos()).InBox([1334, 2082, 2222, 2784]) then
          Break;

        if (attempts >=4) then
          TerminateScript('Something went wrong on teleporting');
      end;
    end;

    Bot.RSW.WalkBlind([1572,2510]);
  end;

  'Xerics talisman (CHARGED)':
  begin
    for attempts := 0 to 4 do
    begin
      Bot.transport.run(rsteleports.XERICS_LOOKOUT);
      WaitUntil((MyPos := Bot.RSW.GetMyPos()).InBox([1334, 2082, 2222, 2784]), 115, 10000);

      if (MyPos := Bot.RSW.GetMyPos()).InBox([1334, 2082, 2222, 2784]) then
        Break;

      if (attempts >=4) then
        TerminateScript('Something went wrong on teleporting');
    end;

    Bot.WriteMsg('Walking to nearby web');
    Bot.RSW.WalkBlind([1600,2340]);
  end;
  end;

  Wait(500,750);

  Bot.WriteMsg('Walking to entrance of the WC Guild');
  if (not Bot.RSW.AtTile([1634,2512], 12)) then
    Bot.RSW.WebWalk([1634,2512]);

  Bot.WriteMsg('Attempting to click the gate');
  for attempts := 0 to 8 do
  begin
    if Bot.GateObj.Click(True, 5) then
      WaitUntil((MyPos := Bot.RSW.GetMyPos()).InBox([1644, 2429, 1920, 2589]), 115, 12500);

    if (MyPos := Bot.RSW.GetMyPos()).InBox([1644, 2429, 1920, 2589]) then
      Break;

    if (attempts >=8) then
      TerminateScript('Something went wrong on entering the gate');
  end;

  Bot.WriteMsg('Walking to Bank');
  Bot.RSW.WebWalk([1752,2532]);

  if Inventory.ContainsItem('Coin pouch') then
  begin
    Inventory.ClickItem('Coin pouch', 'Open-all');
    WaitUntil(Inventory.ContainsItem('Coins'), 115, 5000);
  end;

  bankTimeout.Init(85000);

  while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
  begin
    Bank.WalkOpen(Bot.BankObj);
  end;

  WaitUntil(Bank.IsOpen(), 115, 12500);

  Bank.DepositRandomItems(['Open log basket', '28142', 'Log basket', 'Crystal axe', 'Crystal felling axe',
                           'Dragon axe', 'Dragon axe (or)', 'Dragon felling axe', 'Infernal axe',
                           'Rune felling axe', 'Adamant felling axe', 'Mithril felling axe', 'Black felling axe', 'Steel felling axe',
                           'Rune axe', 'Adamant axe', 'Mithril axe', 'Black axe', 'Steel axe',
                           'Rune pouch', 'Divine rune pouch', 'Forester''s ration']);

  if Bot.DoAlch and (not Bot.RunesDetected) then
  begin
    case FarmRunner.RPouchMethod of
    'Not using/use runes':
    begin
      Bot.WithdrawHelper('Nature rune', 1000);
      if not Bot.InfiniteFire then
        Bot.WithdrawHelper('Fire rune', 5000);
    end;

    'Rune pouch':
    begin
      Bot.WithdrawHelper('Rune pouch', 1);
    end;

    'Divine rune pouch':
    begin
      Bot.WithdrawHelper('Divine rune pouch', 1);
    end;
    end;
  end;

  if Bot.DoAlch and Bot.RunesDetected then
  begin
    Bot.WithdrawHelper('Nature rune', 1000);
    if not Bot.InfiniteFire then
      Bot.WithdrawHelper('Fire rune', 5000);
  end;

  if Bot.DoFletch then
    Bot.WithdrawHelper(Bot.OurKnife, 1);

  Bank.Close(True);

  for I := 0 to High(Antiban.tasks) do
  Antiban.Tasks[I].Countdown.Resume;
end;

function TScript.worldIsFree(): Boolean;
var
  playerPoints: TPointArray := Minimap.GetDots(EMinimapDot.PLAYER);
begin
  FilterPointsDist(playerPoints, 0, 8, Minimap.Center.X, Minimap.Center.Y);
  Result := Length(playerPoints) <= 1;
end;

function TScript.playerCrashDetected(): Boolean;
var
  MyPos: TPoint;
begin
  MyPos := Self.RSW.GetMyPos();
  if not self.worldIsFree() then
    playerNearbyCountdown.Resume()
  else
  begin
    if not playerNearbyCountdown.IsFinished() and not playerNearbyCountdown.IsPaused() then
      WriteLn 'Player left before we were crashed';
    playerNearbyCountdown.Restart();
    playerNearbyCountdown.Pause();
    Exit(False);
  end;

  WriteLn 'Player nearby. Will hop in ' + ToString(playerNearbyCountdown.TimeRemaining()) + 'ms if they remain';
  if playerNearbyCountdown.IsFinished then
    Exit(True);
end;

procedure TScript.DoLoseFocus();
Var T: Int32;
begin
  T := SRL.NormalRange(1700,8000);
  Antiban.DebugLn('Losing focus for '+SRL.MsToTime(T, Time_Short));
  Antiban.LoseFocus(T);
end;

procedure TScript.SetupAntiban();
begin
  Antiban.AddTask((ONE_MINUTE*1)*Self.ABTimeMod,  @Mouse.RandomMovement);
  Antiban.AddTask((ONE_MINUTE*4)*Self.ABTimeMod,  @Self.DoLoseFocus);
end;

function TScript.HandleWalking(Destination: String; Force:Boolean=False): Boolean;
begin
  case Destination of
  'Bank':
    if Inventory.IsFull() and not Self.RSW.AtTile(Self.BankTile, 8) or Force then
    begin
      if (Self.BankObj.IsVisible) then
        Result := Bank.WalkOpen(BankObj)
        else
        Result := Self.RSW.WalkBlind(Self.BankTile);
    end;
  end;
end;

procedure TScript.Report();
begin
  WriteLn('|==============================|');
  WriteLn('|-------- ~ Redwoods ~ --------|');
  WriteLn('|==============================|');
  WriteLn(padR('| Runtime: ' + SRL.MsToTime(GetTimeRunning, Time_Short), 31, ' ') + '|');
  WriteLn(padR('| Chopped: ' + IntToStr(Round(LogCount)), 31, ' ') + '|');
  WriteLn(padR('| Chopped/Hr: ' + IntToStr(Round(LogCount / (GetTimeRunning() / 3600000))), 31, ' ') + '|');
  Writeln(padR('| WC XP Gained: ' + IntToStr(Round(LogCount *(Self.ExpAmount))), 31, ' ') + '|');
  WriteLn(padR('| WC XP/Hr: ' + IntToStr(Round((LogCount *(Self.ExpAmount)) / (GetTimeRunning() / 3600000))), 31, ' ') + '|');
  if Self.DoFletch then
  begin
    Case Self.FletchFor of
    '105 arrow shafts':
    begin
      Writeln(padR('| Fletch XP Gained: ' + IntToStr(Round(LogCount *(35))), 31, ' ') + '|');
      WriteLn(padR('| Fletch XP/Hr: ' + IntToStr(Round((LogCount *(35)) / (GetTimeRunning() / 3600000))), 31, ' ') + '|');
    end;

    'Redwood shield':
    begin
      Writeln(padR('| Fletch XP Gained: ' + IntToStr(Round(ShieldCount *(216))), 31, ' ') + '|');
      WriteLn(padR('| Fletch XP/Hr: ' + IntToStr(Round((ShieldCount *(216)) / (GetTimeRunning() / 3600000))), 31, ' ') + '|');
    end;

    'Redwood hiking staff':
    begin
      Writeln(padR('| Fletch XP Gained: ' + IntToStr(Round(StaffCount *(10.5))), 31, ' ') + '|');
      WriteLn(padR('| Fletch XP/Hr: ' + IntToStr(Round((StaffCount *(10.5)) / (GetTimeRunning() / 3600000))), 31, ' ') + '|');
    end;
    end;
  end;
  if self.DoAlch then
  begin
      Writeln(padR('| Magic XP Gained: ' + IntToStr(Round(ShieldCount *(65))), 31, ' ') + '|');
      WriteLn(padR('| Magic XP/Hr: ' + IntToStr(Round((ShieldCount *(65)) / (GetTimeRunning() / 3600000))), 31, ' ') + '|');
  end;
  if Self.TakeBreaks then
    WriteLn(padR('| Next break: ' + SRL.MsToTime(Max(0, Round(Antiban.Breaks[0].NextAtTime - GetTimeRunning)), Time_Short), 31, ' ') + '|');
  if Self.TakeSleeps then
    WriteLn(padR('| Next sleep: ' + SRL.MsToTime(Max(0, Round(Antiban.Sleeps[0].NextAtTime - GetTimeRunning)), Time_Short), 31, ' ') + '|');
  if self.DoBHRuns then
    WriteLn(padR('| Next BH run: ' + SRL.MsToTime(BirdHouseRunner.ScriptIntervalTimer.TimeRemaining(), TTimeFormat.Time_Short), 31, ' ') + '|');
  if self.DoFarmRuns then
    WriteLn(padR('| Next farm run: ' + SRL.MsToTime(FarmRunner.ReadyTimer.TimeRemaining(), TTimeFormat.Time_Short), 31, ' ') + '|');
  WriteLn(padR('| Shutdown: ' + ToStr(SRL.MsToTime(Self.ShutdownTime - GetTimeRunning, Time_Short)), 31, ' ') + '|');
  WriteLn('|==============================|');

  if Self.UsingFellingAxe then
    Writeln('NOTE: XP when using a Felling Axe is an estimate');
end;

procedure TScript.WalkToSpot();
begin
  Minimap.RotateWithinAngles(25,120);
  RSW.WalkBlind(Self.LadderUpTile);
end;

procedure TScript.HandleLadderUp();
begin
  if not LadderUpObj.WalkClick(True, 10) then
    Exit;

  WaitUntil((Minimap.PercentBlack > 33), 315, 15000);
end;

procedure TScript.HandleLadderDown();
begin
  if (not (Minimap.PercentBlack > 25)) then
    Exit;

  Minimap.RotateWithinAngles(25,120);
  if not LadderDownObj.WalkClick(True, 10) then
     Exit;

  WaitUntil(not (Minimap.PercentBlack > 25), 315, 15000);

  if (not (Minimap.PercentBlack > 25))  then
    Self.RSW.WalkBlind(Self.BankTile);
end;

procedure TScript.ChoppingTree();
begin
  Self.ChopTimer.Init(SRL.SkewedRand(27500,22500,32500));

  if WrongFloorObj.IsVisible() then
  begin
    CarvedRedwoodObj.Click(True,5);
    WaitUntil(not WrongFloorObj.IsVisible(), 115, 7500);
    Wait(2000,2650);
  end;

  if Self.SpecTimer.IsFinished() then
  begin
    Minimap.EnableSpec(100);
    Self.SpecTimer.Restart(Random(10*ONE_SECOND, 20*ONE_SECOND));
  end;

  RedwoodTreeObj.Click(True,5);

  repeat
  if XPBar.EarnedXP then
    Self.ChopTimer.Restart
  until(Self.ChopTimer.IsFinished);
end;

procedure TScript.HandleInventoryState();
var
  ShieldsInInvy,
  StavesInInvy  : Int32;
begin
  if Self.UsingFellingAxe then
    Self.LogCount += (Inventory.CountItem('Redwood logs')*1.20)
  else
    Self.LogCount += Inventory.CountItem('Redwood logs');

  if Self.DoFletch then
  begin
    if Inventory.ContainsItem('Knife') then
      Inventory.Use('Knife', 'Redwood logs')
    else
      Inventory.Use('Fletching knife', 'Redwood logs');

    WaitUntil(Make.IsOpen(), 115, 5000);
    if Make.IsOpen() then
    begin
      Make.Select(Self.FletchFor, Make.QUANTITY_ALL, true);
      WaitUntil(not (Make.IsOpen()), 115, 5000);
    end;

    if Self.FletchFor.ContainsAny(['shield']) then
      WaitUntil((Inventory.CountItem('Redwood logs') < 2), 115, 60000)
    else
      WaitUntil((Inventory.CountItem('Redwood logs') <= 0), 115, 60000);

    ShieldsInInvy := Inventory.CountItem('Redwood shield');
    Inc(Self.ShieldCount, ShieldsInInvy);

    StavesInInvy := Inventory.CountItem('Redwood hiking staff');
    Inc(Self.StaffCount, StavesInInvy);
  end;

  if Self.DoAlch then
  begin
    Magic.Open();

    if not Magic.CanActivate(ESpell.HIGH_LEVEL_ALCHEMY) then
    begin
      Self.DoAlch := False;
      Exit;
    end;

    for 0 to ShieldsInInvy do
    begin
      Magic.CastSpell(ESpell.HIGH_LEVEL_ALCHEMY);
      Inventory.MouseItem('Redwood shield');
      Mouse.Click(MOUSE_LEFT);
      WaitUntil(XPBar.EarnedXP, 115, 2500);
      Wait(250,500); // Gross flat wait but there were issues with lag in some situations
    end;
  end;

  if Self.DoBank then
  begin
    Self.HandleLadderDown;
  end else
  begin
    if SRL.Dice(50) then
    begin
      Inventory.ShiftDrop((['Redwood logs', 'Redwood shield', 'Yew logs', 'Magic logs']), DROP_PATTERN_REGULAR)
    end
    else
      Inventory.ShiftDrop((['Redwood logs', 'Redwood shield', 'Yew logs', 'Magic logs']), DROP_PATTERN_REGULAR_R);
  end;

  Self.ChopCycles += 1;
  ClearDebug();
  Self.Report();
end;

procedure TScript.HandleBank();
var
  attempt: Int32;
begin
  if (not (Bank.IsOpen())) then
    Self.HandleWalking('Bank');

  if (Self.BankObj.UpText.Len > 0) then
    Bank.Open(Self.BankObj)
  else
  begin
    for attempt := 1 to 3 do
    begin
      if Bank.WalkOpen() then
      Bank.IsOpen(15000);
      Break;
    end;
  end;

  if Self.UsingFellingAxe then begin
    if Inventory.ContainsItem('Open log basket') then begin
      Inventory.ClickItem('Open log basket', 'Empty');
      Self.LogCount += (28*1.2);
    end;
    Self.LogCount += (Inventory.CountItem('Redwood logs')*1.2)
  end else begin
    if Inventory.ContainsItem('Open log basket') then begin
      Inventory.ClickItem('Open log basket', 'Empty');
      Self.LogCount += 28;
    end;
    Self.LogCount += Inventory.CountItem('Redwood logs');
  end;


  Bank.DepositRandomItems(['Open log basket', '28142', 'Log basket', 'Steel axe', 'Adamant axe', 'Rune axe', 'Dragon axe', 'Dragon axe (or)', 'Dragon felling axe', 'Infernal axe',
                           'Rune felling axe', 'Adamant felling axe', 'Mithril felling axe', 'Black felling axe', 'Steel felling axe',
                           'Rune pouch', 'Divine rune pouch', 'Knife', 'Fletching knife', 'Nature rune', 'Fire rune', 'Crystal axe', 'Crystal felling axe']);
  Self.Report();

  Bank.Close();
  WaitUntil(not Bank.IsOpen(), 425, 3500);
end;

procedure TScript.EndScript
begin
  Logout.ClickLogout();
  TerminateScript('Time to shutdown');
end;

procedure TScript.DoAntiban();
begin
  Self.TrueRunTime.Pause();
  Antiban.DoAntiban();

  if (not GameClient.IsLoggedIn) then
    Login.LoginPlayer(False);

  if Self.DoFarmRuns and FarmRunner.ReadyTimer.IsFinished() then
  begin
    if (Minimap.PercentBlack > 25) then
    repeat
      Self.HandleLadderDown();
    until not (Minimap.PercentBlack > 25);

    FarmRunner.DoFarmRun;
  end;

  if Self.DoBHRuns and BirdHouseRunner.CanDoBirdHouseRun then
  begin
    if (Minimap.PercentBlack > 25) then
    repeat
      Self.HandleLadderDown();
    until not (Minimap.PercentBlack > 25);

    BirdHouseRunner.DoBirdHouseRun();
  end;

  Self.TrueRunTime.Resume();
  Self.ChopCycles := 0;
end;

procedure TScript.Init();
var
  z: Int32;
begin
  if (not GameClient.IsLoggedIn) then
    Login.LoginPlayer(False);

  Self.ExpAmount := 380;
  Stats.Setup();
  Stats.GetLevel(ESkill.AGILITY);

  if (GameClient.Mode <> EClientMode.FIXED) then
    TerminateScript("Client must be in fixed-classic");

  case Self.WCGuildTP of
  'Radas blessing 3+':
  begin
    KourendDiary := Achievements.GetDiaryLevel(EAchievementDiary.KOUREND_AND_KEBOS);
    KourendBless := "Rada's blessing " + ToStr(KourendDiary);
    Self.WriteMsg('Kourend diary ' + ToStr(KourendDiary));
    Self.WriteMsg("Radas " + ToStr(KourendBless));

    if (Self.KourendDiary < 3) then
      TerminateScript('Radas return method requires a radas blessing 3 or higher.');
  end;
  end;

  Self.IncludeEquipmentSetup();

  if Self.DragonAxeEquipped then
    Self.SpecTimer.Init(300*ONE_SECOND);

  if Self.DoBHRuns then
  begin
    BirdhouseRunner.Init();

    if Self.WCGuildTP.Contains('not doing') then
      TerminateScript('You must pick a return method in the GUI if you want to do farm or BH runs');
  end;

  //RSW.SetupRegions([wcguildBox, redwoodBox, wreckislandBox, boatyislandBox, digsiteBox, fossilziplineBox]);
  RSW.Setup('world');
  RSW.OnWalkingEvent := @RWOnWalkEvent;

  Self.Version            := 'Rev '+{$MACRO SCRIPT_REVISION};
  Mouse.Speed             := SRL.NormalRange(18, 21);
  Mouse.MissChance        := 3;
  Mouse.Distribution      := MOUSE_DISTRIBUTION_GAUSS;
  ItemFinder.Similarity   := 0.9999;
  Self.ChopCycles         := 0;
  Self.SetupAntiban();
  ABTimeMod               := Random(1,3);
  playerNearbyCountdown.Init(15000);

  z := Options.GetZoomLevel();
  if (not InRange(z, 0, 5)) then
    Options.SetZoomLevel(SRL.TruncatedGauss(0,5))
  else
    MM2MS.ZoomLevel := z;

  RSW.EnableRunAtEnergy      := 35;
  RSW.ScreenWalk             := True;

  Self.SlotsAvailable += Inventory.CountItems(['Redwood logs', 'Redwood shield', 'Redwood hiking staff']);
  Self.SlotsAvailable += Inventory.CountEmptySlots;

  if Self.FletchFor.ContainsAny(['hiking']) then
    Self.DoBank := True;

  BankTile  := [1752,2532];
  LadderUpTile := [1704,2472];

  GateObj.Setup(4, [[1642,2510], [1644,2510], [1646,2510], [1648,2510]]);
  GateObj.SetupUpText(['Open', 'Gate']);
  GateObj.Finder.Colors += CTS2(8554662, 42, 0.07, 0.42);

  BankObj.Setup(4, [[1760,2560]]);
  BankObj.SetupUpText(['Bank', 'chest']);
  BankObj.Finder.Colors += CTS2(2312798, 10, 0.12, 1.75);

  RedwoodTreeObj.Setup(4, [[1040,2944], [1040,2948], [1032,2938], [1028,2938]]);
  RedwoodTreeObj.SetupUpText(['Cut']);
  RedwoodTreeObj.Finder.Colors += CTS2(8554662, 42, 0.07, 0.42);

  WrongFloorObj.Setup(4,  [[1032,2968], [1032,2956], [1036,2956], [1030,2960], [1028,2958]]);
  WrongFloorObj.SetupUpText(['Walk-here']);
  WrongFloorObj.Finder.Colors += CTS2(2960701, 7, 2.66, 0.41);

  CarvedRedwoodObj.Setup(4, [[1030,2958]]);
  CarvedRedwoodObj.SetupUpText(['Enter']);
  CarvedRedwoodObj.Finder.Colors += CTS2(8554662, 42, 0.07, 0.42);

  LadderUpObj.Setup(4, [[1688,2490]]);
  LadderUpObj.SetupUpText(['Climb-up']);
  LadderUpObj.Finder.Colors += CTS2(4611946, 24, 0.06, 0.23);

  LadderDownObj.Setup(4, [[1048,2946]]);
  LadderDownObj.SetupUpText(['Climb-down']);
  LadderDownObj.Finder.Colors += CTS2(5336184, 17, 0.07, 0.22);

  Options.SetNPCAttackOption(EAttackOption.ALWAYS_RIGHT_CLICK);
  Combat.SetAutoRetaliate(False);

  if Self.DoBank and Self.DoFletch and not Self.FletchFor.ContainsAny(['hiking']) then
    TerminateScript('Script does not support bank AND fletch on at the same time unless doing staves. Either fletch + drop or bank the logs');

  if Self.DoFletch and not Inventory.ContainsAny(['Fletching knife', 'Knife']) then
    TerminateScript('If you choose fletching then you need to start the script with your knife in the inventory');

  if Inventory.ContainsItem('Fletching knife') then
    Self.OurKnife := 'Fletching knife'
  else
    Self.OurKnife := 'Knife';

  if Inventory.ContainsItem('Log basket') then
    Inventory.ClickItem('Log basket','Open');

  if Inventory.ContainsItem('Open log basket') then begin
    Inventory.MouseItem('Open log basket');
    Mouse.Hold(MOUSE_LEFT);
    Mouse.Move(Inventory.GetSlotBox((random(24,27))));
    Mouse.Release(MOUSE_LEFT);
    Wait(300,500);
  end;

  if Self.DoFarmRuns then
  begin
    if Self.WCGuildTP.Contains('not doing') then
      TerminateScript('You must pick a return method in the GUI if you want to do farm or BH runs');

    FarmRunner.Init();
  end;

  if (Self.DoFarmRuns and FarmRunner.ReadyTimer.IsFinished) or (Self.DoBHRuns and (BHIncludeGUIRunIntervalMinutes = 0)) then
    Self.DoAntiban();
end;

function TScript.GetState(): EState;
begin
  if not GameClient.IsLoggedIn() then
    Exit(EState.LOGIN_PLAYER);

  if ChatButtons.GetState(EChatButton.GAME_CHAT) <> EChatButtonState.ENABLED then
    Exit(EState.CHANGE_CHAT_FILTER);

  if not ChatButtons.IsActive(EChatButton.GAME_CHAT) then
    Exit(EState.OPEN_CHAT);

  if (Self.ChopCycles = Random(3,6)) then
    Exit(EState.DO_ANTIBAN);

  if (not (Minimap.PercentBlack > 25)) then
  begin
    if not (Self.RSW.AtTile(Self.LadderUpTile, 12)) and (not Inventory.ContainsAny(['Redwood logs', 'Redwood hiking staff'])) then
      Exit(EState.WALK_TO_SPOT);

    if (not Inventory.ContainsAny(['Redwood logs', 'Redwood hiking staff', 'Redwood shield'])) and (Self.RSW.AtTile(Self.LadderUpTile, 12)) then
      Exit(Estate.HANDLE_LADDER_UP);

    if Inventory.ContainsAny(['Redwood logs', 'Redwood hiking staff', 'Redwood shield']) then
      Exit(EState.HANDLE_BANK);
  end;

  if (Minimap.PercentBlack > 25) then
  begin
    if Self.playerCrashDetected() then
      Exit(EState.HOP);

    if not Inventory.IsFull() then
      Exit(EState.CHOP_TREE);

    Exit(EState.HANDLE_INVY);
  end;
end;

procedure TScript.Run();
begin
  while true do
  begin
    if (Self.ShutdownTime > 0) and (GetTimeRunning() > Self.ShutdownTime) then
      Self.EndScript();

    if (Self.Totallimit > 0) and (Self.LogCount >= Self.Totallimit) then
      Self.EndScript();

    Self.State := Self.GetState();
    case Self.State of
      EState.OPEN_CHAT: ChatButtons.Open(EChatButton.GAME_CHAT);
      EState.CHANGE_CHAT_FILTER: ChatButtons.ChangeState(EChatButton.GAME_CHAT, EChatButtonState.ENABLED);
      EState.LOGIN_PLAYER: if not Login.LoginPlayer(False) then Break;
      EState.HANDLE_BANK: Self.HandleBank();
      EState.HANDLE_LADDER_UP: Self.HandleLadderUp();
      EState.HANDLE_LADDER_DOWN: Self.HandleLadderDown();
      EState.HANDLE_INVY: Self.HandleInventoryState();
      EState.CHOP_TREE: Self.ChoppingTree();
      EState.DO_ANTIBAN: Self.DoAntiban();
      EState.WALK_TO_SPOT: Self.WalkToSpot();
      EState.HOP: WorldHopper.Hop(WorldArrayRandomizer(WorldList));
      EState.END_SCRIPT: Self.EndScript();
    end;
  end;
end;

begin
  //WaspClient.CheckSubscription(True);
  SettingsHandler.CheckGPUPlugin();

  if (not DirectoryExists(AppPath+'\Resources\')) then
    CreateDirectory(AppPath+'\Resources');

  if (not FileExists(AppPath+'\Resources\SSR2GUI.png')) then
    DownloadToFile('https://raw.githubusercontent.com/TwistedSlayerHelm/Images/refs/heads/main/gui/SSR2GUI.png', AppPath+'\Resources\SSR2GUI.png');

  if FileExists(AppPath+'\Configs/StudentsSettings') then
  SRConfig.Init();

  GUI.Setup('Redwoods', [750,466]);
  GUI.PageControl.SetAllChildsFontColor($000000);
  GUI.Run;

  {$IFNDEF SRL_DISABLE_REMOTEINPUT}
  if WLSettings.GetObject('remote_input').getBoolean('enabled', True) and (not GameClient.RemoteInput.IsSetup()) then GameClient.RemoteInput.Setup();
  {$ENDIF}

  SRConfig.Write();

  Bot.Init();
  Bot.Run();
end.
