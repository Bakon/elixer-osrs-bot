  with cb_fletchred do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(562));
    SetTop(TControl.AdjustToDPI(105));
    SetName('cb_fletchred');
    SetFontColor($000000);
    SetCaption('Fletch');
  end;

  with lcb_fletchitem do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(562));
    SetTop(TControl.AdjustToDPI(125));
    SetName('lcb_fletchitem');
    SetCaption('Item to fletch');
    AddItemArray(['105 arrow shafts', 'Redwood shield', 'Redwood hiking staff']);
    SetItemIndex(0);
    SetFontColor($000000);
    ComboBox.SetFontColor(0);
  end;

  with cb_alchred do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(562));
    SetTop(TControl.AdjustToDPI(165));
    SetName('cb_alchred');
    SetFontColor($000000);
    SetCaption('Alch Shields?');
  end;

  with cb_farmruns do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(562));
    SetTop(TControl.AdjustToDPI(185));
    SetName('cb_farmruns');
    SetFontColor($000000);
    SetCaption('Farm runs');
  end;

  with cb_bhruns do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(562));
    SetTop(TControl.AdjustToDPI(205));
    SetName('cb_bhruns');
    SetFontColor($000000);
    SetCaption('Birdhouse runs');
  end;

  with lcb_wcgtp do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(562));
    SetTop(TControl.AdjustToDPI(225));
    SetName('lcb_wcgtp');
    SetCaption('How we return after');
    AddItemArray(['not doing farm/BH','Radas blessing 3+', 'Xerics talisman (CHARGED)']);
    SetItemIndex(0);
    SetFontColor($000000);
    ComboBox.SetFontColor(0);
  end;

  if SRConfig.tbreakenabled then
  begin
    cb_Breaks.CheckBox.SetChecked(True);
    box_BA.SetText(ToStr(SRConfig.breakintervalint));
    box_BF.SetText(ToStr(SRConfig.breaklengthint));
  end;

  if SRConfig.tsleepenabled then
  begin
    cb_Sleeps.CheckBox.SetChecked(True);
    box_SA.SetText(SRConfig.sleepintervalstr);
    box_SF.SetText(ToStr(SRConfig.sleeplengthint));
  end;

  if (SRConfig.chopamountint <> 0) then
    box_TL.SetText(ToStr(SRConfig.chopamountint));

  if (SRConfig.runtimeint <> 0) then
    box_Run.SetText(ToStr(SRConfig.runtimeint));

  if SRConfig.bankmodeEnabled then
    cb_bankred.CheckBox.SetChecked(True);

  if SRConfig.fletchmodeEnabled then
    cb_fletchred.CheckBox.SetChecked(True);

  if SRConfig.alchshieldsEnabled then
    cb_alchred.CheckBox.SetChecked(True);

  if SRConfig.brunEnabled then
    cb_bhruns.CheckBox.SetChecked(True);

  if SRConfig.frunEnabled then
    cb_farmruns.CheckBox.SetChecked(True);

  lcb_fletchitem.SetItemIndex(SRConfig.itemfletchint);
  lcb_wcgtp.SetItemIndex(SRConfig.returnint);
end;

procedure TScriptForm.Setup(caption: String = 'Script Form'; size: TPoint = [750, 500]; allowResize: Boolean = False); override;
var
  Img: TPicture;
  BGImg: TImage;
  SButton: TButton;
begin
  inherited;

  Img.init();

  try
    Img.LoadFromFile('Resources\SSR2GUI.png')
  except
    writeln('Could not load the gui image')
  finally
  end;

  with BGImg do
  begin
    Init(Self.PageControl);
    SetParent(Self.PageControl);
    SetBounds(0,0,Self.Form.getWidth,Self.Form.getHeight);
    SetPicture(Img);
  end;

  Self.Start.setVisible(False);
  with SButton do
  begin
    Create(Self.Form);
    SetBounds(Self.Form.GetRight-190, Self.Form.GetBottom-70, 180, 60);
    GetFont.SetName('Bahnschrift');
    GetFont.SetSize(15);
    SetCaption('Run');
    SetOnClick(@Self.StartScript);
  end;

  Self.AddTab(CreateSettingsTab());
  Self.CreateAccountManager();
  Self.CreateFarmRunSettingsTab();
  Self.CreateBirdhouseRunSettings();
end;

function TMinimap.IsUnloadedVisible(out unloadedBlackTPA: TPointArray): Boolean;  // Skunkworks
var
  unloadedClusters: T2DPointArray;
begin
  if Minimap.IsPlayerMoving() then // if we are still moving we don't care about unloaded
    Exit(False);

  SRL.FindColors(unloadedBlackTPA, CTS2(65536, 1, 0.01, 0.01), Minimap.Bounds);
  unloadedClusters := unloadedBlackTPA.Cluster(1);
  unloadedClusters.FilterSize(200, EComparator.__GT__);
  if unloadedClusters.Len() = 0 then
    Exit(False);

  Self.DebugLn('unloaded cluster is visible');
  unloadedBlackTPA := unloadedClusters.Biggest();
  Exit(True);
end;

function TMinimap.ClickIntoUnloaded(): Boolean; // Skunkworks
var
  blackTPA: TPointArray;
begin
  if not self.IsUnloadedVisible(blackTPA) then
    Exit(False);

  WriteLn('clicking into unloaded minimap region');
  Mouse.Click(blackTPA.RandomMean(), MOUSE_LEFT);
  if Mainscreen.DidRedClick() then
    Debug(Mainscreen.Bounds);
end;

procedure RWOnWalkEvent(Sender: PWalker; Position: TPoint; Destination: TPoint);
begin
  if SRL.Dice(5) then
    Mouse.RandomMovement;

  Sender^.ScreenWalk := SRL.Dice(45);

  if Minimap.FRClickIntoUnloaded() then
    Writeln('We had to click into unloaded');

  Position := [];
  Destination := [];
end;

function TBank.OpenTab(tab: Int32): Boolean; override;
var
  b: TBox;
begin
  if not Self.IsOpen() then
    Exit;

  if tab = Self.GetCurrentTab() then
  begin
    if (tab = 0) and not ('howing' in Self.GetTitle()) then
      Exit(True);
  end;

  b := Self.GetTabBox(tab);
  if b <> [] then
  begin
    Mouse.Click(b, MOUSE_LEFT);
    Wait(650,950);
    Result := WaitUntil((tab = Self.GetCurrentTab()), 100, 2000);
  end;
end;

function TScript.WithdrawHelper(item : TItem; quant : Int32) : Boolean; // CJ
var
  withdrawItem : TBankItem;
  attempts : int32;
begin
  if not Inventory.ContainsItem(item) then
  begin
    Bot.WriteMsg('Withdrawing ' + item);
    for attempts := 0 to 5 do
    begin
      withdrawItem := TBankItem.Setup(item, quant, False);
      Bank.WithdrawItem(withdrawItem, False);
      Result := Waituntil(Inventory.ContainsItem(item), 315, 5000);

      if Inventory.ContainsItem(item) then
        Break;
    end;
  end
  else
    Result := true;
end;

function WorldArrayRandomizer(const arr: array of Int32): array of Int32;
begin
  if High(arr) >= 0 then
  begin
    SetLength(Result, 1);
    Result[0] := arr[Random(0, High(arr))];
  end
end;


function TInventory.IsOpen(): Boolean; override;
begin
  Result := (GameTabs.GetCurrentTab() = EGameTab.INVENTORY);
  if (not Result) then Self.Open;
  Result := (GameTabs.GetCurrentTab() = EGameTab.INVENTORY);
end;

procedure TMinimap.RotateWithinAngles(min, max: Int32);
var
  minMaxAvg: Int32 := Floor((min + max) div 2);
  preferredAngle: Int32 := SRL.SkewedRand(minMaxAvg, min, max);
begin
  if preferredAngle < 0 then
    preferredAngle := preferredAngle + 360;

  Minimap.SetCompassAngle(preferredAngle);
end;

// Undo the bogged down version in WaspLib
function TChooseOption.Select(Text: TStringArray; MouseAction: Int32 = MOUSE_LEFT; CaseSensitive: Boolean = True; CloseIfNotFound: Boolean = True): Boolean; override;
var
  Choices: TChooseOption_OptionArray;
  I, J: Int32;
begin
  if Self.Open() then
  begin
    Wait(0, 750, wdLeft);

    Choices := GetOptions();

    for I := 0 to High(Choices) do
      for J := 0 to High(Text) do
        if (CaseSensitive and (Text[J] in Choices[I].Text)) or ((not CaseSensitive) and (Lowercase(Text[J]) in Lowercase(Choices[I].Text))) then
        begin
          Self.Select(Choices[I], MouseAction);
          Exit(True);
        end;

    if CloseIfNotFound then
    begin
      WaitEx(400, 150);

      Self.Close();
    end;
  end;
end;

procedure TScript.IncludeEquipmentSetup();
begin
  if Magic.CanActivate(ESpell.HIGH_LEVEL_ALCHEMY) then
    Self.RunesDetected := True;

  if Equipment.ContainsItem('Tome of fire') then
    Self.InfiniteFire := True;

  if Equipment.ContainsItem('Tome of earth') then
    Self.InfiniteEarth := True;

  if Equipment.ContainsItem('Tome of water') then
    Self.InfiniteWater := True;

  if Equipment.ContainsAny(['Lumberjack hat', 'Lumberjack hat', 'Lumberjack hat', 'Lumberjack hat']) then
    Self.ExpAmount += (Self.ExpAmount * 0.025);

  if Equipment.ContainsAny(['Crystal felling axe', 'Dragon felling axe', 'Rune felling axe', 'Adamant felling axe', 'Mithril felling axe', 'Black felling axe', 'Steel felling axe']) then
  begin
    Self.UsingFellingAxe := True;
    Self.ExpAmount += (Self.ExpAmount * 0.1);
  end;

  case Self.WCGuildTP of
  'Radas blessing 3+':
  begin
    if Equipment.ContainsItem(KourendBless) then
      Self.RadasEquipped := True;
  end;
  end;

  if Equipment.ContainsItem("Xeric's talisman") then
    Self.XericTaliEquipped := True;

  if Equipment.ContainsAny(['Crystal axe', 'Crystal felling axe', 'Dragon axe', 'Dragon axe (or)', 'Dragon felling axe', 'Infernal axe']) then
    Self.DragonAxeEquipped := True;
end;

procedure TFarmRun.OnStart(); override;
var
  I : Int32;
  bankTimeout: TCountdown;
begin
  for I := 0 to High(Antiban.tasks) do
    Antiban.Tasks[I].Countdown.Pause;

  bankTimeout.Init(45000);

  while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
  begin
    Bank.WalkOpen(Bot.BankObj);
  end;

  WaitUntil(Bank.IsOpen(), 115, 12500);

  Bank.DepositRandomItems(['Open log basket', '28142', 'Log basket', 'Crystal axe', 'Crystal felling axe',
                           'Dragon axe', 'Dragon axe (or)',  'Dragon felling axe', 'Infernal axe',
                           'Rune felling axe', 'Adamant felling axe', 'Mithril felling axe', 'Black felling axe', 'Steel felling axe',
                           'Rune axe', 'Adamant axe', 'Mithril axe', 'Black axe', 'Steel axe',
                           'Rune pouch', 'Divine rune pouch', 'Forester''s ration']);

  Wait(500,750);

  case Bot.WCGuildTP of
    'Radas blessing 3+':
    begin
      if (not Bot.RadasEquipped) then
        Bot.WithdrawHelper(Bot.KourendBless, 1);
    end;

    'Xerics talisman (CHARGED)':
    begin
      if (not Bot.XericTaliEquipped) then
      begin
        Bot.WithdrawHelper('Xeric''s talisman', 1);
        Inventory.ClickItem('Xeric''s talisman', 'Wear');
        Bot.XericTaliEquipped := True;
      end;
    end;
    end;

  inherited;
end;

procedure TFarmRun.OnComplete(); override;
var
  I, attempts : Int32;
  MyPos: TPoint;
  bankTimeout : TCountdown;
begin
  MyPos := Bot.RSW.GetMyPos();

  if chat.HasContinue then
    Chat.ClickContinue();

  case Bot.WCGuildTP of
  'Radas blessing 3+':
  begin
    if Inventory.ContainsItem(Bot.KourendBless) then
    begin
      for attempts := 0 to 4 do
      begin
        Inventory.ClickItem(Bot.KourendBless, 'Kourend Woodland');
        WaitUntil((MyPos := Bot.RSW.GetMyPos()).InBox([1334, 2082, 2222, 2784]), 115, 10000);

        Wait(300,500);
        if (MyPos := Bot.RSW.GetMyPos()).InBox([1334, 2082, 2222, 2784]) then
          Break;

        if (attempts >=4) then
          TerminateScript('Something went wrong on teleporting');
      end;
    end
    else
    begin
      for attempts := 0 to 4 do
      begin
        Equipment.ClickItem(Bot.KourendBless, 'Kourend Woodland');
        WaitUntil((MyPos := Bot.RSW.GetMyPos()).InBox([1334, 2082, 2222, 2784]), 115, 10000);

        Wait(300,500);
        if (MyPos := Bot.RSW.GetMyPos()).InBox([1334, 2082, 2222, 2784]) then
          Break;

        if (attempts >=4) then
          TerminateScript('Something went wrong on teleporting');
      end;
    end;

    Bot.RSW.WalkBlind([1572,2510]);
  end;

  'Xerics talisman (CHARGED)':
  begin
    for attempts := 0 to 4 do
    begin
      Bot.transport.run(rsteleports.XERICS_LOOKOUT);
      WaitUntil((MyPos := Bot.RSW.GetMyPos()).InBox([1334, 2082, 2222, 2784]), 115, 10000);

      if (MyPos := Bot.RSW.GetMyPos()).InBox([1334, 2082, 2222, 2784]) then
        Break;

      if (attempts >=4) then
        TerminateScript('Something went wrong on teleporting');
    end;

    Bot.WriteMsg('Walking to nearby web');
    Bot.RSW.WalkBlind([1600,2340]);
  end;
  end;

  Wait(500,750);

  Bot.WriteMsg('Walking to entrance of the WC Guild');

  if (not Bot.RSW.AtTile([1634,2512], 12)) then
    Bot.RSW.WebWalk([1634,2512]);

  Bot.WriteMsg('Attempting to click the gate');

  for attempts := 0 to 8 do
  begin
    if Bot.GateObj.Click(True, 5) then
      WaitUntil((MyPos := Bot.RSW.GetMyPos()).InBox([1644, 2429, 1920, 2589]), 115, 12500);

    if (MyPos := Bot.RSW.GetMyPos()).InBox([1644, 2429, 1920, 2589]) then
      Break;
  end;

  Bot.WriteMsg('Walking to Bank');
  Bot.RSW.WebWalk([1752,2532]);

  if Inventory.ContainsItem('Coin pouch') then
  begin
    Inventory.ClickItem('Coin pouch', 'Open-all');
    WaitUntil(Inventory.ContainsItem('Coins'), 115, 5000);
  end;

  bankTimeout.Init(45000);

  while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
  begin
    Bank.WalkOpen(Bot.BankObj);
  end;
  WaitUntil(Bank.IsOpen(), 115, 12500);


  if not Bot.DoAlch then
  begin
    if Inventory.ContainsItem('Rune pouch') then
      Inventory.ClickItem('Rune pouch', 'Deposit-All');

    if Inventory.ContainsItem('Divine rune pouch') then
      Inventory.ClickItem('Divine rune pouch', 'Deposit-All');

    Bank.DepositRandomItems(['Open log basket', '28142', 'Log basket', 'Crystal axe', 'Crystal felling axe',
                           'Dragon axe', 'Dragon axe (or)', 'Dragon felling axe', 'Infernal axe',
                           'Rune felling axe', 'Adamant felling axe', 'Mithril felling axe', 'Black felling axe', 'Steel felling axe',
                           'Rune axe', 'Adamant axe', 'Mithril axe', 'Black axe', 'Steel axe',
                           'Forester''s ration']);
  end
  else
  Bank.DepositRandomItems(['Open log basket', '28142', 'Log basket', 'Crystal axe', 'Crystal felling axe',
                           'Dragon axe', 'Dragon axe (or)', 'Dragon felling axe', 'Infernal axe',
                           'Rune felling axe', 'Adamant felling axe', 'Mithril felling axe', 'Black felling axe', 'Steel felling axe',
                           'Rune axe', 'Adamant axe', 'Mithril axe', 'Black axe', 'Steel axe',
                           'Rune pouch', 'Divine rune pouch', 'Forester''s ration']);


  if Bot.DoAlch and (not Bot.RunesDetected) then
  begin
    case FarmRunner.RPouchMethod of
    'Not using/use runes':
    begin
      Bot.WithdrawHelper('Nature rune', 1000);
      if not Bot.InfiniteFire then
        Bot.WithdrawHelper('Fire rune', 5000);
    end;

    'Rune pouch':
    begin
      Bot.WithdrawHelper('Rune pouch', 1);
    end;

    'Divine rune pouch':
    begin
      Bot.WithdrawHelper('Divine rune pouch', 1);
    end;
    end;
  end;

  if Bot.DoAlch and Bot.RunesDetected then
  begin
    Bot.WithdrawHelper('Nature rune', 1000);
    if not Bot.InfiniteFire then
      Bot.WithdrawHelper('Fire rune', 5000);
  end;

  if Bot.DoFletch then
    Bot.WithdrawHelper(Bot.OurKnife, 1);

  Bank.Close(True);

  for I := 0 to High(Antiban.tasks) do
  Antiban.Tasks[I].Countdown.Resume;
end;

function TBirdHouseInclude.OnStart() : Boolean; override;
var
  i : Int32;
  bankTimeout : TCountdown;
begin

  for I := 0 to High(Antiban.tasks) do
    Antiban.Tasks[I].Countdown.Pause;

  if Self.AlwaysUseBestLog then
  begin
    Self.SuggestedLogType := BirdhouseRunner.GetLogForHunterLevel(Stats.GetLevel(ESkill.HUNTER));
    if Self.LogType <> Self.SuggestedLogType then
      Self.LogType := Self.SuggestedLogType;
  end;

  bankTimeout.Init(45000);

  while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
  begin
    Bank.WalkOpen(Bot.BankObj);
  end;
  WaitUntil(Bank.IsOpen(), 115, 12500);
  if not Bank.IsOpen() then
  begin
    Self.DebugLn("Failed to get to bank");
    Exit(false);
  end;

  begin
    Bank.DepositRandomItems(['Open log basket', '28142', 'Log basket', 'Crystal axe', 'Crystal felling axe',
                             'Dragon axe', 'Dragon axe (or)', 'Dragon felling axe', 'Infernal axe',
                             'Rune felling axe', 'Adamant felling axe', 'Mithril felling axe', 'Black felling axe', 'Steel felling axe',
                             'Rune axe', 'Adamant axe', 'Mithril axe', 'Black axe', 'Steel axe',
                             'Rune pouch', 'Divine rune pouch', 'Forester''s ration']);

    //If we can't get our stuff then bail
    if not Self.WithdrawNextRun() then
    begin
      Bank.Close();
      BirdhouseRunner.IsDisabled := true;
      Exit(false);
    end;

    case Bot.WCGuildTP of
    'Radas blessing 3+':
    begin
      if (not Bot.RadasEquipped) then
        Bot.WithdrawHelper(Bot.KourendBless, 1);
    end;

    'Xerics talisman (CHARGED)':
    begin
      if (not Bot.XericTaliEquipped) then
      begin
        Bot.WithdrawHelper('Xeric''s talisman', 1);
        Inventory.ClickItem('Xeric''s talisman', 'Wear');
        Bot.XericTaliEquipped := True;
      end;
    end;
    end;
  end;

  Bank.Close();
  Result := true;
end;

procedure TBirdHouseInclude.OnComplete(); override;
var
  I, attempts: Int32;
  MyPos: TPoint;
  bankTimeout : TCountdown;
begin
  MyPos := Bot.RSW.GetMyPos();

  if chat.HasContinue then
    Chat.ClickContinue();

  ScriptWalker := @Bot.RSW;

  case Bot.WCGuildTP of
  'Radas blessing 3+':
  begin
    if Inventory.ContainsItem(Bot.KourendBless) then
    begin
      for attempts := 0 to 4 do
      begin
        Inventory.ClickItem(Bot.KourendBless, 'Kourend Woodland');
        WaitUntil((MyPos := Bot.RSW.GetMyPos()).InBox([1334, 2082, 2222, 2784]), 115, 10000);

        Wait(300,500);
        if (MyPos := Bot.RSW.GetMyPos()).InBox([1334, 2082, 2222, 2784]) then
          Break;

        if (attempts >=4) then
          TerminateScript('Something went wrong on teleporting');
      end;
    end
