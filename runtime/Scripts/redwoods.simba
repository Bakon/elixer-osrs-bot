procedure TScript.WriteMsg(Message: String);
begin
  WriteLn(SRL.TimeStamp() + '[Redwoods]: '+ Message);
end;

procedure TIniConfig.Init();
var
  frun, brun, bankmode, fletchmode, alchshields, tbreak, tsleep, bhbestlog, bhclockworks : string;
begin
   frun := ReadINI('Redwoods General', 'Farm runs', AppPath+'Configs/StudentsSettings');
   self.frunEnabled := StrToBoolDef(frun, False);

   brun := ReadINI('Redwoods General', 'BH runs', AppPath+'Configs/StudentsSettings');
   self.brunEnabled := StrToBoolDef(brun, False);

   bankmode := ReadINI('Redwoods General', 'Bank mode', AppPath+'Configs/StudentsSettings');
   self.bankmodeEnabled := StrToBoolDef(bankmode, False);

   fletchmode := ReadINI('Redwoods General', 'Fletch mode', AppPath+'Configs/StudentsSettings');
   self.fletchmodeEnabled := StrToBoolDef(fletchmode, False);

   alchshields := ReadINI('Redwoods General', 'Alch mode', AppPath+'Configs/StudentsSettings');
   self.alchshieldsEnabled := StrToBoolDef(alchshields, False);

   tbreak := ReadINI('Redwoods General', 'Take breaks', AppPath+'Configs/StudentsSettings');
   self.tbreakenabled := StrToBoolDef(tbreak, False);

   tsleep := ReadINI('Redwoods General', 'Take sleeps', AppPath+'Configs/StudentsSettings');
   self.tsleepenabled := StrToBoolDef(tsleep, False);

   SRConfig.itemfletchint := StrToIntDef(ReadINI('Redwoods General', 'Fletching', AppPath+'Configs/StudentsSettings'), 0);
   SRConfig.returnint := StrToIntDef(ReadINI('Redwoods General', 'Return via', AppPath+'Configs/StudentsSettings'), 0);
   SRConfig.chopamountint := StrToIntDef(ReadINI('Redwoods General', 'Chop amount', AppPath+'Configs/StudentsSettings'), 600);
   SRConfig.runtimeint := StrToIntDef(ReadINI('Redwoods General', 'Run time', AppPath+'Configs/StudentsSettings'), 240);

   SRConfig.breakintervalint := StrToIntDef(ReadINI('Redwoods General', 'Break interval', AppPath+'Configs/StudentsSettings'), 60);
   SRConfig.breaklengthint := StrToIntDef(ReadINI('Redwoods General', 'Break length', AppPath+'Configs/StudentsSettings'), 15);
   SRConfig.sleepintervalstr := ReadINI('Redwoods General', 'Sleep interval', AppPath+'Configs/StudentsSettings');
   SRConfig.sleeplengthint := StrToIntDef(ReadINI('Redwoods General', 'Sleep length', AppPath+'Configs/StudentsSettings'), 8);

   SRConfig.bhlogint := StrToIntDef(ReadINI('Redwoods BH Tab', 'BH logs', AppPath+'Configs/StudentsSettings'), 0);
   BHIncludeGUILogType := ELogType(SRConfig.bhlogint);

   SRConfig.bhseed := ReadINI('Redwoods BH Tab', 'BH seed', AppPath+'Configs/StudentsSettings');
   BHIncludeGUISeed := SRConfig.bhseed;

   SRConfig.bhrunint := StrToIntDef(ReadINI('Redwoods BH Tab', 'BH runtime', AppPath+'Configs/StudentsSettings'), 0);
   BHIncludeGUIRunIntervalMinutes := Round(SRConfig.bhrunint / 60000);

   bhbestlog := ReadINI('Redwoods BH Tab', 'BH best log', AppPath+'Configs/StudentsSettings');
   self.bhusebestlogEnabled := StrToBoolDef(bhbestlog, False);
   BHIncludeGUIUseBestLog := SRConfig.bhusebestlogEnabled;

   bhclockworks := ReadINI('Redwoods BH Tab', 'BH clockworks', AppPath+'Configs/StudentsSettings');
   self.bhcraftclockworksEnabled := StrToBoolDef(bhclockworks, False);
   BHIncludeGUICraftWhileNav := SRConfig.bhcraftclockworksEnabled;

   SRConfig.loginindexint := StrToIntDef(ReadINI('Redwoods Account Tab', 'Login index', AppPath+'Configs/StudentsSettings'), 0);
   Login.PlayerIndex := SRConfig.loginindexint;
end;

procedure TIniConfig.Write();
begin
  WriteIni('Redwoods General', 'Farm runs', ToStr(self.frunEnabled), AppPath+'Configs/StudentsSettings');
  WriteIni('Redwoods General', 'BH runs', ToStr(self.brunEnabled), AppPath+'Configs/StudentsSettings');
  WriteIni('Redwoods General', 'Bank mode', ToStr(self.bankmodeEnabled), AppPath+'Configs/StudentsSettings');
  WriteIni('Redwoods General', 'Fletch mode', ToStr(self.fletchmodeEnabled), AppPath+'Configs/StudentsSettings');
  WriteIni('Redwoods General', 'Alch mode', ToStr(self.alchshieldsEnabled), AppPath+'Configs/StudentsSettings');
  WriteIni('Redwoods General', 'Take breaks', ToStr(self.tbreakenabled), AppPath+'Configs/StudentsSettings');
  WriteIni('Redwoods General', 'Take sleeps', ToStr(self.tsleepenabled), AppPath+'Configs/StudentsSettings');

  WriteIni('Redwoods General', 'Break interval', ToStr(self.breakintervalint), AppPath+'Configs/StudentsSettings');
  WriteIni('Redwoods General', 'Break length', ToStr(self.breaklengthint), AppPath+'Configs/StudentsSettings');
  WriteIni('Redwoods General', 'Sleep interval', Self.sleepintervalstr, AppPath+'Configs/StudentsSettings');
  WriteIni('Redwoods General', 'Sleep length', ToStr(self.sleeplengthint), AppPath+'Configs/StudentsSettings');
  WriteIni('Redwoods General', 'Fletching', ToStr(self.itemfletchint), AppPath+'Configs/StudentsSettings');
  WriteIni('Redwoods General', 'Return via', ToStr(self.returnint), AppPath+'Configs/StudentsSettings');
  WriteIni('Redwoods General', 'Chop amount', ToStr(self.chopamountint), AppPath+'Configs/StudentsSettings');
  WriteIni('Redwoods General', 'Run time', ToStr(self.runtimeint), AppPath+'Configs/StudentsSettings');

  WriteIni('Redwoods BH Tab', 'BH logs', ToStr(Ord(BirdHouseRunner.LogType)), AppPath+'Configs/StudentsSettings');
  WriteIni('Redwoods BH Tab', 'BH seed', BirdHouseRunner.Seed, AppPath+'Configs/StudentsSettings');
  WriteIni('Redwoods BH Tab', 'BH runtime', ToStr(BirdHouseRunner.TaskInterval), AppPath+'Configs/StudentsSettings');
  WriteIni('Redwoods BH Tab', 'BH best log', ToStr(BirdHouseRunner.AlwaysUseBestLog), AppPath+'Configs/StudentsSettings');
  WriteIni('Redwoods BH Tab', 'BH clockworks', ToStr(BirdHouseRunner.NeedClockworks), AppPath+'Configs/StudentsSettings');

  WriteIni('Redwoods Account Tab', 'Login index', ToStr(Login.PlayerIndex), AppPath+'Configs/StudentsSettings');

  // ... any other things you stored on TIniConfig
end;

procedure TScriptForm.StartScript(Sender: TObject); override;
var
  MaxRun, TotalLimit: Int32;
  e_Run, e_BA, e_BF, e_SA, e_SF, t_lim: TEdit;
  cb_Breaks,cb_Sleeps, FarmRuns, BHRuns, FletchRed, BankRed, AlchRed: TCheckBox;
  Loc, fletchingitem, WCGTP: TComboBox;

begin
  inherited;

  Self.Form.Close();
  Bot.WriteMsg('Starting script');

  t_Lim  := Self.Form.GetChild('box_tl_edit');
  TotalLimit := StrToInt(T_lim.getText);
  Bot.Totallimit := (TotalLimit);

{ Time settings }
  e_Run            := Self.Form.GetChild('box_run_edit');
  MaxRun           := StrToInt(e_Run.getText);
  Bot.ShutdownTime := (MaxRun * 60000) + Random(- (MaxRun * 6000), (MaxRun * 6000));

  cb_Breaks        := Self.Form.GetChild('cb_breaks_checkbox');
  Bot.TakeBreaks   := cb_Breaks.IsChecked;
  if Bot.TakeBreaks then
  begin
    e_BA           := Self.Form.GetChild('box_ba_edit');
    e_BF           := Self.Form.GetChild('box_bf_edit');
    Antiban.AddBreak(ONE_MINUTE*StrToInt(e_BA.getText),ONE_MINUTE*StrToInt(e_BF.getText), 0.15, 1.0);
  end;

  cb_Sleeps        := Self.Form.GetChild('cb_sleeps_checkbox');
  Bot.TakeSleeps   := cb_Sleeps.IsChecked;
  if Bot.TakeSleeps then
  begin
    e_SA           := Self.Form.GetChild('box_sa_edit');
    e_SF           := Self.Form.GetChild('box_sf_edit');
    Antiban.AddSleep(e_SA.getText, StrToInt(e_SF.getText) * ONE_HOUR, 0.1, 1.0);
  end;

{ Script settings }
  Loc  := Self.Form.GetChild('lcb_loc_combobox');
  Bot.Location   := Loc.GetText;

  fletchingitem := Self.Form.GetChild('lcb_fletchitem_combobox');
  Bot.FletchFor  := fletchingitem.getText;

  BankRed := Self.Form.GetChild('cb_bankred_checkbox');
  Bot.DoBank  := (BankRed.GetState = cbChecked);

  FletchRed := Self.Form.GetChild('cb_fletchred_checkbox');
  Bot.DoFletch  := (FletchRed.GetState = cbChecked);

  AlchRed := Self.Form.GetChild('cb_alchred_checkbox');
  Bot.DoAlch := (AlchRed.getState = cbChecked);

  FarmRuns := Self.Form.GetChild('cb_farmruns_checkbox');
  Bot.DoFarmRuns  := (FarmRuns.GetState = cbChecked);

  BHRuns := Self.Form.GetChild('cb_bhruns_checkbox');
  Bot.DoBHRuns    := (BHRuns.getState = cbChecked);

  WCGTP := Self.Form.GetChild('lcb_wcgtp_combobox');
  Bot.WCGuildTP  := WCGTP.GetText;

  SRConfig.chopamountint := TotalLimit;
  SRConfig.runtimeint := MaxRun;

  SRConfig.tbreakenabled := Bot.TakeBreaks;
  SRConfig.tsleepenabled := Bot.TakeSleeps;

  if Bot.TakeBreaks then
  begin
    SRConfig.breakintervalint := StrToInt(e_BA.getText);
    SRConfig.breaklengthint := StrToInt(e_BF.getText);
  end;

  if Bot.TakeSleeps then
  begin
    SRConfig.sleepintervalstr := e_SA.getText;
    SRConfig.sleeplengthint := StrToInt(e_SF.getText);
  end;

  SRConfig.bankmodeEnabled := Bot.DoBank;
  SRConfig.fletchmodeEnabled := Bot.DoFletch;
  SRConfig.alchshieldsEnabled := Bot.DoAlch;
  SRConfig.frunEnabled := Bot.DoFarmRuns;
  SRConfig.brunEnabled := Bot.DoBHRuns;

  SRConfig.itemfletchint := fletchingitem.getItemIndex();
  SRConfig.returnint := WCGTP.getItemIndex();
end;

function TScriptForm.CreateSettingsTab(): TTabSheet;
type
  TScriptForm = TScriptForm;

procedure TScriptForm.UpdateSList({$H-}sender: TObject);{$H+}
var
  Loc, fletchingitem, WCGTP: TComboBox;
  FletchRed, BankRed, AlchRed, LocCap, FletchCap, WCGTPCap: Tlabel;

begin
  Loc  := Self.Form.GetChild('lcb_loc_combobox');
  LocCap := Self.Form.GetChild('lcb_loc_caption');
  fletchingitem := Self.Form.GetChild('lcb_fletchitem_combobox');
  FletchCap := Self.Form.GetChild('lcb_fletchitem_caption');
  WCGTP := Self.Form.GetChild('lcb_wcgtp_combobox');
  WCGTPCap := Self.Form.GetChild('lcb_wcgtp_combobox');

  BankRed := Self.Form.GetChild('cb_bankred_panel');
  FletchRed := Self.Form.GetChild('cb_fletchred_panel');
  AlchRed := Self.Form.GetChild('cb_alchred_panel');

  Loc.SetFontColor(0);
  fletchingitem.SetFontColor(0);
  WCGTP.SetFontColor(0);
  LocCap.SetFontColor(0); // Needed?
  FletchCap.SetFontColor(0); // Needed?
  WCGTPCap.SetFontColor(0); // Needed?

  Loc.Clear;
  Loc.Refresh;

  fletchingitem.Clear;
  fletchingitem.Refresh;

  WCGTP.Clear;
  WCGTP.Refresh;

  LocCap.Refresh;
  FletchCap.Refresh;
  WCGTPCap.Refresh;
end;

var
  lb_Time,lb_Script: TLabel;
  cb_Breaks,cb_Sleeps,cb_bankred,cb_fletchred,cb_alchred,
  cb_farmruns, cb_bhruns: TLabeledCheckBox;
