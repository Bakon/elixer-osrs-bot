{$DEFINE SCRIPT_REVISION := '1'}
{$IFNDEF SCRIPT_CHAIN}
  {$DEFINE SCRIPT_GUI}
  {$I SRL-T/main.simba}
  {$I WaspLib/main.simba}
{$ENDIF}

type
  ELocation = (HOSIDIUS, ROGUES_DEN, MYTHS_GUILD, WINES);

const
  WINE_GRAPES: TItemArray = [
    'Grapes',
    'Zamorak''s grapes'
  ];

  RAW_FOOD: TItemArray = [
    'Custom',
    'Meat',
    'Shrimps',
    'Chicken',
    'Rabbit',
    'Anchovies',
    'Sardine',
    'Herring',
    'Mackerel',
    'Trout',
    'Cod',
    'Pike',
    'Salmon',
    'Tuna',
    'Karambwan',
    'Rainbow fish',
    'Lobster',
    'Bass',
    'Swordfish',
    'Monkfish',
    'Shark',
    'Sea turtle',
    'Anglerfish',
    'Dark crab',
    'Manta ray'
  ];

var
  CurrentFood: TItem   := 'Anglerfish';
  CurrentFood2: TItem  := 'None'; // optional follow-up: cooked when the first runs out
  CurrentLocation := ELocation.HOSIDIUS;

type
  ECookerState = (
    OPEN_BANK,
    WITHDRAW_ITEMS,
    DEPOSIT_ITEMS,

    OPEN_COLLECT,
    HANDLE_COLLECT,
    CLOSE_INTERFACE,

    DO_COOKING,
    HANDLE_MAKE,
    WAIT_COOKING,

    LEVEL_UP,
    CLOSE_CONTEXT,

    END_SCRIPT
  );

  TCooker = record(TBaseBankScript)
    State: ECookerState;

    Food: TItem;
    Ingredient: TBankItem;
    Jug: TBankItem;
    Products: array of TBankItem;

    CookingObj: TGameObjectV2;

    Cooking: Boolean;
    UsingFire: Boolean;
    WineMode: Boolean;
    HasNextFood: Boolean;
  end;


procedure TCooker.SetupItems();
var
  cookedPrefix: TStringArray;
  burntFish: TStringArray;
begin
  Self.Food := CurrentFood;
  ItemFinder.Similarity := 0.99999;

  if Self.WineMode then
  begin
    Self.Jug := TBankItem.Setup('Jug of water', 14);
    Self.Ingredient := TBankItem.Setup(Self.Food, 14);

    if ToString(Self.Food).Contains('Zamorak') then
      Self.Products := [TBankItem.Setup('Zamorak''s unfermented wine')]
    else
      Self.Products := [TBankItem.Setup('Unfermented wine')];

    Self.ActionProfit := (
      ItemData.GetAverage(Self.Products[0].Item) -
      ItemData.GetAverage(Self.Ingredient.Item) -
      ItemData.GetAverage(Self.Jug.Item)
    );
    Exit;
  end;

  cookedPrefix := ['chicken', 'rabbit', 'meat', 'crab meat',
                   'karambwan', 'chompy', 'fishcake', 'jubbly', 'sweetcorn'];

  burntFish := ['herring', 'mackerel', 'sardine', 'anchovies',
                'giant carp', 'trout', 'cod', 'pike', 'salmon', 'tuna', 'bass'];

  Self.Ingredient := TBankItem.Setup('Raw ' + ToString(Self.Food).Lower());

  if cookedPrefix.Contains(LowerCase(Self.Food)) then
    Self.Products := [
      TBankItem.Setup('Cooked ' + ToString(Self.Food).Lower()),
      TBankItem.Setup('Burnt ' + ToString(Self.Food).Lower())
    ]
  else if burntFish.Contains(LowerCase(Self.Food)) then
    Self.Products := [
      TBankItem.Setup(Self.Food),
      TBankItem.Setup('Burnt fish')
    ]
  else if 'shrimps' in LowerCase(Self.Food) then
    Self.Products := [
      TBankItem.Setup(Self.Food),
      TBankItem.Setup('Burnt shrimp')
    ]
  else
    Self.Products := [
      TBankItem.Setup(Self.Food),
      TBankItem.Setup('Burnt ' + ToString(Self.Food).Lower())
    ];

  Self.ActionProfit := (
    ItemData.GetAverage(Self.Products[0].Item) -
    ItemData.GetAverage(Self.Ingredient.Item)
  );
end;

procedure TCooker.SetupLocation();
var
  tmp: TGameObjectV2;
begin
  case CurrentLocation of
    ELocation.HOSIDIUS:
    begin
      GENERATED_GRAPH.NodeRadius := 30;
      Map.SetupChunk(EChunk.HOSIDIUS_KITCHEN);
      Objects.Setup(Map.Objects(), @Map.Walker);
      Self.CookingObj := Objects.Get('Clay oven');
      Delete(Self.CookingObj.Coordinates, 0, 1);
      Delete(Self.CookingObj.Coordinates, 1, 1);
      Delete(Self.CookingObj.Rotations, 0, 2);
    end;

    ELocation.ROGUES_DEN:
    begin
      Map.SetupChunk(EChunk.ROGUES_DEN);
      tmp := TGameObjectV2.Setup(0.7, 5, [[21128, 30542]]);
      tmp.SetupUpText(['Emerald', 'Benedict']);
      tmp.Walker := @Map.Walker;
      tmp.Finder.Colors += CTS2(3430243, 19, 0.15, 0.81);
      tmp.Finder.Colors += CTS2(6523832, 17, 0.03, 0.89);
      Banks._AddObject(tmp);

      Self.CookingObj := TGameObjectV2.Setup(0.8,1, [[21132,30538]]);
      Self.CookingObj.SetupUpText('Fire');
      Self.CookingObj.Finder.Colors += CTS2(3317724, 14, 0.23, 1.65);
      Self.CookingObj.Walker := @Map.Walker;
    end;

    ELocation.MYTHS_GUILD:
    begin
      Map.SetupChunk([[38,44,38,44], [1]]);
      Objects.Setup(Map.Objects(), @Map.Walker);
      Self.CookingObj := Objects.Get('Range');
    end;

    ELocation.WINES:
    begin
      Self.RSW.Setup('world');
      Self.CollectEmpty := True;
    end;
  end;
end;

procedure TCooker.Init(maxActions: UInt32; maxTime: UInt64); override;
begin
  Antiban.Skills := [ESkill.COOKING, ESkill.TOTAL];
  Antiban.MinZoom := 15;
  Antiban.MaxZoom := 60;

  inherited;

  Self.WineMode := CurrentLocation = ELocation.WINES;
  Self.HasNextFood := (not Self.WineMode) and (ToString(CurrentFood2) <> 'None') and
                      (CurrentFood2 <> CurrentFood);
  Self.SetupItems();
  Self.SetupLocation();
end;

// When the bank runs out of the first food, roll over to the configured
// second one: re-setup the items, clear the empty flag and dump any leftover
// products so the next withdraw starts from a clean inventory.
function TCooker.TrySwitchFood(): Boolean;
begin
  if not Self.HasNextFood then
    Exit(False);

  Self.DebugLn('Out of ' + ToString(CurrentFood) + ' — switching to ' + ToString(CurrentFood2) + '.');
  CurrentFood := CurrentFood2;
  Self.HasNextFood := False;
  Self.BankEmpty := False;
  Self.SetupItems();

  if Bank.IsOpen() then
    Bank.DepositAll();

  Result := True;
end;


function TCooker.HasProducts(): Boolean;
begin
  if Self.WineMode then
    Exit(Inventory.ContainsItem(Self.Products[0].Item));

  Result := Inventory.ContainsAny([Self.Products[0].Item, Self.Products[1].Item]);
end;


function TCooker.Deposit(): Boolean;
var
  invCount: Int32;
begin
  if Self.WineMode then
  begin
    Self.TotalActions += Inventory.CountItem(Self.Products[0].Item);
    Self.TotalProfit := Self.TotalActions * Self.ActionProfit;
    Exit(Bank.DepositAll());
  end;

  invCount := Inventory.Count();
  Result := Self.DepositItem(Self.Products[0]);
  Self.DepositItem(Self.Products[1]);

  if Result then
  begin
    Self.TotalActions += invCount - Inventory.Count();
    Self.TotalProfit := Self.TotalActions * Self.ActionProfit;
  end;
end;

function TCooker.DoCooking(): Boolean;
var
  fire, tpa: TPointArray;
  playerBox: TBox;
begin
  if Self.WineMode then
  begin
    if Inventory.Use(Self.Jug.Item, Self.Ingredient.Item) then
      Result := Make.IsOpen(4000);
    Exit;
  end;

  case CurrentLocation of
    ELocation.ROGUES_DEN:
      begin
        playerBox := Box(Mainscreen.Center, 100, 100);
        if SRL.FindColors(tpa, CTS2(2730450, 13, 0.09, 1.45), playerBox) > 0 then
          fire += tpa;
        if SRL.FindColors(tpa, CTS2(15432, 1, 0.15, 0.01), playerBox) > 0 then
          fire += tpa;

        Mouse.Move(fire.Cluster(1).Biggest());
        if Mainscreen.IsUpText(['Cook', 'Fire']) then
        begin
          Mouse.Click(MOUSE_LEFT);
          Minimap.WaitPlayerMoving(300, 3000);
          Exit(Make.IsOpen(4000));
        end;
      end;
  end;

  if CookingObj.WalkSelectOption(['Cook', 'Fire']) then
  begin
    Minimap.WaitPlayerMoving(300, 3000);
    Result := Make.IsOpen(4000);
  end;
end;

function TCooker.HandleMake(): Boolean;
var
  i: Int32 := 0;
begin
  if not Make.IsOpen() then //not sure if I can remove this.
    Exit;                 //it's probably not needed.

  Result := Make.Select(i, Make.QUANTITY_ALL, Antiban.BioDice());
  Self.Cooking := Result;

  if Result then
    WaitUntil(not Make.IsOpen(), 100, 4000);
end;


function TCooker.IsCooking(waitTime: Int32 = 2500): Boolean;
var
  count: Int32;
begin
  count := Inventory.CountItem(Self.Ingredient.Item);
  if count = 0 then
    Exit;

  Result := WaitUntil(count > Inventory.CountItem(Self.Ingredient.Item), 300, waitTime);
  if Result then
    WL.Activity.Restart();
end;

function TCooker.WaitCooking(): Boolean;
begin
  Result := Self.IsCooking();
  Self.Cooking := Result;
end;


function TCooker.GetState(): ECookerState;
begin
  if WL.Activity.IsFinished() then
    Exit(ECookerState.END_SCRIPT);

  if ChooseOption.IsOpen() then
    Exit(ECookerState.CLOSE_CONTEXT);

  if XPBar.EarnedXP() then
    Exit(ECookerState.WAIT_COOKING);

  if Chat.LeveledUp() then
  begin
    Self.Cooking := False;
    Exit(ECookerState.LEVEL_UP);
  end;

  if Make.IsOpen() then
    Exit(ECookerState.HANDLE_MAKE);

  if GameInterface.IsOpen() then
  begin
    Self.Cooking := False;
    Self.HoveringBank := False;
    if not Self.BankEmpty and Bank.IsOpen() then
    begin
      if Self.HasProducts() then
        Exit(ECookerState.DEPOSIT_ITEMS);

      if Self.WineMode then
      begin
        if not Inventory.ContainsAll([Self.Jug.Item, Self.Ingredient.Item]) then
          Exit(ECookerState.WITHDRAW_ITEMS);
      end
      else if not Inventory.ContainsItem(Self.Ingredient.Item) then
        Exit(ECookerState.WITHDRAW_ITEMS);
    end;

    if not Self.CollectEmpty and CollectBox.IsOpen() then
    begin
      if not CollectBox.ContainsItem(Self.Ingredient.Item) then
        Exit(ECookerState.HANDLE_COLLECT);
    end;

    Exit(ECookerState.CLOSE_INTERFACE);
  end;

  if Self.WineMode then
  begin
    if Inventory.ContainsAll([Self.Jug.Item, Self.Ingredient.Item]) then
    begin
      if Self.Cooking then
        Exit(ECookerState.WAIT_COOKING);

      Exit(ECookerState.DO_COOKING);
    end;

    if Self.BankEmpty then
      Exit(ECookerState.END_SCRIPT);

    Exit(ECookerState.OPEN_BANK);
  end;

  if Inventory.ContainsItem(Self.Ingredient.Item) then
  begin
    if Self.Cooking then
      Exit(ECookerState.WAIT_COOKING);

    Exit(ECookerState.DO_COOKING);
  end;

  if Self.BankEmpty and Self.TrySwitchFood() then
    Exit(ECookerState.OPEN_BANK);

  if Self.BankEmpty and Self.CollectEmpty then
    Exit(ECookerState.END_SCRIPT);

  if Self.BankEmpty then
    Exit(ECookerState.OPEN_COLLECT);

  Exit(ECookerState.OPEN_BANK);
end;

function TCooker.Terminate(): Boolean; override;
begin
  Result := inherited();
  if Result then
    for 0 to 5 do
      if Result := Bank.WithdrawItem(Self.Products[0], True) then
        Break;
end;

procedure TCooker.Run(maxActions: UInt32; maxTime: UInt64);
begin
  Self.Init(maxActions, maxTime);

  repeat
    Self.State := Self.GetState();
    Self.SetAction(ToString(Self.State));

    case Self.State of
      ECookerState.OPEN_BANK:
        if Self.WineMode then
          Bank.WalkOpen()
        else
          Banks.WalkOpen();

      ECookerState.WITHDRAW_ITEMS:
      begin
        if Self.WineMode then
          Self.Withdraw(Self.Jug);
        Self.Withdraw(Self.Ingredient);
        // Bank is open here, so a rollover can deposit leftovers right away.
        if Self.BankEmpty then
          Self.TrySwitchFood();
      end;

      ECookerState.DEPOSIT_ITEMS: Self.Deposit();

      ECookerState.OPEN_COLLECT: CollectBoxes.WalkOpen();
      ECookerState.HANDLE_COLLECT: Self.HandleCollectBox([Self.Ingredient.Item]);
      ECookerState.CLOSE_INTERFACE: GameInterface.Close();

      ECookerState.LEVEL_UP: Chat.HandleLevelUp();
      ECookerState.DO_COOKING: Self.DoCooking();
      ECookerState.HANDLE_MAKE: Self.HandleMake();
      ECookerState.WAIT_COOKING: Self.WaitCooking();
      ECookerState.CLOSE_CONTEXT: ChooseOption.Close();

      ECookerState.END_SCRIPT: Break;
    end;

    Self.DoAntiban();
  until Self.ShouldStop();

  if not Self.Terminate then
    TerminateScript('cooking-by-elixer didn''t terminate properly. Stopping execution.');
end;

var
  Cooker: TCooker;

function TMake.Select(Index: Int32; Quantity: Int32; UseKeyboard: Boolean = True): Boolean; override;
var
  Buttons: TGameButtonArray;
begin
  Buttons := Self.GetItemButtons();
  if Index <= High(Buttons) then
    Result := Self.SelectHelper(Buttons[Index], Quantity, UseKeyboard);
end;

function TBanks.WalkOpen(mapObj: PRSMapObject = nil): Boolean; override;
begin
  if GameInterface.IsOpen() then
  begin
    if Bank.IsOpen() or BankPin.IsOpen() then
      Exit(True);
    GameInterface.Close(True);
  end;

  if mapObj = nil then mapObj := Self.GetClosest();

  case mapObj^.MapObjectType of
    EGameMapObjectType.OBJ:
      case CurrentLocation of
        ELocation.ROGUES_DEN: Result := mapObj^.WalkSelectOption(['Bank']) or (MainScreen.IsUpText('Emerald') and ChooseOption.Select(['Bank B', 'Bank E']));
        else Result := mapObj^.WalkClick() or (MainScreen.IsUpText('Banker') and ChooseOption.Select(['Bank B', 'Bank E']));
      end;
    EGameMapObjectType.NPC: Result := mapObj^.WalkSelectOption(['Bank B', 'Bank E']) or (MainScreen.IsUpText('Bank') and ChooseOption.Select(['Bank B', 'Bank E']));
  end;

  if not Result then
    Exit;

  Minimap.WaitMoving();
  Result := WaitUntil(GameInterface.IsOpen(), 300, 3000) and (Bank.IsOpen() or BankPin.IsOpen());
end;

{$IFNDEF SCRIPT_CHAIN}
{$IFDEF SCRIPT_GUI}
type
  TCookerConfig = record(TScriptForm)
    LocSelector: TLabeledCombobox;
    CustomFoodName: TLabeledEdit;
    FoodSelector: TLabeledCombobox;
    Food2Selector: TLabeledCombobox;
    Config: TConfigJSON;
  end;

procedure TCookerConfig.StartScript({$H-}sender: TObject);{$H+} override;
begin
  CurrentLocation := ELocation(Self.LocSelector.GetItemIndex());
  Self.Config.Put('location', Ord(CurrentLocation));

  if CurrentLocation = ELocation.WINES then
  begin
    Self.Config.Put('wine_selector', Self.FoodSelector.GetItemIndex());
    CurrentFood := Self.FoodSelector.GetText();
  end
  else
  begin
    Self.Config.Put('food_selector', Self.FoodSelector.GetItemIndex());

    if Self.FoodSelector.GetItemIndex() = 0 then
    begin
      CurrentFood := Self.CustomFoodName.GetText();
      Self.Config.Put('custom', ToStr(CurrentFood));
    end
    else
      CurrentFood := Self.FoodSelector.GetText();

    Self.Config.Put('food_selector2', Self.Food2Selector.GetItemIndex());
    if Self.Food2Selector.GetItemIndex() > 0 then
      CurrentFood2 := Self.Food2Selector.GetText()
    else
      CurrentFood2 := 'None';
  end;

  inherited;
end;

procedure TCookerConfig.FoodSelectorOnChange(sender: TObject);
var
  combobox: TComboBox;
begin
  combobox := sender;
  Self.CustomFoodName.SetVisible(combobox.getText() = 'Custom');
end;

procedure TCookerConfig.UpdateFoodItems();
begin
  Self.FoodSelector.Clear();

  if Self.LocSelector.GetItemIndex() = Ord(ELocation.WINES) then
  begin
    Self.FoodSelector.AddItemArray(WINE_GRAPES);
    if Self.Config.Has('wine_selector') then
      Self.FoodSelector.SetItemIndex(Self.Config.GetInt('wine_selector'))
    else
      Self.FoodSelector.SetItemIndex(0);
    Self.CustomFoodName.SetVisible(False);
    Self.Food2Selector.SetVisible(False); // wines have no follow-up food
    Exit;
  end;

  Self.Food2Selector.SetVisible(True);
  Self.FoodSelector.AddItemArray(RAW_FOOD);
  if Self.Config.Has('food_selector') then
    Self.FoodSelector.SetItemIndex(Self.Config.GetInt('food_selector'))
  else
    Self.FoodSelector.SetItemIndex(0);
  Self.CustomFoodName.SetVisible(Self.FoodSelector.GetText() = 'Custom');
end;

procedure TCookerConfig.LocSelectorOnChange({$H-}sender: TObject);{$H+}
begin
  Self.UpdateFoodItems();
end;

procedure TCookerConfig.Run(); override;
var
  tab: TTabSheet;
  food2: TItemArray;
begin
  Self.Setup('Elixer Cooking');
  Self.Config.Setup('elixer-cooking');
  Self.Start.setOnClick(@Self.StartScript);

  Self.AddTab('Script Settings');
  tab := Self.Tabs[High(Self.Tabs)];

  Self.CreateAccountManager(tab);

  with Self.LocSelector do
  begin
    Create(tab);
    SetCaption('Location:');
    SetLeft(TControl.AdjustToDPI(20));
    SetTop(TControl.AdjustToDPI(200));
    SetWidth(TControl.AdjustToDPI(200));
    SetStyle(csDropDownList);
    AddItemArray(['Hosidius kitchen', 'Rogues den', 'Myth''s guild', 'Wines (any bank)']);
    if Self.Config.Has('location') then
      SetItemIndex(Self.Config.GetInt('location'))
    else
      SetItemIndex(Ord(CurrentLocation));
  end;

  with Self.FoodSelector do
  begin
    Create(tab);
    SetCaption('Food type:');
    SetLeft(Self.LocSelector.GetRight() + TControl.AdjustToDPI(20));
    SetTop(Self.LocSelector.GetTop());
    SetWidth(TControl.AdjustToDPI(200));
    SetStyle(csDropDownList);
    AddItemArray(RAW_FOOD);
    Combobox.setOnChange(@Self.FoodSelectorOnChange);
    if Self.Config.Has('food_selector') then
      SetItemIndex(Self.Config.GetInt('food_selector'))
    else
      SetItemIndex(0);
  end;

  with Self.CustomFoodName do
  begin
    Create(tab);
    SetCaption('Food name (must be the exact name):');
    SetLeft(Self.FoodSelector.GetRight() + TControl.AdjustToDPI(20));
    SetTop(Self.LocSelector.GetTop());
    SetWidth(TControl.AdjustToDPI(200));
    SetVisible(Self.FoodSelector.GetText() = 'Custom');
    if Self.Config.Has('custom') then
      SetText(Self.Config.GetString('custom'))
    else
      SetText(CurrentFood);
  end;

  with Self.Food2Selector do
  begin
    Create(tab);
    SetCaption('Then cook (when the first runs out):');
    SetLeft(Self.LocSelector.GetLeft());
    SetTop(Self.LocSelector.GetBottom() + TControl.AdjustToDPI(20));
    SetWidth(TControl.AdjustToDPI(200));
    SetStyle(csDropDownList);
    // Same list as the first selector, with 'None' in the Custom slot.
    food2 := Copy(RAW_FOOD);
    food2[0] := 'None';
    AddItemArray(food2);
    if Self.Config.Has('food_selector2') then
      SetItemIndex(Self.Config.GetInt('food_selector2'))
    else
      SetItemIndex(0);
  end;

  Self.LocSelector.Combobox.setOnChange(@Self.LocSelectorOnChange);
  if Self.LocSelector.GetItemIndex() = Ord(ELocation.WINES) then
    Self.UpdateFoodItems();

  Self.CreateAntibanManager();
  Self.CreateWaspLibSettings();

  inherited;
end;

var
  CookerConfig: TCookerConfig;
{$ENDIF}
{$ENDIF}

{$IFNDEF SCRIPT_CHAIN}
begin
  {$IFDEF SCRIPT_GUI}
  CookerConfig.Run();
  {$ENDIF}
  Cooker.Run(WLSettings.MaxActions, WLSettings.MaxTime);
end.
{$ENDIF}
