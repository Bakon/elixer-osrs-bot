procedure TScript.HosidiusTeleport();
var
  attempts: Int32;
begin
  if Self.RSW.AtTile(Self.StartTile, 60) and Self.OnContract then
    Exit;

  case Self.HosidiusTP of
  'Xerics Talisman (CHARGED)':
  begin
    Self.handleTeleport(RSTeleports.XERICS_GLADE, False, hosidiusBox, 'Hosidius with Xeric Tali', 'teleport to Hosidius');
  end;

  'Hosidius TABLET':
  begin
    Self.handleTeleport(RSTeleports.HOSIDIUS_PORTAL, False, [811,507,859,544], 'Hosidius with Hosidius Tablet', 'Hosidius teleport tab');
  end;

  'House teleport TABLET':
  begin
    Self.WriteMsg('Teleporting to Hosidius with House tablet');
    for attempts := 0 to 8 do
    begin
      Inventory.ClickItem('Teleport to house', 'Outside');

      if WaitUntil(((MyPos := RSW.GetMyPos()).InBox([811,507,859,544])), 115, 10000) then
        Break;

      if attempts = 4 then
      begin
        Logout.ClickLogout();
        TerminateScript('Could not teleport to Hosidius');
      end;
    end;
  end;

  'House teleport RUNES':
  begin
    Self.handleTeleport(RSTeleports.HOUSE, True, [811,507,859,544], 'House', 'House in Hosidius');
  end;

  'Construction cape TRIMMED':
  begin
    Self.handleTeleport(RSTeleports.HOUSE_CAPE, False, [811,507,859,544], 'Tele to POH', 'Constuction cape(t)');
  end;

  'Construction cape UNTRIMMED':
  begin
    Self.handleTeleport(RSTeleports.HOUSE_CAPE, False, [811,507,859,544], 'Tele to POH', 'Constuction cape');
  end;
  end;

  if not Self.HouseIsCorrect then
  begin
    case Self.HosidiusTP of
    'Hosidius TABLET', 'House teleport TABLET', 'House teleport RUNES', 'Construction cape TRIMMED', 'Construction cape UNTRIMMED':
    begin
      if not (ScriptWalker^.GetMyPos()).InBox([811,507,859,544]) then
      begin
        Logout.ClickLogout();
        TerminateScript('Detected the incorrect House location. Put your house in Hosidius. If it is in Hosidius, you may have teleported inside. Please check the script page for setting instructions');
      end;

      Self.HouseIsCorrect := True;
    end;
    end;
  end;
end;

