  Self.handleMahoganyObject(MariahTable2, MariahTable2Ghost, 'Mariah table 2', 'Mariah table 2 ghost');
  Minimap.RotateWithinAngles(122, 194);
  Wait(850,1150);

  if Self.HappyChecker then
    Exit;

  if (MariahTable3.IsVisible or MariahTable3Ghost.IsVisible) and not Self.HappyChecker then
  begin
    Self.handleDoorObjectNormalOC(AnchorTile2, DoorTile2, AnchorColor2, DoorColor2, Self.AnchorValue2, MariahDoorUp, [1474,840]);
    Self.handleMahoganyObject(MariahTable3, MariahTable3Ghost, 'Mariah table 3', 'Mariah table 3 ghost');
    Minimap.RotateWithinAngles(122, 194);
    Self.handleDoorObjectSpecialOC(AnchorTile2, DoorTile2, AnchorColor2, DoorColor2, Self.AnchorValue2, MariahDoorUp, MariahLadderDown);
  end;

  if Self.RSW.AtTile([[1478,835]], 8) then
  begin
    Minimap.RotateWithinAngles(122, 194);
    Self.handleDoorObjectSpecialOC(AnchorTile2, DoorTile2, AnchorColor2, DoorColor2, Self.AnchorValue2, MariahDoorUp, MariahLadderDown);
  end;

  if (Minimap.PercentBlack > 30) and not Self.HappyChecker then
  begin
    Minimap.RotateWithinAngles(122, 194);
    Self.handleDownstairsObject(MariahLadderDown);
  end;

  Inc(Self.HouseLoopCount, 1);
end;

