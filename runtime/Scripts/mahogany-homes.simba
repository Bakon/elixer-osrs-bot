function TScript.handleDoorObjectSpecialOC(ATile: TPoint; DTile: TPoint; AColor: TCTS2Color; DColor:TCTS2Color; mhAnchor: Double; mhDObj: TGameObject; mhSObj: TGameObject): Boolean;
var
  door,anchor: TPointArray;

begin
  FindDoorAndAnchor(ATile, DTile, AColor, DColor, ScriptWalker^.GetMyPos(), door, anchor);

  case Self.IsDoorOpenOC(Door, Anchor, mhAnchor, False, False) of
  dsOpen: ;

  dsClosed, dsUndefined:
  begin
    mhDObj.Hover(10, False);

    if Mainscreen.IsUpText(['pen ', 'Op', 'n D']) then
    begin
      MhDObj.Click(True, 10);
      Wait(1450,1650);
      Minimap.WaitPlayerMoving(115,8000);
    end;
  end;
  end;

  try
    mhSObj.WalkClick(True, 10);
  except
    Self.WriteMsg('Walk Click failed to find a viable path. If you see this, send it to Student');
    Exit;
  end;

  XPBar.EarnedXP();

  if Self.HosidMariah or Self.ArdyRoss then
  begin
    Result := WaitUntil(not (Minimap.PercentBlack > 25), 315, 5000);
    Wait(95,125);
    Exit;
  end;

  if Self.ArdyJess then
  begin
    Result := WaitUntil(XPBar.EarnedXP(), 215, 5000);
    Exit;
  end;

  Result := WaitUntil((Minimap.PercentBlack > 25), 315, 8000);
  Wait(95,125);
end;

function TScript.handleDoorObjectSpecialCO(ATile: TPoint; DTile: TPoint; AColor: TCTS2Color; DColor:TCTS2Color; mhAnchor: Double; mhDObj: TGameObject; mhSObj: TGameObject): Boolean;
var
  door,anchor: TPointArray;
begin
  FindDoorAndAnchor(ATile, DTile, AColor, DColor, ScriptWalker^.GetMyPos(), door, anchor);

  case Self.IsDoorOpenCO(Door, Anchor, mhAnchor, False, False) of
  dsOpen: ;

  dsClosed, dsUndefined:
  begin
    mhDObj.Hover(10, False);

    if Mainscreen.IsUpText(['pen ', 'Op', 'n D']) then
    begin
      MhDObj.Click(True, 10);
      Wait(1150,1450);
      Minimap.WaitPlayerMoving(1500,3000);
    end;
  end;
  end;

  try
    mhSObj.WalkClick(True, 10);
  except
    Self.WriteMsg('Walk Click failed to find a viable path. If you see this, send it to Student');
    Exit;
  end;

  Result := WaitUntil((Minimap.PercentBlack > 33), 315, 8000);
end;

