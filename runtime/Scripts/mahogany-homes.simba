begin
  if Self.RSW.AtTile(Self.StartTile, 60) and Self.OnContract then
    Exit;

  Self.handleTeleport(RSTeleports.CRAFTING_GUILD_CAPE, False, craftinguildBox, 'Crafting guild', 'Crafting cape');
end;

function TScript.HappyChecker(): Boolean;
begin
  if (Self.HouseLoopCount = 3) then
  begin
    Self.WriteMsg('You activated a loop failsafe.');
    Exit(True);
  end;

  if Self.ArdyJess then
    Result := Chat.FindMessage('Jess seems happy with', [811014], 2, 7);

  if Self.ArdyNoella then
    Result := Chat.FindMessage('Noella seems happy with', [811014], 2, 7);

  if Self.ArdyRoss then
    Result := Chat.FindMessage('Ross seems happy with', [811014], 2, 7);

  if Self.FallyLarry then
    Result := Chat.FindMessage('Larry seems happy with', [811014], 2, 7);

  if Self.FallyNorman then
    Result := Chat.FindMessage('Norman seems happy with', [811014], 2, 7);

  if Self.FallyTau then
    Result := Chat.FindMessage('Tau seems happy with', [811014], 2, 7);

  if Self.HosidBarbara then
    Result := Chat.FindMessage('Barbara seems happy with', [811014], 2, 7);

  if Self.HosidLeela then
    Result := Chat.FindMessage('Leela seems happy with', [811014], 2, 7);

  if Self.HosidMariah then
    Result := Chat.FindMessage('Mariah seems happy with', [811014], 2, 7);

  if Self.VarrockBob then
    Result := Chat.FindMessage('Bob seems happy with', [811014], 2, 7);

  if Self.VarrockJeff then
    Result := Chat.FindMessage('Jeff seems happy with', [811014], 2, 7);

  if Self.VarrockSarah then
    Result := Chat.FindMessage('Sarah seems happy with', [811014], 2, 7);
end;

function TScript.PlayerNearby(): Boolean; //placeholder for now
var
  playerPoints: TPointArray := Minimap.GetDots(EMinimapDot.PLAYER);
begin
  FilterPointsDist(playerPoints, 0, 30, Minimap.Center.X, Minimap.Center.Y);
  Result := Length(playerPoints) = 0;
end;

procedure TScript.HandleNPC(NPCMMDot: TMMDot);
var
  attempts: int32;
begin
  writeln('Turning in the contract');
  for attempts := 0 to 10 do
  begin
    if NPCMMDot.SelectOption(['lk-t'], 10) then
      WaitUntil((Chat.GetChat.Contains('finished with') or Chat.GetChat.Contains('it going') or Chat.GetChat.Contains('your contractor') or Chat.GetChat.Contains('Perhaps another')), 150, 10000);

    if Chat.GetChat.Contains('finished with') then
      Break;

    if Chat.GetChat.Contains('your contractor') then
      Break;

    if Chat.GetChat.Contains('Perhaps another') then
      Break;

    if attempts > 6 then begin
      Antiban.RandomRotate();
    end;
  end;
end;

function TScript.handleRepairObject(mhRepObj: TGameObject; mhRepObjStr : String): Boolean;
begin
  XPbar.EarnedXP();

  if Self.HappyChecker then
    Exit;

  if Mainscreen.IsUpText('Cook ') then
    Exit;

  if not mhRepObj.SelectOption(['pair '], 3) then
    Exit;

  Result :=  WaitUntil(XPbar.EarnedXP(), 115, 10000);

  if DEBUG_BOOLEAN then
    Bot.WriteMsg(mhRepObjStr + ' has been repaired');

  Wait(125,165);
end;

function TScript.handleMahoganyObject(mhObj: TGameObject; mhObjGhost: TGameObject; mhObjStr : String; mhObjGhostStr : String): Boolean;
var
  attempts : Int32;
  Angle : Double;
  CubArray : TCuboidExArray;
  T : TCountDown;
begin
  if Self.HappyChecker then
    Exit;

  if not mhObj.IsVisible and not mhObjGhost.IsVisible and DEBUG_BOOLEAN then
    Bot.WriteMsg(mhObjStr + ' and ' + mhObjGhostStr + ' cannot be found');

  XPBar.EarnedXP();

  for attempts := 0 to 2 do
  begin
    ATPA := MainScreen.FindObject(mhObj.Finder);

    if Length(ATPA) = 0 then begin
      if not Self.RSW.MakePointVisible(mhObj.Coordinates[0]) and
        not Self.RSW.WalkBlind(mhObj.Coordinates[0]) then
      Exit;

      if attempts >= 2 then begin
        Angle := Minimap.GetCompassAngle() + Random(-50, 50);
        Minimap.SetCompassAngle(angle, 10);
      end;

      Continue;
    end;

    CubArray := mhObj.GetCuboidArray;

    if Length(CubArray) = 0 then
      Continue;

    Mouse.Move(CubArray[0].Center.Random(0, 2));

    if MainScreen.IsUpText('lk-t') then
    begin
      Mouse.Click(MOUSE_RIGHT);
      ChooseOption.Select('Remove ', MOUSE_LEFT);
    end
    else
    begin
      if MainScreen.IsUpText('move ') then
        Mouse.Click(MOUSE_LEFT);
    end;

    if DEBUG_BOOLEAN then
      Bot.WriteMsg('Attempting to remove ' + mhObjStr);

    if not MainScreen.IsUpText('move ') then
      Break;

    Wait(650,750);

    Minimap.WaitPlayerMoving(50, 5000);

    if Chat.ClickContinue(True) then
      Exit;

    if mhObjGhost.IsVisible() then
      Break;
  end;

  if mhObjGhost.Hover(5, false) then
  begin
    if not MainScreen.IsUpText('ild ') then
      Exit;

    if not mhObjGhost.Click(True, 5) then
      Exit;

    if DEBUG_BOOLEAN then
      Bot.WriteMsg('Attempting to repair ' + mhObjGhostStr);

    T.init(9000);
    While not T.IsFinished do
    begin
      if GameInterface.IsOpen(EInterfaceType.ANY) then
      begin
        Self.InterfaceHandler();
        WaitUntil(XPbar.EarnedXP, 115, 9000);
        Result := True;
        Break;
      end else
      if XPBar.EarnedXP then
      begin
        Result := True;
        Break;
      end else if Chat.ClickContinue(True) then
      begin
        Result := True;
        Break;
      end;
    end;

    if Result then Wait(125,165);
  end;
end;

procedure TScript.handleUpstairsObject(upObj: TGameObject);
var
  attempts: Int32;
begin
  if Self.HappyChecker and not Self.FallyNorman then
    Exit;

  for attempts := 0 to 8 do
  begin
    if (Minimap.PercentBlack > 25) then
      Break;

    if upObj.Hover(8, false) then
      upObj.Click(True, 3);

    WaitUntil((Minimap.PercentBlack > 25), 315, 8000);
  end;

  Wait(350, 450);
end;

procedure TScript.handleDownstairsObject(downObj: TGameObject);
var
  attempts: Int32;
begin
  if (not (Minimap.PercentBlack > 25)) then
    Exit;

  for attempts := 0 to 8 do
  begin
    if (not (Minimap.PercentBlack > 25)) then
      Break;

    if downObj.Hover(8, false) then
      downObj.Click(True, 3);

    WaitUntil(not (Minimap.PercentBlack > 25), 315, 8000);
  end;

  Wait(350, 450);
end;

function TScript.handleDoorObjectNormalOC(ATile: TPoint; DTile: TPoint; AColor: TCTS2Color; DColor:TCTS2Color; mhAnchor: Double; mhDObj: TGameObject; Coords: TPoint): Boolean;
var
  door,anchor: TPointArray;
  attempts:int32;
begin
  FindDoorAndAnchor(ATile, DTile, AColor, DColor, ScriptWalker^.GetMyPos(), door, anchor);

  case Self.IsDoorOpenOC(Door, Anchor, mhAnchor, False, False) of
  dsOpen:
  for attempts := 0 to 8 do
  begin
    if not Self.RSW.AtTile(Coords, 6) then
      Self.RSW.WalkBlind(Coords);

    if Self.RSW.AtTile(Coords, 6) then
      Break;

    mhDObj.Hover(10, False);

    if Mainscreen.IsUpText(['pen ', 'Op', 'n D']) then
    begin
      MhDObj.Click(True, 10);
      Wait(1450,1650);
      Minimap.WaitPlayerMoving(500,8000);
    end;
  end;

  dsClosed, dsUndefined:
  for attempts := 0 to 8 do
  begin
    mhDObj.Hover(10, False);

    if Mainscreen.IsUpText(['pen ', 'Op', 'n D']) then
    begin
      MhDObj.Click(True, 10);
      Wait(1450,1650);
      Minimap.WaitPlayerMoving(500,8000);
    end;

    if not Self.RSW.AtTile(Coords, 6) then
      Self.RSW.WalkBlind(Coords);

    if Self.RSW.AtTile(Coords, 6) then
      Break;
  end;
  end;

  if not Self.RSW.AtTile(Coords, 6) then
    Self.RSW.WalkBlind(Coords);

  Result := WaitUntil(Self.RSW.AtTile(Coords, 6), 115, 5000);
end;

