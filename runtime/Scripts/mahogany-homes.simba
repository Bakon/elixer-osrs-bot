procedure TScriptForm.Setup(caption: String = 'Script Form'; size: TPoint = [750, 500]; allowResize: Boolean = False); override;
var
  Img: TPicture;
  BGImg: TImage;
  SButton: TButton;
begin
  inherited;

  Img.init();

  try
    Img.LoadFromFile('Resources\SMH2GUI.png');
  except
    writeln('Could not load the gui image')
  finally
  end;

  with BGImg do
  begin
    Init(Self.PageControl);
    SetParent(Self.PageControl);
    SetBounds(0,0,Self.Form.getWidth,Self.Form.getHeight);
    SetPicture(Img);
  end;

  Self.Start.setVisible(False);
  with SButton do
  begin
    Create(Self.Form);
    SetBounds(Self.Form.GetRight-190, Self.Form.GetBottom-70, 180, 60);
    GetFont.SetName('Bahnschrift');
    GetFont.SetSize(15);
    SetCaption('Run');
    SetOnClick(@Self.StartScript);
  end;

  Self.AddTab(CreateSettingsTab());
  Self.CreateAccountManager();
  Self.CreateFarmRunSettingsTab();
  Self.CreateBirdhouseRunSettings();
end;

// Undo the bogged down version in WaspLib
function TChooseOption.Select(Text: TStringArray; MouseAction: Int32 = MOUSE_LEFT; CaseSensitive: Boolean = True; CloseIfNotFound: Boolean = True): Boolean; override;
var
  Choices: TChooseOption_OptionArray;
  I, J: Int32;
begin
  if Self.Open() then
  begin
    Wait(0, 750, wdLeft);

    Choices := GetOptions();

    for I := 0 to High(Choices) do
      for J := 0 to High(Text) do
        if (CaseSensitive and (Text[J] in Choices[I].Text)) or ((not CaseSensitive) and (Lowercase(Text[J]) in Lowercase(Choices[I].Text))) then
        begin
          Self.Select(Choices[I], MouseAction);
          Exit(True);
        end;

    if CloseIfNotFound then
    begin
      WaitEx(400, 150);

      Self.Close();
    end;
  end;
end;

{ Import SRL-F snippets }
procedure TScript.DoLoseFocus();
var T: Int32;
begin
  T := SRL.NormalRange(2500,15000);
  Antiban.DebugLn('Losing focus for '+SRL.MsToTime(T, Time_Short));
  Antiban.LoseFocus(T);
end;

function TMinimap.IsUnloadedVisible(out unloadedBlackTPA: TPointArray): Boolean;  // Skunkworks
var
  unloadedClusters: T2DPointArray;
begin
  if Minimap.IsPlayerMoving() then // if we are still moving we don't care about unloaded
    Exit(False);

  SRL.FindColors(unloadedBlackTPA, CTS2(65536, 1, 0.01, 0.01), Minimap.Bounds);
  unloadedClusters := unloadedBlackTPA.Cluster(1);
  unloadedClusters.FilterSize(200, EComparator.__GT__);
  if unloadedClusters.Len() = 0 then
    Exit(False);

  Self.DebugLn('unloaded cluster is visible');
  unloadedBlackTPA := unloadedClusters.Biggest();
  Exit(True);
end;

function TMinimap.ClickIntoUnloaded(): Boolean;  // Skunkworks
var
  blackTPA: TPointArray;
begin
  if not self.IsUnloadedVisible(blackTPA) then
    Exit(False);

  WriteLn('clicking into unloaded minimap region');
  Mouse.Click(blackTPA.RandomMean(), MOUSE_LEFT);
  if Mainscreen.DidRedClick() then
    Debug(Mainscreen.Bounds);
end;

procedure TScript.OnWalkEvent(Sender: PWalker; Position: TPoint; Destination: TPoint);
begin
  //if Minimap.ClickIntoUnloaded() then
  //  Bot.WriteMsg('We had to click into unloaded map');

  if SRL.Dice(5) then
    Mouse.RandomMovement;

  Sender^.ScreenWalk := SRL.Dice(45);

  Position    := [];
  Destination := [];
end;

procedure TScript.GameEndReset(); // placeholder name
begin
  Self.VarrockBob := False;
  Self.VarrockJeff := False;
  Self.VarrockSarah := False;
  Self.FallyTau := False;
  Self.FallyLarry := False;
  Self.FallyNorman := False;
  Self.HosidLeela := False;
  Self.HosidMariah := False;
  Self.HosidBarbara := False;
  Self.ArdyRoss := False;
  Self.ArdyJess := False;
  Self.ArdyNoella := False;

  Self.OnContract := False;
  Self.WhichNPC := [];

  Self.HouseLoopCount := 0;

  Self.Report();

  if not Self.UsePlankSack then
    Self.GetPlankAmount();
end;

procedure TScript.DoAntiban();
begin
  InactivityTimerMH.Pause();
  Self.TrueRunTime.Pause();
  Antiban.DoAntiban();

  if (not GameClient.IsLoggedIn) then
    Login.LoginPlayer(False);

  if Self.DoFarmRuns and FarmRunner.ReadyTimer.IsFinished() then
  begin
    FarmRunner.DoFarmRun;
    Self.GameEndReset();
  end;

  if Self.DoBHRuns and BirdHouseRunner.ScriptIntervalTimer.IsFinished() then
  begin
    BirdHouseRunner.DoBirdHouseRun();
    Self.GameEndReset();
  end;

  Self.TrueRunTime.Resume();
  InactivityTimerMH.Resume();
end;

procedure TScript.SetupAntiban();
begin
  Antiban.AddTask((ONE_MINUTE*4)*Self.ABTimeMod,  @Mouse.RandomMovement);
  Antiban.AddTask((ONE_MINUTE*8)*Self.ABTimeMod,  @Self.DoLoseFocus);
end;

procedure TScript.Report();
var
  CurrentXP := XPBar.Read();
  GainedXP := ((CurrentXP) - (StartXP));
  RunTime: Int64;
begin
  RunTime  := Self.TrueRunTime.ElapsedTime();

  WriteLn('|===================================|');
  WriteLn('|------- ~ Mahogany Homes ~ -------|');
  WriteLn('|===================================|');
  WriteLn(padR('| Runtime: ' + SRL.MsToTime(RunTime, Time_Short), 36, ' ') + '|');
  WriteLn(padR('| Contracts: ' + IntToStr(GameCount), 36, ' ') + '|');
  WriteLn(padR('| Contracts/Hr: ' + IntToStr(Round(GameCount / (RunTime / 3600000))), 36, ' ') + '|');
  WriteLn(padR('| XP Gained: ' + ToString(Round(GainedXP)), 36, ' ') + '|');
  WriteLn(padR('| XP/Hr: ' + ToString(Round((GainedXP) / (RunTime / 3600000))), 36, ' ') + '|');
  WriteLn(padR('| Points: ' + (IntToStr(Self.pointsperContract * GameCount)), 36, ' ') + '|');
  WriteLn(padR('| Point/Hr: ' + IntToStr(Round(((Self.pointsperContract) * (GameCount)) / (RunTime / 3600000))), 36, ' ') + '|');
  if Self.TakeBreaks then
    WriteLn(padR('| Next break: ' + SRL.MsToTime(Max(0, Round(Antiban.Breaks[0].NextAtTime - RunTime)), Time_Short), 36, ' ') + '|');
  if Self.TakeSleeps then
    WriteLn(padR('| Next sleep: ' + SRL.MsToTime(Max(0, Round(Antiban.Sleeps[0].NextAtTime - RunTime)), Time_Short), 36, ' ') + '|');
  if self.DoBHRuns then
    WriteLn(padR('| Next BH run: ' + SRL.MsToTime(BirdHouseRunner.ScriptIntervalTimer.TimeRemaining(), TTimeFormat.Time_Short), 36, ' ') + '|');
  if self.DoFarmRuns then
    WriteLn(padR('| Next farm run: ' + SRL.MsToTime(FarmRunner.ReadyTimer.TimeRemaining(), TTimeFormat.Time_Short), 36, ' ') + '|');
  WriteLn(padR('| Shutdown: ' + ToStr(SRL.MsToTime(Self.ShutdownTime - GetTimeRunning, Time_Short)), 36, ' ') + '|');
  WriteLn('|===================================|');
  WriteLn('|=-=-=-=-=- ~ Elixer ~ -=-=-=-=-=-=-|');
  WriteLn('|===================================|');
end;

function TChat.FindMessage(Message: String; Colors: TIntegerArray = CHAT_MESSAGE_COLORS; startLine, endLine: Int32): Boolean; overload;
var
  I: Int32;
begin
  for I := startLine to endLine do
    if Message in Self.GetMessage(I, Colors) then
      Exit(True);
end;

procedure TMinimap.RotateWithinAngles(min, max: Int32);
var
  minMaxAvg: Int32 := Floor((min + max) div 2);
  preferredAngle: Int32 := SRL.SkewedRand(minMaxAvg, min, max);
begin
  if preferredAngle < 0 then
    preferredAngle := preferredAngle + 360;

  if InRange(self.getCompassAngle(True), min, max) then
    Exit;

  Minimap.SetCompassAngle(preferredAngle);
end;

procedure TScript.GetPlankAmount();
begin
  if Self.UsePlankSack and PlankCheckNeeded then
  begin
    if not Inventory.ContainsItem('Plank sack') then
      Exit;

    Inventory.ClickItem('Plank sack', 'Check');
    WaitUntil(((' planks:') in Chat.GetMessage(7, [CHAT_COLOR_BLACK])), 115, 5000);

    Self.plankLine1 := Chat.GetMessage(4);
    Self.plankLine2 := Chat.GetMessage(5);
    Self.plankLine3 := Chat.GetMessage(6);
    Self.plankLine4 := Chat.GetMessage(7);

    if not Self.plankLine4.ContainsAny(['currently empty']) then
      Self.plankAmounts := Self.plankLine4.ExtractNumbers()
    else
      Self.plankAmounts := [0];

    case ContractEnum of
    EContract.BEGINNER:
    begin
      if Self.plankLine1.ContainsAny(['Oak', 'Teak', 'Mahogany']) or
         Self.plankLine2.ContainsAny(['Oak', 'Teak', 'Mahogany'])or
         Self.plankLine3.ContainsAny(['Oak', 'Teak', 'Mahogany']) or
         Self.plankLine4.ContainsAny(['Oak', 'Teak', 'Mahogany']) then
        TerminateScript('You have the wrong planks in your plank sack. Empty it, relog and then restart the script');

      Self.PlanksStored := (Self.plankAmounts[0]) + (Inventory.CountItem(Self.PlankType));
      Self.BarsStored := (Inventory.CountItem('Steel bar'));
    end;

    EContract.NOVICE:
    begin
      if Self.plankLine1.ContainsAny(['Basic', 'Teak', 'Mahogany']) or
         Self.plankLine2.ContainsAny(['Basic', 'Teak', 'Mahogany']) or
         Self.plankLine3.ContainsAny(['Basic', 'Teak', 'Mahogany']) or
         Self.plankLine4.ContainsAny(['Basic', 'Teak', 'Mahogany']) then
        TerminateScript('You have the wrong planks in your plank sack. Empty it, relog and then restart the script');

      Self.PlanksStored := (Self.plankAmounts[0]) + (Inventory.CountItem(Self.PlankType));
      Self.BarsStored := (Inventory.CountItem('Steel bar'));
    end;

    EContract.ADEPT:
    begin
      if Self.plankLine1.ContainsAny(['Basic', 'Oak', 'Mahogany']) or
         Self.plankLine2.ContainsAny(['Basic', 'Oak', 'Mahogany']) or
         Self.plankLine3.ContainsAny(['Basic', 'Oak', 'Mahogany']) or
         Self.plankLine4.ContainsAny(['Basic', 'Oak', 'Mahogany']) then
        TerminateScript('You have the wrong planks in your plank sack. Empty it, relog and then restart the script');

      Self.PlanksStored := (Self.plankAmounts[0]) + (Inventory.CountItem(Self.PlankType));
      Self.BarsStored := (Inventory.CountItem('Steel bar'));
    end;

    EContract.EXPERT:
    begin
      if Self.plankLine1.ContainsAny(['Basic', 'Oak', 'Teak']) or
         Self.plankLine2.ContainsAny(['Basic', 'Oak', 'Teak']) or
         Self.plankLine3.ContainsAny(['Basic', 'Oak', 'Teak']) or
         Self.plankLine4.ContainsAny(['Basic', 'Oak', 'Teak']) then
        TerminateScript('You have the wrong planks in your plank sack. Empty it, relog and then restart the script');

      Self.PlanksStored := (Self.plankAmounts[0]) + (Inventory.CountItem(Self.PlankType));
      Self.BarsStored := (Inventory.CountItem('Steel bar'));
    end;
    end;

    Self.PlankCheckNeeded := False;
  end
  else
  if Self.UsePlankSack and not Self.PlankCheckNeeded then
  begin
    Self.PlanksStored := 28 + (Inventory.CountItem(Self.PlankType));
    Self.BarsStored := (Inventory.CountItem('Steel bar'));
  end
  else
  begin
    case ContractEnum of
    EContract.BEGINNER:
    begin
      Self.PlanksStored := (Inventory.CountItem(Self.PlankType));
      Self.BarsStored := (Inventory.CountItem('Steel bar'));
    end;

    EContract.NOVICE:
    begin
      Self.PlanksStored := (Inventory.CountItem(Self.PlankType));
      Self.BarsStored := (Inventory.CountItem('Steel bar'));
    end;

    EContract.ADEPT:
    begin
      Self.PlanksStored := (Inventory.CountItem(Self.PlankType));
      Self.BarsStored := (Inventory.CountItem('Steel bar'));
    end;

    EContract.EXPERT:
    begin
      Self.PlanksStored := (Inventory.CountItem(Self.PlankType));
      Self.BarsStored := (Inventory.CountItem('Steel bar'));
    end;
    end;
  end;

  if DEBUG_BOOLEAN then begin
    Bot.WriteMsg('Our plank type is: ' + Self.PlankType);
    Bot.WriteMsg('Our plank count is: ' + ToStr(Self.PlanksStored));
  end;
end;

function TScript.hasEnoughPlanks(): Boolean;
begin
  if not Inventory.Open() then Exit();;

  if Self.UsePlankSack and not Inventory.ContainsItem('Plank sack') then
    Exit(False);

  if Self.UsePlankSack then
  begin
    Self.PlankSackCount := ((Self.PlanksStored) - Self.PlanksNeeded);

    if (Self.PlankSackCount >= 1) and (Self.BarsStored > 0) then
      Exit(True);
  end;

  if not Self.UsePlankSack then
  begin
    Self.PlankSackCount := (Self.PlanksStored);

    if (Self.PlankSackCount >= 16) and (Self.BarsStored > 0) then
      Exit(True);
  end;
end;

function TScript.IsDoorOpenCO(Door, Anchor: TPointArray; Split: Double; Inverse: Boolean = False; UseMean: Boolean = False): EDoorState;
var
  p,q: Vector3;
  ptAnchor,ptDoor: TPoint;
begin
  // ensure no failure
  if (length(Anchor) = 0) or (length(Door) = 0) then Exit(dsUndefined);

  // find the point in the ledger that's closest to the door and vice versa
  // alternatively we could just use the mean and skip this step in many cases.
  if not UseMean then begin
    anchor.Sort(door.Mean());
    ptAnchor := anchor[0];
    door.Sort(ptAnchor);
    ptDoor := door[0];
  end else begin
    ptAnchor := anchor.Mean();
    ptDoor   := door.Mean();
  end;

  // convert to minimap to work in 2d space, so distance is always the same no matter position,
  // camera angle and zoom.
  p := MainScreen.PointToMM(ptDoor);
  q := MainScreen.PointToMM(ptAnchor);

  if (p.Distance(q) <= Split) xor inverse then
    Exit(dsClosed)
  else
    Exit(dsOpen);
end;

function TScript.IsDoorOpenOC(Door, Anchor: TPointArray; Split: Double; Inverse: Boolean = False; UseMean: Boolean = False): EDoorState;
var
  p,q: Vector3;
  ptAnchor,ptDoor: TPoint;
begin
  // ensure no failure
  if (length(Anchor) = 0) or (length(Door) = 0) then Exit(dsUndefined);

  // find the point in the ledger that's closest to the door and vice versa
  // alternatively we could just use the mean and skip this step in many cases.
  if not UseMean then begin
    anchor.Sort(door.Mean());
    ptAnchor := anchor[0];
    door.Sort(ptAnchor);
    ptDoor := door[0];
  end else begin
    ptAnchor := anchor.Mean();
    ptDoor   := door.Mean();
  end;

  // convert to minimap to work in 2d space, so distance is always the same no matter position,
  // camera angle and zoom.
  p := MainScreen.PointToMM(ptDoor);
  q := MainScreen.PointToMM(ptAnchor);

  if (p.Distance(q) <= Split) xor inverse then
    Exit(dsOpen)
  else
    Exit(dsClosed);
end;

procedure TScript.FindDoorAndAnchor(ATile: TPoint; DTile: TPoint; AColor: TCTS2Color; DColor:TCTS2Color; WorldPos: TPoint; out Door, Anchor: TPointArray);
var
  ledger: TPointArray;
  ATPA: T2DPointArray;
  LeadgerSearchBox, DoorSearchBox: TBox;
begin
  // rough area of where the ledger and door is
  LeadgerSearchBox := RSW.GetTileMSEx(WorldPos, ATile).Expand(5).Bounds();
  DoorSearchBox    := RSW.GetTileMSEx(WorldPos, DTile).Expand(5).Bounds();

  DoorSearchBox.LimitTo(MainScreen.Bounds);
  LeadgerSearchBox.LimitTo(MainScreen.Bounds);

  // find the ledger, and the door tpas
  srl.FindColors(ledger, AColor,  LeadgerSearchBox);
  srl.FindColors(door,   DColor,  DoorSearchBox);

  // basic noise filtering
  ATPA := door.Grow(1).Cluster(2);
  door := ATPA.Biggest();

  // basic noise filtering, small object, so I dont erode noise.
  ATPA := ledger.Cluster(2);
  ledger := ATPA.Biggest();

  Anchor := Ledger;
end;

function TScript.ringofduelingCheck(): Boolean;
begin
  MyPos := Self.RSW.GetMyPos();
  if (('dueling crumbles to dust' in Chat.GetMessage(7, [CHAT_COLOR_PURPLE])) or ('dueling crumbles to dust' in Chat.GetMessage(6, [CHAT_COLOR_PURPLE])) or ('dueling crumbles to dust' in Chat.GetMessage(5, [CHAT_COLOR_PURPLE]))) then
    Exit(Self.ringofdueling := True);
end;

function TScript.handleTeleport(TTLocation: TTeleportLocation; useMagic: Boolean; telBox: TBox; locString: String; TTmethodString: String): Boolean;
var
  attempts : Int32;
begin
  if (MyPos := RSW.GetMyPos()).InBox(telBox) then
    Exit();

  Self.WriteMsg('Teleporting to ' +  locString);
  for attempts := 0 to 20 do
  begin
    Transport.run(TTLocation, useMagic);
    MyPos := RSW.GetMyPos();

    Result := WaitUntil((MyPos := RSW.GetMyPos()).InBox(telBox), 115, 10000);

    if Result then
      Break;

    if attempts >= 19 then
    begin
      Logout.ClickLogout();
      TerminateScript('Could not find or use ' + TTmethodString);
    end;
  end;

  MyPos := RSW.GetMyPos();
end;

procedure TScript.CastleWarsTeleport();
begin
  Self.handleTeleport(RSTeleports.CASTLE_WARS, False, castlewarsBox, 'Castle Wars', 'Ring of dueling');
  Self.ringofduelingCheck();
end;

procedure TScript.VarrockTeleport();
var
  TabSlot : Int32;
begin
  if Self.RSW.AtTile(Self.StartTile, 60) and Self.OnContract then
    Exit;

  case Self.ArFaVaTP of
  'TABLETS (any spellbook)':
  begin
    if Inventory.FindItem('Varrock teleport', TabSlot) then begin
      if not Self.VarrockTeleportSetup then begin
        Inventory.ClickSlot(TabSlot, 'Toggle');
        if not WaitUntil(('portal' in Chat.GetChatTitle), 17, 3000) then
          Exit;

        if 'Grand' in Chat.GetChatTitle then begin
          Chat.ClickOption('Varrock');
          if not WaitUntil(Chat.FindMessage('central Varr'), 17, 3000) then
            Exit;
        end;

        Self.VarrockTeleportSetup := True;
      end;
    end;

    Self.handleTeleport(RSTeleports.VARROCK, False, varrockBox, 'Varrock', 'Varrock teleport tab');
  end;

  'RUNES (normal spellbook)':
  begin
    Self.handleTeleport(RSTeleports.VARROCK, True, varrockBox, 'Varrock', 'teleport to Varrock');
  end;
  end;
end;

procedure TScript.ArdougneTeleport();
begin
  if Self.RSW.AtTile(Self.StartTile, 60) and Self.OnContract and not (MyPos := RSW.GetMyPos()).InBox([256,226,284,242]) then
    Exit;

  case Self.ArFaVaTP of
  'TABLETS (any spellbook)':
  begin
    Self.handleTeleport(RSTeleports.ARDOUGNE, False, [421,232,502,325], 'Ardougne', 'Ardougne teleport tab');
  end;

  'RUNES (normal spellbook)':
  begin
    Self.handleTeleport(RSTeleports.ARDOUGNE, True, [421,232,502,325], 'Ardougne', 'teleport to Ardougne');
  end;
  end;
end;

procedure TScript.FaladorTeleport();
begin
  if Self.RSW.AtTile(Self.StartTile, 60) and Self.OnContract then
    Exit;

  case Self.ArFaVaTP of
  'TABLETS (any spellbook)':
  begin
    Self.handleTeleport(RSTeleports.FALADOR, False, faladorBox, 'Falador', 'Falador teleport tab');
  end;

  'RUNES (normal spellbook)':
