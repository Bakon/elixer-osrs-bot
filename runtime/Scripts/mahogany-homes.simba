procedure TScript.RossHouse();
begin
  Minimap.RotateWithinAngles(30, 130);
  Self.handleMahoganyObject(RossDrawers1, RossDrawers1Ghost, 'Ross drawers 1', 'Ross drawers 1 ghost');

  if ('reach that' in Chat.GetMessage(7, [0])) then
  begin
    Self.DoorHandler();
    Exit;
  end;

  Self.handleMahoganyObject(RossDrawers2, RossDrawers2Ghost, 'Ross drawers 2', 'Ross drawers 2 ghost');
  Self.handleRepairObject(RossRange, 'Ross range');

  if Self.HappyChecker then
    Exit;

  Self.handleUpstairsObject(RossLadderUp);

  if (not Minimap.PercentBlack > 25) then
    Exit;

  Minimap.RotateWithinAngles(15, -45);
  Self.handleRepairObject(RossHatStand, 'Ross hat stand');
  Minimap.RotateWithinAngles(92, -59);
  Self.handleDoorObjectNormalOC(AnchorTile, DoorTile, AnchorColor, DoorColor, Self.AnchorValue, RossDoorUp1, [1258,110]);
  Self.handleRepairObject(RossMirror, 'Ross mirror');
  Self.handleMahoganyObject(RossBed, RossBedGhost, 'Ross bed', 'Ross bed ghost');
  Minimap.RotateWithinAngles(92, -59);
  Wait(850,1150);

  if Self.HappyChecker then
  begin
    Self.handleDoorObjectSpecialOC(AnchorTile, DoorTile, AnchorColor, DoorColor, Self.AnchorValue, RossDoorUp1, RossLadderDown);
    Exit;
  end;

  Self.handleDoorObjectNormalOC(AnchorTile, DoorTile, AnchorColor, DoorColor, Self.AnchorValue, RossDoorUp1, [1258,122]);

  Minimap.RotateWithinAngles(2,42);
  Minimap.WaitMoving();
  Self.handleDoorObjectNormalOC(AnchorTile2, DoorTile2, AnchorColor2, DoorColor2, Self.AnchorValue2, RossDoorUp2, [1238,114]);
  Self.handleMahoganyObject(RossDoubleBed, RossDoubleBedGhost, 'Ross double bed', 'Ross double bed ghost');
  Minimap.RotateWithinAngles(2,42);
  Self.handleDoorObjectSpecialOC(AnchorTile2, DoorTile2, AnchorColor2, DoorColor2, Self.AnchorValue2, RossDoorUp2, RossLadderDown);
  Wait(450,700);
  Inc(Self.HouseLoopCount, 1);
end;

procedure TScript.NoellaHouse();
begin
  if Self.RSW.AtTile([434,208], 4) then
    Exit;

  Self.handleRepairObject(NoellaGFClock, 'Noelle clock');
  Self.handleMahoganyObject(NoellaTable1, NoellaTable1Ghost, 'Noella table 1', 'Noella table 1 ghost');
  Self.handleMahoganyObject(NoellaDrawers, NoellaDrawersGhost, 'Noella drawer', 'Noella drawer ghost');
  Self.handleMahoganyObject(NoellaTable2, NoellaTable2Ghost, 'Noella table 2', 'Noella table 2 ghost');
  Self.handleDownstairsObject(NoellaStairsLeftDown);
  Self.handleUpstairsObject(NoellaStairsRight);
  Self.handleRepairObject(NoellaHatStand, 'Noella hat stand');
  WaitUntil(not XPBar.EarnedXP(), 115, 5000);
  Self.handleRepairObject(NoellaMirror, 'Noella mirror');
  Self.handleMahoganyObject(NoellaCupboard, NoellaCupboardGhost, 'Noella cupboard', 'Noella cupboard ghost');
  Minimap.RotateWithinAngles(6,96);  //Temp Fix
  Self.handleMahoganyObject(NoellaDresser, NoellaDresserGhost, 'Noella dresser', 'Noella dresser ghost');
  Self.handleDownstairsObject(NoellaStairsRightDown);
  Inc(Self.HouseLoopCount, 1);

  if not Self.HappyChecker and not (Self.HouseLoopCount = 3) then
    Self.handleUpstairsObject(NoellaStairsLeft);

  if (Minimap.PercentBlack > 25) and not Self.InsideHouse then
  begin
    Self.handleDownstairsObject(NoellaStairsRightDown);
    Self.handleUpstairsObject(NoellaStairsLeft);
  end;
end;

procedure TScript.JessHouse();
begin
  if (not (Minimap.PercentBlack > 25)) then
    Exit;

  Self.handleMahoganyObject(JessDrawers1,JessDrawers1Ghost, 'Jess drawers 1', 'Jess drawers 1 ghost');
  Minimap.RotateWithinAngles(42,124);
  Self.handleDoorObjectNormalOC(AnchorTile2, DoorTile2, AnchorColor2, DoorColor2, Self.AnchorValue2, JessDoor1, [1286,202]);
  Self.handleMahoganyObject(JessCabinet1,JessCabinet1Ghost, 'Jess cabinet 1', 'Jess cabinet 1 ghost');
  Minimap.RotateWithinAngles(-3,25);
  Self.handleMahoganyObject(JessCabinet2,JessCabinet2Ghost, 'Jess cabinet 2', 'Jess cabinet 2 ghost');
  Minimap.RotateWithinAngles(15,87);
  Self.handleDoorObjectNormalOC(AnchorTile3, DoorTile3, AnchorColor3, DoorColor3, Self.AnchorValue3, JessDoor2, [1250,206]);
  Self.handleMahoganyObject(JessTable,JessTableGhost, 'Jess table', 'Jess table ghost');
  Self.handleMahoganyObject(JessBed,JessBedGhost, 'Jess bed', 'Jess bed ghost');
  Self.handleRepairObject(JessGFClock, 'Jess clock');
  Self.handleMahoganyObject(JessDrawers2,JessDrawers2Ghost, 'Jess drawers 2', 'Jess drawers 2 ghost');
  Wait(450,700);

  if Self.HappyChecker and (Minimap.PercentBlack > 25) then
  begin
    Minimap.RotateWithinAngles(15,87);
    Self.handleDoorObjectNormalOC(AnchorTile3, DoorTile3, AnchorColor3, DoorColor3, Self.AnchorValue3, JessDoor2, [1274,206]);
    Exit;
  end;

  if JessTub.Hover(4, false) then
  begin
    Minimap.RotateWithinAngles(309,353);
    Self.handleDoorObjectSpecialOC(AnchorTile4, DoorTile4, AnchorColor4, DoorColor4, Self.AnchorValue4, JessDoor3, JessTub);
    Minimap.RotateWithinAngles(309,353);
    Self.handleDoorObjectNormalOC(AnchorTile4, DoorTile4, AnchorColor4, DoorColor4, Self.AnchorValue4, JessDoor3, [1254,206]);
  end;

  Minimap.RotateWithinAngles(15,87);
  Self.handleDoorObjectNormalOC(AnchorTile3, DoorTile3, AnchorColor3, DoorColor3, Self.AnchorValue3, JessDoor2, [1274,206]);
  Inc(Self.HouseLoopCount, 1);
end;

