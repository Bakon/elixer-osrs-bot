procedure TScript.MariahHouse();
begin
  Minimap.RotateWithinAngles(75, 180);
  Self.handleRepairObject(MariahSink, 'Mariah sink');
  Self.handleMahoganyObject(MariahCupboard, MariahCupboardGhost, 'Mariah cupboard', 'Mariah cupboard ghost');
  Self.handleMahoganyObject(MariahCookingShelves, MariahCookingShelvesGhost, 'Mariah cooking shelves', 'Mariah cooking shelves ghost');
  Self.handleRepairObject(MariahHatStand, 'Mariah hat stand');
  Self.handleMahoganyObject(MariahTable, MariahTableGhost, 'Mariah table', 'Mariah table ghost');
  Self.handleUpstairsObject(MariahLadderUp);
  Minimap.RotateWithinAngles(75, 115);
