procedure TScript.ChatChecker();
begin
  MyPos := RSW.GetMyPos();
  Self.WriteMsg('Our current position is' + ToStr(MyPos));

  if Chat.FindOption('Jess', [255]) then
  begin
    Self.WriteMsg('Our current contract is Jess');
    Self.ArdyJess := True;
    Self.StartTile := [298,316];
    Self.OnContract := True;
    Self.AnchorTile := [296,340];
    Self.DoorTile :=  [296,324];
    Self.Anchorcolor := CTS2(1813698, 11, 0.02, 0.60);
    Self.DoorColor := CTS2(1192766, 3, 0.14, 1.19);
    Self.AnchorValue := 17.6;

