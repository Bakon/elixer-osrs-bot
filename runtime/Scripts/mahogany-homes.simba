procedure TScript.InterfaceHandler();
var
  b: TBox;
begin
  if DEBUG_BOOLEAN then
    Bot.WriteMsg('Choosing our object in the interface');

  case ContractEnum of
  EContract.BEGINNER:
  if SRL.Dice(85) then
  begin
    Keyboard.KeyDown(VK_1);
    Wait(25,100);
    Keyboard.KeyUp(VK_1);
  end
  else
  begin
    b := ([39,72,149,98]);
    Mouse.Click(b, MOUSE_LEFT);
  end;

  EContract.NOVICE:
  if SRL.Dice(85) then
  begin
    Keyboard.KeyDown(VK_2);
    Wait(25,100);
    Keyboard.KeyUp(VK_2);
  end
  else
  begin
    b := ([39,131,149,164]);
    Mouse.Click(b, MOUSE_LEFT);
  end;

  EContract.ADEPT:
  if SRL.Dice(85) then
  begin
    Keyboard.KeyDown(VK_3);
    Wait(25,100);
     Keyboard.KeyUp(VK_3);
  end
  else
  begin
    b := ([39,194,149,221]);
    Mouse.Click(b, MOUSE_LEFT);
  end;

  EContract.EXPERT:
  if SRL.Dice(85) then
  begin
    Keyboard.KeyDown(VK_4);
    Wait(25,100);
    Keyboard.KeyUp(VK_4);
  end
  else
  begin
    b := ([39,260,149,291]);
    Mouse.Click(b, MOUSE_LEFT);
  end;
  end;
end;

procedure TScript.JessFinder();
var
  attempts: Int32;
begin
  if not (Minimap.PercentBlack > 25) then
    TerminateScript('Called JessFinder but not upstairs');

  for attempts := 0 to 10 do
  begin
    Minimap.RotateWithinAngles(116, 164);

    if JessNPC.Find(ATPA) then
      Break;

    if attempts >= 6 then
    begin
      Mouse.Click(MainScreen.GetPlayerBox.Expand(-5), MOUSE_RIGHT);
      if ChooseOption.Select('lk-to Je', MOUSE_LEFT) then
        Exit;
    end;

    if attempts >= 9 then
      TerminateScript('We cannot find Jess for some reason');
  end;

  if Length(ATPA) < 1 then
    Exit;

  HerPos := rsw.MSToWorld(ATPA[0].Mean());

  MyPos := RSW.GetMyPos();

  if ((ScriptWalker^.GetMyPos()).InBox(Jess2Box)) then
  for attempts := 0 to 10 do
  begin
    if Self.RSW.AtTile([1274,206], 6)  then
      Break;

    if not Self.RSW.AtTile([1274,206], 6) then
    begin
      Minimap.RotateWithinAngles(15,87);
      Self.handleDoorObjectNormalOC(AnchorTile3, DoorTile3, AnchorColor3, DoorColor3, Self.AnchorValue3, JessDoor2, [1274,206]);
    end;
  end;

  if ((ScriptWalker^.GetMyPos()).InBox(Jess3Box)) then
  for attempts := 0 to 10 do
  begin
    if Self.RSW.AtTile([1274,206], 6)  then
      Break;

    if not Self.RSW.AtTile([1254,206], 6) then
    begin
      Minimap.RotateWithinAngles(309,353);
      Self.handleDoorObjectNormalOC(AnchorTile4, DoorTile4, AnchorColor4, DoorColor4, Self.AnchorValue4, JessDoor3, [1254,206]);
    end;

    if not Self.RSW.AtTile([1274,206], 6) then
    begin
      Minimap.RotateWithinAngles(15,87);
      Self.handleDoorObjectNormalOC(AnchorTile3, DoorTile3, AnchorColor3, DoorColor3, Self.AnchorValue3, JessDoor2, [1274,206]);
    end;
  end;

  if HerPos.InBox(Jess1Box) then
  for attempts := 0 to 10 do
  begin
    if ((ScriptWalker^.GetMyPos()).InBox(Jess1Box)) then
      Break;

    if not Self.RSW.AtTile([1278,214], 6) then
    begin
      Minimap.RotateWithinAngles(60,112);
      Self.handleDoorObjectNormalOC(AnchorTile2, DoorTile2, AnchorColor2, DoorColor2, Self.AnchorValue2, JessDoor1, [1278,214]);
    end;
  end;


  if not HerPos.InBox(Jess1Box) and not HerPos.InBox(Jess2Box) and not HerPos.InBox(Jess3Box) then
  for attempts := 0 to 10 do
  begin
    if not Self.RSW.AtTile([1286,202], 6) then
    begin
    Minimap.RotateWithinAngles(42,124);
    Self.handleDoorObjectNormalOC(AnchorTile2, DoorTile2, AnchorColor2, DoorColor2, Self.AnchorValue2, JessDoor1, [1286,202]);
    end;
  end;
end;

function TScript.getContractString(conType: EContract) : string;
begin
  Result := ToStr(conType);
  Result := Result.Lower();
  Result := Result.Capitalize();
  Result := Result + " Contract";
end;

procedure TScript.CuppaHandler();
begin
  if Chat.GetChat.Contains('finished with') then
  begin
    repeat
      Chat.ClickContinue(True);
    until ('You drink the tea') in Chat.GetMessage(7, [CHAT_COLOR_BLACK]);
    Wait(75, 125);
  end;
    Inc(Self.GameCount, 1);
end;

function TScript.walkToLocation(Destination: String; Force:Boolean=False): Boolean;
var
  TauBox: TPointArray  := [[1040,878],[1028,882],[1014,896],[1014,904],[1018,904], [1022,912], [1034,912], [1032,890], [1040,888]];
begin
  case Destination of
  'Failsafe':
  begin
    Self.ArdougneTeleport();
    Result := (ScriptWalker^.GetMyPos()).InBox([421,232,502,325]);
  end;

  'Contract NPC':
  begin
   if not (ScriptWalker^.GetMyPos()).InBox([337,253,522,426]) then
     Self.ArdougneTeleport();

   if not Self.RSW.AtTile(Self.ContractTile, 24) then
     Self.RSW.WebWalk(Self.ContractTile, 24);

   Result := Self.RSW.AtTile(Self.ContractTile, 24);

   Minimap.WaitPlayerMoving(100, 7500);

   if not Result and (Minimap.PercentBlack > 33) then
     Self.ArdougneTeleport();
  end;

  'Contract Start':
  begin
    MyPos := Self.RSW.GetMyPos();

    if Self.UsePlankSack then
    begin
      if ((ScriptWalker^.GetMyPos()).InBox([288,866,308,898])) and Self.VarrockBob then
      begin
        Minimap.RotateWithinAngles(99, 121);

        Self.handleDoorObjectNormalOC(AnchorTile, DoorTile, AnchorColor, DoorColor, Self.AnchorValue,Self.JeffFrontDoor, [320,880]);

        if (not Self.RSW.AtTile(Self.StartTile, 24)) or Force  then
          Result := Self.WalkerHelper(Self.StartTile, 24);
         Exit;
      end;

      if ((ScriptWalker^.GetMyPos()).InBox([280,722,304,750])) and Self.VarrockJeff then
      begin
        Minimap.RotateWithinAngles(20, 70);

        Self.handleDoorObjectNormalOC(AnchorTile, DoorTile, AnchorColor, DoorColor, Self.AnchorValue,Self.BobFrontDoor, [312,738]);

        if (not Self.RSW.AtTile(Self.StartTile, 24)) or Force  then
          Result := Self.WalkerHelper(Self.StartTile, 24);
         Exit;
      end;

      if ((ScriptWalker^.GetMyPos()).InBox(NormanUpBox)) and (Self.FallyTau or Self.FallyLarry) then
      begin
        Self.handleDownstairsObject(NormanLadderDown);

        Minimap.RotateWithinAngles(-48, 70);

        Self.handleDoorObjectNormalCO(AnchorTile, DoorTile, AnchorColor, DoorColor, Self.AnchorValue, Self.NormanFrontDoor, [985, 881]);

        if (not Self.RSW.AtTile(Self.StartTile, 24)) or Force  then
          Result := Self.WalkerHelper(Self.StartTile, 24);

         Exit;
      end;

      if ((ScriptWalker^.GetMyPos()).InBox([972,805,1003,827])) and (Self.FallyTau or Self.FallyNorman) then
      begin
        Minimap.RotateWithinAngles(-84, 44);

        Self.handleDoorObjectNormalCO(AnchorTile, DoorTile, AnchorColor, DoorColor, Self.AnchorValue, Self.LarryFrontDoor, [988,836]);

        if (not Self.RSW.AtTile(Self.StartTile, 24)) or Force  then
          Result := Self.WalkerHelper(Self.StartTile, 24);
         Exit;
      end;

      if SRL.PointInPoly(MyPos, TauBox) and (Self.FallyLarry or Self.FallyNorman) then
      begin
        Minimap.RotateWithinAngles(272, 330);

        Self.handleDoorObjectNormalOC(AnchorTile, DoorTile, AnchorColor, DoorColor, Self.AnchorValue, Self.TauFrontDoor, [1016,880]);

        if (not Self.RSW.AtTile(Self.StartTile, 24)) or Force then
          Result := Self.WalkerHelper(Self.StartTile, 24);
        Exit;
      end;
    end;

    Self.TeleportToLocation();

    if (not Self.RSW.AtTile(Self.StartTile, 24)) then
      Result := Self.WalkerHelper(Self.StartTile, 24);
  end;

  'Bank':
  begin
    if Self.hasEnoughPlanks and Self.OnContract then
      Exit;

    if Self.CraftingGuildBanking then
    begin
      MyPos := RSW.GetMyPos();

      if (not Self.RSW.AtTile(Self.BankTile, 98)) or Force then
        Self.CraftingGuildTeleport();

      if Result := Self.RSW.WalkBlind(Self.BankTile, 98) then
        Exit;
    end;

    case Self.ContractMethod of
    'NPC contact (lunar spellbook)':
    begin
      if (not Self.RSW.AtTile(Self.BankTile, 24)) or Force  then
        Self.CastleWarsTeleport();

        Result := Self.WalkerHelper(Self.BankTile, 24);
    end;

    'Talk to NPC (normal spellbook)':
    begin
      if (not Self.RSW.AtTile(Self.BankTile, 24)) or (Self.RSW.AtTile(Self.ContractTile, 24)) then
      begin
        Self.ArdougneTeleport();

        Result := Self.WalkerHelper(Self.BankTile, 24);
      end;

      if (Self.RSW.AtTile(Self.ContractTile, 24)) or Force then
      begin
        Result := Self.WalkerHelper(Self.BankTile, 24);

        if GameInterface.IsOpen() then
          GameInterface.Close();
      end;
    end;
    end;
  end;
  end;
end;

function TScript.WalkerHelper(Destination: TPoint; WaitUntilDistance: Int32 = 0; attempts: Integer = 2): Boolean;
var
  attempt: Integer;
begin
  for attempt := 0 to attempts do
  begin
    try
      RSW.WebWalk(Destination, WaitUntilDistance);
    except
      Self.WriteMsg('WebWalk failed to find a viable path. If you see this, send it to Student');
      Self.walkToLocation('Failsafe');
    end;
  end;

  Wait(178, 314);
  Minimap.WaitMoving();

  if Result := Self.RSW.AtTile(Destination, WaitUntilDistance) then
    Exit;
end;

procedure TScript.TeleportToLocation();
begin
  MyPos := Self.RSW.GetMyPos();

  if Self.ArdyRoss or Self.ArdyJess or Self.ArdyNoella then
    Self.ArdougneTeleport();

  if Self.HosidLeela or Self.HosidMariah or Self.HosidBarbara then
    Self.HosidiusTeleport();

  if Self.VarrockBob or Self.VarrockJeff or Self.VarrockSarah then
    Self.VarrockTeleport();

  if Self.FallyTau or Self.FallyLarry or Self.FallyNorman then
  begin
    if Self.UsePlankSack and ((ScriptWalker^.GetMyPos()).InBox(faladorBox)) then
      Exit;

    Self.FaladorTeleport();
  end;
end;

procedure TScript.InventoryFailsafeCheck();
begin
  if LampHandler.Open then
    LampHandler.SelectLampSkill(ERSLampSkill.CONSTRUCTION);

  if Inventory.ContainsItem('Coin pouch') then
  begin
    Inventory.ClickItem('Coin pouch', 'Open-all');
    WaitUntil(Inventory.ContainsItem('Coins'), 115, 5000);
  end;

  if Inventory.ContainsAny(['Cooking apple', 'Banana', 'Strawberry', 'Jangerberries', 'Lemon', 'Redberries', 'Pineapple', 'Lime', 'Strange fruit', 'Golovanova fruit top', 'Papaya fruit']) then
  begin
    Inventory.ShiftDrop(['Cooking apple', 'Banana', 'Strawberry', 'Jangerberries', 'Lemon', 'Redberries', 'Pineapple', 'Lime', 'Strange fruit', 'Golovanova fruit top', 'Papaya fruit'], DROP_PATTERN_REGULAR);
    WaitUntil(not (Inventory.ContainsAny(['Cooking apple', 'Banana', 'Strawberry', 'Jangerberries', 'Lemon', 'Redberries', 'Pineapple', 'Lime', 'Strange fruit', 'Golovanova fruit top', 'Papaya fruit'])), 115, 5000);
  end;
end;

procedure TScript.GetContract();
var
  attempts: int32;
begin
  if (not GameClient.IsLoggedIn) then Exit;

  XPbar.EarnedXP();

  case Self.ContractMethod of
  'NPC contact (lunar spellbook)':
  begin
    if Self.WhichNPC <> [] then
      Exit;

    Self.WriteMsg('Getting another contract');
    if not Magic.Open then
      Exit;

    if not (Magic.CanActivate(ESpell.NPC_CONTACT)) then
      TerminateScript('Unable to cast NPC contact for some reason');

    if Self.LastContractTier then
    begin
      if Magic.CastSpell(ESpell.NPC_CONTACT, 'Last-tier contract') then
        WaitUntil(XPBar.EarnedXP(), 115, 8000);

      if WaitUntil(Chat.GetChat.Contains('go see'), 115, 8000) then
      begin
        Self.ChatChecker();
        Exit;
      end;
    end
    else
    begin
      Magic.CastSpell(ESpell.NPC_CONTACT, 'Amy');
      WaitUntil(XPBar.EarnedXP(), 115, 8000);
    end;

    if WaitUntil(Chat.ClickContinue, 150, 7000) then
    begin
      if Chat.GetChat.Contains('Go see') then
      begin
        Self.ChatChecker();
        Self.LastContractTier := True;
          Exit;
      end;

      if Chat.GetChat.Contains('What kind') then
      begin
        WaitUntil(Chat.ClickContinue, 150, 7000);
        Chat.ClickOption(Self.GetContractString(Self.ContractEnum), True);
        WaitUntil(Chat.ClickContinue, 150, 7000);

        if Chat.FindOption('expensive supplies', [128]) then
          Chat.ClickOption('t warn me again', True);

        if WaitUntil(Chat.GetChat.Contains('Please could'), 150, 5000) then
        begin
          Self.ChatChecker();
          Self.LastContractTier := True;
        end;
      end;
    end;
  end;

  'Talk to NPC (normal spellbook)':
  begin
    Self.WalkToLocation('Contract NPC');

    Self.WriteMsg('Getting another contract');
    for attempts := 0 to 10 do
    begin
      if Self.LastContractTier then
      begin
        if Self.EllieNPC.SelectOption(['Last-tier'], 8) then begin
            WaitUntil(Chat.GetChat.Contains('Go see') or (Chat.GetChat.Contains('my current')), 150, 4000);
          Break;
        end;
      end;

      if Self.EllieNPC.SelectOption(['Contract'], 10) then
        WaitUntil(Chat.FindOption('Beginner Contract', [CHAT_COLOR_BLACK]) or (Chat.GetChat.Contains('my current')), 150, 4000);

      if Chat.FindOption('Beginner Contract', [CHAT_COLOR_BLACK]) or Chat.GetChat.Contains('my current') then
        Break;

      if (attempts > 7) then
      begin
        Mouse.Click(MainScreen.GetPlayerBox.Expand(-5), MOUSE_RIGHT);
        if ChooseOption.Select('Contract', MOUSE_LEFT) then
          Break;

        TerminateScript('Having a hard time finding the contract option. If this is your first time playing MH, you might need to speak to Amy in Falador first.');
      end;
    end;

    if Chat.FindOption('Beginner Contract', [CHAT_COLOR_BLACK]) then
    begin
      Chat.ClickOption(Self.GetContractString(Self.ContractEnum), True);
      WaitUntil(Chat.ClickContinue, 150, 7000);

      if Chat.FindOption('expensive supplies', [128]) then
        Chat.ClickOption('t warn me again', True);

      if WaitUntil(Chat.GetChat.Contains('Please could'), 150, 5000) then
      begin
        Self.ChatChecker();
        Self.LastContractTier := True;
      end;
    end;

    if Chat.GetChat.Contains('my current') then
    begin
      if WaitUntil(Chat.ClickContinue, 150, 7000) then
      begin
        if Chat.GetChat.Contains('Go see') then
        begin
          Self.ChatChecker();
          Self.LastContractTier := True;
            Exit;
        end;
      end;
    end;

    if WaitUntil(Chat.GetChat.Contains('Please could'), 150, 5000) then
      Self.ChatChecker();
  end;
  end;
end;

function TScript.clickBank(): Boolean; // CJ
var
  attempt: Int32;
begin
  for attempt := 0 to 8 do
  begin
    if GameInterface.IsOpen(EInterfaceType.ANY) then
      GameInterface.Close();

    Self.WalkToLocation('Bank');

    Bot.InventoryFailsafeCheck();

    Bank.Open(Self.BankObj);

    if Result := Bank.IsOpen(15000) then
      Break;
  end;
end;

function TScript.insideHouse(): Boolean;
var
  TauBox: TPointArray  := [[1040,878],[1028,882],[1014,896],[1014,904],[1018,904], [1022,912], [1034,912], [1032,890], [1040,888]];
  BarbaraBox: TPointArray  := [[850,437], [850,467], [879,467], [879,453], [859,453], [859,437]];
begin
  if Self.HosidBarbara then
    Exit(SRL.PointInPoly(MyPos := Self.RSW.GetMyPos(), BarbaraBox));

  if Self.FallyTau then
    Exit(SRL.PointInPoly(MyPos := Self.RSW.GetMyPos(), TauBox));

  if Self.ArdyRoss then
    Exit((MyPos := RSW.GetMyPos()).InBox([256,226,284,242]));

  if Self.ArdyJess and not ((MyPos := RSW.GetMyPos()).InBox([1439,430,1615,556])) then
    Exit((Minimap.PercentBlack > 25));

  if Self.ArdyNoella then
    Exit((MyPos := RSW.GetMyPos()).InBox([1514,92,1544,124]));

  Exit((MyPos := RSW.GetMyPos()).InBox(Self.HouseBox));
end;

function TScript.BarWithdrawHelper(item : TItem; quant: Int32; startquant : Int32;  finalquant : Int32) : Boolean; // CJ
var
  withdrawItem : TBankItem;
  attempts : int32;
begin
  ItemFinder.Similarity := 0.99999;

  if ((Inventory.CountItem(item) = startquant)) then
  begin
    Self.WriteMsg('Withdrawing ' + item);
    for attempts := 0 to 8 do
    begin
      withdrawItem := TBankItem.Setup(item, quant, False);
      Bank.WithdrawItem(withdrawItem, False);
      Waituntil((Inventory.CountItem(item) = finalquant), 315, 3000);

      if (Inventory.CountItem(item) = finalquant) then
        Break;

      if (attempts > 7) and not (Inventory.CountItem(item) = finalquant) then
      begin
        Logout.ClickLogout();
        TerminateScript('Not enough ' + item);
      end;
    end;
  end
  else
    Result := true;

  ItemFinder.Similarity := 0.999;
end;

function TScript.WithdrawHelper(item : TItem; quant : Int32) : Boolean; // CJ
var
  withdrawItem : TBankItem;
  attempts : int32;
begin
  if not Inventory.ContainsItem(item) then
  begin
    Self.WriteMsg('Withdrawing ' + item);
    for attempts := 0 to 8 do
    begin
      if (attempts > 1) and not Inventory.ContainsItem(item) then
        Bank.SetScrollPosition(0);

      withdrawItem := TBankItem.Setup(item, quant, False);
      Bank.WithdrawItem(withdrawItem, False);
      Result := Waituntil(Inventory.ContainsItem(item), 315, 3000);

      if Inventory.ContainsItem(item) then
        Break;

      if (attempts > 7) and not Inventory.ContainsItem(item) then
      begin
        Logout.ClickLogout();
        TerminateScript('Did not find ' + item);
      end;
    end;
  end
  else
    Result := true;
end;

procedure TScript.WithdrawItems();
var
  plankbankItem: TBankItem;
  invenBars, attempts: Int32;
begin
  if not Bank.IsOpen() then
    Exit;

  Bank.DepositRandomItems(['Rune pouch', 'Divine rune pouch', 'Varrock teleport', 'Ardougne teleport', 'Falador teleport', 'Hosidius teleport', 'Teleport to house', 'Crafting cape', 'Crafting cape(t)',
                           'Air rune', 'Water rune', 'Earth rune', 'Law rune', 'Fire rune', 'Nature rune', 'Astral rune', 'Cosmic rune', 'Plank sack', 'Saw', 'Hammer', 'Steel bar', Bot.PlankType]);

  case Self.RPouchMethod of
  'Rune pouch':
  begin
    Self.WithdrawHelper('Rune pouch', 1);
  end;

  'Divine rune pouch':
  begin
    Self.WithdrawHelper('Divine rune pouch', 1);
  end;
  end;

  case Self.ContractMethod of
  'NPC contact (lunar spellbook)':
  begin
    if Self.ringofdueling and not Self.CraftingGuildBanking then
    begin
      Self.WithdrawHelper('Ring of dueling(8)', 1);

      if Inventory.ContainsItem('Ring of dueling(8)') then
      begin
      Self.WriteMsg('Equipping ring');
      Inventory.ClickItem('Ring of dueling(8)', 'Wear');
      WaitUntil(not Inventory.ContainsItem('Ring of dueling(8)'), 115, 5000);
      end;

      Self.ringofdueling := False;
    end;
  end;

  'Talk to NPC (normal spellbook)':
  begin
    case Self.ArFaVaTP of
    'RUNES (normal spellbook)':
    begin
      case Self.RPouchMethod of
      'Rune pouch':
      begin
        if not Self.InfiniteWater then
          Self.WithdrawHelper('Water rune', -1);
      end;

      'None':
      begin
        if not Self.InfiniteAir then
          Self.WithdrawHelper('Air rune', -1);

        if not Self.InfiniteEarth then
          Self.WithdrawHelper('Earth rune', -1);

        Self.WithdrawHelper('Law rune', -1);

        if not Self.InfiniteWater then
          Self.WithdrawHelper('Water rune', -1);
      end;
      end;

      if not Self.InfiniteFire then
        Self.WithdrawHelper('Fire rune', -1);
    end;
    end;
  end;
  end;

  case Self.ArFaVaTP of
  'TABLETS (any spellbook)':
  begin
    Self.WithdrawHelper('Ardougne teleport', -1);
    Self.WithdrawHelper('Falador teleport', -1);
    Self.WithdrawHelper('Varrock teleport', -1);
  end;
  end;

  case Self.RPouchMethod of
  'Rune pouch':
  begin
    Self.WithdrawHelper('Rune pouch', 1);
  end;

  'Divine rune pouch':
  begin
    Self.WithdrawHelper('Divine rune pouch', 1);
  end;
  end;

  case Self.HosidiusTP of
  'Xerics Talisman (CHARGED)':
  begin
    if not Self.XericTaliEquipped then
    begin
      if not Inventory.ContainsItem("Xeric's talisman") then
        Self.WithdrawHelper("Xeric's talisman", 1);

      Inventory.ClickItem("Xeric's talisman", 'Wear');
      Waituntil(not Inventory.ContainsItem("Xeric's talisman"), 315, 5000);
      Self.XericTaliEquipped := True;
    end;
  end;

  'Hosidius TABLET':
  begin
    Self.WithdrawHelper('Hosidius teleport', -1);
  end;

  'House teleport TABLET':
  begin
    Self.WithdrawHelper('Teleport to house', -1);
  end;
  end;

  if (Inventory.CountItem('Hammer') < 1) and not Self.ImcandoHammerEq then
  begin
    Self.WithdrawHelper('Hammer', 1);
  end;

  if (Inventory.CountItem('Saw') < 1) and not Self.AmySawEq then
  begin
    Self.WithdrawHelper('Saw', 1);
  end;

  case Self.RPouchMethod of
  'Rune pouch':
  begin
    Self.WithdrawHelper('Rune pouch', 1);
  end;

  'Divine rune pouch':
  begin
    Self.WithdrawHelper('Divine rune pouch', 1);
  end;
  end;

  invenBars := Inventory.CountItem('Steel bar');

  if not Self.UsePlankSack then
  begin;
    if (invenBars = 1) then
    begin
      Self.BarWithdrawHelper('Steel bar', 1, 1, 2);
    end
    else
    if (invenBars = 0) then
    begin
      Self.BarWithdrawHelper('Steel bar', 2, 0, 2);
    end;
  end;

  if Self.UsePlankSack then
  begin
    if (invenBars = 0) then
    begin
      Self.BarWithdrawHelper('Steel bar', 3, 0, 3);
    end
    else
    if (invenBars = 1) then
    begin
      Self.BarWithdrawHelper('Steel bar', 2, 1, 3);
    end
    else
    if (invenBars = 2) then
    begin
      Self.BarWithdrawHelper('Steel bar', 1, 2, 3);
    end;

    if not Inventory.ContainsItem('Plank sack') then
      Self.WithdrawHelper('Plank sack', 1);

    Self.WriteMsg('Withdrawing Planks');
    ItemFinder.Similarity := 0.99999;
    for attempts := 0 to 8 do
    begin
      if Inventory.IsFull then
        Break;

      plankbankItem := plankbankItem.Setup(Self.PlankType, -1, False);
      Bank.WithdrawItem(plankbankItem, False);
      WaitUntil((Inventory.CountItem(Self.PlankType) >= 14), 115, 5000);

      if not Self.FullSack then begin
        Inventory.ClickItem('Plank sack', 'Fill');
        WaitUntil(not Inventory.IsFull(), 115, 1750);
      end;

      if Inventory.ContainsItem(Self.PlankType) then
        Self.FullSack := True;
    end;
    ItemFinder.Similarity := 0.999;
    Self.FullSack := False;
  end;

  if not Inventory.IsFull then
  begin
    ItemFinder.Similarity := 0.99999;
    plankbankItem := plankbankItem.Setup(Self.PlankType, -1, False);
    Bank.WithdrawItem(plankbankItem, False);
    WaitUntil((Inventory.CountEmptySlots < 1), 115, 5000);
    ItemFinder.Similarity := 0.999;
  end;

  if not Bank.ContainsItem(Self.PlankType) then
  begin
    Logout.ClickLogout();
    TerminateScript('Out of planks');
  end;

  Bank.Close;

  Self.GetPlankAmount();
end;

procedure TFarmRun.OnStart(); override;
var
  I : Int32;
  bankTimeout: TCountdown;
begin
  for I := 0 to High(Antiban.tasks) do
    Antiban.Tasks[I].Countdown.Pause;

  ScriptWalker := @Bot.rsw;

  Bot.walkToLocation('Bank');

  Bot.InventoryFailsafeCheck();

  bankTimeout.Init(45000);

  while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
    Bank.Open(Bot.BankObj);

  WaitUntil(Bank.IsOpen(), 115, 12500);
  Bank.DepositRandomItems(['Law rune', 'Water rune', 'Ardougne teleport', 'Rune pouch', 'Divine rune pouch']);
  Wait(500,750);

  if Bot.ringofdueling and not Bot.CraftingGuildBanking then
  begin
    Bot.WithdrawHelper('Ring of dueling(8)', 1);

    if Inventory.ContainsItem('Ring of dueling(8)') then
    begin
     Bot.WriteMsg('Equipping ring');
     Inventory.ClickItem('Ring of dueling(8)', 'Wear');
     WaitUntil(not Inventory.ContainsItem('Ring of dueling(8)'), 115, 5000);
    end;

    Bot.ringofdueling := False;
  end;

  ScriptWalker := @Self.rsw;

  inherited;
end;

procedure TFarmRun.OnComplete(); override;
var
  I: Int32;
  bankTimeout: TCountdown;
begin
  if Chat.HasContinue then
    Chat.ClickContinue();

  ScriptWalker := @Bot.rsw;

  Bot.walkToLocation('Bank');

  Bot.InventoryFailsafeCheck();

  bankTimeout.Init(45000);

  while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
    Bank.Open(Bot.BankObj);

  WaitUntil(Bank.IsOpen(), 115, 12500);
  Bank.DepositRandomItems(['Law rune', 'Water rune', 'Ardougne teleport', 'Rune pouch', 'Divine rune pouch']);
  Wait(500,750);

  if Bot.ringofdueling and not Bot.CraftingGuildBanking then
  begin
    Bot.WithdrawHelper('Ring of dueling(8)', 1);

    if Inventory.ContainsItem('Ring of dueling(8)') then
    begin
     Bot.WriteMsg('Equipping ring');
     Inventory.ClickItem('Ring of dueling(8)', 'Wear');
     WaitUntil(not Inventory.ContainsItem('Ring of dueling(8)'), 115, 5000);
    end;

    Bot.ringofdueling := False;
  end;

  for I := 0 to High(Antiban.tasks) do
  Antiban.Tasks[I].Countdown.Resume;
end;

function TBirdHouseInclude.OnStart() : Boolean; override;
var
  I: Int32;
  bankTimeout : TCountdown;
begin
  for I := 0 to High(Antiban.tasks) do
    Antiban.Tasks[I].Countdown.Pause;

  if Self.AlwaysUseBestLog then
  begin
    Self.SuggestedLogType := BirdhouseRunner.GetLogForHunterLevel(Stats.GetLevel(ESkill.HUNTER));
    if Self.LogType <> Self.SuggestedLogType then
      Self.LogType := Self.SuggestedLogType;
  end;

  ScriptWalker := @Bot.RSW;

  Bot.walkToLocation('Bank');

  Bot.InventoryFailsafeCheck();

  bankTimeout.Init(45000);

  while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
    Bank.Open(Bot.BankObj);

  WaitUntil(Bank.IsOpen(), 115, 12500);
  Bank.DepositRandomItems(['Law rune', 'Water rune', 'Ardougne teleport', 'Rune pouch', 'Divine rune pouch']);
  Wait(500,750);

  if Bot.ringofdueling and not Bot.CraftingGuildBanking then
  begin
    Bot.WithdrawHelper('Ring of dueling(8)', 1);

    if Inventory.ContainsItem('Ring of dueling(8)') then
    begin
     Bot.WriteMsg('Equipping ring');
     Inventory.ClickItem('Ring of dueling(8)', 'Wear');
     WaitUntil(not Inventory.ContainsItem('Ring of dueling(8)'), 115, 5000);
    end;

    Bot.ringofdueling := False;
  end;

  case Bot.ContractMethod of
  'Talk to NPC (normal spellbook)':
  begin
    case Bot.RPouchMethod of
    'None':
    begin
      case Bot.ArFaVaTP of
      'TABLETS (any spellbook)':
      begin
        Bot.WithdrawHelper('Ardougne teleport', -1);
      end;

      'RUNES (normal spellbook)':
      begin
        if not Bot.InfiniteWater then
          Bot.WithdrawHelper('Water rune', -1);

        Bot.WithdrawHelper('Law rune', -1);
      end;
      end;
    end;

    'Rune pouch':
    begin
      case Bot.ArFaVaTP of
      'TABLETS (any spellbook)':
      begin
        Bot.WithdrawHelper('Ardougne teleport', -1);
      end;

      'RUNES (normal spellbook)':
      begin
        Bot.WithdrawHelper('Rune pouch', 1);
        if not Bot.InfiniteWater then
          Bot.WithdrawHelper('Water rune', -1);
      end;
      end;
    end;

    'Divine rune pouch':
    begin
      case Bot.ArFaVaTP of
      'TABLETS (any spellbook)':
      begin
        if not Bot.WithdrawHelper('Ardougne teleport', -1) then
        begin
          Logout.ClickLogout();
          TerminateScript('Out of Ardy tabs');
        end;
      end;

      'RUNES (normal spellbook)':
      begin
        Bot.WithdrawHelper('Divine rune pouch', 1);
      end;
      end;
    end;
    end;
  end;
  end;

  //If we can't get our stuff then bail
  if not Self.WithdrawNextRun() then
  begin
    Bank.Close();
    BirdhouseRunner.IsDisabled := true;
    Exit(false);
  end;

  Bank.Close();
  Result := true;
  ScriptWalker := @Self.RSW;
end;

procedure TBirdHouseInclude.OnComplete(); override;
var
  I : Int32;
  bankTimeout: TCountdown;
begin
  ScriptWalker := @Bot.RSW;

  if chat.HasContinue then
    Chat.ClickContinue();

  Bot.walkToLocation('Bank');

  Bot.InventoryFailsafeCheck();

  bankTimeout.Init(45000);

  while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
    Bank.Open(Bot.BankObj);

  WaitUntil(Bank.IsOpen(), 115, 12500);
  Bank.DepositRandomItems(['Law rune', 'Water rune', 'Ardougne teleport', 'Rune pouch', 'Divine rune pouch']);
  Wait(500,750);

  if Bot.ringofdueling and not Bot.CraftingGuildBanking then
  begin
    Bot.WithdrawHelper('Ring of dueling(8)', 1);

    if Inventory.ContainsItem('Ring of dueling(8)') then
    begin
     Bot.WriteMsg('Equipping ring');
     Inventory.ClickItem('Ring of dueling(8)', 'Wear');
     WaitUntil(not Inventory.ContainsItem('Ring of dueling(8)'), 115, 5000);
    end;

    Bot.ringofdueling := False;
  end;

  for I := 0 to High(Antiban.tasks) do
    Antiban.Tasks[I].Countdown.Resume;
end;

procedure TScript.IncludeEquipmentSetup();
var
  Staff    : String;
  AllStaves: TStringArray := ['Staff of air','Staff of water','Staff of earth','Staff of fire',
                              'Air battlestaff','Water battlestaff', 'Earth battlestaff', 'Fire battlestaff',
                              'Mystic air staff', 'Mystic water staff', 'Mystic earth staff', 'Mystic fire staff',
                              'Mystic dust staff', 'Mystic mist staff', 'Mystic dust staff','Mystic steam staff', 'Mystic mud staff',
                              'Dust battlestaff', 'Mist battlestaff', 'Steam battlestaff', 'Smoke battlestaff', 'Lava battlestaff', 'Mud battlestaff',
                              'Mystic smoke staff', 'Mystic steam staff', 'Mystic lava staff',
                              'Kodai wand', 'Twinflame staff'];
  Hits     : TItemFinderMatchArray;
begin
  if Equipment.ContainsAny(['Construct. cape', 'Construct. cape(t)']) then
    Self.ConstructionCapeEquipped := True;

  if Equipment.ContainsItem("Xeric's talisman") then
    Self.XericTaliEquipped := True;

  if Equipment.ContainsAny(['Crafting cape', 'Crafting cape(t)']) then
    Self.CraftingCapeEquipped := True;

  ItemFinder.Similarity := 0.9999;

  for Staff in AllStaves do
  begin
    if not Equipment.Open() then
      Exit;

    Hits := ItemFinder.FindAll([Staff], Equipment.GetSlotBoxes, 1);
    if Length(Hits) > 0 then
    begin
      if Staff.ContainsAny(['Air', 'Dust', 'Mist', 'Smoke', 'air', 'dust', 'mist', 'smoke']) then
        Self.InfiniteAir := True;

      if Staff.ContainsAny(['Water', 'Mud', 'Mist', 'Steam', 'Kodai', 'water', 'mud', 'mist', 'Steam', 'Twinflame']) then
        Self.InfiniteWater := True;

      if Staff.ContainsAny(['Earth', 'Dust', 'Mud', 'Lava', 'earth', 'dust', 'mud', 'lava']) then
        Self.InfiniteEarth := True;

      if Staff.ContainsAny(['Fire', 'Smoke', 'Steam', 'Lava', 'fire', 'smoke', 'steam', 'lava', 'Twinflame']) then
        Self.InfiniteFire := True;
    end;
  end;

  ItemFinder.Similarity := 0.999;

  if Equipment.ContainsItem('Tome of water') then
    Self.InfiniteWater := True;

  if Equipment.ContainsItem('Tome of fire') then
    Self.InfiniteFire := True;

  if Equipment.ContainsItem('Tome of earth') then
    Self.InfiniteEarth := True;

  if Equipment.ContainsAny(["Amy's saw", "Amy's saw (off-hand)"]) then
    Self.AmySawEq := True;

  if Equipment.ContainsAny(['Imcando hammer', 'Imcando hammer (off-hand)']) then
    Self.ImcandoHammerEq := True;

  case Self.ContractMethod of
  'NPC contact (lunar spellbook)':
  begin
    if not Equipment.ContainsAny(getChargedJewelleryNames('Ring of dueling')) and not Self.CraftingGuildBanking then
      Self.ringofdueling := True;

    if not Equipment.ContainsAny(getChargedJewelleryNames('Ring of dueling')) and not Self.CraftingGuildBanking and not (ScriptWalker^.GetMyPos()).InBox(castlewarsBox) then
      TerminateScript('You need to either have a ring of dueling equipped OR start in castle wars');
  end;
  end;

  if not  Equipment.ContainsAny(['Crafting cape', 'Crafting cape(t)']) and Self.CraftingGuildBanking then
    TerminateScript('You need to have your crafting cape equipped on startup');

  case Self.ArFaVaTP of
  'TABLETS (any spellbook)':
  begin
    if (Self.VarrockDiary = 0) or (Self.VarrockDiary = 1) then
      Self.VarrockTeleportSetup := True;

    if (Self.VarrockDiary = 2) or (Self.VarrockDiary = 3) or (Self.VarrockDiary = 4) then
      Self.VarrockTeleportSetup := False;
  end;
  end;

  Self.GetPlankAmount();
end;

procedure TScript.EntranceHandlerCoordsOC(EnterHouseBox:Tbox; LowerAngle:Int32; UpperAngle:Int32; mhDObj: TGameObject;  Coords:Tpoint);
var
  attempts: int32;
begin
  MyPos := Self.RSW.GetMyPos();

  if Self.MyPos.InBox(EnterHouseBox) then
    Exit;

  Self.WriteMsg('Opening door');
  for attempts := 0 to 5 do begin
    if not Self.RSW.AtTile(Self.StartTile, 8) then
      Self.RSW.WalkBlind(Self.StartTile);

    Minimap.RotateWithinAngles(LowerAngle, UpperAngle);

    Self.handleDoorObjectNormalOC(AnchorTile, DoorTile, AnchorColor, DoorColor, Self.AnchorValue, mhDObj, Coords);

    if Self.InsideHouse then
      Break;
  end;
end;

procedure TScript.EntranceHandlerCoordsCO(EnterHouseBox:Tbox; LowerAngle:Int32;UpperAngle:Int32; mhDObj: TGameObject;  Coords:Tpoint);
var
  attempts: int32;
begin
  MyPos := Self.RSW.GetMyPos();

  if Self.MyPos.InBox(EnterHouseBox) then
    Exit;

  Self.WriteMsg('Opening door');
  for attempts := 0 to 8 do begin
    if not Self.RSW.AtTile(Self.StartTile, 8) then
      Self.RSW.WalkBlind(Self.StartTile);

    Minimap.RotateWithinAngles(LowerAngle, UpperAngle);

    Self.handleDoorObjectNormalCO(AnchorTile, DoorTile, AnchorColor, DoorColor, Self.AnchorValue, mhDObj,Coords);

    if Self.InsideHouse then
      Break;
  end;
end;

procedure TScript.EntranceHandlerObjectOC(LowerAngle:Int32;UpperAngle:Int32; mhDObj: TGameObject;  insideObj: TGameObject);
var
  attempts: int32;
begin
  if (Minimap.PercentBlack > 25) then
    Exit;

  if not (Minimap.PercentBlack > 25) then
  for attempts := 0 to 8 do begin
    if not Self.RSW.AtTile(Self.StartTile, 8) then
      Self.RSW.WalkBlind(Self.StartTile);

    Minimap.RotateWithinAngles(LowerAngle,UpperAngle);

    Self.handleDoorObjectSpecialOC(AnchorTile, DoorTile, AnchorColor, DoorColor, Self.AnchorValue, mhDObj, insideObj);

    WaitUntil(((Minimap.PercentBlack > 25)), 115, 4500);

    if (Minimap.PercentBlack > 25) then
      Break;
  end;
end;

procedure TScript.EntranceHandlerObjectCO(LowerAngle:Int32;UpperAngle:Int32; mhDObj: TGameObject;  insideObj: TGameObject);
var
  attempts :int32;
begin
  if (Minimap.PercentBlack > 25) then
    Exit;

  if not (Minimap.PercentBlack > 25) then
  for attempts := 0 to 8 do begin
    if not Self.RSW.AtTile(Self.StartTile, 8) then
      Self.RSW.WalkBlind(Self.StartTile);

    Minimap.RotateWithinAngles(LowerAngle,UpperAngle);

    Self.handleDoorObjectSpecialCO(AnchorTile, DoorTile, AnchorColor, DoorColor, Self.AnchorValue ,mhDObj, insideObj);

    WaitUntil(((Minimap.PercentBlack > 25)), 115, 4500);

    if (Minimap.PercentBlack > 25) then
      Break;
  end;
end;

procedure TScript.EnterHouseCoordsOC();
begin
  Self.EntranceHandlerCoordsOC(Self.HouseBox, Self.AngleMin, Self.AngleMax, Self.mhFrontDoor, Self.TravelCoord);
end;

procedure TScript.EnterHouseCoordsCO();
begin
  Self.EntranceHandlerCoordsCO(Self.HouseBox, Self.AngleMin, Self.AngleMax, Self.mhFrontDoor, Self.TravelCoord);
end;

procedure TScript.EnterHouseObjectOC();
begin
  Self.EntranceHandlerObjectOC(Self.AngleMin, Self.AngleMax, Self.mhFrontDoor, Self.mhInsideObject);
end;

procedure TScript.EnterHouseObjectCO();
begin
  Self.EntranceHandlerObjectCO(Self.AngleMin, Self.AngleMax, Self.mhFrontDoor, Self.mhInsideObject);
end;

procedure TScript.HandleEndGame();
begin
  Self.PlanksStored := Self.PlankSackCount;
  Self.BarsStored := (Inventory.CountItem('Steel bar'));

  if Self.ArdyJess then
  begin
    if not (Minimap.PercentBlack > 25) then
    begin
      Self.WriteMsg('Detecting that we are not upstairs');
      Self.walkToLocation('Contract Start');
      Self.EnterHouseObjectOC;
    end
    else
    begin
      Self.JessFinder();
    end;
  end;

  if Self.ArdyRoss and (Minimap.PercentBlack > 25) then
  begin
    Minimap.RotateWithinAngles(-20,63);
    Self.handleDoorObjectSpecialOC(AnchorTile2, DoorTile2, AnchorColor2, DoorColor2, Self.AnchorValue2, RossDoorUp2, RossLadderDown);
  end;

  if Self.VarrockJeff then
  begin
    if (Minimap.PercentBlack > 25) then
      Self.handleDownstairsObject(JeffStairsDown);

    if not Self.RSW.AtTile([296,874], 8) then
    begin
        Minimap.RotateWithinAngles(267,320);

        Self.handleDoorObjectNormalOC(AnchorTile2, DoorTile2, AnchorColor2, DoorColor2, Self.AnchorValue2,JeffDoor2,[296,874]);
    end;
  end;

  if Self.VarrockBob and (Minimap.PercentBlack > 30) then
    Self.handleDownstairsObject(BobStaircaseDown);

  if Self.FallyNorman and not (Minimap.PercentBlack > 30) then
    Self.handleUpstairsObject(NormanLadderUp);

  if Self.FallyLarry and (Minimap.PercentBlack > 30) then
    Self.handleDownstairsObject(LarryStaircaseDown);

  if Self.HosidBarbara then
  begin
    Minimap.RotateWithinAngles(137,286);

    Self.handleDoorObjectNormalOC(AnchorTile2, DoorTile2, AnchorColor2, DoorColor2, Self.AnchorValue2,BarbaraBedDoor, [854,446]);
  end;

  if Self.HosidMariah and (Minimap.PercentBlack > 30) then
  begin
    Minimap.RotateWithinAngles(180, 270);

    if Self.RSW.AtTile([[1478,835]], 8) then
      Self.handleDoorObjectSpecialOC(AnchorTile2, DoorTile2, AnchorColor2, DoorColor2, Self.AnchorValue2, MariahDoorUp, MariahLadderDown);

    Self.handleDownstairsObject(MariahLadderDown);
  end;

  if Self.HosidLeela and (Minimap.PercentBlack > 30) then
    Self.handleDownstairsObject(LeelaLadderDown);

  Self.handleNPC(WhichNPC);
  Self.CuppaHandler();
  Self.GameEndReset();
end;

procedure TScript.DoorHandler();
var
  TauBox: TPointArray  := [[1040,878],[1028,882],[1014,896],[1014,904],[1018,904], [1022,912], [1034,912], [1032,890], [1040,888]];
  attempts: int32;
begin
  if Self.VarrockJeff or Self.VarrockBob or Self.FallyLarry or Self.FallyNorman or Self.HosidBarbara or Self.HosidLeela or Self.HosidMariah then
  begin
    Self.EnterHouseCoordsOC;
  end
  else
  if Self.VarrockSarah then
  begin
    Self.EnterHouseCoordsCO;
  end
  else
  if Self.ArdyJess then
  begin
    Self.EnterHouseObjectOC;
  end
  else
  if Self.ArdyNoella then
  begin
    Self.EnterHouseObjectCO;
  end
  else
  if Self.FallyTau then
  begin
    if not SRL.PointInPoly(MyPos, TauBox) then
    for attempts := 0 to 7 do
    begin
      Minimap.RotateWithinAngles(-61, 2);

      Self.handleDoorObjectNormalOC(AnchorTile, DoorTile, AnchorColor, DoorColor, Self.AnchorValue, TauFrontDoor, [1030,888]);

      MyPos := Self.RSW.GetMyPos();

      if Self.insideHouse then
        Break;
    end;
  end
  else
  if Self.ArdyRoss then
  begin
    if not ('go through the' in Chat.GetMessage(7, [0])) then
    begin
      for attempts := 0 to 10 do
      begin
        if RossDoor.SelectOption(['pen ', 'Op', 'n D'], 10) then
        begin
          WaitUntil(('go through the' in Chat.GetMessage(7, [0])), 115, 8000);
          Wait(2050,2550);
          MyPos := Self.RSW.GetMyPos();

          if Self.insideHouse then
            Break;
        end;

        Writeln('Did not manage to click Ross Door');

        if attempts >= 7 then
          Antiban.SmallCameraRotation();
      end;
    end;
  end;
end;

procedure TScript.JeffHouse();
begin
  if Self.HappyChecker then
    Exit;

  Minimap.RotateWithinAngles(-15,15);
  Self.handleMahoganyObject(JeffBookcase,JeffBookcaseGhost, 'Jeff bookcase', 'Jeff bookcase ghost');
  Self.handleMahoganyObject(JeffTable,JeffTableGhost, 'Jeff table', 'Jeff table ghost');
  Minimap.RotateWithinAngles(267,320);
  Self.handleDoorObjectSpecialOC(AnchorTile2, DoorTile2, AnchorColor2, DoorColor2, Self.AnchorValue2, JeffDoor2, JeffStairsUp);

  if (not Minimap.PercentBlack > 25) then
    Exit;

  Self.handleMahoganyObject(JeffDresser,JeffDresserGhost, 'Jeff dresser', 'Jeff dresser ghost');
  Self.handleMahoganyObject(JeffChair,JeffChairGhost, 'Jeff chair', 'Jeff chair ghost');
  Self.handleRepairObject(JeffMirror, 'Jeff mirror');
  Self.handleMahoganyObject(JeffBed,JeffBedGhost, 'Jeff bed', 'Jeff bed ghost');
  Self.handleMahoganyObject(JeffDrawer,JeffDrawerGhost, 'Jeff drawer', 'Jeff drawer ghost');
  Self.handleDownstairsObject(JeffStairsDown);

  if not Self.RSW.AtTile([[292,898]], 5) then
    Exit;

  Self.handleMahoganyObject(JeffShelves,JeffShelvesGhost, 'Jeff shelves', 'Jeff shelves ghost');
  Minimap.RotateWithinAngles(267,320);
