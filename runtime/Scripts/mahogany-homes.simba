function TScript.GetState(): EState;
begin
  if XPBar.EarnedXP() then
    Exit(EState.RESET_SAFETY_NET);

  if InactivityTimerMH.isFinished then
    Exit(EState.END_SCRIPT_NET);

  if ChatButtons.GetState(EChatButton.GAME_CHAT) <> EChatButtonState.ENABLED then
    Exit(EState.CHANGE_CHAT_FILTER);

  if not ChatButtons.IsActive(EChatButton.GAME_CHAT) then
    Exit(EState.OPEN_CHAT);

  if InRange(Chat.GetScrollPosition, 1, 99) then
    Chat.SetScrollPosition(100);

  case Self.ContractMethod of
  'NPC contact (lunar spellbook)':
  begin
    if not Self.UsePlankSack then
    begin
      if (not Self.hasenoughPlanks) and (not Self.OnContract) then
      begin
        if not (ScriptWalker^.GetMyPos()).InBox(castlewarsBox) and not (ScriptWalker^.GetMyPos()).InBox(craftinguildBox) then
          Exit(EState.TELEPORT_HANDLER);

        if (not Bank.IsOpen()) then
          Exit(EState.CLICK_BANK);

        if Bank.IsOpen() then
          Exit(EState.WITHDRAW_ITEMS);
      end;

      if (Self.hasenoughPlanks) and (not Self.OnContract) then
        Exit(EState.GET_CONTRACT);

      if Self.OnContract then
      begin
        if Self.HappyChecker then
          Exit(EState.HANDLE_TURN_IN);

        if Self.InsideHouse and not Self.HappyChecker then
          Exit(EState.HOUSE_HANDLER);

        if Self.RSW.AtTile(Self.StartTile, 24) then
          Exit(EState.ENTRANCE_DOOR_HANDLER);

        if (not Self.RSW.AtTile(Self.StartTile, 24)) then
          Exit(Estate.WALK_TO_CONTRACT);
      end;
    end;

    if Self.UsePlankSack then
    begin
      if Self.OnContract and Self.hasEnoughPlanks then
      begin
        if Self.HappyChecker then
          Exit(EState.HANDLE_TURN_IN);

        if Self.InsideHouse and not Self.HappyChecker then
          Exit(EState.HOUSE_HANDLER);

        if Self.RSW.AtTile(Self.StartTile, 24) then
          Exit(EState.ENTRANCE_DOOR_HANDLER);

        if (not Self.RSW.AtTile(Self.StartTile, 24)) then
          Exit(Estate.WALK_TO_CONTRACT);
      end;

      if (ScriptWalker^.GetMyPos()).InBox(castlewarsBox) or (ScriptWalker^.GetMyPos()).InBox(craftinguildBox) then
      begin
        if (not (Self.hasenoughPlanks)) and (not Bank.IsOpen()) then
          Exit(EState.CLICK_BANK);

        if Bank.IsOpen() then
          Exit(EState.WITHDRAW_ITEMS);
      end;

      if (not (Self.hasenoughPlanks)) and not (ScriptWalker^.GetMyPos()).InBox(castlewarsBox) and not (ScriptWalker^.GetMyPos()).InBox(craftinguildBox) then
        Exit(EState.TELEPORT_HANDLER);

      if (not Self.OnContract) then
        Exit(EState.GET_CONTRACT);
    end;
  end;

  'Talk to NPC (normal spellbook)':
  begin
    if not Self.UsePlankSack then
    begin
      if (not (Self.hasenoughPlanks)) and not Self.OnContract then
      begin
        if not (ScriptWalker^.GetMyPos()).InBox([337,253,522,426]) and not (ScriptWalker^.GetMyPos()).InBox(craftinguildBox) then
          Exit(EState.TELEPORT_HANDLER);

        if (not Bank.IsOpen()) then
          Exit(EState.CLICK_BANK);

        if Bank.IsOpen() then
          Exit(EState.WITHDRAW_ITEMS);
      end;

      if (Self.hasenoughPlanks) and not Self.OnContract then
        Exit(EState.TRAVEL_TO_CONTRACT);

      if Self.OnContract then
      begin
        if Self.HappyChecker then
          Exit(EState.HANDLE_TURN_IN);

        if Self.InsideHouse then
          Exit(EState.HOUSE_HANDLER);

        if Self.RSW.AtTile(Self.StartTile, 24) then
          Exit(EState.ENTRANCE_DOOR_HANDLER);

        if (not Self.RSW.AtTile(Self.StartTile, 24)) then
          Exit(Estate.WALK_TO_CONTRACT);
      end;
    end;

    if Self.UsePlankSack then
    begin
      if Self.OnContract and Self.hasEnoughPlanks then
      begin
        if Self.HappyChecker then
          Exit(EState.HANDLE_TURN_IN);

        if Self.InsideHouse and not Self.HappyChecker then
          Exit(EState.HOUSE_HANDLER);

        if Self.RSW.AtTile(Self.StartTile, 24) then
          Exit(EState.ENTRANCE_DOOR_HANDLER);

        if (not Self.RSW.AtTile(Self.StartTile, 24)) then
          Exit(Estate.WALK_TO_CONTRACT);
      end;

      if (ScriptWalker^.GetMyPos()).InBox([337,253,522,426]) or (ScriptWalker^.GetMyPos()).InBox(craftinguildBox) then
      begin
        if (not (Self.hasenoughPlanks)) and (not Bank.IsOpen()) then
          Exit(EState.CLICK_BANK);

        if Bank.IsOpen() then
          Exit(EState.WITHDRAW_ITEMS);
      end;

      if (not (Self.hasenoughPlanks)) and not (ScriptWalker^.GetMyPos()).InBox([337,253,522,426]) and not (ScriptWalker^.GetMyPos()).InBox(craftinguildBox) then
        Exit(EState.TELEPORT_HANDLER);

      if (not Self.OnContract) then
        Exit(EState.TRAVEL_TO_CONTRACT);
    end;
  end;
  end;
end;

function LoginIfNot(): Boolean;
begin
  if not GameClient.IsLoggedIn() then
  begin
    if not Login.LoginPlayer(False) then
    begin
      TerminateScript("Could not log in player");
    end
    else
      Result := True;
  end;
end;

procedure TScript.Run();
begin
  while true do
  begin
    if (Self.ShutdownTime > 0) and (GetTimeRunning() > Self.ShutdownTime) then
      Self.EndScript();

    if (Self.ContractLimit > 0) and (Self.GameCount >= Self.ContractLimit) then
      Self.EndScript();

    LoginIfNot();
    Self.State := Self.GetState();
    case Self.State of
      EState.OPEN_CHAT: ChatButtons.Open(EChatButton.GAME_CHAT);
      EState.CHANGE_CHAT_FILTER: ChatButtons.ChangeState(EChatButton.GAME_CHAT, EChatButtonState.ENABLED);
      EState.GET_CONTRACT: Self.GetContract();
      EState.RESET_SAFETY_NET: InactivityTimerMH.Restart;
      EState.TRAVEL_TO_CONTRACT: begin Self.WalkToLocation('Contract NPC'); Self.GetContract(); end;
      EState.CLICK_BANK: begin Self.DoAntiban(); Self.clickBank(); end;
      EState.WITHDRAW_ITEMS: Self.WithdrawItems();
      EState.TELEPORT_HANDLER: Self.WalkToLocation('Bank');
      EState.WALK_TO_CONTRACT: Self.WalkToLocation('Contract Start');
      EState.ENTRANCE_DOOR_HANDLER: Self.DoorHandler();
      EState.HANDLE_TURN_IN: Self.HandleEndGame();
      EState.HOUSE_HANDLER: Self.HouseHandler();
      EState.END_SCRIPT: Self.EndScript();
      EState.END_SCRIPT_NET: Self.SafetyNetEndScript();
    end;
  end;
end;

begin
  //WaspClient.CheckSubscription(True);
  SettingsHandler.CheckGPUPlugin();

  if (not DirectoryExists(AppPath+'\Resources\')) then
    CreateDirectory(AppPath+'\Resources');

  if (not FileExists(AppPath+'\Resources\SMH2GUI.png')) then
    DownloadToFile('https://raw.githubusercontent.com/TwistedSlayerHelm/Images/refs/heads/main/gui/SMH2GUI.png', AppPath+'\Resources\SMH2GUI.png');

  if FileExists(AppPath+'\Configs/StudentsSettings') then
    MHConfig.Init();

  GUI.Setup('Mahogany Homes', [750,466]);
  GUI.PageControl.SetAllChildsFontColor($000000);
  GUI.Run();

  {$IFNDEF SRL_DISABLE_REMOTEINPUT}
  if WLSettings.GetObject('remote_input').getBoolean('enabled', True) and (not GameClient.RemoteInput.IsSetup()) then GameClient.RemoteInput.Setup();
  {$ENDIF}

  MHConfig.Write();

  Bot.Init();
  Bot.Run();
end.
