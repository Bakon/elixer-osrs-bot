procedure TScript.WriteMsg(Message: String);
begin
  WriteLn(SRL.TimeStamp() + '[Mahogany Homes]: '+ Message);
end;

procedure TIniConfig.Init();
var
  sack, frun, brun, tbreak, tsleep, cguildbank, bhbestlog, bhclockworks : string;
begin
   sack := ReadINI('General', 'Plank sack', AppPath+'Configs/StudentsSettings');
   self.sackEnabled := StrToBoolDef(sack, False);

   frun := ReadINI('General', 'Farm runs', AppPath+'Configs/StudentsSettings');
   self.frunEnabled := StrToBoolDef(frun, False);

   brun := ReadINI('General', 'BH runs', AppPath+'Configs/StudentsSettings');
   self.brunEnabled := StrToBoolDef(brun, False);

   tbreak := ReadINI('General', 'Take breaks', AppPath+'Configs/StudentsSettings');
   self.tbreakenabled := StrToBoolDef(tbreak, False);

   tsleep := ReadINI('General', 'Take sleeps', AppPath+'Configs/StudentsSettings');
   self.tsleepenabled := StrToBoolDef(tsleep, False);

   cguildbank := ReadINI('General', 'CGuild banking', AppPath+'Configs/StudentsSettings');
   self.cguildbankEnabled := StrToBoolDef(cguildbank, False);

   MHConfig.contractcountint := StrToIntDef(ReadINI('General', 'Contract count', AppPath+'Configs/StudentsSettings'), 200);
   MHConfig.maxrunforint := StrToIntDef(ReadINI('General', 'Max run for', AppPath+'Configs/StudentsSettings'), 600);

   MHConfig.breakintervalint := StrToIntDef(ReadINI('General', 'Break interval', AppPath+'Configs/StudentsSettings'), 60);
   MHConfig.breaklengthint := StrToIntDef(ReadINI('General', 'Break length', AppPath+'Configs/StudentsSettings'), 15);
   MHConfig.sleepintervalstr := ReadINI('General', 'Sleep interval', AppPath+'Configs/StudentsSettings');
   MHConfig.sleeplengthint := StrToIntDef(ReadINI('General', 'Sleep length', AppPath+'Configs/StudentsSettings'), 8);

   MHConfig.contractint := StrToIntDef(ReadINI('General', 'Contract', AppPath+'Configs/StudentsSettings'), 0);
   MHConfig.methodint := StrToIntDef(ReadINI('General', 'Method', AppPath+'Configs/StudentsSettings'), 0);
   MHConfig.runepouchint := StrToIntDef(ReadINI('General', 'RPouch', AppPath+'Configs/StudentsSettings'), 0);
   MHConfig.hosidiustpint := StrToIntDef(ReadINI('General', 'Hosidus TP', AppPath+'Configs/StudentsSettings'), 0);
   MHConfig.arfavatpint := StrToIntDef(ReadINI('General', 'ArFaVa TP', AppPath+'Configs/StudentsSettings'), 0);

   MHConfig.bhlogint := StrToIntDef(ReadINI('BH Tab', 'BH logs', AppPath+'Configs/StudentsSettings'), 0);
   BHIncludeGUILogType := ELogType(MHConfig.bhlogint);

   MHConfig.bhseed := ReadINI('BH Tab', 'BH seed', AppPath+'Configs/StudentsSettings');
   BHIncludeGUISeed := MHConfig.bhseed;

   MHConfig.bhrunint := StrToIntDef(ReadINI('BH Tab', 'BH runtime', AppPath+'Configs/StudentsSettings'), 0);
   BHIncludeGUIRunIntervalMinutes := Round(MHConfig.bhrunint / 60000);

   bhbestlog := ReadINI('BH Tab', 'BH best log', AppPath+'Configs/StudentsSettings');
   self.bhusebestlogEnabled := StrToBoolDef(bhbestlog, False);
   BHIncludeGUIUseBestLog := MHConfig.bhusebestlogEnabled;

   bhclockworks := ReadINI('BH Tab', 'BH clockworks', AppPath+'Configs/StudentsSettings');
   self.bhcraftclockworksEnabled := StrToBoolDef(bhclockworks, False);
   BHIncludeGUICraftWhileNav := MHConfig.bhcraftclockworksEnabled;

   MHConfig.loginindexint := StrToIntDef(ReadINI('Account Tab', 'Login index', AppPath+'Configs/StudentsSettings'), 0);
   Login.PlayerIndex := MHConfig.loginindexint;
end;

procedure TIniConfig.Write();
begin
  WriteIni('General', 'Plank sack', ToStr(self.sackEnabled), AppPath+'Configs/StudentsSettings');
  WriteIni('General', 'Farm runs', ToStr(self.frunEnabled), AppPath+'Configs/StudentsSettings');
  WriteIni('General', 'BH runs', ToStr(self.brunEnabled), AppPath+'Configs/StudentsSettings');

  WriteIni('General', 'Contract', ToStr(self.contractint), AppPath+'Configs/StudentsSettings');
  WriteIni('General', 'Method', ToStr(self.methodint), AppPath+'Configs/StudentsSettings');
  WriteIni('General', 'RPouch', ToStr(self.runepouchint), AppPath+'Configs/StudentsSettings');
  WriteIni('General', 'Hosidus TP', ToStr(self.hosidiustpint), AppPath+'Configs/StudentsSettings');
  WriteIni('General', 'ArFaVa TP', ToStr(self.arfavatpint), AppPath+'Configs/StudentsSettings');
  WriteIni('General', 'CGuild banking', ToStr(self.cguildbankEnabled), AppPath+'Configs/StudentsSettings');

  WriteIni('General', 'Take breaks', ToStr(self.tbreakenabled), AppPath+'Configs/StudentsSettings');
  WriteIni('General', 'Take sleeps', ToStr(self.tsleepenabled), AppPath+'Configs/StudentsSettings');
  WriteIni('General', 'Contract count', ToStr(self.contractcountint), AppPath+'Configs/StudentsSettings');
  WriteIni('General', 'Max run for', ToStr(self.maxrunforint), AppPath+'Configs/StudentsSettings');

  WriteIni('General', 'Break interval', ToStr(self.breakintervalint), AppPath+'Configs/StudentsSettings');
  WriteIni('General', 'Break length', ToStr(self.breaklengthint), AppPath+'Configs/StudentsSettings');
  WriteIni('General', 'Sleep interval', Self.sleepintervalstr, AppPath+'Configs/StudentsSettings');
  WriteIni('General', 'Sleep length', ToStr(self.sleeplengthint), AppPath+'Configs/StudentsSettings');

  WriteIni('BH Tab', 'BH logs', ToStr(Ord(BirdHouseRunner.LogType)), AppPath+'Configs/StudentsSettings');
  WriteIni('BH Tab', 'BH seed', BirdHouseRunner.Seed, AppPath+'Configs/StudentsSettings');
  WriteIni('BH Tab', 'BH runtime', ToStr(BirdHouseRunner.TaskInterval), AppPath+'Configs/StudentsSettings');
  WriteIni('BH Tab', 'BH best log', ToStr(BirdHouseRunner.AlwaysUseBestLog), AppPath+'Configs/StudentsSettings');
  WriteIni('BH Tab', 'BH clockworks', ToStr(BirdHouseRunner.NeedClockworks), AppPath+'Configs/StudentsSettings');

  WriteIni('Account Tab', 'Login index', ToStr(Login.PlayerIndex), AppPath+'Configs/StudentsSettings');
  // ... any other things you stored on TIniConfig
end;

procedure TScriptForm.StartScript(Sender: TObject); override;
var
  MaxRun, ContractLimit: Int32;
  e_Run, e_BA, e_BF, e_SA, e_SF, c_lim: TEdit;
  cb_Breaks,cb_Sleeps, FarmRuns, BHRuns, CGBank, PSack: TCheckBox;
  RPouch, Cmethod, HosTP, AFVTP,  ContractTypeVariable: TComboBox;

begin
  inherited;

  Self.Form.Close();
  Bot.WriteMsg('Starting script');

  c_lim  := Self.Form.GetChild('box_cl_edit');
  ContractLimit := StrToInt(C_lim.getText);
  Bot.ContractLimit := (ContractLimit);

{ Time settings }
  e_Run            := Self.Form.GetChild('box_run_edit');
  MaxRun           := StrToInt(e_Run.getText);
  Bot.ShutdownTime := (MaxRun * 60000) + Random(- (MaxRun * 6000), (MaxRun * 6000));

  cb_Breaks        := Self.Form.GetChild('cb_breaks_checkbox');
  Bot.TakeBreaks   := cb_Breaks.IsChecked;
  if Bot.TakeBreaks then
  begin
    e_BA           := Self.Form.GetChild('box_ba_edit');
    e_BF           := Self.Form.GetChild('box_bf_edit');
    Antiban.AddBreak(ONE_MINUTE*StrToInt(e_BA.getText),ONE_MINUTE*StrToInt(e_BF.getText), 0.15, 1.0);
  end;

  cb_Sleeps        := Self.Form.GetChild('cb_sleeps_checkbox');
  Bot.TakeSleeps   := cb_Sleeps.IsChecked;
  if Bot.TakeSleeps then
  begin
    e_SA           := Self.Form.GetChild('box_sa_edit');
    e_SF           := Self.Form.GetChild('box_sf_edit');
    Antiban.AddSleep(e_SA.getText, StrToInt(e_SF.getText) * ONE_HOUR, 0.1, 1.0);
  end;

  { Script settings }
  ContractTypeVariable  := Self.Form.GetChild('lcb_contract_combobox');
  Bot.ContractEnum := EContract(ContractTypeVariable.getItemIndex());

  PSack := Self.Form.GetChild('cb_psack_checkbox');
  Bot.UsePlankSack := (PSack.getState = cbChecked);

  CGBank := Self.Form.GetChild('cb_cgbank_checkbox');
  Bot.CraftingGuildBanking := (CGBank.getState = cbChecked);

  FarmRuns := Self.Form.GetChild('cb_farmruns_checkbox');
  Bot.DoFarmRuns  := (FarmRuns.GetState = cbChecked);

  BHRuns := Self.Form.GetChild('cb_bhruns_checkbox');
  Bot.DoBHRuns    := (BHRuns.getState = cbChecked);

  HosTP := Self.Form.GetChild('lcb_hostp_combobox');
  Bot.HosidiusTP := HosTP.GetText;

  AFVTP := Self.Form.GetChild('lcb_afvtp_combobox');
  Bot.ArFaVaTP := AFVTP.GetText;

  RPouch := Self.Form.GetChild('lcb_rpouch_combobox');
  Bot.RPouchMethod := RPouch.getText;

  CMethod := Self.Form.GetChild('lcb_cmethod_combobox');
  Bot.ContractMethod := CMethod.getText;

  MHConfig.tbreakenabled := Bot.TakeBreaks;
  MHConfig.tsleepenabled := Bot.TakeSleeps;

  MHConfig.contractcountint := ContractLimit;
  MHConfig.maxrunforint := MaxRun;

  if Bot.TakeBreaks then
  begin
    MHConfig.breakintervalint := StrToInt(e_BA.getText);
    MHConfig.breaklengthint := StrToInt(e_BF.getText);
  end;

  if Bot.TakeSleeps then
  begin
    MHConfig.sleepintervalstr := e_SA.getText;
    MHConfig.sleeplengthint := StrToInt(e_SF.getText);
  end;

  MHConfig.sackenabled := Bot.UsePlankSack;
  MHConfig.frunEnabled := Bot.DoFarmRuns;
  MHConfig.brunEnabled := Bot.DoBHRuns;
  MHConfig.cguildbankEnabled := Bot.CraftingGuildBanking;

  MHConfig.contractint := Ord(Bot.ContractEnum);
  MHConfig.methodint := CMethod.getItemIndex();
  MHConfig.runepouchint := RPouch.getItemIndex();
  MHConfig.hosidiustpint := HosTP.getItemIndex();
  MHConfig.arfavatpint := AFVTP.getItemIndex();
end;

function TScriptForm.CreateSettingsTab(): TTabSheet;
type
  TScriptForm = TScriptForm;

procedure TScriptForm.UpdateSList({$H-}sender: TObject);{$H+}
var
  S, ContractTypeVariable, RPouch, HosTP, AFVTP, CMethod: TComboBox;
  PSack, CGBank : TCheckBox;
  HosTPCap, AFVTPCap, RPouchCap, CmethodCap: TLabel;

begin
  S := Sender;
  ContractTypeVariable  := Self.Form.GetChild('lcb_contract_combobox');
  Bot.ContractEnum := EContract(ContractTypeVariable.getItemIndex());

  PSack := Self.Form.GetChild('cb_psack_checkbox');
  Bot.UsePlankSack := (PSack.getState = cbChecked);

  CGBank := Self.Form.GetChild('cb_cgbank_checkbox');
  Bot.CraftingGuildBanking := (CGBank.getState = cbChecked);

  RPouch  := Self.Form.GetChild('lcb_rpouch_combobox');
  Bot.RPouchMethod := RPouch.getText;
  RPouchCap := Self.Form.GetChild('lcb_rpouch_caption');

  HosTP := Self.Form.GetChild('lcb_hostp_combobox');
  Bot.HosidiusTP := HosTP.GetText;
  HosTPCap := Self.Form.GetChild('lcb_hostp_caption');

  AFVTP := Self.Form.GetChild('lcb_afvtp_combobox');
  Bot.ArFaVaTP := AFVTP.GetText;
  AFVTPCap := Self.Form.GetChild('lcb_afvtp_caption');

  CMethod := Self.Form.GetChild('lcb_cmethod_combobox');
  Bot.ContractMethod := CMethod.getText;
  CmethodCap := Self.Form.GetChild('lcb_cmethod_caption');

  RPouch.SetFontColor(0);
  RPouchCap.SetFontColor(0); // Needed?
  HosTP.SetFontColor(0);
  HosTPCap.SetFontColor(0); // Needed?
  AFVTP.SetFontColor(0);
  AFVTPCap.SetFontColor(0); // Needed?
  CMethod.SetFontColor(0);
  CmethodCap.SetFontColor(0); //Needed?

  ContractTypeVariable.SetFontColor(0);

  ContractTypeVariable.Clear;
  ContractTypeVariable.Refresh;
  RPouch.Clear;
  RPouch.Refresh;
  HosTP.Clear;
  HosTP.Refresh;
  AFVTP.Clear;
  AFVTP.Refresh;
  CMethod.Clear;
  CMethod.Refresh;

  RPouchCap.Refresh;
  HosTPCap.Refresh;
  AFVTPCap.Refresh;
  CmethodCap.Refresh;
end;

var
  lb_Time, lb_Script: TLabel;
  cb_Breaks, cb_Sleeps,
  cb_farmruns, cb_bhruns, cb_psack, cb_cgbank: TLabeledCheckBox;
  box_Run, box_BA, box_BF,
  box_SA, box_SF, box_CL: TLabeledEdit;
  lcb_contract, lcb_rpouch, lcb_hostp, lcb_afvtp, lcb_cmethod: TLabeledComboBox;
begin
  Result.Init(nil);
  Result.SetCaption('Script settings');
