{$DEFINE SCRIPT_REVISION := '1'}
{$DEFINE SCRIPT_GUI}
{$I SRL-T/main.simba}
{$I WaspLib/main.simba}

(*
Elixer Tempoross
================
Plays the Tempoross fishing minigame at the Ruins of Unkah: boards the ship,
fishes harpoonfish (optionally cooking them at the shrine), loads them into
the ammunition crates, repairs damaged masts/totem poles, tethers during
colossal waves, douses fires with buckets and harpoons the spirit pool when
Tempoross is vulnerable. Re-queues automatically after each round.

Start anywhere in the Ruins of Unkah with a harpoon in the inventory or
equipped (or let the script grab one from a harpoon crate). Reward permits
accumulate on your account; spend them at the reward pool manually.

This is a best-effort first version: several object names, chat messages and
the HUD reader are marked for field testing. Babysit the first runs.
*)

type
  ETemporossState = (
    END_SCRIPT,
    CLOSE_INTERFACE,

    // Lobby
    BOARD_SHIP,
    WAIT_START,

    // Arena
    TETHER,
    GET_ROPE,
    GET_HAMMER,
    GET_BUCKET,
    GET_HARPOON,
    REPAIR_STRUCTURE,
    FILL_BUCKET,
    DOUSE_FIRE,
    ATTACK_SPIRIT_POOL,
    COOK_FISH,
    LOAD_CRATE,
    WAIT_FISHING,
    FISH
  );

// GUI-configurable settings.
var
  CookFish: Boolean         = False; // Cook raw harpoonfish at the shrine before loading
  DouseFires: Boolean       = True;  // Keep a bucket and douse fires that appear
  RepairStructures: Boolean = True;  // Keep a hammer and repair damaged masts/totems
  TetherWaves: Boolean      = True;  // Keep a rope and tether when a colossal wave comes
  DebugMapNames: Boolean    = False; // Print all map object/NPC names at startup (field-test aid)
  FishBeforeLoading: Int32  = 17;    // Fish to hold before running to the ammunition crate
  IntensityDump: Int32      = 92;    // Storm intensity % at which fish are dumped immediately

type
  TTemporossFisher = record(TBaseWalkerScript)
    State: ETemporossState;

    // Everything is a WaspLib walker object (GameObjects.Tempoross*) on the
    // RSW region maps — the library ships the whole arena. In-arena detection
    // combines walker position with the arena-only HUD bars.
    InArena, WasInArena, Boarded: Boolean;
    ArenaMisses: Int32;
    MyPos: TPoint;
    CheckRepair: Boolean;

    // Round state.
    IsFishing, WaveIncoming, Vulnerable, RoundEnding, NeedHarpoon: Boolean;
    Energy, Essence, Intensity, Points: Int32;
    RopeTries, HammerTries, BucketTries, HarpoonTries: Int32;
    RoundFishLoaded: Int32;

    FishTimer, WaveTimer, BoardTimer, HUDTimer, SpiritTimer, PosTimer: TCountDown;

    RawFish, CookedFish: TItem;
    Harpoons: TItemArray;
  end;

procedure TAntiban.Setup(); override;
begin
  Self.Skills := [ESkill.FISHING, ESkill.TOTAL];
  Self.MinZoom := 10;
  Self.MaxZoom := 50;

  inherited;
end;

procedure TTemporossFisher.Init(maxActions: UInt32; maxTime: UInt64); override;
begin
  inherited;

  // The library ships the whole minigame as walker objects: the dock rope
  // ladder plus every arena object with real coordinates on the region maps.
  Self.RSW.SetupRegions([RSRegions.RUINS_OF_UNKAH, RSRegions.TEMPOROSS_COVE]);
  GameObjects.Setup();

  Self.RawFish := 'Raw harpoonfish';
  Self.CookedFish := 'Harpoonfish';
  Self.Harpoons := [
    'Harpoon', 'Barb-tail harpoon', 'Dragon harpoon', 'Infernal harpoon',
    'Crystal harpoon'
  ];

  Self.NeedHarpoon := not Inventory.ContainsAny(Self.Harpoons);
  if Self.NeedHarpoon then
    Self.NeedHarpoon := not (Equipment.Open() and Equipment.ContainsAny(Self.Harpoons));

  Self.FishTimer.Setup(8000);    // no XP for this long = not fishing anymore
  Self.WaveTimer.Setup(25000);   // hard cap on waiting a wave out
  Self.BoardTimer.Setup(180000); // re-click the ship if no game after 3 min
  Self.HUDTimer.Setup(3000);     // HUD OCR throttle
  Self.SpiritTimer.Setup(7000);  // spirit pool probe throttle
  Self.PosTimer.Setup(3000);     // position breadcrumb throttle

  Self.Energy := -1;
  Self.Essence := -1;
  Self.Intensity := -1;
end;

function TTemporossFisher.CountFish(): Int32;
begin
  Result := Inventory.CountItem(Self.RawFish) + Inventory.CountItem(Self.CookedFish);
end;

// ---------------------------------------------------------------------------
// Minigame HUD (energy/essence/intensity/points) via OCR. Box, bar colors and
// text colors were calibrated from field-test screenshots (fixed mode).
// If OCR misses, spirit-pool probing and chat messages still carry the round.
// ---------------------------------------------------------------------------
function TTemporossFisher.ParsePercent(text, tag: String): Int32;
var
  i: Int32;
  s, digits: String;
begin
  Result := -1;

  i := Pos(LowerCase(tag), LowerCase(text));
  if i = 0 then
    Exit;

  s := Copy(text, i + Length(tag), 10);
  for i := 1 to Length(s) do
  begin
    if s[i] in ['0'..'9'] then
      digits += s[i]
    else if digits <> '' then
      Break;
  end;

  if digits <> '' then
    Result := StrToIntDef(digits, -1);
end;

function TTemporossFisher.HUDBox(): TBox;
begin
  Result := Box(
    MainScreen.Bounds.X1, MainScreen.Bounds.Y1 + 30,
    MainScreen.Bounds.X1 + 235, MainScreen.Bounds.Y1 + 165
  );
end;

function TTemporossFisher.BarPercent(color: TCTS2Color): Int32;
var
  tpa: TPointArray;
begin
  Result := -1;
  if SRL.FindColors(tpa, color, Self.HUDBox()) < 8 then
    Exit;
  Result := Min(100, Round(tpa.Bounds().Width() / 168 * 100));
end;

// The Energy (cyan) and Essence (green) bars only exist inside the arena.
// Bar colors sampled from field-test screenshots.
function TTemporossFisher.HUDVisible(): Boolean;
var
  tpa: TPointArray;
begin
  Result := (SRL.FindColors(tpa, CTS2($EADD5A, 14, 0.10, 1.60), Self.HUDBox()) > 40) or
            (SRL.FindColors(tpa, CTS2($5ADD5A, 14, 0.10, 1.60), Self.HUDBox()) > 40);

  // Both bars can be drained during the vulnerable phase — the intensity
  // label (grey bar, readable by OCR) still proves the HUD is up.
  if not Result then
    Result := Self.ParsePercent(OCR.Recognize(Self.HUDBox(),
      TOCRColorFilter.Create([$000000]), FONT_PLAIN_12), 'Intensity') > -1;
end;

procedure TTemporossFisher.UpdateHUD();
var
  text: String;
begin
  if not Self.HUDTimer.IsFinished() then
    Exit;
  Self.HUDTimer.Restart();

  // Energy/essence come from the fill width of their bars (the black-text OCR
  // only resolves on the grey intensity bar); 168px = full bar in fixed mode.
  Self.Energy  := Self.BarPercent(CTS2($EADD5A, 14, 0.10, 1.60));
  Self.Essence := Self.BarPercent(CTS2($5ADD5A, 14, 0.10, 1.60));
  if Self.InArena then
  begin
    if Self.Energy = -1 then
      Self.Energy := 0; // bar fully drained: Tempoross is vulnerable
    if Self.Essence = -1 then
      Self.Essence := 0;
  end;

  text := OCR.Recognize(Self.HUDBox(), TOCRColorFilter.Create([$000000]), FONT_PLAIN_12);
  Self.Intensity := Self.ParsePercent(text, 'Intensity');

  text := OCR.Recognize(Self.HUDBox(), TOCRColorFilter.Create([$0000FF]), FONT_PLAIN_12);
  Self.Points := Self.ParsePercent(text, 'Points');

  if Self.Energy = 0 then
    Self.Vulnerable := True;
end;

// ---------------------------------------------------------------------------
// Chat-driven events.
// TODO(field-test): message fragments are best guesses, all lowercase checks.
// ---------------------------------------------------------------------------
procedure TTemporossFisher.ProcessChat();
var
  msg: String;
begin
  msg := LowerCase(Chat.GetMessage(CHAT_INPUT_LINE - 1) + ' ' +
                   Chat.GetMessage(CHAT_INPUT_LINE - 2));

  // Wave-passed lines outrank the warning: they always arrive after it.
  if msg.Contains('wave washes over') or msg.Contains('wave slams into') then
    Self.WaveIncoming := False
  else if msg.Contains('colossal wave closes in') then
  begin
    if not Self.WaveIncoming then
      Self.WaveTimer.Restart();
    Self.WaveIncoming := True;
  end;

  if msg.Contains('vulnerable') then // guessed fragment
    Self.Vulnerable := True;

  if msg.Contains('storm is out of control') or msg.Contains('too much energy') then
    Self.RoundEnding := True;
end;

// ---------------------------------------------------------------------------
// Minimap-dot NPC finding (fishing spots and the spirit pool are NPC dots).
// ---------------------------------------------------------------------------
function TTemporossFisher.HoverNPCDot(upText: TStringArray): Boolean;
var
  dots: TPointArray;
  dot: TPoint;
  rect: TRectangle;
  attempts: Int32;
begin
  dots := Minimap.GetDots(EMinimapDot.NPC).Offset(2, 2);
  if dots = [] then
    Exit;

  dots := dots.Sorted(Minimap.Center);

  for dot in dots do
  begin
    rect := Minimap.PointToMSRect(dot);
    if not MainScreen.Bounds.Contains(rect.Bounds()) then
      Continue; // off-screen dots don't consume attempts

    Inc(attempts);
    if attempts > 8 then
      Exit;

    Mouse.Move(rect);
    if MainScreen.IsUpText(upText, 400) then
      Exit(True);

    Self.DebugLn('dot uptext: "' + MainScreen.GetUpText() + '" (wanted ' + ToStr(upText) + ')');
  end;
end;

// The fishing spots spawn at the water's edge, far from the boat; the crew
// (Captain Dudi and co.) cluster near the spawn. So walk toward the FARTHEST
// NPC dot on the minimap - no upper cap - which is almost always a spot.
function TTemporossFisher.WalkTowardNPCDot(): Boolean;
var
  dots: TPointArray;
begin
  dots := Minimap.GetDots(EMinimapDot.NPC).Offset(2, 2);
  // Skip only the dots right on top of us (that's the crew we're standing by).
  dots := dots.FilterDist(18, 999, Minimap.Center.X, Minimap.Center.Y);
  if dots = [] then
    Exit;

  dots := dots.Sorted(Minimap.Center);
  Mouse.Move(dots[High(dots)]); // farthest = the water-edge fishing spot
  Mouse.Click(MOUSE_LEFT);
  Minimap.WaitMoving();
  Result := True;
end;

function TTemporossFisher.ClickNPCDot(upText: TStringArray): Boolean;
begin
  if not Self.HoverNPCDot(upText) then
    Exit;

  Result := Antiban.BioRedClick(MOUSE_LEFT, 3);
end;

// ---------------------------------------------------------------------------
// Lobby.
// ---------------------------------------------------------------------------
function TTemporossFisher.BoardShip(): Boolean;
begin
  if GameObjects.UnkahShipRopeLadder.WalkClick() then
  begin
    Minimap.WaitMoving();
    Self.Boarded := True;
    Self.BoardTimer.Restart();
    Result := True;
  end;
end;

procedure TTemporossFisher.WaitStart();
begin
  // Idle on deck until the map flips to the arena region; GetState re-checks.
  Wait(1200, 2400);

  if Self.BoardTimer.IsFinished() then
    Self.Boarded := False; // probably never boarded; try again
end;

procedure TTemporossFisher.ResetRound();
begin
  Self.Boarded := False;
  Self.IsFishing := False;
  Self.WaveIncoming := False;
  Self.Vulnerable := False;
  Self.RoundEnding := False;
  Self.Energy := -1;
  Self.Essence := -1;
  Self.Intensity := -1;
  Self.RopeTries := 0;
  Self.HammerTries := 0;
  Self.BucketTries := 0;
  Self.HarpoonTries := 0;
  Self.RoundFishLoaded := 0;
  Self.Points := -1;
  Self.CheckRepair := False;
end;

// ---------------------------------------------------------------------------
// Supplies: library walker objects, same mechanism as every other script.
// ---------------------------------------------------------------------------
function TTemporossFisher.TakeFromCrate(crate: TGameObject; item: TItem; var tries: Int32): Boolean;
begin
  Inc(tries);

  if crate.WalkSelectOption(['Take']) or crate.WalkClick() then
  begin
    Minimap.WaitMoving();
    Result := WaitUntil(Inventory.ContainsItem(item), 300, 6000);
  end;
end;

function TTemporossFisher.FillBucket(): Boolean;
begin
  if GameObjects.TemporossPump.WalkSelectOption(['Use']) or
     GameObjects.TemporossPump.WalkClick() then
  begin
    Minimap.WaitMoving();
    Result := WaitUntil(Inventory.ContainsItem('Bucket of water'), 300, 6000);
  end;
end;

// ---------------------------------------------------------------------------
// Fires. Not in the static map data (they spawn dynamically), so find them
// by color on the mainscreen and confirm with the Douse uptext.
// ---------------------------------------------------------------------------
function TTemporossFisher.FindFire(out atpa: T2DPointArray): Boolean;
var
  tpa: TPointArray;
begin
  // Flame colors: warm ORANGE (~RGB 215,158,58). The earlier pure-yellow
  // value was mis-sampled off the yellow broadcast text ("More fish!"), which
  // made the bot see fire constantly and abandon fishing. Orange excludes it.
  if SRL.FindColors(tpa, CTS2($3A9ED7, 22, 0.18, 1.40), MainScreen.Bounds) < 60 then
    Exit;

  atpa := tpa.Cluster(MainScreen.NormalizeDistance(6));
  atpa := atpa.ExcludeSize(MainScreen.NormalizeDistance(40), __LT__);

  Result := atpa <> [];
  if Result then
    atpa := atpa.SortFrom(MainScreen.GetPlayerBox().Center());
end;

function TTemporossFisher.DouseFire(): Boolean;
var
  atpa: T2DPointArray;
  i: Int32;
begin
  if not Self.FindFire(atpa) then
    Exit;

  for i := 0 to Min(High(atpa), 3) do
  begin
    Mouse.Move(atpa[i].RandomValue());
    if MainScreen.IsUpText('Douse', 400) then
    begin
      Mouse.Click(MOUSE_LEFT);
      Minimap.WaitMoving();
      Exit(WaitUntil(not Inventory.ContainsItem('Bucket of water'), 300, 8000));
    end;
  end;
end;

function TTemporossFisher.FireVisible(): Boolean;
var
  atpa: T2DPointArray;
begin
  Result := Self.FindFire(atpa);
end;

// ---------------------------------------------------------------------------
// Repairs. Damaged masts/totems are found on screen by their Repair uptext,
// checked once after each wave passes (waves and fires cause the damage).
// ---------------------------------------------------------------------------
function TTemporossFisher.Repair(): Boolean;
begin
  Self.CheckRepair := False;
  if GameObjects.TemporossTotems.WalkSelectOption(['Repair']) or
     GameObjects.TemporossMasts.WalkSelectOption(['Repair']) then
  begin
    Minimap.WaitMoving();
    Result := XPBar.WaitXP(5000);
  end;
end;

// ---------------------------------------------------------------------------
// Colossal waves: tether to a totem pole or mast until the wave passes.
// ---------------------------------------------------------------------------
function TTemporossFisher.Tether(): Boolean;
begin
  if TetherWaves and Inventory.ContainsItem('Rope') then
    Result := GameObjects.TemporossTotems.WalkSelectOption(['Tether']) or
              GameObjects.TemporossMasts.WalkSelectOption(['Tether']);

  // Wait the wave out even if tethering failed (chat clears the flag).
  while Self.WaveIncoming and not Self.WaveTimer.IsFinished() do
  begin
    Wait(500, 800);
    Self.ProcessChat();
  end;
  Self.WaveIncoming := False;
  Self.CheckRepair := True;
end;

// ---------------------------------------------------------------------------
// Fishing / spirit pool / loading / cooking.
// ---------------------------------------------------------------------------
function TTemporossFisher.CatchFish(): Boolean;
begin
  Self.IsFishing := False;

  // Nothing in hover range? Close the distance to the far spots first.
  if not Self.HoverNPCDot(['ishing spot', 'Harpoon']) then
    Self.WalkTowardNPCDot();

  if Self.ClickNPCDot(['ishing spot', 'Harpoon']) then
  begin
    Minimap.WaitMoving();
    XPBar.EarnedXP();
    Self.IsFishing := True;
    Self.FishTimer.Restart();
    WL.Activity.Restart();
    Result := True;
  end;
end;

procedure TTemporossFisher.WaitFishing();
begin
  Wait(900, 1600);

  if XPBar.EarnedXP() then
  begin
    Self.FishTimer.Restart();
    WL.Activity.Restart();
    Exit;
  end;

  if Self.FishTimer.IsFinished() then
    Self.IsFishing := False;
end;

function TTemporossFisher.SpiritPoolActive(): Boolean;
begin
  if not Self.SpiritTimer.IsFinished() then
    Exit(Self.Vulnerable);
  Self.SpiritTimer.Restart();

  Result := Self.HoverNPCDot(['pirit pool']);
  Self.Vulnerable := Result;
end;

function TTemporossFisher.AttackSpiritPool(): Boolean;
begin
  if GameObjects.TemporossPools.WalkClick() or Self.ClickNPCDot(['pirit pool']) then
  begin
    Minimap.WaitMoving();
    Self.IsFishing := True;
    Self.FishTimer.Restart();
    WL.Activity.Restart();
    Result := True;
  end
  else
    Self.Vulnerable := False; // pool gone; back to normal play
end;

function TTemporossFisher.LoadCrate(): Boolean;
var
  before, loaded: Int32;
begin
  before := Self.CountFish();

  if GameObjects.TemporossCrates.WalkSelectOption(['Fill']) or
     GameObjects.TemporossCrates.WalkClick() then
  begin
    Minimap.WaitMoving();
    Result := WaitUntil(Self.CountFish() = 0, 600, 20000);
  end;

  loaded := before - Self.CountFish();
  if loaded > 0 then
  begin
    Self.RoundFishLoaded += loaded;
    Self.TotalActions += loaded;
    WL.Activity.Restart();
  end;
end;

function TTemporossFisher.CookAtShrine(): Boolean;
var
  remaining: Int32;
begin
  if GameObjects.TemporossShrines.WalkSelectOption(['Cook-at', 'Cook']) then
  begin
    Minimap.WaitMoving();

    // Wait while the raw stack keeps shrinking; bail when it stalls.
    repeat
      remaining := Inventory.CountItem(Self.RawFish);
      if remaining = 0 then
        Break;
      WL.Activity.Restart();
    until not WaitUntil(Inventory.CountItem(Self.RawFish) < remaining, 300, 6000);

    Result := Inventory.CountItem(Self.RawFish) = 0;
  end;
end;

// ---------------------------------------------------------------------------
// State machine.
// ---------------------------------------------------------------------------
function TTemporossFisher.GetState(): ETemporossState;
var
  fishCount: Int32;
begin
  if WL.Activity.IsFinished() then
    Exit(ETemporossState.END_SCRIPT);

  // The arena is an instance: map matching is meaningless inside it. The
  // arena-only HUD bars are the reliable "inside" signal; two consecutive
  // misses are required to leave, so loading flicker can't reset the round.
  if Self.HUDVisible() then
  begin
    Self.InArena := True;
    Self.ArenaMisses := 0;
  end
  else
  begin
    Inc(Self.ArenaMisses);
    if Self.ArenaMisses >= 2 then
      Self.InArena := False;
  end;

  if Self.PosTimer.IsFinished() then
  begin
    Self.MyPos := Self.RSW.GetMyPos();
    Self.DebugLn('pos=' + ToStr(Self.MyPos) +
      ' arena=' + ToStr(Self.InArena) + ' boarded=' + ToStr(Self.Boarded) +
      ' energy=' + ToStr(Self.Energy) + ' intensity=' + ToStr(Self.Intensity) +
      ' points=' + ToStr(Self.Points) + ' fish=' + ToStr(Self.CountFish()));
    Self.PosTimer.Restart();
  end;

  if Self.WasInArena and not Self.InArena then
    Self.ResetRound(); // round over, back at the docks
  Self.WasInArena := Self.InArena;

  if GameInterface.IsOpen() then
    Exit(ETemporossState.CLOSE_INTERFACE);

  if not Self.InArena then
  begin
    if Self.Boarded then
      Exit(ETemporossState.WAIT_START);
    Exit(ETemporossState.BOARD_SHIP);
  end;

  Self.ProcessChat();
  Self.UpdateHUD();

  if Self.WaveIncoming then
    Exit(ETemporossState.TETHER);

  fishCount := Self.CountFish();

  // Harpoon first: without one, fishing (the whole point) is impossible.
  if Self.NeedHarpoon and (Self.HarpoonTries < 4) then
    Exit(ETemporossState.GET_HARPOON);

  // Round-start supplies (each capped at 3 attempts per round).
  if TetherWaves and (Self.RopeTries < 3)
    and not Inventory.ContainsItem('Rope') then
      Exit(ETemporossState.GET_ROPE);

  if RepairStructures and (Self.HammerTries < 3)
    and not Inventory.ContainsItem('Hammer') then
      Exit(ETemporossState.GET_HAMMER);

  if DouseFires and (Self.BucketTries < 3)
    and not Inventory.ContainsAny(['Bucket', 'Bucket of water']) then
      Exit(ETemporossState.GET_BUCKET);

  if RepairStructures and Self.CheckRepair and Inventory.ContainsItem('Hammer') then
    Exit(ETemporossState.REPAIR_STRUCTURE);

  if DouseFires and Inventory.ContainsItem('Bucket of water')
    and Self.FireVisible() then
      Exit(ETemporossState.DOUSE_FIRE);

  if DouseFires and Inventory.ContainsItem('Bucket')
    and not Inventory.ContainsItem('Bucket of water')
    and Self.FireVisible() then
      Exit(ETemporossState.FILL_BUCKET);

  if Self.SpiritPoolActive() then
  begin
    if fishCount > 0 then
      Exit(ETemporossState.LOAD_CRATE); // dump ammo first, then harpoon the pool
    Exit(ETemporossState.ATTACK_SPIRIT_POOL);
  end;

  // Storm about to end the round: get the fish in the crates now.
  if (Self.RoundEnding or ((Self.Intensity > -1) and (Self.Intensity >= IntensityDump)))
    and (fishCount > 0) then
      Exit(ETemporossState.LOAD_CRATE);

  if (fishCount >= FishBeforeLoading) or Inventory.IsFull() then
  begin
    if CookFish and (Inventory.CountItem(Self.RawFish) > 0) then
      Exit(ETemporossState.COOK_FISH);
    Exit(ETemporossState.LOAD_CRATE);
  end;

  if Self.IsFishing then
    Exit(ETemporossState.WAIT_FISHING);

  Exit(ETemporossState.FISH);
end;

procedure TTemporossFisher.Run(maxActions: UInt32; maxTime: UInt64);
begin
  Self.Init(maxActions, maxTime);

  repeat
    Self.State := Self.GetState();
    Self.SetAction(ToStr(Self.State));

    // A pathing failure anywhere (the walker raises on unreachable targets)
    // must cost one retry, not the whole run.
    try
      case Self.State of
        ETemporossState.END_SCRIPT: Break;
        ETemporossState.CLOSE_INTERFACE: GameInterface.Close();

        ETemporossState.BOARD_SHIP: Self.BoardShip();
        ETemporossState.WAIT_START: Self.WaitStart();

        ETemporossState.TETHER: Self.Tether();
        ETemporossState.GET_ROPE: Self.TakeFromCrate(GameObjects.TemporossRopes, 'Rope', Self.RopeTries);
        ETemporossState.GET_HAMMER: Self.TakeFromCrate(GameObjects.TemporossHammers, 'Hammer', Self.HammerTries);
        ETemporossState.GET_BUCKET: Self.TakeFromCrate(GameObjects.TemporossBuckets, 'Bucket', Self.BucketTries);
        ETemporossState.GET_HARPOON:
          if Self.TakeFromCrate(GameObjects.TemporossHarpoons, 'Harpoon', Self.HarpoonTries) then
            Self.NeedHarpoon := False;
        ETemporossState.REPAIR_STRUCTURE: Self.Repair();
        ETemporossState.FILL_BUCKET: Self.FillBucket();
        ETemporossState.DOUSE_FIRE: Self.DouseFire();
        ETemporossState.ATTACK_SPIRIT_POOL: Self.AttackSpiritPool();
        ETemporossState.COOK_FISH: Self.CookAtShrine();
        ETemporossState.LOAD_CRATE: Self.LoadCrate();
        ETemporossState.WAIT_FISHING: Self.WaitFishing();
        ETemporossState.FISH: Self.CatchFish();
      end;
    except
      Self.DebugLn('State ' + ToStr(Self.State) + ' failed: ' + GetExceptionMessage());
      Wait(1200, 2400);
    end;

    // Antiban only while actually fishing or cooking, never while idling on
    // the boat or between states.
    case Self.State of
      ETemporossState.WAIT_FISHING, ETemporossState.COOK_FISH:
        Self.DoAntiban();
    end;
  until Self.ShouldStop();
end;

var
  TemporossFisher: TTemporossFisher;

{$IFDEF SCRIPT_GUI}
type
  TTemporossForm = record(TScriptForm)
    CookState: TLabeledCheckbox;
    DouseState: TLabeledCheckbox;
    RepairState: TLabeledCheckbox;
    TetherState: TLabeledCheckbox;
    DebugNamesState: TLabeledCheckbox;
    FishLoadEdit: TLabeledEdit;
    IntensityEdit: TLabeledEdit;
    Info: TLabel;
    Config: TConfigJSON;
  end;

procedure TTemporossForm.StartScript(sender: TObject); override;
begin
  CookFish := Self.CookState.IsChecked();
  DouseFires := Self.DouseState.IsChecked();
  RepairStructures := Self.RepairState.IsChecked();
  TetherWaves := Self.TetherState.IsChecked();
  DebugMapNames := Self.DebugNamesState.IsChecked();

  FishBeforeLoading := StrToIntDef(Self.FishLoadEdit.GetText(), 17);
  FishBeforeLoading := EnsureRange(FishBeforeLoading, 1, 27);

  IntensityDump := StrToIntDef(Self.IntensityEdit.GetText(), 92);
  IntensityDump := EnsureRange(IntensityDump, 50, 100);

  Self.Config.Put('cook', CookFish);
  Self.Config.Put('douse', DouseFires);
  Self.Config.Put('repair', RepairStructures);
  Self.Config.Put('tether', TetherWaves);
  Self.Config.Put('fish_load', FishBeforeLoading);
  Self.Config.Put('intensity_dump', IntensityDump);

  inherited;
end;

procedure TTemporossForm.Run(); override;
var
  tab: TTabSheet;
begin
  Self.Setup('Elixer Tempoross');
  Self.Config.Setup('elixer-tempoross');
  Self.Start.SetOnClick(@Self.StartScript);

  if Self.Config.Has('cook') then
    CookFish := Self.Config.GetBoolean('cook');
  if Self.Config.Has('douse') then
    DouseFires := Self.Config.GetBoolean('douse');
  if Self.Config.Has('repair') then
    RepairStructures := Self.Config.GetBoolean('repair');
  if Self.Config.Has('tether') then
    TetherWaves := Self.Config.GetBoolean('tether');
  if Self.Config.Has('fish_load') then
    FishBeforeLoading := Self.Config.GetInt('fish_load');
  if Self.Config.Has('intensity_dump') then
    IntensityDump := Self.Config.GetInt('intensity_dump');

  Self.AddTab('Script Settings');
  tab := Self.Tabs[High(Self.Tabs)];

  Self.CreateAccountManager(tab);

  with Self.CookState do
  begin
    Create(tab);
    SetCaption('Cook fish at the shrine');
    SetLeft(TControl.AdjustToDPI(15));
    SetTop(TControl.AdjustToDPI(150));
    SetChecked(CookFish);
  end;

  with Self.DouseState do
  begin
    Create(tab);
    SetCaption('Douse fires with buckets');
    SetLeft(Self.CookState.GetLeft());
    SetTop(Self.CookState.GetBottom() + TControl.AdjustToDPI(10));
    SetChecked(DouseFires);
  end;

  with Self.RepairState do
  begin
    Create(tab);
    SetCaption('Repair damaged masts/totems');
    SetLeft(Self.DouseState.GetLeft());
    SetTop(Self.DouseState.GetBottom() + TControl.AdjustToDPI(10));
    SetChecked(RepairStructures);
  end;

  with Self.TetherState do
  begin
    Create(tab);
    SetCaption('Tether during colossal waves');
    SetLeft(Self.RepairState.GetLeft());
    SetTop(Self.RepairState.GetBottom() + TControl.AdjustToDPI(10));
    SetChecked(TetherWaves);
  end;

  with Self.DebugNamesState do
  begin
    Create(tab);
    SetCaption('Print map names at startup (debug)');
    SetLeft(Self.TetherState.GetLeft());
    SetTop(Self.TetherState.GetBottom() + TControl.AdjustToDPI(10));
    SetChecked(DebugMapNames);
  end;

  with Self.FishLoadEdit do
  begin
    Create(tab);
    SetCaption('Fish before loading:');
    SetLeft(Self.CookState.GetRight() + TControl.AdjustToDPI(40));
    SetTop(Self.CookState.GetTop());
    SetText(ToStr(FishBeforeLoading));
  end;

  with Self.IntensityEdit do
  begin
    Create(tab);
    SetCaption('Dump fish at intensity %:');
    SetLeft(Self.FishLoadEdit.GetLeft());
    SetTop(Self.FishLoadEdit.GetBottom() + TControl.AdjustToDPI(10));
    SetText(ToStr(IntensityDump));
  end;

  with Self.Info do
  begin
    Create(tab);
    SetCaption(
      'Start in the Ruins of Unkah with a harpoon (or let the script take one).' +
      LineEnding +
      'Reward permits accumulate; spend them at the reward pool yourself.' +
      LineEnding + LineEnding +
      'First runs should be babysat: enable the debug checkbox and check the' +
      LineEnding +
      'console if the script cannot find crates, the ship or the shrine.'
    );
    SetLeft(Self.DebugNamesState.GetLeft());
    SetTop(Self.DebugNamesState.GetBottom() + TControl.AdjustToDPI(30));
  end;

  Self.CreateAntibanManager();
  Self.CreateWaspLibSettings();

  inherited;
end;

var
  TemporossForm: TTemporossForm;
{$ENDIF}

begin
  {$IFDEF SCRIPT_GUI}
  Sync(@TemporossForm.Run);
  {$ENDIF}

  {$IFNDEF SRL_DISABLE_REMOTEINPUT}
  if not GameClient.RemoteInput.IsSetup() then
    GameClient.RemoteInput.Setup();
  {$ENDIF}

  TemporossFisher.Run(WLSettings.MaxActions(), WLSettings.MaxTime());
end.
