procedure TMiner.WriteMsg(Message: String);
begin
  WriteLn(SRL.TimeStamp() + '[GemMiner]: '+ Message);
end;

procedure TIniConfig.Init();
var
  frun, brun, tbreak, tsleep,
  bhbestlog, bhclockworks : string;
begin
   frun := ReadINI('GemMiner General', 'Farm runs', AppPath+'Configs/StudentsSettings');
   self.frunEnabled := StrToBoolDef(frun, False);

   brun := ReadINI('GemMiner General', 'BH runs', AppPath+'Configs/StudentsSettings');
   self.brunEnabled := StrToBoolDef(brun, False);

   tbreak := ReadINI('GemMiner General', 'Take breaks', AppPath+'Configs/StudentsSettings');
   self.tbreakenabled := StrToBoolDef(tbreak, False);

   tsleep := ReadINI('GemMiner General', 'Take sleeps', AppPath+'Configs/StudentsSettings');
   self.tsleepenabled := StrToBoolDef(tsleep, False);

   GMConfig.maxactionsint := StrToIntDef(ReadINI('GemMiner General', 'Max actions', AppPath+'Configs/StudentsSettings'), 3000);
   GMConfig.maxrunforint := StrToIntDef(ReadINI('GemMiner General', 'Max run for', AppPath+'Configs/StudentsSettings'), 600);

   GMConfig.breakintervalint := StrToIntDef(ReadINI('GemMiner General', 'Break interval', AppPath+'Configs/StudentsSettings'), 60);
   GMConfig.breaklengthint := StrToIntDef(ReadINI('GemMiner General', 'Break length', AppPath+'Configs/StudentsSettings'), 15);
   GMConfig.sleepintervalstr := ReadINI('GemMiner General', 'Sleep interval', AppPath+'Configs/StudentsSettings');
   GMConfig.sleeplengthint := StrToIntDef(ReadINI('GemMiner General', 'Sleep length', AppPath+'Configs/StudentsSettings'), 8);

   GMConfig.bhlogint := StrToIntDef(ReadINI('GemMiner BH Tab', 'BH logs', AppPath+'Configs/StudentsSettings'), 0);
   BHIncludeGUILogType := ELogType(GMConfig.bhlogint);

   GMConfig.bhseed := ReadINI('GemMiner BH Tab', 'BH seed', AppPath+'Configs/StudentsSettings');
   BHIncludeGUISeed := GMConfig.bhseed;

   GMConfig.bhrunint := StrToIntDef(ReadINI('GemMiner BH Tab', 'BH runtime', AppPath+'Configs/StudentsSettings'), 0);
   BHIncludeGUIRunIntervalMinutes := Round(GMConfig.bhrunint / 60000);

   bhbestlog := ReadINI('GemMiner BH Tab', 'BH best log', AppPath+'Configs/StudentsSettings');
   self.bhusebestlogEnabled := StrToBoolDef(bhbestlog, False);
   BHIncludeGUIUseBestLog := GMConfig.bhusebestlogEnabled;

   bhclockworks := ReadINI('GemMiner BH Tab', 'BH clockworks', AppPath+'Configs/StudentsSettings');
   self.bhcraftclockworksEnabled := StrToBoolDef(bhclockworks, False);
   BHIncludeGUICraftWhileNav := GMConfig.bhcraftclockworksEnabled;

   GMConfig.loginindexint := StrToIntDef(ReadINI('GemMiner Account Tab', 'Login index', AppPath+'Configs/StudentsSettings'), 0);
   Login.PlayerIndex := GMConfig.loginindexint;
end;

procedure TIniConfig.Write();
begin
  WriteIni('GemMiner General', 'Farm runs', ToStr(self.frunEnabled), AppPath+'Configs/StudentsSettings');
  WriteIni('GemMiner General', 'BH runs', ToStr(self.brunEnabled), AppPath+'Configs/StudentsSettings');

  WriteIni('GemMiner General', 'Take breaks', ToStr(self.tbreakenabled), AppPath+'Configs/StudentsSettings');
  WriteIni('GemMiner General', 'Take sleeps', ToStr(self.tsleepenabled), AppPath+'Configs/StudentsSettings');

  WriteIni('GemMiner General', 'Max actions', ToStr(self.maxactionsint), AppPath+'Configs/StudentsSettings');
  WriteIni('GemMiner General', 'Max run for', ToStr(self.maxrunforint), AppPath+'Configs/StudentsSettings');

  WriteIni('GemMiner General', 'Break interval', ToStr(self.breakintervalint), AppPath+'Configs/StudentsSettings');
  WriteIni('GemMiner General', 'Break length', ToStr(self.breaklengthint), AppPath+'Configs/StudentsSettings');
  WriteIni('GemMiner General', 'Sleep interval', Self.sleepintervalstr, AppPath+'Configs/StudentsSettings');
  WriteIni('GemMiner General', 'Sleep length', ToStr(self.sleeplengthint), AppPath+'Configs/StudentsSettings');

  WriteIni('GemMiner BH Tab', 'BH logs', ToStr(Ord(BirdHouseRunner.LogType)), AppPath+'Configs/StudentsSettings');
  WriteIni('GemMiner BH Tab', 'BH seed', BirdHouseRunner.Seed, AppPath+'Configs/StudentsSettings');
  WriteIni('GemMiner BH Tab', 'BH runtime', ToStr(BirdHouseRunner.TaskInterval), AppPath+'Configs/StudentsSettings');
  WriteIni('GemMiner BH Tab', 'BH best log', ToStr(BirdHouseRunner.AlwaysUseBestLog), AppPath+'Configs/StudentsSettings');
  WriteIni('GemMiner BH Tab', 'BH clockworks', ToStr(BirdHouseRunner.NeedClockworks), AppPath+'Configs/StudentsSettings');

  WriteIni('GemMiner Account Tab', 'Login index', ToStr(Login.PlayerIndex), AppPath+'Configs/StudentsSettings');
  // ... any other things you stored on TIniConfig
end;

procedure TGUI.StartScript(sender: TObject); override;
var
  MaxRun: Int32;
  cb_Breaks,cb_Sleeps, FarmRuns, BHRuns: TCheckBox;
begin
  //Miner.UseDepositAll := Self.UseDepAll.IsChecked;
  _MaxActions := StrToInt(MaxActions.GetText());
  _MaxRuntime := (StrToInt(MaxRuntime.GetText())*ONE_MINUTE);

  Self.Form.Close();
  Miner.WriteMsg('Starting script');

{ Time settings }
  MaxRun           :=  _MaxRuntime;
  Miner.ShutdownTime := (MaxRun) + Random(-(Floor(MaxRun*0.1)), (Floor(MaxRun*0.1)));

  cb_Breaks        := Self.Form.GetChild('cb_breaks_checkbox');
  Miner.TakeBreaks   := cb_Breaks.IsChecked;
  if Miner.TakeBreaks then
    Antiban.AddBreak(ONE_MINUTE*StrToInt(BreakAfter.GetText()), ONE_MINUTE*StrToInt(BreakFor.GetText()));

  cb_Sleeps        := Self.Form.GetChild('cb_sleeps_checkbox');
  Miner.TakeSleeps   := cb_Sleeps.IsChecked;
  if Miner.TakeSleeps then
    Antiban.AddSleep(SleepAt.GetText(), StrToInt(SleepFor.GetText()) * ONE_HOUR);

  FarmRuns := Self.Form.GetChild('cb_farmruns_checkbox');
  BHRuns := Self.Form.GetChild('cb_bhruns_checkbox');

  Miner.DoFarmRuns  := (FarmRuns.GetState = cbChecked);
  Miner.DoBHRuns    := (BHRuns.getState = cbChecked);

  GMConfig.tbreakenabled := Miner.TakeBreaks;
  GMConfig.tsleepenabled := Miner.TakeSleeps;

  GMConfig.maxrunforint := StrToInt(MaxRuntime.GetText());
  GMConfig.maxactionsint := StrToInt(MaxActions.GetText());

  if Miner.TakeBreaks then
  begin
    GMConfig.breakintervalint := StrToInt(BreakAfter.GetText());
    GMConfig.breaklengthint := StrToInt(BreakFor.GetText())
  end;

  if Miner.TakeSleeps then
  begin
    GMConfig.sleepintervalstr := SleepAt.GetText();
    GMConfig.sleeplengthint :=  StrToInt(SleepFor.GetText());
  end;

  GMConfig.frunEnabled := Miner.DoFarmRuns;
  GMConfig.brunEnabled := Miner.DoBHRuns;

  inherited;

  if Length(Login.GetPlayer().Worlds) > 10 then
    WorldList := Login.GetPlayer().Worlds;
end;

procedure TGUI.Run(); override;
var
  tab: TTabSheet;
begin
  Self.Setup('Gem Miner');
  Self.Start.setOnClick(@Self.StartScript);

  Self.AddTab('Script Settings');
  tab := Self.Tabs[High(Self.Tabs)];
  Self.CreateAccountManager(tab);
  Self.CreateFarmRunSettingsTab();
  Self.CreateBirdhouseRunSettings();

  with cb_Breaks do
  begin
    Create(tab);
    SetLeft(TControl.AdjustToDPI(25));
    SetTop(TControl.AdjustToDPI(175));
    SetName('cb_breaks');
    SetCaption('Take breaks');
    SetFontColor($000000);
  end;

  with Self.BreakAfter do begin
    Create(tab);
    SetName('Break_After');
    SetCaption('Break after');
    SetLeft(TControl.AdjustToDPI(25));
    SetTop(TControl.AdjustToDPI(200));
    SetText(ToStr(Random(24, 58)));
    SetHint('Minutes');
  end;

  with Self.BreakFor do begin
    Create(tab);
    SetName('Break_For');
    SetCaption('Break for');
    SetLeft(TControl.AdjustToDPI(25));
    SetTop(TControl.AdjustToDPI(240));
    SetText(ToStr(Random(3, 15)));
    SetHint('Minutes');
  end;

  with cb_Sleeps do
  begin
    Create(tab);
    SetLeft(TControl.AdjustToDPI(200));
    SetTop(TControl.AdjustToDPI(175));
    SetName('cb_sleeps');
    SetCaption('Take sleeps');
    SetFontColor($000000);
  end;

  with Self.SleepAt do begin
    Create(tab);
    SetName('Sleep_After');
    SetCaption('Sleep at');
    SetLeft(TControl.AdjustToDPI(200));
    SetTop(TControl.AdjustToDPI(200));
    SetText('01:00:00');
  end;

  with Self.SleepFor do begin
    Create(tab);
    SetName('Sleep_For');
    SetCaption('Sleep for');
    SetLeft(TControl.AdjustToDPI(200));
    SetTop(TControl.AdjustToDPI(240));
    SetText(ToStr(Random(6, 14)));
    SetHint('Hours');
  end;

  with Self.MaxActions do begin
    Create(tab);
    SetName('Max_Actions');
    SetCaption('Max actions');
    SetLeft(TControl.AdjustToDPI(450));
    SetTop(TControl.AdjustToDPI(200));
    SetText(ToStr(Random(5000, 50000)));
  end;

  with Self.MaxRuntime do begin
    Create(tab);
    SetName('Max_Runtime');
    SetCaption('Max runtime');
    SetLeft(TControl.AdjustToDPI(450));
    SetTop(TControl.AdjustToDPI(240));
    SetText(ToStr(Random(60, 12000)));
    SetHint('Minutes');
  end;

  with cb_farmruns do
  begin
    Create(tab);
    SetLeft(TControl.AdjustToDPI(25));
    SetTop(TControl.AdjustToDPI(300));
    SetName('cb_farmruns');
    SetFontColor($000000);
    SetCaption('Farm runs');
  end;

  with cb_bhruns do
  begin
    Create(tab);
    SetLeft(TControl.AdjustToDPI(25));
    SetTop(TControl.AdjustToDPI(320));
    SetName('cb_bhruns');
    SetFontColor($000000);
    SetCaption('Birdhouse runs');
  end;

  if GMConfig.frunEnabled then
    cb_farmruns.CheckBox.SetChecked(True);

  if GMConfig.brunEnabled then
    cb_bhruns.CheckBox.SetChecked(True);

  if GMConfig.tbreakenabled then
  begin
    cb_Breaks.CheckBox.SetChecked(True);
    BreakAfter.SetText(ToStr(GMConfig.breakintervalint));
    BreakFor.SetText(ToStr(GMConfig.breaklengthint));
  end;

  if GMConfig.tsleepenabled then
  begin
    cb_Sleeps.CheckBox.SetChecked(True);
    SleepAt.SetText(GMConfig.sleepintervalstr);
    SleepFor.SetText(ToStr(GMConfig.sleeplengthint));
  end;

  if (GMConfig.maxrunforint <> 0) then
    MaxRuntime.SetText(ToStr(GMConfig.maxrunforint));

  if (GMConfig.maxactionsint <> 0) then
    MaxActions.SetText(ToStr(GMConfig.maxactionsint));

  inherited;
end;

procedure TMinimap.RotateWithinAngles(min, max: Int32);
var
  minMaxAvg: Int32 := Floor((min + max) div 2);
  preferredAngle: Int32 := SRL.SkewedRand(minMaxAvg, min, max);
begin
  if preferredAngle < 0 then
    preferredAngle := preferredAngle + 360;

  if InRange(self.getCompassAngle(True), min, max) then
    Exit;

  Minimap.SetCompassAngle(preferredAngle);
end;

function WorldArrayRandomizer(const arr: array of Int32): array of Int32;
begin
  if High(arr) >= 0 then
  begin
    SetLength(Result, 1);
    Result[0] := arr[Random(0, High(arr))];
  end
end;

function TMiner.gemDepositHelper(Item: TItem; useQuantityButtons: Boolean): Boolean;
var
  attempts: Int32;
begin
  for attempts := 0 to 3 do begin
    DepositBox.DepositItem(Item, useQuantityButtons);
    WaitUntil(not Inventory.ContainsItem(Item), 115, 3000);

    Wait(250,500);

    if not Inventory.ContainsItem(Item) then
      Result := True;

    if Result then
      Break;

    if attempts >= 3 then
      TerminateScript('Something is wrong, we cannot deposit an item');
  end;
end;

function TMiner.DoBanking(attempts: Int32 = 0): Boolean;
var
  atpa: T2DPointArray;
  mmwalkpoint: TPoint;
  bankBox: TBox;
begin
  if attempts > 10 then
    Exit(False);
  if not GameClient.IsLoggedIn then
    Login.LoginPlayer(False);
  if not DepositBox.IsOpen then begin
    bankBox := RSW.GetTileMS(BANK_COORDS, 5).Bounds().Expand(10);
    atpa := Mainscreen.FindObject(DepBoxFinder, bankBox);

    if (atpa.Len = 0) or (atpa[0].Len = 0) then begin
      if attempts < 2 then begin
        Antiban.RandomRotate;
      end else if attempts < 5 then begin
        mmwalkpoint := RSW.WorldToMM(TPAFromBox(NEARBY_BANK_BOX)).RandomValue();
        Mouse.Click(mmwalkpoint, MOUSE_LEFT);
        Mouse.RandomMovement;
        Wait(600);
        Minimap.WaitPlayerMoving();
      end else begin
        RSW.WalkBlind(TPAFromBox(NEARBY_BANK_BOX).RandomValue(), 8);
      end;
      Exit(DoBanking(attempts + 1));
    end;

    for 1 to 3 do begin
      if SRL.Dice(60) then
        Mouse.HumanMove(atpa[0].RandomValue)
      else
        Mouse.Move(atpa[0]);
      if not ('Bank' in Mainscreen.GetUpText) then begin
        if SRL.Dice(50) then
          Mouse.RandomMovement;
        Continue;
      end;
      Mouse.Click(MOUSE_LEFT);
      begin
        if SRL.Dice(60) then
          Mouse.HumanMove(TPAFromBox(DepositIdleBox).RandomValue)
        else
          Mouse.Move(DepositIdleBox);
      end;
      Break;
    end;
    Minimap.WaitPlayerMoving();
    if not DepositBox.IsOpen(5000) then begin
      RSW.WalkBlind(TPAFromBox(NEARBY_BANK_BOX).RandomValue(), 8);
      Exit(DoBanking(attempts + 1));
    end;
  end;

  if Self.hasPickaxe then begin
    Self.gemDepositHelper('Uncut opal', true);
    Self.gemDepositHelper('Uncut jade', true);
    Self.gemDepositHelper('Uncut red topaz', true);
    Self.gemDepositHelper('Uncut sapphire', true);
    Self.gemDepositHelper('Uncut emerald', true);
    Self.gemDepositHelper('Uncut ruby', true);
    Self.gemDepositHelper('Uncut diamond', true);

    if Inventory.ContainsAny(['Uncut opal', 'Uncut jade', 'Uncut red topaz',
                            'Uncut sapphire', 'Uncut emerald', 'Uncut ruby',
                            'Uncut diamond']) then
      Exit(DoBanking(attempts + 1));
  end
  else
  begin
    DepositBox.DepositInventory();
    if (DepositIdleBox.X1 = Mainscreen.Bounds.X1) and
       (DepositIdleBox.Y1 = Mainscreen.Bounds.Y1) and
       (DepositIdleBox.X2 = Mainscreen.Bounds.X2) and
       (DepositIdleBox.Y2 = Mainscreen.Bounds.Y2) then begin
        DepositIdleBox := DepositBox.Buttons[EDepositButton.DEPOSIT_INVENTORY].Bounds.Expand(18);
    end;

    if not WaitUntil(not Inventory.IsFull, 50, 5000) then
      Exit(DoBanking(attempts + 1));
  end;

  DepositBox.Close(True);
  WaitUntil(not DepositBox.IsOpen, 115, 2500);
  ForceDeposit := False;
  RockIndex := 0;
  Exit(True);
end;

function TMiner.handleTeleport(TTLocation: TTeleportLocation; useMagic: Boolean; telBox: TBox; locString: String; TTmethodString: String): Boolean;
var
  attempts : Int32;
begin
  if (RSW.GetMyPos().InBox(telBox)) then
    Exit();

  writeln('Teleporting to ' +  locString);
  for attempts := 1 to 15 do
  begin
    Transport.run(TTLocation, useMagic);

    Result := WaitUntil(RSW.GetMyPos().InBox(telBox), 115, 10000);

    if Result then
      Break;

    if attempts > 14 then
    begin
      Logout.ClickLogout();
      TerminateScript('Could not find or use ' + TTmethodString);
    end;

    if Minimap.IsPrayerEnabled = True then
      Minimap.DisablePrayer();
  end;
end;

function TMiner.handleLadder(Destination: String): Boolean;
var
  attempts: Int32;
begin
  case Destination of
  'Gem mine':
  begin
    if RSW.GetMyPos().InBox(RSREGIONS.GEM_ROCKS_MINE) then
      Exit;

    for attempts := 0 to 8 do
    begin
      if (not Self.RSW.AtTile([6700,4460], 16)) then
        RSW.WalkBlind([6700,4460]);

      if Self.LadderObjDown.WalkClick(True, 5) then
        WaitUntil(RSW.GetMyPos().InBox(RSREGIONS.GEM_ROCKS_MINE), 115, 10000);

      Result := RSW.GetMyPos().InBox(RSREGIONS.GEM_ROCKS_MINE);

      if Result then
        Exit;
    end;
  end;

  'Shilo bank':
  begin
    if RSW.GetMyPos().InBox([6520, 4368, 7118, 4764]) then
      Exit;

    for attempts := 0 to 8 do
    begin
      if Self.LadderObj.WalkClick(True, 5) then
        WaitUntil(RSW.GetMyPos().InBox([6520, 4368, 7118, 4764]), 115, 10000);

      Result := RSW.GetMyPos().InBox([6520, 4368, 7118, 4764]);

      if Result then
        Exit;
    end;
  end;
  end;
end;

procedure TMiner.HandleCart();
var
  attempts: Int32;
begin
  if (not Self.RSW.AtTile([6500,3584], 16)) then
    RSW.WebWalk([6500,3584]);

  for attempts := 0 to 8 do
  begin
    if Self.CartObj.SelectOption(['Pay'], 5) then
      WaitUntil((RSW.GetMyPos().InBox([6520, 4368, 7118, 4764])), 115, 10000);

    if RSW.GetMyPos().InBox([6520, 4368, 7118, 4764]) then
      Break;
  end;
end;

procedure TMiner.HandleShip();
var
  b: TBox;
  attempts: Int32;
begin
  b := ([236,154,244,157]);

  Miner.handleTeleport(RSTeleports.MONASTERY, False, [5392, 2984, 6418, 3760], 'Ardy Monastary', 'Ardougne cloak');

  if RSW.GetMyPos().InBox([5392, 2984, 6418, 3760]) then
  begin
    RSW.WalkBlind([5928,3420]);
    RSW.WalkBlind([6088,3348]);
  end;

  for attempts := 0 to 8 do
  begin
    if BarnabyNPC.SelectOption(['Brimhaven']) then
      WaitUntil(not RSW.GetMyPos().InBox([5392, 2984, 6418, 3760]), 115, 10000);

    if not RSW.GetMyPos().InBox([5392, 2984, 6418, 3760]) then
      Break;

    if (attempts >= 8) then
      TerminateScript('Could not find Barnaby');
  end;

  Minimap.RotateWithinAngles(2, -3);

  if not RSW.GetMyPos().InBox([6268, 3333, 6735, 3811]) then
  for attempts := 0 to 8 do
  begin
    Mouse.Move(b);

    if Mainscreen.IsUpText(['Cr', 'oss', 'ang']) then
    begin
      Mouse.Click(b, MOUSE_LEFT);
      WaitUntil(RSW.GetMyPos().InBox([6268, 3333, 6735, 3811]), 115, 10000);
    end;

    if RSW.GetMyPos().InBox([6268, 3333, 6735, 3811]) then
      Break;

    if (attempts >= 8) then
      TerminateScript('Could not cross the gangplank');
  end;
end;

function TMiner.WithdrawHelper(item : TItem; quant : Int32) : Boolean; // CJ
var
  withdrawItem : TBankItem;
  attempts : int32;
begin
  if not Inventory.ContainsItem(item) then
  begin
    Self.WriteMsg('Withdrawing ' + item);
    for attempts := 0 to 8 do
    begin
      withdrawItem := TBankItem.Setup(item, quant, False);
      Bank.WithdrawItem(withdrawItem, False);
      Result := Waituntil(Inventory.ContainsItem(item), 315, 3000);

      if Inventory.ContainsItem(item) then
        Break;

      if (attempts > 7) and not Inventory.ContainsItem(item) then
      begin
        Logout.ClickLogout();
        TerminateScript('Did not find ' + item);
      end;
    end;
  end
  else
    Result := true;
end;

procedure TFarmRun.OnStart(); override;
var
  I : Int32;
  bankTimeout: TCountdown;
begin
  for I := 0 to High(Antiban.tasks) do
    Antiban.Tasks[I].Countdown.Pause;

  Miner.HandleLadder('Shilo bank');
  Miner.RSW.WebWalk([6800,4624]);

  bankTimeout.Init(45000);

  while not bankTimeOut.IsFinished() and not Bank.IsOpen() do begin
  if Miner.BankNPC.SelectOption(['Bank Banker']) then
    WaitUntil(Bank.IsOpen(), 115, 10000);
  end;

  Bank.DepositRandomItems(['Steel pickaxe', 'Mithril pickaxe', 'Adamant pickaxe', 'Rune pickaxe', 'Dragon pickaxe', 'Crystal pickaxe', '3rd age pickaxe']);
  Wait(500,750);

  if not Miner.HasEnoughDiary then begin
    if not Miner.ArdyCloakEquipped then
      Miner.WithdrawHelper(Miner.ArdyCloak, 1);

    Miner.WithdrawHelper('Coins', 230);
  end
  else
  begin
    if not Miner.KaramjaGlovesEquipped then
      Miner.WithdrawHelper(Miner.KaramjaGloves, 1);
  end;

  inherited;
end;

procedure TFarmRun.OnComplete(); override;
var
  I: Int32;
begin
  if Chat.HasContinue then
    Chat.ClickContinue();

  if Miner.HasEnoughDiary and (Inventory.ContainsItem(Miner.KaramjaGloves) or Miner.KaramjaGlovesEquipped) then begin
    Miner.handleTeleport(RSTeleports.KARAMJA_GLOVES_GEM_MINE, False, [3912, 627, 4238, 889], 'Gem mine', 'Karamja gloves');
    Miner.DoBanking(5);
  end
  else begin
    Miner.HandleShip();
    Miner.HandleCart();
    Miner.HandleLadder('Gem mine');
    Miner.DoBanking(5);
  end;

  for I := 0 to High(Antiban.tasks) do
  Antiban.Tasks[I].Countdown.Resume;
end;

function TBirdHouseInclude.OnStart() : Boolean; override;
var
  I: Int32;
  bankTimeout : TCountdown;
begin

  for I := 0 to High(Antiban.tasks) do
    Antiban.Tasks[I].Countdown.Pause;

  if Self.AlwaysUseBestLog then
  begin
    Self.SuggestedLogType := BirdhouseRunner.GetLogForHunterLevel(Stats.GetLevel(ESkill.HUNTER));
    if Self.LogType <> Self.SuggestedLogType then
      Self.LogType := Self.SuggestedLogType;
  end;

  Miner.HandleLadder('Shilo bank');
  Miner.RSW.WebWalk([6800,4624]);

  bankTimeout.Init(45000);

  while not bankTimeOut.IsFinished() and not Bank.IsOpen() do begin
      if Miner.BankNPC.SelectOption(['Bank Banker']) then
        WaitUntil(Bank.IsOpen(), 115, 10000);
    end;

  Bank.DepositRandomItems(['Steel pickaxe', 'Mithril pickaxe', 'Adamant pickaxe', 'Rune pickaxe', 'Dragon pickaxe', 'Crystal pickaxe', '3rd age pickaxe']);
  Wait(500,750);

  if not Miner.HasEnoughDiary then begin
    if not Miner.ArdyCloakEquipped then
      Miner.WithdrawHelper(Miner.ArdyCloak, 1);

    Miner.WithdrawHelper('Coins', 230);
  end
  else
  begin
    if not Miner.KaramjaGlovesEquipped then
      Miner.WithdrawHelper(Miner.KaramjaGloves, 1);
  end;

  //If we can't get our stuff then bail
  if not Self.WithdrawNextRun() then
  begin
    Bank.Close();
    BirdhouseRunner.IsDisabled := true;
    Miner.DoBHRuns := false;
    Miner.HandleLadder('Gem mine');
    Miner.DoBanking(5);
    Exit(false);
  end;

  Bank.Close();
  Result := true;
end;

procedure TBirdHouseInclude.OnComplete(); override;
var
  I : Int32;
  bankTimeout: TCountdown;
begin
  ScriptWalker := @Miner.RSW;

  if chat.HasContinue then
    Chat.ClickContinue();

  if Miner.HasEnoughDiary and (Inventory.ContainsItem(Miner.KaramjaGloves) or Miner.KaramjaGlovesEquipped) then begin
    Miner.handleTeleport(RSTeleports.KARAMJA_GLOVES_GEM_MINE, False, [3912, 627, 4238, 889], 'Gem mine', 'Karamja gloves');
    Miner.DoBanking(5);
  end
  else begin
    Miner.HandleShip();
    Miner.HandleCart();
    Miner.RSW.WalkBlind([6800,4624]);
    bankTimeout.Init(45000);

    while not bankTimeOut.IsFinished() and not Bank.IsOpen() do begin
      if Miner.BankNPC.SelectOption(['Bank Banker']) then
        WaitUntil(Bank.IsOpen(), 115, 10000);
    end;

    Bank.DepositRandomItems(['Steel pickaxe', 'Mithril pickaxe', 'Adamant pickaxe', 'Rune pickaxe', 'Dragon pickaxe']);
    Wait(500,750);
    Bank.Close(True);

    Miner.HandleLadder('Gem mine');
  end;

  for I := 0 to High(Antiban.tasks) do
    Antiban.Tasks[I].Countdown.Resume;
end;

procedure TMouse.RandomMovement(); override;
var
  cachedSpeed: Int32;
begin
  cachedSpeed := Self.Speed;

  Self.Speed := SRL.NormalRange(7, 11);
  Self.Move(Box(Mouse.Position(), 75, 75), True);

  Self.Speed := cachedSpeed;
end;

procedure TMiner.DoAntiban();
begin
  InactivityTimer.Pause();
  Antiban.DoAntiban();

  if (not GameClient.IsLoggedIn) then
    Login.LoginPlayer(False);

  if Self.DoFarmRuns and FarmRunner.ReadyTimer.IsFinished() then
    FarmRunner.DoFarmRun;

  if Self.DoBHRuns and BirdHouseRunner.ScriptIntervalTimer.IsFinished() then
    BirdHouseRunner.DoBirdHouseRun();

  InactivityTimer.Resume();
end;

procedure TMiner.DebugLn(s: String); begin
  WriteLn(s);
end;

procedure TMiner.Report();
var
  RunTime: Int64;
  XPGained: Int32;
  XpPerHour : Int32;
  GemsPerHour : Int32;
begin
  Self.currentXP := XPBar.Read();
  RunTime  := Self.RunTime.ElapsedTime();
  XPGained := ((Self.currentXP) - Self.startXP);
  XPPerHour := NumberPerHour(XPGained, Runtime);
  GemsPerHour := NumberPerHour(Round(XPGained/65), Runtime);

  RunTime  := Self.RunTime.ElapsedTime();

  WriteLn('|===================================|');
  WriteLn('|------ ~ GemMiner ~ -------|');
  WriteLn('|===================================|');
  WriteLn(padR('| Runtime: ' + SRL.MsToTime(RunTime, Time_Short), 36, ' ') + '|');
  WriteLn(padR('| Gems: ' + ToStr(Round(XPGained/65)), 36, ' ') + '|');
  WriteLn(padR('| Gems/Hr: ' + '(' + ToStr(GemsPerHour) + '/H)', 36, ' ') + '|');
  WriteLn(padR('| XP Gained: ' + ToStr(Floor(XPGained)), 36, ' ') + '|');
  WriteLn(padR('| XP/Hr: ' + ToStr(XPPerHour), 36, ' ') + '|');
  if Self.TakeBreaks then
    WriteLn(padR('| Next break: ' + SRL.MsToTime(Max(0, Round(Antiban.Breaks[0].NextAtTime - RunTime)), Time_Short), 36, ' ') + '|');
  if Self.TakeSleeps then
    WriteLn(padR('| Next sleep: ' + SRL.MsToTime(Max(0, Round(Antiban.Sleeps[0].NextAtTime - RunTime)), Time_Short), 36, ' ') + '|');
  if self.DoBHRuns then
    WriteLn(padR('| Next BH run: ' + SRL.MsToTime(BirdHouseRunner.ScriptIntervalTimer.TimeRemaining(), TTimeFormat.Time_Short), 36, ' ') + '|');
  if self.DoFarmRuns then
    WriteLn(padR('| Next farm run: ' + SRL.MsToTime(FarmRunner.ReadyTimer.TimeRemaining(), TTimeFormat.Time_Short), 36, ' ') + '|');
    WriteLn(padR('| Shutdown: ' + ToStr(SRL.MsToTime(Self.ShutdownTime - RunTime, Time_Short)), 36, ' ') + '|');
  WriteLn('|===================================|');
  WriteLn('|===================================|');
end;

procedure Antiban.RightClickItem(); begin
  Antiban.HoverMSTile(EMinimapDot.ITEM, True);
  Wait(500, 1600);
  Mouse.RandomMovement();
end;

procedure Antiban.DoLoseFocus();
var
  t: Int32;
begin
  t := SRL.NormalRange(1*ONE_SECOND, 8*ONE_SECOND);
  Antiban.DebugLn('Losing focus for '+SRL.MsToTime(t, Time_Short));
  Antiban.LoseFocus(t);
end;

procedure _OnStartSleep(task: PSleepTask);
begin
  Miner.Runtime.Pause;
  task^.Length;
end;

procedure _OnFinishSleep(task: PSleepTask); begin

  Miner.Runtime.Resume;
  task^.Length;
end;

procedure _OnStartBreak(task: PBreakTask); begin
  if task^.Length > ONE_MINUTE then
    Miner.Runtime.Pause
end;

procedure _OnFinishBreak(task: PBreakTask); begin
  if Miner.Runtime.IsPaused then
    Miner.Runtime.Resume;
  task^.Length;
end;

procedure TMiner.Init();
var
  i: Int32;
  d: Double;
begin
  Version := 'Rev '+{$MACRO SCRIPT_REVISION};
  DebugMode := False;
  Self.KaramjaGlovesEquipped    := False;
  Self.ArdyCloakEquipped        := False;
  Self.hasPickaxe               := False;
  Self.RSW.OnWalkingEvent       := @OnWalkEvent;
  Self.RSW.AdaptiveWalk         := True;
  Self.RSW.EnableRunAtEnergy    := 25;
  Self.startXP                  := XPBar.Read();

  if (GameClient.Mode <> EClientMode.FIXED) then
    TerminateScript("Client must be in fixed-classic, run settings searcher found in the launcher");

  Self.KaramjaDiary := Achievements.GetDiaryLevel(EAchievementDiary.KARAMJA);
  Self.ArdyDiary := Achievements.GetDiaryLevel(EAchievementDiary.ARDOUGNE);

  if (Self.KaramjaDiary >= 3) then
    Self.HasEnoughDiary := True;

  if (Self.ArdyDiary <> 0) then
  begin
    Self.ArdyCloak := 'Ardougne cloak ' + ToStr(ArdyDiary);
    Self.WriteMsg('Ardougne diary ' + ToStr(ArdyDiary));
    Self.WriteMsg('Ardougne cloak ' + ToStr(ArdyDiary));

    if Equipment.ContainsItem(ArdyCloak) then
      Self.ArdyCloakEquipped := True;
  end;

  if (Self.KaramjaDiary <> 0) then
  begin
    Self.KaramjaGloves := 'Karamja gloves ' + ToStr(KaramjaDiary);
    Self.WriteMsg('Karamja diary ' + ToStr(KaramjaDiary));
    Self.WriteMsg('Karamja gloves ' + ToStr(KaramjaDiary));

    if Equipment.ContainsItem(KaramjaGloves) then
      Self.KaramjaGlovesEquipped := True;
  end;

  if Self.DoFarmRuns and (Self.ArdyDiary < 1) and not Self.HasEnoughDiary then
    TerminateScript('You need at least ardougne easy in order to teleport back to the gem mine without Karamja hard');

  if Self.DoBHRuns then
    BirdhouseRunner.Init();

  RSW.Setup('world');
  RSW.WebGraph.LoadNodesFromString('');
  RSW.WebGraph.LoadPathsFromString('');

  Options.SetNPCAttackOption(EAttackOption.HIDDEN);
  Combat.SetAutoRetaliate(False);

  if Self.DoFarmRuns then
    FarmRunner.Init();

  //Skill tab
  StartingXp := XPBar.Read;
  i := Stats.GetLevel(ESkill.MINING);
  d := Floor(84*(99-i)/98) + Floor(210*(i-1)/98) + 1;
  d := Min(Max(d/256, 0), 1);

  //Timers
  MiningTimer.Init(Floor(2400/d)+4800);
  ReportTimer.Init(90*ONE_SECOND);
  InactivityTimer.Init(10*ONE_MINUTE);

  //Options tab
  Options.SetZoomLevel(Random(28, 32));
  Mainscreen.SetHighestPitch;

  //Antiban
  Antiban.Skills += ESkill.MINING;
  Antiban.Skills += ESkill.TOTAL;
  Antiban.AddTask(ONE_MINUTE*2,   @Mouse.RandomMovement);
  Antiban.AddTask(ONE_MINUTE*14,  @Antiban.DoLoseFocus);
  Antiban.AddTask(ONE_MINUTE*13,  @Antiban.RightClickItem);
  Antiban.AddTask(ONE_MINUTE*15,  @Antiban.HoverSkills);
  Antiban.AddBreak(ONE_MINUTE*13, ONE_SECOND*22, 0.2, 0.0);
  Antiban.MinZoom := 28; Antiban.MaxZoom := 32;
  Antiban.OnStartSleep := @_OnStartSleep;
  Antiban.OnFinishSleep := @_OnFinishSleep;
  Antiban.OnStartBreak := @_OnStartBreak;
  Antiban.OnFinishBreak := @_OnFinishBreak;

  DepBoxFinder.Colors := [CTS2(3227730, 16, 0.03, 0.05)];

  //Mouse
  Mouse.Speed := Random(14, 18);
  Mouse.MissChance := Random(2, 3);
  DepositIdleBox := Mainscreen.Bounds;

  Miner.BankNPC.Setup(4, [[6804,4628]]);
  Miner.BankNPC.SetupUpText(['Talk', 'lk-to', 'ank']);
  Miner.BankNPC.Finder.Colors += CTS2(6447720, 7, 0.31, 0.10);

  Miner.LadderObj.Setup(4, [[4064,760]]);
  Miner.LadderObj.SetupUpText(['Climb', 'mb-up', 'Lad']);
  Miner.LadderObj.Finder.Colors += CTS2(4743277, 9, 0.06, 0.52);

  Miner.LadderObjDown.Setup(4, [[6692,4456]]);
  Miner.LadderObjDown.SetupUpText(['Climb', 'mb-do', 'Lad']);
  Miner.LadderObjDown.Finder.Colors += CTS2(4743277, 9, 0.06, 0.52);

  Miner.CartObj.Setup(4, [[6502,3600], [6504, 3600]]);
  Miner.CartObj.SetupUpText(['Boa', 'rav', 'art']);
  Miner.CartObj.Finder.Colors += CTS2(3431528, 7, 0.05, 1.57);

  BarnabyNPC.SetupUpText(['k-to', 'aby']);
  BarnabyNPC.Finder.Colors += CTS2(9200405, 8, 0.04, 0.51);

  if (Self.UseSpecialAttack := Equipment.ContainsAny(SPEC_PICKS)) then
    if Equipment.ContainsItem('Lightbearer') then
      Self.SpecTimer.Init(150*ONE_SECOND)
    else
      Self.SpecTimer.Init(300*ONE_SECOND);

  if Inventory.ContainsAny(['Bronze pickaxe','Iron pickaxe','Steel pickaxe','Mithril pickaxe','Adamant pickaxe','Rune pickaxe','Dragon pickaxe','Crystal pickaxe','3rd age pickaxe']) then
    Self.hasPickaxe := True;

  if not RSW.GetMyPos.InBox([3752, 467, 4398, 1049]) then
    TerminateScript('Start the script within the lower gem mine.');

  if FarmRunner.StartWithRun or (BHIncludeGUIRunIntervalMinutes = 0) then
    Self.DoAntiban();
end;

function TMiner.PlayersNearby(pos: TPoint): Boolean;
var
  dots, nohop: TPointArray;
  dot: TPoint;
begin
  if not GameClient.IsLoggedIn then Login.LoginPlayer;
  dots := Minimap.GetDots(EMinimapDot.PLAYER);
  if dots.Len = 0 then Exit(False);
  nohop := Scriptwalker^.WorldToMM(pos, TPAFromBox(NO_HOP_BOX), Minimap.GetCompassAngle(False));
  FilterPointsDist(dots, 0, 40, Minimap.Center.X, Minimap.Center.Y);
  for dot in dots do
    if nohop.Contains(dot) then
      dots.remove(dot);
  Result := dots.Len <> 0;
end;

function TMiner.GetRockTPA(pos: TPoint; out tpa: TPointArray; index: Int32): Boolean;
var
  p, mypos: TPoint;
  box1, box2: TBox;
  tpa1, tpa2: TPointArray;
begin
  tpa := [];
  Result := False;
  mypos := pos;
  box1 := scriptwalker^.GetTileMSEx(mypos, ROCKS[index]).Bounds();
  if index <> High(ROCKS) then
    box2 := scriptwalker^.GetTileMSEx(mypos, Rocks[index + 1]).Bounds();

  if not Mainscreen.Bounds.Contains(box1) then
    Exit(False);

  SRL.FindColors(tpa1, ROCK_COL, box1);
  if (index = High(Rocks))
     or (not Mainscreen.Bounds.Contains(box2))
     or (tpa1.Len <= 10) then begin
      tpa := tpa1;
      Exit(tpa.Len > 10);
  end;

  SRL.FindColors(tpa2, ROCK_COL, box2);
  if tpa2.Len <= 10 then begin
    tpa := tpa1;
    Exit(tpa.Len > 10);
  end

  for p in tpa1 do
    if tpa2.Find(p) = -1 then
      tpa += p;
  tpa.ClearDuplicates();

  Result := tpa.Len > 10;
end;

function TMiner.ClickRock(tpa: TPointArray; attempts: Int32 = 1): Boolean;
var
  filteredTPA: TPointArray;
  middle: TPoint;
begin
  if attempts <= 2 then begin
    if (not tpa.Contains(Mouse.Position)) and (not ('Gem' in Mainscreen.GetUpText)) then begin
      middle := tpa.Mean();
      filteredTPA := tpa.FilterDist(0, 8, middle.X, middle.Y);
      if SRL.Dice(65) then
        Mouse.HumanMove(filteredTpa.RandomValue)
      else
        Mouse.Move(filteredTPA);
    end
    if not ('Gem' in Mainscreen.GetUpText) then
      Exit(ClickRock(tpa, attempts + 1));
    Mouse.Click(MOUSE_LEFT);
    Result := Mainscreen.DidRedClick();
  end else if attempts < 5 then begin
    if not GetRockTPA(Self.RSW.GetMyPos(), tpa, RockIndex) then
      Exit(ClickRock([], attempts + 1));
    if (not tpa.Contains(Mouse.Position)) and (not ('Gem' in Mainscreen.GetUpText)) then begin
      if SRL.Dice(65) then
        Mouse.HumanMove(tpa.Mean)
      else
        Mouse.Move(tpa.Mean);
    end
    if not ('Gem' in Mainscreen.GetUpText) then
      Exit(ClickRock([], attempts + 1));
    Mouse.Click(MOUSE_LEFT);
    Result := Mainscreen.DidRedClick();
    //WaitUntil(XPBar.EarnedXP, 115, 7500);
  end else Result := False;
end

procedure TMiner.HoverNextRock();
var
   filteredTPA, tpa: TPointArray;
   middle: TPoint;
begin
  Wait(625,725);
  Minimap.WaitMoving();
  if not GetRockTPA(Scriptwalker^.GetMyPos, tpa, RockIndex +1) then
    Exit;
  middle := tpa.Mean();
  filteredTPA := tpa.FilterDist(0, 8, middle.X, middle.Y);
  if SRL.Dice(66) then
    Mouse.HumanMove(filteredTPA.RandomValue)
  else
    Mouse.Move(filteredTPA);
end;

procedure TMiner.OnWalking(walker: PWalker; position: TPoint; destination: TPoint); begin
  position;
  destination;
  walker^.Enabled := DepositBox.IsOpen;
end;

procedure TMiner.Run(maxactions: Int32; maxruntime: Int64);
var
  compass: Double;
  invcount: Int32;
  tpa: TPointArray;
  resetinactive: Boolean;
  pos: TPoint;
begin
  MaxRuntimeCD.Init(maxruntime);

  if not (GameClient.IsLoggedIn or Login.LoginPlayer(False)) then
    TerminateScript('Failed to login on script start.');
    
  Self.Init;
  Runtime.Start;

  while PlayersNearby(Self.RSW.GetMyPos()) do begin
    WorldHopper.Hop(WorldArrayRandomizer(WorldList));
    if InactivityTimer.IsFinished() then
      TerminateScript('Failed to find an open world in a reasonable amount of time.');
  end;

  if (Self.RSW.GetMyPos()).InBox([6520, 4368, 7118, 4764]) then
    Self.HandleLadder('Gem mine');

  repeat
    if Login.IsWorldSwitcherOpen then begin
      Login.CloseWorldSwitcher;
      Continue;
    end;

    if not (GameClient.IsLoggedIn or Login.LoginPlayer(False)) then
      Continue;
      
    if ReportTimer.IsFinished then begin
      Self.ReportTimer.Init(90*ONE_SECOND);
      Self.Report;
    end;

    if Chat.LeveledUp then
      Chat.HandleLevelUp;

    if XPBar.EarnedXP() then
      InactivityTimer.Restart;

    pos := Self.RSW.GetMyPos();
    if PlayersNearby(pos) then begin
      if StartCrashTimer then begin
        CrashTimer.Init(6*ONE_SECOND);
        StartCrashTimer := False;
        DebugLn('Player detected, starting crash timer');
      end
      if CrashTimer.IsFinished() then begin
        repeat
          WorldHopper.Hop(WorldArrayRandomizer(WorldList));
          if InactivityTimer.IsFinished() then
            TerminateScript('Failed to find an open world in a reasonable amount of time.');
        until not PlayersNearby(pos);
      end
    end else begin
      StartCrashTimer := True;
    end;

    if not GameClient.IsLoggedIn then
      Continue;

    compass := Minimap.GetCompassAngle();
    if (compass < 259) or (compass > 279) then
      Minimap.SetCompassAngle(Random(260, 280));

    if (RockIndex > High(ROCKS)) or Inventory.IsFull() then begin
      Self.currentXP := XPBar.Read();

      if not DoBanking() then
         TerminateScript('Failed to bank');
      Self.DoAntiban();
      RockIndex := 0;
    end;

    if not GameClient.IsLoggedIn then
      Continue;

    GameInterface.Close();

    if pos.DistanceTo(ROCKS[RockIndex]) > 45 then begin
      RSW.WalkBlind(ROCKS[RockIndex], 15);
      Minimap.WaitPlayerMoving();
    end;

    if (not GetRockTPA(pos, tpa, RockIndex)) or (not GetRockTPA(pos, tpa, RockIndex)) then begin
      DebugLn('Couldn''t find rock ' + ToStr(RockIndex));
      RockIndex += 1;
      Continue;
    end;

    if ClickRock(tpa) then begin
      Wait(150,250);
      Minimap.WaitMoving;
      if SRL.Dice(0.5) then begin
        Mouse.RandomMovement();
        Wait(600);
      end;
      if Self.UseSpecialAttack and Self.SpecTimer.IsFinished then begin
        if Minimap.EnableSpec(100) then begin
          Self.SpecTimer.Restart(507, 5178);
          Continue;
        end;
      end;
      if SRL.Dice(3) then
        Antiban.LoseFocus(Floor(Random()*2*ONE_SECOND));
      if (RockIndex <> High(ROCKS)) then
        HoverNextRock();
      MiningTimer.Restart();
      invcount := Inventory.Count();
      repeat until (resetinactive := XPBar.EarnedXP()) or
                   (resetinactive := (invcount < Inventory.Count)) or
                    MiningTimer.IsFinished();
      RockIndex += 1;
      if resetinactive then 
        InactivityTimer.Restart();
      resetinactive := False;
    end else Mouse.RandomMovement();

  until InactivityTimer.IsFinished() or
        MaxRuntimeCD.IsFinished() or
        (TotalActions > maxactions) or
        ((Self.ShutdownTime > 0) and (GetTimeRunning() > Self.ShutdownTime));

  if InactivityTimer.IsFinished() then
    WriteLn('Terminating, No xp gained in 10 minutes')
  else if MaxRuntimeCD.IsFinished() then
    WriteLn('Terminating, max runtime reached')
  else if TotalActions > maxactions then
    WriteLn('Terminating, max actions reached')
  else if (Self.ShutdownTime > 0) and (GetTimeRunning() > Self.ShutdownTime) then
    WriteLn('Terminating, max runtime reached');
end;

begin
  //WaspClient.CheckSubscription(True);
  SettingsHandler.CheckGPUPlugin();

  if FileExists(AppPath+'\Configs/StudentsSettings') then
    GMConfig.Init();

  GUI.Run();

  {$IFNDEF SRL_DISABLE_REMOTEINPUT}
  if WLSettings.GetObject('remote_input').getBoolean('enabled', True) and (not GameClient.RemoteInput.IsSetup()) then GameClient.RemoteInput.Setup();
  {$ENDIF}

  GMConfig.Write();
  Miner.Run(_MaxActions, _MaxRuntime);
end.
