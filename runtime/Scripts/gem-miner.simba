type
  TMiner = record
    DebugMode, ForceDeposit, UseSpecialAttack, StartCrashTimer,
    UseDepositAll: Boolean;
    TotalActions, RockIndex, StartingXp: Int32;
    Runtime: TStopWatch;
    MiningTimer, MaxRuntimeCD, InactivityTimer, ReportTimer,
    SpecTimer, CrashTimer: TCountdown;
    RSW: TWalker;
    DepBoxFinder: TObjectFinder;
    Version: String;
    DepositIdleBox: TBox;
    currentXP,
    startXP : Int32;
    Transport : TUniversalTransport;
    KaramjaGloves, ArdyCloak : String;
    KaramjaDiary, ArdyDiary, I : Int32;
    TakeBreaks, TakeSleeps, DoFarmRuns, DoBHRuns, hasEnoughDiary, KaramjaGlovesEquipped, ArdyCloakEquipped, hasPickaxe : Boolean;
    ShutdownTime : Int64;
    BarnabyNPC : TMMDot;
    BankObj, CartObj, LadderObj, LadderObjDown, BankNPC : TGameObject;
  end;

  TGUI = record(TScriptForm)
    BreakAfter, BreakFor,
    SleepAt, SleepFor,
    MaxActions, MaxRuntime: TLabeledEdit;
