procedure TScript.WriteMsg(Message: String);
begin
  WriteLn(SRL.TimeStamp() + '[Soul Wars]: '+ Message);
end;

procedure TIniConfig.Init();
var
  frun, brun, tbreak, tsleep, highnpc, highalt,
  bhbestlog, bhclockworks: string;
begin
   frun := ReadINI('Soul Wars General', 'Farm runs', AppPath+'Configs/StudentsSettings');
   Self.frunEnabled := StrToBoolDef(frun, False);

   brun := ReadINI('Soul Wars General', 'BH runs', AppPath+'Configs/StudentsSettings');
   Self.brunEnabled := StrToBoolDef(brun, False);

   tbreak := ReadINI('Soul Wars General', 'Take breaks', AppPath+'Configs/StudentsSettings');
   Self.tbreakenabled := StrToBoolDef(tbreak, False);

   tsleep := ReadINI('Soul Wars General', 'Take sleeps', AppPath+'Configs/StudentsSettings');
   Self.tsleepenabled := StrToBoolDef(tsleep, False);

   highnpc := ReadINI('Soul Wars General', 'Use higher level npc', AppPath+'Configs/StudentsSettings');
   Self.npcenabled := StrToBoolDef(highnpc, False);

   highalt := ReadINI('Soul Wars General', 'Alt account is high lvl', AppPath+'Configs/StudentsSettings');
   Self.altenabled := StrToBoolDef(highalt, False);

   SWConfig.rsnstr := ReadINI('Soul Wars General', 'RSN to boost', AppPath+'Configs/StudentsSettings');

   SWConfig.breakintervalint := StrToIntDef(ReadINI('Soul Wars General', 'Break interval', AppPath+'Configs/StudentsSettings'), 60);
   SWConfig.maxrunforint := StrToIntDef(ReadINI('Soul Wars General', 'Max run for', AppPath+'Configs/StudentsSettings'), 600);
   SWConfig.gamecountint := StrToIntDef(ReadINI('Soul Wars General', 'Games to play', AppPath+'Configs/StudentsSettings'), 100);

   SWConfig.breaklengthint := StrToIntDef(ReadINI('Soul Wars General', 'Break length', AppPath+'Configs/StudentsSettings'), 15);
   SWConfig.sleepintervalstr := ReadINI('Soul Wars General', 'Sleep interval', AppPath+'Configs/StudentsSettings');
   SWConfig.sleeplengthint := StrToIntDef(ReadINI('Soul Wars General', 'Sleep length', AppPath+'Configs/StudentsSettings'), 8);

   SWConfig.bhlogint := StrToIntDef(ReadINI('Soul Wars BH Tab', 'BH logs', AppPath+'Configs/StudentsSettings'), 0);
   BHIncludeGUILogType := ELogType(SWConfig.bhlogint);

   SWConfig.bhseed := ReadINI('Soul Wars BH Tab', 'BH seed', AppPath+'Configs/StudentsSettings');
   BHIncludeGUISeed := SWConfig.bhseed;

   SWConfig.bhrunint := StrToIntDef(ReadINI('Soul Wars BH Tab', 'BH runtime', AppPath+'Configs/StudentsSettings'), 0);
   BHIncludeGUIRunIntervalMinutes := Round(SWConfig.bhrunint / 60000);

   bhbestlog := ReadINI('Soul Wars BH Tab', 'BH best log', AppPath+'Configs/StudentsSettings');
   Self.bhusebestlogEnabled := StrToBoolDef(bhbestlog, False);
   BHIncludeGUIUseBestLog := SWConfig.bhusebestlogEnabled;

   bhclockworks := ReadINI('Soul Wars BH Tab', 'BH clockworks', AppPath+'Configs/StudentsSettings');
   Self.bhcraftclockworksEnabled := StrToBoolDef(bhclockworks, False);
   BHIncludeGUICraftWhileNav := SWConfig.bhcraftclockworksEnabled;

   SWConfig.loginindexint := StrToIntDef(ReadINI('Soul Wars Account Tab', 'Login index', AppPath+'Configs/StudentsSettings'), 0);
   Login.PlayerIndex := SWConfig.loginindexint;
end;

procedure TIniConfig.Write();
begin
  WriteIni('Soul Wars General', 'Farm runs', ToStr(Self.frunEnabled), AppPath+'Configs/StudentsSettings');
  WriteIni('Soul Wars General', 'BH runs', ToStr(Self.brunEnabled), AppPath+'Configs/StudentsSettings');
  WriteIni('Soul Wars General', 'Take breaks', ToStr(Self.tbreakenabled), AppPath+'Configs/StudentsSettings');
  WriteIni('Soul Wars General', 'Take sleeps', ToStr(Self.tsleepenabled), AppPath+'Configs/StudentsSettings');
  WriteIni('Soul Wars General', 'Break interval', ToStr(Self.breakintervalint), AppPath+'Configs/StudentsSettings');
  WriteIni('Soul Wars General', 'Break length', ToStr(Self.breaklengthint), AppPath+'Configs/StudentsSettings');
  WriteIni('Soul Wars General', 'Sleep interval', Self.sleepintervalstr, AppPath+'Configs/StudentsSettings');
  WriteIni('Soul Wars General', 'Sleep length', ToStr(Self.sleeplengthint), AppPath+'Configs/StudentsSettings');
  WriteIni('Soul Wars General', 'Max run for', ToStr(Self.maxrunforint), AppPath+'Configs/StudentsSettings');
  WriteIni('Soul Wars General', 'Games to play', ToStr(Self.gamecountint), AppPath+'Configs/StudentsSettings');
  WriteIni('Soul Wars General', 'RSN to boost', Self.rsnstr, AppPath+'Configs/StudentsSettings');
  WriteIni('Soul Wars General', 'Use higher level npc', ToStr(Self.npcenabled), AppPath+'Configs/StudentsSettings');
  WriteIni('Soul Wars General', 'Alt account is high lvl', ToStr(Self.altenabled), AppPath+'Configs/StudentsSettings');

  WriteIni('Soul Wars BH Tab', 'BH logs', ToStr(Ord(BirdHouseRunner.LogType)), AppPath+'Configs/StudentsSettings');
  WriteIni('Soul Wars BH Tab', 'BH seed', BirdHouseRunner.Seed, AppPath+'Configs/StudentsSettings');
  WriteIni('Soul Wars BH Tab', 'BH runtime', ToStr(BirdHouseRunner.TaskInterval), AppPath+'Configs/StudentsSettings');
  WriteIni('Soul Wars BH Tab', 'BH best log', ToStr(BirdHouseRunner.AlwaysUseBestLog), AppPath+'Configs/StudentsSettings');
  WriteIni('Soul Wars BH Tab', 'BH clockworks', ToStr(BirdHouseRunner.NeedClockworks), AppPath+'Configs/StudentsSettings');

  WriteIni('Soul Wars Account Tab', 'Login index', ToStr(Login.PlayerIndex), AppPath+'Configs/StudentsSettings');

  // ... any other things you stored on TIniConfig
end;

procedure TScriptForm.StartScript(Sender: TObject); override;
var
  MaxRun, GameLimit: Int32;
  e_Run, e_BA, e_BF, e_SA, e_SF, g_Lim, d_rsn: TEdit;
  cb_Breaks, cb_Sleeps, cb_HLNPC, cb_HLA, FarmRuns, BHRuns: TCheckBox;
  Rol: TComboBox;
begin
  inherited;

  Self.Form.Close();
  Bot.WriteMsg('Starting script');

  g_Lim  := Self.Form.GetChild('box_gl_edit');
  GameLimit := StrToInt(g_Lim.getText);
  Bot.GameLimit := (GameLimit);

  d_rsn := Self.Form.GetChild('box_rsn_edit');
  Bot.dRSN := d_rsn.getText;

{ Time settings }
  e_Run            := Self.Form.GetChild('box_run_edit');
  MaxRun           := StrToInt(e_Run.getText);
  Bot.ShutdownTime := (MaxRun * 60000) + Random(- (MaxRun * 6000), (MaxRun * 6000));

  cb_Breaks        := Self.Form.GetChild('cb_breaks_checkbox');
  Bot.TakeBreaks   := cb_Breaks.IsChecked;
  if Bot.TakeBreaks then
  begin
    e_BA           := Self.Form.GetChild('box_ba_edit');
    e_BF           := Self.Form.GetChild('box_bf_edit');
    Antiban.AddBreak(ONE_MINUTE*StrToInt(e_BA.getText),ONE_MINUTE*StrToInt(e_BF.getText), 0.15, 1.0);
  end;

  cb_Sleeps        := Self.Form.GetChild('cb_sleeps_checkbox');
  Bot.TakeSleeps   := cb_Sleeps.IsChecked;
  if Bot.TakeSleeps then
  begin
    e_SA           := Self.Form.GetChild('box_sa_edit');
    e_SF           := Self.Form.GetChild('box_sf_edit');
    Antiban.AddSleep(e_SA.getText, StrToInt(e_SF.getText) * ONE_HOUR, 0.1, 1.0);
  end;

{ Script settings }

  Rol              := Self.Form.GetChild('lcb_rol_combobox');
  Bot.Role         := Rol.GetText;

  cb_HLNPC         := Self.Form.GetChild('cb_hlnpc_checkbox');
  Bot.HighLvlNPC   := cb_HLNPC.IsChecked;

  cb_HLA         := Self.Form.GetChild('cb_hla_checkbox');
  Bot.HighLvlAlt := cb_HLA.IsChecked;

  FarmRuns := Self.Form.GetChild('cb_farmruns_checkbox');
  Bot.DoFarmRuns  := (FarmRuns.GetState = cbChecked);

  BHRuns := Self.Form.GetChild('cb_bhruns_checkbox');
  Bot.DoBHRuns    := (BHRuns.getState = cbChecked);

  SWConfig.maxrunforint := MaxRun;
  SWConfig.gamecountint := GameLimit;

  SWConfig.tbreakenabled := Bot.TakeBreaks;
  SWConfig.tsleepenabled := Bot.TakeSleeps;

  SWConfig.npcenabled := Bot.HighLvlNPC;
  SWConfig.altenabled := Bot.HighLvlAlt;

  if Bot.TakeBreaks then
  begin
    SWConfig.breakintervalint := StrToInt(e_BA.getText);
    SWConfig.breaklengthint := StrToInt(e_BF.getText);
  end;

  if Bot.TakeSleeps then
  begin
    SWConfig.sleepintervalstr := e_SA.getText;
    SWConfig.sleeplengthint := StrToInt(e_SF.getText);
  end;

  SWConfig.rsnstr := d_rsn.getText;

  SWConfig.frunEnabled := Bot.DoFarmRuns;
  SWConfig.brunEnabled := Bot.DoBHRuns;
end;

function TScriptForm.CreateSettingsTab(): TTabSheet;
  type TScriptForm = TScriptForm;
  procedure TScriptForm.UpdateSList(Sender: TObject);
  var
    S,Rol: TComboBox;

  begin
    S := Sender;
    Rol  := Self.Form.GetChild('lcb_rol_combobox');
  end;

var
  lb_Time,lb_Script: TLabel;
  cb_Breaks,cb_Sleeps,cb_HLNPC,cb_HLA,cb_farmruns,cb_bhruns: TLabeledCheckBox;
  box_Run,box_BA,box_BF,
  box_SA,box_SF,box_GL,box_rsn: TLabeledEdit;
  lcb_Rol: TLabeledComboBox;
begin
  Result.Init(nil);
  Result.SetCaption('Script settings');
  Result.SetName('Settings_Tab');

{ Setup time settings }
  with lb_Time do
  begin
    Create(Result);
    SetLeft(125);
    SetTop(10);
    SetFontColor($800080);
    GetFont().SetSize(15);
    SetCaption('Time Settings');
  end;

  with box_Run do
  begin
    Create(Result);
    SetLeft(562);
    SetTop(310);
    SetName('box_Run');
    SetCaption('Run for');
    SetToolTip('Time in minutes');
    SetText('300');
    SetFontColor($800080);
  end;

  with cb_Breaks do
  begin
    Create(Result);
    SetLeft(5);
    SetTop(55);
    SetName('cb_breaks');
    SetCaption('Take breaks');
    SetFontColor($800080);
  end;

  with box_BA do
  begin
    Create(Result);
    SetLeft(5);
    SetTop(75);
    SetName('box_ba');
    SetCaption('Break after');
    SetToolTip('Time in minutes');
    SetText('60');
    SetFontColor($800080);
  end;

  with box_BF do
  begin
    Create(Result);
    SetLeft(5);
    SetTop(125);
    SetName('box_bf');
    SetCaption('Break for');
    SetToolTip('Time in minutes');
    SetText('15');
    SetFontColor($800080);
  end;

  with cb_Sleeps do
  begin
    Create(Result);
    SetLeft(200);
    SetTop(55);
    SetName('cb_sleeps');
    SetCaption('Take sleeps');
    SetFontColor($800080);
  end;

  with box_SA do
  begin
    Create(Result);
    SetLeft(200);
    SetTop(75);
    SetName('box_sa');
    SetCaption('Sleep at');
    SetToolTip('Time in 24Hr format');
    SetText('11:00:00');
    SetFontColor($800080);
  end;

  with box_SF do
  begin
    Create(Result);
    SetLeft(200);
    SetTop(125);
    SetName('box_sf');
    SetCaption('Sleep for');
    SetToolTip('Time in hours');
    SetText('2');
    SetFontColor($800080);
  end;

{ Setup general settings }
  with lb_Script do
  begin
    Create(Result);
    SetLeft(562);
    SetTop(10);
    SetFontColor($800080);
    GetFont().SetSize(15);
    SetCaption('General settings');
  end;

  with lcb_rol do
  begin
    Create(Result);
    SetLeft(562);
    SetTop(45);
    SetName('lcb_rol');
    SetCaption('Role');
    AddItemArray(['Alt', 'ReceivesZeal']);
    SetFontColor($800080);
    SetItemIndex(0);
    ComboBox.SetFontColor(0);
    ComboBox.SetOnChange(@Self.UpdateSList);
  end;

  with box_rsn do
  begin
    Create(Result);
    SetLeft(562);
    SetTop(90);
    SetName('box_rsn');
    SetCaption('Type RSN of ReceivesZeal');
    SetToolTip('The account that is being boosted');
    SetText('RSN HERE');
    SetFontColor($800080);
  end;

  with cb_HLNPC do
  begin
    Create(Result);
    SetLeft(562);
    SetTop(135);
    SetName('cb_hlnpc');
    SetCaption('Use 4 frag NPC');
    SetToolTip('Uses souls that drop 4 frags on kill');
    SetFontColor($800080);
  end;

  with cb_HLA do
  begin
    Create(Result);
    SetLeft(562);
    SetTop(170);
    SetName('cb_hla');
    SetCaption('Alt account is high lvl');
    SetToolTip('Enable if your alt is consistently hitting >28 frags');
    SetFontColor($800080);
  end;

  with box_GL do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(562));
    SetTop(TControl.AdjustToDPI(270));
    SetName('box_gl');
    SetCaption('Game limit');
    SetToolTip('How many to games to play');
    SetText('100');
    SetMaxLength(6);
    SetFontColor($800080);
  end;

  with cb_farmruns do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(562));
    SetTop(TControl.AdjustToDPI(220));
    SetName('cb_farmruns');
    SetFontColor($800080);
    SetCaption('Farm runs');
  end;

  with cb_bhruns do
  begin
    Create(Result);
    SetLeft(TControl.AdjustToDPI(562));
    SetTop(TControl.AdjustToDPI(240));
    SetName('cb_bhruns');
    SetFontColor($800080);
    SetCaption('Birdhouse runs');
  end;

   if (SWConfig.maxrunforint <> 0) then
    box_Run.SetText(ToStr(SWConfig.maxrunforint));

  if (SWConfig.gamecountint <> 0) then
    box_GL.SetText(ToStr(SWConfig.gamecountint));

  if SWConfig.frunEnabled then
    cb_farmruns.CheckBox.SetChecked(True);

  if SWConfig.brunEnabled then
    cb_bhruns.CheckBox.SetChecked(True);

  if SWConfig.npcenabled then
    cb_HLNPC.CheckBox.SetChecked(True);

  if SWConfig.altenabled then
    cb_HLA.CheckBox.SetChecked(True);

  if SWConfig.tbreakenabled then
  begin
    cb_Breaks.CheckBox.SetChecked(True);
    box_BA.SetText(ToStr(SWConfig.breakintervalint));
    box_BF.SetText(ToStr(SWConfig.breaklengthint));
  end;

  if SWConfig.tsleepenabled then
  begin
    cb_Sleeps.CheckBox.SetChecked(True);
    box_SA.SetText(SWConfig.sleepintervalstr);
    box_SF.SetText(ToStr(SWConfig.sleeplengthint));
  end;

  box_rsn.SetText(SWConfig.rsnstr);
end;

procedure TScriptForm.Setup(caption: String = 'Script Form'; size: TPoint = [750, 500]; allowResize: Boolean = False); override;
var
  Img: TPicture;
  BGImg: TImage;
  SButton: TButton;
begin
  inherited;

  Img.init();

  try
    Img.LoadFromFile('Resources\SSWGUI.png')
  except
    writeln('Could not load the gui image')
  finally
  end;

  with BGImg do
  begin
    Init(Self.PageControl);
    SetParent(Self.PageControl);
    SetBounds(0,0,Self.Form.getWidth,Self.Form.getHeight);
    SetPicture(Img);
  end;

  Self.Start.setVisible(False);
  with SButton do
  begin
    Create(Self.Form);
    SetBounds(Self.Form.GetRight-190, Self.Form.GetBottom-70, 180, 60);
    GetFont.SetName('Bahnschrift');
    GetFont.SetSize(15);
    SetCaption('Run');
    SetOnClick(@Self.StartScript);
  end;

  Self.AddTab(CreateSettingsTab());
  Self.CreateAccountManager();
  Self.CreateFarmRunSettingsTab();
  Self.CreateBirdhouseRunSettings();
end;

function TMinimap.IsUnloadedVisible(out unloadedBlackTPA: TPointArray): Boolean; // Skunk
var
  unloadedClusters: T2DPointArray;
begin
  if Minimap.IsPlayerMoving() then // if we are still moving we don't care about unloaded
    Exit(False);
  SRL.FindColors(unloadedBlackTPA, 0, Minimap.Bounds);
  unloadedClusters := unloadedBlackTPA.Cluster(1);
  unloadedClusters.FilterSize(200, EComparator.__GT__);
  if unloadedClusters.Len() = 0 then
    Exit(False);

  unloadedBlackTPA := unloadedClusters.Biggest();
end;

function TMinimap.ClickIntoUnloaded(): Boolean;  // Skunk
var
  blackTPA: TPointArray;
begin
  if not self.IsUnloadedVisible(blackTPA) then
    Exit(False);

  WriteLn('clicking into unloaded minimap region');
  Mouse.Click(blackTPA.RandomMean(), MOUSE_LEFT);
  if Mainscreen.DidRedClick() then
    Debug(Mainscreen.Bounds);
end;

procedure OnWalkEventSW(Sender: PWalker; Position: TPoint; Destination: TPoint);
var
  slotOption: String;
begin
  if Minimap.ClickIntoUnloaded() then
    Bot.WriteMsg('We had to click into unloaded map');

  if Bot.Role.Contains('ReceivesZeal') then
    Exit;

  if Sender <> @Bot.RSW then
    Exit;

  if not (Bot.MyPos := Bot.RSW.GetMyPos()).InBox([4191, 4638, 4990, 4938]) then
    Exit;

  if Minimap.GetHPLevel < 2 then
    Exit;

  if ToStr(Bot.damageItem) <> 'Locator orb' then
    slotOption := 'Guzzle';

  Inventory.ClickItem(ToStr(Bot.damageItem), slotOption);

  Position := [];
  Destination := [];
end;

function WorldArrayRandomizer(const arr: array of Int32): array of Int32;
begin
  if High(arr) >= 0 then
  begin
    SetLength(Result, 1);
    Result[0] := arr[Random(0, High(arr))];
  end
end;

function WriteCommunications(comms: TSoulWarsComm): Boolean;
var
  exception : String;
  stream : TFileStream;
begin
  try
    stream.Init(SIMBA_DATA_DIR + 'soul_wars.dat', 2);

    stream.getSize;
    stream.setSize(0);
    stream.setPosition(0);
    stream.Write(comms, SizeOf(TSoulWarsComm));
    Result := True;
  except
    exception := GetExceptionMessage;
    if not ('Unable to open' in exception) then
      raise exception;
  finally
    stream.Free;
  end;
end;

function ReadCommunications(): Boolean;
var
  exception : String;
  stream : TFileStream;
begin
  try
    stream.Init(SIMBA_DATA_DIR + 'soul_wars.dat', 2);

    stream.Read(Bot.Comms, SizeOf(TSoulWarsComm));
    Result := True;
  except
    exception := GetExceptionMessage;
    if not ('Unable to open' in exception) then
      raise exception;
  finally
    stream.Free;
  end;
end;

procedure TScript.WriteCommsLoops(TTime: Int32; CappingBool:Boolean; BreakBool: Boolean; SleepBool: Boolean; FragsInBool: Boolean; TerminateBool: Boolean; InsideZone: Boolean; CurrentWorld: Int32; MessageString: String);
var
  TTimeout: TCountdown;
  DidWrite: Boolean;
begin
  TTimeout.Init(TTime);
  repeat
    DidWrite := WriteCommunications([CappingBool, BreakBool, SleepBool, FragsInBool, TerminateBool, InsideZone, CurrentWorld]);
    if DidWrite then
      Break;
  until TTimeout.isFinished();

  if not DidWrite then
    Self.WriteMsg(MessageString);
end;

procedure TScript.CheckWorld();
begin
  if Logout.Open then
  begin
    if not Logout.IsWorldSwitcherOpen() then
      Logout.GetButton(ELogoutButton.WORLD_SWITCHER).Click(MOUSE_LEFT);
    Wait(1500,2000);
    Self.WorldInt := WorldHopper.GetCurrentWorld();

    if Role.Contains('ReceivesZeal') then
      WriteCommunications([False, False, False, False, False, False, Self.WorldInt]);
  end;
end;

procedure TScript.Hopper();
begin
  Self.WriteMsg ("We might be on a world with a gold farming group, attempting to hop");
  Waituntil(WorldHopper.Hop(WorldArrayRandomizer(WorldList)), 115, 12000);
  Self.CheckWorld();
end;

procedure TScript.ClearChat();
var
  b: TBox := [262,484,291,491];
begin
  Mouse.move(b);

  if WaitUntil(Mainscreen.IsUpText('Swi'), 200, 5000)  then
    Mouse.Click(MOUSE_RIGHT);

  if not ChooseOption.Select('Channel: Clear history', MOUSE_LEFT) then
    Exit;
end;

procedure TScript.DoLoseFocus();
Var T: Int32;
begin
  T := SRL.NormalRange(1700,8000);
  Antiban.DebugLn('Losing focus for '+SRL.MsToTime(T, Time_Short));
  Antiban.LoseFocus(T);
end;

procedure TScript.SetupAntiban();
begin
  Antiban.AddTask((ONE_MINUTE*1)*Self.ABTimeMod,  @Mouse.RandomMovement);
  Antiban.AddTask((ONE_MINUTE*4)*Self.ABTimeMod,  @Self.DoLoseFocus);
  Antiban.AddBreak(ONE_MINUTE*240, ONE_MINUTE*5, 0.1, 1.0);
end;

function TScript.WithdrawHelper(item : TItem; quant : Int32) : Boolean; // CJ
var
  withdrawItem : TBankItem;
  attempts : int32;
begin
  if not Inventory.ContainsItem(item) then
  begin
    Bot.WriteMsg('Withdrawing ' + item);
    for attempts := 0 to 3 do
    begin
      if not Inventory.ContainsItem(item) and (attempts = 3) then
      begin
        Logout.ClickLogout();
        TerminateScript('Did not find ' + item);
      end;

      withdrawItem := TBankItem.Setup(item, quant, False);
      Bank.WithdrawItem(withdrawItem, False);
      Result := Waituntil(Inventory.ContainsItem(item), 315, 3000);

      if Inventory.ContainsItem(item) then
        Break;
    end;
  end
  else
    Result := true;
end;

procedure TScript.SetupDamageItem();   // Torwent
begin
  Self.WriteMsg('Checking inventory for an item to damage ourselves');

  if Inventory.ContainsItem('Locator orb') then
    damageItem := 'Locator orb'
  else if Inventory.ContainsItem('Dwarven rock cake') then  //this will use 7509 ID which is hot cake
    damageItem := 'Dwarven rock cake'
  else if Inventory.ContainsItem(7510) then  //7510 is cold rock cake ID
    damageItem := 7510;

  if ToStr(damageItem) = '' then
    TerminateScript('You need either a Locator orb or a Dwarven rock cake to run this script.');
end;

procedure TScript.QuickPrayerSelector(); // Credit to Kilsbigpils AKA The Professor
var
  OldSelected: array of EPrayer;
  DesiredPrayer: EPrayer;
  i: Integer;
  Match: Boolean;
begin
  Self.WriteMsg('Setting up prayer');

  Magic.CastSpell(ESpell.FALADOR_TELEPORT);

  QuickPrayer.Open;
  OldSelected := QuickPrayer.GetSelectedPrayers;
  writeln(OldSelected);

  Debug(Prayer.GetPrayerBoxes(Prayer.GetAvailablePrayers()));

  if (Stats.GetLevel(ESkill.Prayer) >= 43) then
    DesiredPrayer := EPrayer.PROTECT_FROM_MELEE;

  Match := False;
  for i := 0 to Length(OldSelected) - 1 do
  begin
    if OldSelected[i] = DesiredPrayer then
    begin
      Match := True;
      Break;
    end;
  end;

  if not Match then
  begin
    QuickPrayer.DeselectPrayer(OldSelected);
    QuickPrayer.SelectPrayer([DesiredPrayer]);
  end;

  QuickPrayer.Close;
end;

procedure TFarmRun.OnStart(); override;
var
  I : Int32;
begin
  for I := 0 to High(Antiban.tasks) do
    Antiban.Tasks[I].Countdown.Pause;

  Wait(6000);
  GameInterface.Close;
  Bank.WalkOpen(Bot.SWBank);
  WaitUntil(Bank.IsOpen, 115, 12000);
  Wait(500,750);
  Bank.DepositAll();

  inherited;
end;

procedure TFarmRun.OnComplete(); override;
var
  I, attempts : Int32;
  bankTimeout : TCountdown;
begin
  if Chat.HasContinue then
    Chat.ClickContinue();

  for attempts := 0 to 6 do
  begin
    if (attempts >= 6) then
    begin
      Bot.WriteCommsLoops(3000, False, False, False, False, True, False, Bot.WorldInt, 'Something is wrong:');
      TerminateScript('Failed to teleport back from our farm run');
    end;

    if Bot.transport.run(rsteleports.MINIGAME_SOUL_WARS) then
      WaitUntil((Bot.MyPos := Bot.RSW.GetMyPos()).InBox([4404, 4900, 4772, 5196]), 115, 25000);

    if (Bot.MyPos := Bot.RSW.GetMyPos()).InBox([4404, 4900, 4772, 5196]) then
      Break;

    Wait(240000, 300000);
  end;

  while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
  begin
    Bank.WalkOpen(Bot.SWBank);
  end;

  if bankTimeout.IsFinished() and not Bank.IsOpen() then
    TerminateScript("Failed to bank");

  Bank.DepositAll();

  for I := 0 to High(Antiban.tasks) do
  Antiban.Tasks[I].Countdown.Resume;
end;

function TBirdHouseInclude.OnStart() : Boolean; override;
var
  i : Int32;
  bankTimeout : TCountdown;
begin
  for I := 0 to High(Antiban.tasks) do
    Antiban.Tasks[I].Countdown.Pause;

  GameInterface.Close;

  if Self.AlwaysUseBestLog then
  begin
    Self.SuggestedLogType := BirdhouseRunner.GetLogForHunterLevel(Stats.GetLevel(ESkill.HUNTER));
    if Self.LogType <> Self.SuggestedLogType then
      Self.LogType := Self.SuggestedLogType;
  end;

  bankTimeout.Init(30000);

  while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
    Bank.WalkOpen(Bot.SWBank);

  if not Bank.IsOpen() then
  begin
    Self.DebugLn("Failed to get to bank");
    Exit(false);
  end;

  Bank.DepositAll();

  //If we can't get our stuff then bail
  if not Self.WithdrawNextRun() then
  begin
    Bank.Close();
    BirdhouseRunner.IsDisabled := true;
    Exit(false);
  end;

  Bank.Close();

  Result := true;
end;

procedure TBirdHouseInclude.OnComplete(); override;
var
  I, attempts : Int32;
  bankTimeout : TCountdown;
begin
  ScriptWalker := @Bot.RSW;

  for attempts := 0 to 6 do
  begin
    if (attempts >= 6) then
    begin
      Bot.WriteCommsLoops(3000, False, False, False, False, True, False, Bot.WorldInt, 'Something is wrong:');
      TerminateScript('Failed to teleport back from our farm run');
    end;

    if Bot.transport.run(rsteleports.MINIGAME_SOUL_WARS) then
      WaitUntil((Bot.MyPos := Bot.RSW.GetMyPos()).InBox([4404, 4900, 4772, 5196]), 115, 25000);

    if (Bot.MyPos := Bot.RSW.GetMyPos()).InBox([4404, 4900, 4772, 5196]) then
      Break;

    Wait(240000, 300000);
  end;

  bankTimeout.Init(30000);

  while not bankTimeOut.IsFinished() and not Bank.IsOpen() do
  begin
    Bank.WalkOpen(Bot.SWBank);
  end;

  if bankTimeout.IsFinished() and not Bank.IsOpen() then
    TerminateScript("Failed to bank");

  Bank.DepositAll();

  for I := 0 to High(Antiban.tasks) do
  Antiban.Tasks[I].Countdown.Resume;
end;

procedure TScript.GetZealAmount();
begin
  if not (('You earned') in Chat.GetMessage(7, [CHAT_COLOR_BLACK])) then
    Exit;

  Self.ZealLine := Chat.GetMessage(7);
  Self.ZealAmounts := Self.ZealLine.ExtractNumbers();

  if (Length(Self.ZealAmounts) < 1) then
    Self.ZealAmounts := [0];

  Self.ZealGains +=  Floor(Self.ZealAmounts[0]);
end;

function TScript.TooManyPlayersNearby(): Boolean;
var
  Dots: TPointArray := Minimap.GetDots(EMinimapDot.PLAYER);
begin
  FilterPointsDist(Dots, 0, 75, Minimap.Center.X, Minimap.Center.Y);
  Exit(Length(Dots) >= 5);
end;

procedure TScript.HandleStartZoneEntrance();
var
  attempts : Int32;
begin
  Self.FinishGame := False;
  Self.capeisred  := False;
  Self.capeisblue := False;

  if not (MyPos := Self.RSW.GetMyPos()).InBox([4434,4950,4732,5182]) then
  begin
    Antiban.RandomRotate();
    Exit;
  end;

  if Self.TooManyPlayersNearby and Role.Contains('ReceivesZeal') then
    Self.Hopper();

  Self.WriteMsg('Entering starting zone');

  if GameInterface.IsOpen then
    GameInterface.Close();

  for attempts := 0 to 5 do
  begin
    if PBoostPortal.WalkClick(True, 5) then
      WaitUntil((MyPos := Self.RSW.GetMyPos()).InBox([4624,5060,4658,5880]), 115, 10000);
    Wait(1500,2500);

    if (MyPos := Self.RSW.GetMyPos()).InBox([4624,5060,4658,5880]) then
    begin
      Self.WriteMsg('Inside starting zone');

      if Role.Contains('Zeal') then
        Self.WriteCommsLoops(5000, False, False, False, False, False, True, Self.WorldInt, 'Something is wrong:');
      Exit;
    end;

    if Chat.GetChat.Contains('Yes.') then
      WaitUntil(Chat.ClickOption('and don'), 115, 5000);

    if (attempts >= 5) then
      TerminateScript('Having a difficult time getting to the start area');

    if Chat.GetChat.Contains('need to complete ') then
    begin
      Self.WriteCommsLoops(3000, False, False, False, False, True, False, Self.WorldInt, 'Something is wrong:');
      TerminateScript('You must complete the tutorial for SW first');
    end;
  end;
end;

procedure TScript.ResetGameLogic();
begin
  Wait(550,950);
  Self.FinishGame := False;
  Self.capeisred := False;
  Self.capeisblue := False;
  GameCount += 1;
  ABGameCount += 1;

  Self.WriteCommsLoops(3000, False, False, False, False, False, False, Self.WorldInt, 'Something is wrong, failed to write for the end of the game');
  Self.Report();
end;

function TScript.InsideStartZone: Boolean;
var
  MyPos: TPoint;
begin
  Exit((MyPos := Self.RSW.GetMyPos()).InBox([4624,5060,4658,5880]));
end;

procedure TScript.WaitForReturn();
begin
  Self.WriteMsg('Other account is currently taking a break or a sleep. Waiting on it to return');

  if GameClient.IsLoggedIn then
    Logout.ClickLogout();

  if Self.Comms.OnSleep then
  begin
    Wait(90*ONE_SECOND);
    Inc(Self.ReturnLoopInt, 1);
    Self.WriteMsg('Our loop count is ' + IntToStr(Self.ReturnLoopInt));
    if (Self.ReturnLoopInt >= 960) then
      TerminateScript('Something went wrong while waiting');
  end;

  if Self.Comms.OnBreak then
  begin
    Wait(90*ONE_SECOND);
    Inc(Self.ReturnLoopInt, 1);
    Self.WriteMsg('Our loop count is ' + IntToStr(Self.ReturnLoopInt));
    if (Self.ReturnLoopInt >= 40) then
      TerminateScript('Something went wrong while waiting');
  end;
end;

function TScript.PlayerNearby(): Boolean;
var
  Dots: TPointArray := Minimap.GetDots(EMinimapDot.PLAYER);
begin
  FilterPointsDist(Dots, 0, 30, Minimap.Center.X, Minimap.Center.Y);
  Exit(Length(Dots) >= 1);
end;

function TScript.GetChallengerTileMM(MMPos: TPoint): TPoint; // Stolen from Flight, Don't tell him
var
  Challenger: TPointArray;
begin
  Challenger := Minimap.GetDots(EMinimapDot.PLAYER);
  Writeln(Challenger);
  Writeln(Minimap.HasDotUnder);
  if (Challenger.Len() > 0) then
  begin
    Challenger.Sort(MMPos);
    if (MMPos = Minimap.Center) and (Minimap.HasDotUnder) then
      Result := Minimap.Center
    else
      Result := [Challenger[0].X+2, Challenger[0].Y+2];
  end;
end;

function TScript.GetEnemyTileMM(MMPos: TPoint): TPoint; // Stolen from Flight, Don't tell him
var
  SWNPC: TPointArray;
begin
  SWNPC := Minimap.GetDots(EMinimapDot.NPC);
  if (SWNPC.Len() > 0) then
  begin
    SWNPC.Sort(MMPos);
    if (MMPos = Minimap.Center) and (Minimap.HasDotUnder) then
      Result := Minimap.Center
    else
      Result := [SWNPC[0].X+2, SWNPC[0].Y+2];
  end;
end;

function TScript.GetLootTileMM(MMPos: TPoint): TPoint; // Stolen from Flight, Don't tell him
var
  FragTile: TPointArray;
begin
  FragTile := Minimap.GetDots(EMinimapDot.ITEM);
  if (FragTile.Len() > 0) then
  begin
    FragTile.Sort(MMPos);
    if (MMPos = Minimap.Center) and (Minimap.HasDotUnder) then
      Result := Minimap.Center
    else
      Result := [FragTile[0].X+2, FragTile[0].Y+2];
  end;
end;

function TScript.InitiateChallenge(): Boolean;
var
  attempts : Int32;
  MSRect: TRectangle;
  b: TBox;
begin
  Self.WriteMsg('Waiting for Zeal gainer to be nearby.');

  for attempts := 0 to 10 do
  begin
    Minimap.WaitPlayerMoving(115);
    WaitUntil(Self.PlayerNearby or Minimap.HasDotUnder, 115, 5500);
    Wait(randomRange(2500,3500));

    ReadCommunications();

    if Self.Comms.OnBreak or Self.Comms.OnSleep then begin
      Self.WriteMsg('We appear to be on break or sleeping');
      Exit;
    end;

    if Self.Comms.InArena then
    begin
      Writeln(Self.GetChallengerTileMM(Minimap.Center));

      Self.WriteMsg('Initiating challenge.');
      MSRect := Minimap.PointToMsRect(Self.GetChallengerTileMM(Minimap.Center), 1, 1);
      B := MSRect.Bounds;
      B.LimitTo(Mainscreen.Bounds);

      Mouse.Click(B, MOUSE_RIGHT);

      if ChooseOption.Select('Challenge ' + Bot.dRSN) then
        Result := WaitUntil(GameInterface.IsOpen, 2500, 15000);
    end;

    if Chat.FindMessage('appear to be', [0]) then
    begin
      Self.WriteCommsLoops(3000, False, False, False, False, True, False, Self.WorldInt, 'Something is wrong');
      TerminateScript('One or both accounts are not in a clan chat, make sure both accounts are in their own clan chat');
    end;

    if Chat.FindMessage('is in your', [0]) then
    begin
      Self.WriteCommsLoops(3000, False, False, False, False, True, False, Self.WorldInt, 'Something is wrong');
      TerminateScript('Both accounts must be in their own clan chat, not the same one');
    end;

    if GameInterface.IsOpen then
      Exit;

    if (Self.WaitLoopInt >= 2) then
    begin
      Mouse.Click(Mainscreen.GetPlayerBox, MOUSE_RIGHT);
      ChooseOption.Select('Challenge ' + Bot.dRSN);
    end;

    if (Self.WaitLoopInt >= 3) then
    begin
      Mouse.Click(Mainscreen.GetPlayerBox, MOUSE_RIGHT);
      if not ChooseOption.Select('Challenge ' + Bot.dRSN) then
      begin
        Self.WriteCommsLoops(3000, False, False, False, False, True, False, Self.WorldInt, 'Something is wrong');
        TerminateScript('Waited too long for our other account to communicate, terminating.');
      end;
      WaitUntil(GameInterface.IsOpen, 2500, 15000);
      if GameInterface.IsOpen then
        Exit;
    end;

    if (attempts >= 10) and (Self.WaitLoopInt < 3) then
    begin
      Inc(Self.WaitLoopInt, 1);
      Self.WriteMsg('InitiateChallenge wait loop count is ' + IntToStr(Self.WaitLoopInt));
      Self.CheckWorld();
      Antiban.RandomRotate();
      Exit;
    end;
  end;
end;

function TScript.AcceptCheck(): Boolean;
begin
  if (' wishes to challenge ' in Chat.GetMessage(7, [12926])) then
    Exit(True);
end;

function TScript.AcceptChallenge(): Boolean;
var
  b: TBox := [19,445,321,453];
  attempts : Int32;
begin
  if Chat.GetChat.Contains('No.') then
    Chat.ClickOption('No.', True, [0]);

  for attempts := 0 to 10 do
  begin
    if WaitUntil(Self.AcceptCheck, 115, 12500) then
      Break;

    if not Self.AcceptCheck then
      Self.WriteMsg('Waiting for our alt');

    if (MyPos := Self.RSW.GetMyPos()).InBox([4624,5060,4658,5880]) then
      Self.WriteCommsLoops(3000, False, False, False, False, False, True, Self.WorldInt, 'Something is wrong:');

    if attempts >= 10 then
      TerminateScript('Something is wrong with our alt');
  end;

  Self.WriteMsg('Choosing the challenge in the chat box.');

  Mouse.move(b);

  if WaitUntil(Mainscreen.IsUpText('Acc'), 200, 5000)  then
      Mouse.Click(MOUSE_LEFT);

  Result := WaitUntil(GameInterface.IsOpen, 600, 12000);
end;

function TScript.HandleConfirmation(): Boolean;
var
  T : TBox := [210,226,306,245];
begin
  Self.WriteMsg('Confirming challenge.');

  if GameInterface.IsOpen then
  begin
    Mouse.move(T);
    if WaitUntil(Mainscreen.IsUpText('Confirm'), 200, 5000)  then
      Mouse.Click(MOUSE_LEFT);

    Result := WaitUntil((MyPos := Self.RSW.GetMyPos()).InBox([4289,4799,4339,4873]) or (MyPos := Self.RSW.GetMyPos()).InBox([4805,4715,4859,4784]), 115, 8000);
  end;
end;

procedure TScript.CheckTeamSide();
begin
  Self.WaitLoopInt := 0;
  Self.ReturnLoopInt := 0;
  Self.WriteMsg('Determining our cape color.');
  if (MyPos := Self.RSW.GetMyPos()).InBox([4289,4800,4339,4873]) then
    Self.capeisblue := True;

  if (MyPos := Self.RSW.GetMyPos()).InBox([4834,4744,4858,4784]) then
    Self.capeisred := True;
end;

function TScript.GrabPotions(): Boolean;
begin
  Self.WriteMsg('Grabbing pots');
  if Self.capeisred then
  begin
    if RedPotions.WalkClick(True, 5) then
      WaitUntil(Make.IsOpen(2000, 2500), 415, 5000);

    if Make.IsOpen() then
    begin
      if Role.Contains('Alt') then
      begin
        Make.Select('Potion of power(4)', 5, true);
      end
      else
        Make.Select('Potion of power(4)', 1, true);

      Result := WaitUntil(Inventory.ContainsItem('Potion of power(4)'), 415, 3150);
    end;
  end;

  if Self.capeisblue then
  begin
    if BluePotions.WalkClick(True, 5) then
      WaitUntil(Make.IsOpen(2000, 2500), 415, 5000);

    if Make.IsOpen() then
    begin
      if Role.Contains('Alt') then
      begin
        Make.Select('Potion of power(4)', 5, true);
      end
      else
        Make.Select('Potion of power(4)', 1, true);

      Result := WaitUntil(Inventory.ContainsItem('Potion of power(4)'), 415, 3150);
    end;
  end;

  if Role.Contains('Alt') then
    Inventory.ClickItem('Potion of power(4)');
end;

procedure TScript.HandleGamePortal();
var
  attempts : int32;
begin
  if Role.Contains('ReceivesZeal') then
  begin
    if Self.HighLvlAlt then
      Wait(11000,15000);

    if not Self.HighLvlAlt then
      Wait(21000,25000);
  end;

  Self.WriteMsg('Exiting start area');
  for attempts := 0 to 10 do
  begin
    if Self.capeisred then
    begin
      if RedBarrier.WalkClick(True, 15) then
        WaitUntil((MyPos := Self.RSW.GetMyPos()).InBox([4861,4759,4870,4768]), 250, 8000);

      if (MyPos := Self.RSW.GetMyPos()).InBox([4861,4759,4870,4768]) then
        Exit;
    end;

    if Self.capeisblue then
    begin
      if BlueBarrier.WalkClick(True, 15) then
        WaitUntil((MyPos := Self.RSW.GetMyPos()).InBox([4273,4812,4287,4825]), 250, 8000);

      if (MyPos := Self.RSW.GetMyPos()).InBox([4273,4812,4287,4825]) then
        Exit;
    end;
  end;
end;

procedure TScript.ReceivesZealWalkToSpot();
begin
  if (MyPos := Self.RSW.GetMyPos()).InBox([4434, 4950, 4732, 5182]) then Exit;

  if Self.capeisred and not Self.RSW.AtTile([4534,4792], 16) then
    Self.RSW.WalkBlind([4534,4792]);

  if Self.capeisblue and not Self.RSW.AtTile([4606,4796], 16) then
    Self.RSW.WebWalk([4606,4796]);
end;

procedure Tscript.WalkToSouls();
begin
  Self.WriteMsg('Getting to Souls');
  if HighLvlNPC then
  begin
    Wait(750,1150);
    Self.RSW.WebWalk([4567,4884]);
    Exit;
  end;

  if Self.capeisred then
    Self.RSW.WebWalk([4738,4868]);

  if Self.capeisblue then
    Self.RSW.WebWalk([4412,4729]);
end;

procedure TScript.CaptureZones();
const
  WBox: TBox := [162,35,169,40];
  CBox: TBox := [202,35,209,40];
  EBox: TBox := [242,35,249,40];
begin
  Self.WriteMsg('Capturing zones.');

  if Self.capeisred then
  begin
    if not SRL.FindColors(tpa, CTS2(3423157, 2, 0.37, 2.70), EBox) then
    begin
      if (MyPos := Self.RSW.GetMyPos()).InBox([4434, 4950, 4732, 5182]) then Exit;
      if (MyPos := Self.RSW.GetMyPos()).InBox([4805,4715,4859,4784]) then
      begin
        Self.RSW.WalkBlind([4842,4764]);
        Exit;
      end;

      Self.RSW.WebWalk([4755,4751]);
      WaitUntil(SRL.FindColors(tpa, CTS2(3423157, 2, 0.37, 2.70), EBox) > 0, 115, 25000);

      if Role.Contains('ReceivesZeal') and Self.HighLvlAlt then
      begin
        Wait(8000,11000);
      end
      else
        Wait(14000,19000);
    end;

    if not SRL.FindColors(tpa, CTS2(3423157, 2, 0.37, 2.70), WBox) then
    begin
      if (MyPos := Self.RSW.GetMyPos()).InBox([4434, 4950, 4732, 5182]) then Exit;
      Self.RSW.WebWalk([4397,4833]);
      WaitUntil(SRL.FindColors(tpa, CTS2(3423157, 2, 0.37, 2.70), WBox) > 0, 115, 25000);

      if Role.Contains('ReceivesZeal') and Self.HighLvlAlt then
      begin
        Wait(8000,11000);
      end
      else
        Wait(14000,19000);
    end;

    if not SRL.FindColors(tpa, CTS2(3423157, 2, 0.37, 2.70), CBox) then
    begin
      if (MyPos := Self.RSW.GetMyPos()).InBox([4434, 4950, 4732, 5182]) then Exit;
      Self.RSW.WebWalk([4567,4791]);
      WaitUntil(SRL.FindColors(tpa, CTS2(3423157, 2, 0.37, 2.70), CBox) > 0, 115, 25000);
      Self.WriteCommsLoops(3000, True, False, False, False, False, False, Self.WorldInt, 'Something is wrong, failed to write at end of capping');

      if Role.Contains('ReceivesZeal') and Self.HighLvlAlt then
      begin
        Wait(8000,11000);
      end
      else
        Wait(14000,19000);
    end;
  end;

  if Self.capeisblue then
  begin
    if not SRL.FindColors(tpa, CTS2(11228990, 4, 0.09, 1.18), WBox) then
    begin
      if (MyPos := Self.RSW.GetMyPos()).InBox([4434, 4950, 4732, 5182]) then Exit;
      if (MyPos := Self.RSW.GetMyPos()).InBox([4289,4800,4339,4873]) then
      begin
        Self.RSW.WalkBlind([4842,4764]);
        Exit;
      end;
      Self.RSW.WebWalk([4397,4833]);
      WaitUntil(SRL.FindColors(tpa, CTS2(11228990, 4, 0.09, 1.18), WBox) > 0, 115, 25000);

      if Role.Contains('ReceivesZeal') and Self.HighLvlAlt then
      begin
        Wait(8000,11000);
      end
      else
        Wait(14000,19000);
    end;

    if not SRL.FindColors(tpa, CTS2(11228990, 4, 0.09, 1.18), EBox) then
    begin
      if (MyPos := Self.RSW.GetMyPos()).InBox([4434, 4950, 4732, 5182]) then Exit;
      Self.RSW.WebWalk([4755,4751]);
      WaitUntil(SRL.FindColors(tpa, CTS2(11228990, 4, 0.09, 1.18), EBox) > 0, 115, 25000);

      if Role.Contains('ReceivesZeal') and Self.HighLvlAlt then
      begin
        Wait(8000,11000);
      end
      else
        Wait(14000,19000);
    end;

    if not SRL.FindColors(tpa, CTS2(11228990, 4, 0.09, 1.18), CBox) then
    begin
      if (MyPos := Self.RSW.GetMyPos()).InBox([4434, 4950, 4732, 5182]) then Exit;
      Self.RSW.WebWalk([4567,4791]);
      WaitUntil(SRL.FindColors(tpa, CTS2(11228990, 4, 0.09, 1.18), CBox) > 0, 115, 25000);
      Self.WriteCommsLoops(3000, True, False, False, False, False, False, Self.WorldInt, 'Something is wrong, failed to write at end of capping');

      if Role.Contains('ReceivesZeal') and Self.HighLvlAlt then
      begin
        Wait(8000,11000);
      end
      else
        Wait(14000,19000);
    end;
  end;

  Self.ReceivesZealWalkToSpot();
end;

function TScript.NeedLowerHP(hpLevel: Int32 = -1): Boolean; // Torwent
begin
  if (MyPos := Self.RSW.GetMyPos()).InBox([4434, 4950, 4732, 5182]) then
    Result := True;

  if hpLevel < 2 then
    Exit;

  if hpLevel >= 2 then
    Result := True;
end;

procedure TScript.LowerHealth();  // Torwent
var
  slotOption: String;
  currentHP, newHP: Int32;
begin
  if (MyPos := Self.RSW.GetMyPos()).InBox([4434, 4950, 4732, 5182]) then
    Exit;

  Self.WriteMsg('Lowering health.');
  begin
    if ToStr(Self.damageItem) <> 'Locator orb' then
      slotOption := 'Guzzle';

    currentHP := Minimap.GetHPLevel();

    while Self.NeedLowerHP(currentHP) do
    begin
      Inventory.ClickItem(ToStr(Self.damageItem), slotOption);
      Wait(100);

      if not WaitUntil(currentHP > (newHP := Minimap.GetHPLevel()), 100, 1500) then
        Antiban.SmallRandomMouse();

      currentHP := newHP;

      if not Self.PlayerNearby then Exit;
    end;
  end;
end;

function TScript.ItemDotDetected(): Boolean;
var
Dots: TPointArray := Minimap.GetDots(EMinimapDot.ITEM);
begin
  FilterPointsDist(Dots, 0, 35, Minimap.Center.X, Minimap.Center.Y);
  Exit(Length(Dots) >= 1);
end;

function TScript.GroundFrags: Boolean;
begin
  Exit(SRL.FindColors(tpa, fragmentCol, Mainscreen.GetPlayerBox().Expand(50, 50)) > 0);
end;

procedure TScript.UsePotions();
var
  slot: Int32;
  slotOption: String;
begin
  Self.WriteMsg('Restoring prayer.');

  Inventory.finditem('Potion of power(1..4)', slot);

  if Inventory.ClickSlot(slot, slotOption) then
    WaitUntil((Minimap.GetPrayerLevel >= 25), 215, 7000);
end;

function TScript.SortForgottenSouls(): TPointArray;
Var
  TPA     :TPointArray;
  ATPA    :T2DPointArray;
  Finder  :TObjectFinder;
begin
  Finder.Colors += fsoulCol;
  Finder.Grow := 4;
  Finder.ClusterDistance := 4;

  ATPA := MainScreen.FindObject(Finder);

  if ATPA.Len < 1 then
  begin
    Antiban.RandomRotate();
    Self.WalkToSouls();
    Exit;
  end;

  for TPA in ATPA do
    Result += TPA.Mean();

  with Mainscreen.GetPlayerBox() do
  begin
    Result.Sort([Middle.X, Y2])
  end;
end;

procedure TScript.AttackForgottenSoul();
var
  i: Int32;
  fsouls: TPointArray;
  CombatTimeout: TCountdown;
begin
  Self.WriteMsg('Attempting to fight targets for fragments.');

  if (Stats.GetLevel(ESkill.Prayer) >= 43) then
    Minimap.EnablePrayer();

  XPBar.EarnedXP(); // Reset stored XP cache

  fsouls := Self.sortForgottenSouls();

  if Length(fsouls) < 1 then
  begin
    Self.WriteMsg('Did not find a target, trying again.');
    Exit;
  end;

  Mouse.Click(fsouls[i], MOUSE_LEFT);

  CombatTimeout.Init(7000);

  while not CombatTimeout.IsFinished and not Self.ItemDotDetected do
  begin
    if XPBar.EarnedXP then
      CombatTimeout.Restart;

    if Mainscreen.FindHitsplats(MainScreen.GetPlayerBox) then
      CombatTimeout.Restart;
  end;
end;

function TScript.CollectFragments(): Boolean;
var
  MSRect: TRectangle;
begin
  Self.WriteMsg('Looting fragments.');
  Self.fragmentCount := Inventory.CountItemStack('Soul fragment');

  MSRect := Minimap.PointToMsRect(Self.GetLootTileMM(Minimap.Center), 0, 0);
  MSRect := msRect.Expand(-4);
  Mouse.Click(MSRect.Mean, MOUSE_RIGHT);

  if not ChooseOption.Select('Take ') then
  begin
    Antiban.RandomRotate();
    Exit;
  end;

  Result := WaitUntil((Inventory.CountItemStack('Soul fragment') > Self.fragmentCount), 515, 5000);
  Self.fragmentCount := Inventory.CountItemStack('Soul fragment');
end;

procedure TScript.KillAlt();
var
  MSRect: TRectangle;
  b: TBox;
begin
  WaitUntil(Self.PlayerNearby, 115, 30000);

  Inventory.ClickItem('Potion of power(4)');

  Self.WriteMsg('Killing Alt for fragments.');
  MSRect := Minimap.PointToMsRect(Self.GetChallengerTileMM(Minimap.Center), 1, 1);
  B := MSRect.Bounds;
  B.LimitTo(Mainscreen.Bounds);

  Mouse.Click(B, MOUSE_RIGHT);

  if ChooseOption.Select('Attack ') then
    WaitUntil(not Self.PlayerNearby, 115, 25000);
end;

function TScript.TurnInFrags(): Boolean;
begin
  Self.WriteMsg('Turning in our looted fragments.');

  if Inventory.CountItemStack('Soul fragment') > 30 then
  begin
    if Obelisk.WalkClick(True, 10) then
    WaitUntil(not (Inventory.CountItemStack('Soul fragment') > 30), 115, 5000);
  end
  else
  begin
    if Obelisk.WalkClick(True, 10) then
      WaitUntil(not (Inventory.ContainsItem('Soul fragment') or Chat.FindMessage('need to do that', [0])), 115, 5000);
  end;

  Self.WriteCommsLoops(3000, True, False, False, True, False, False, Self.WorldInt, 'Something went wrong with writing at frag turn in');
  Result := WaitUntil((MyPos := Self.RSW.GetMyPos()).InBox([4434, 4950, 4732, 5182]), 115, 30000);

  if Result then
  begin
    Self.GetZealAmount();
    Self.ResetGameLogic();
  end;
end;

procedure TScript.AltExit();
var
  attempts : int32;
begin
  Self.WriteMsg('Exiting the game to force it to end.');
  for attempts := 0 to 10 do
  begin
    if Self.capeisred then
    begin
      if RedPortal.WalkClick(True, 5) then
        WaitUntil(Chat.GetChat.Contains('Yes.'), 250, 5000);

      if Chat.ClickOption('Yes.', True, [0]) then
        WaitUntil((MyPos := Self.RSW.GetMyPos()).InBox([4434,4950,4732,5182]), 250, 15000);
    end;

    if Self.capeisblue then
    begin
      if BluePortal.WalkClick(True, 5) then
      WaitUntil(Chat.GetChat.Contains('Yes.'), 250, 5000);

      if Chat.ClickOption('Yes.', True, [0]) then
        WaitUntil((MyPos := Self.RSW.GetMyPos()).InBox([4434,4950,4732,5182]), 250, 15000);
    end;

    if (MyPos := Self.RSW.GetMyPos()).InBox([4434,4950,4732,5182]) then
      Break;
  end;

  Self.ResetGameLogic();
end;

function TScript.AltEndGame(): Boolean;
begin
  Self.WriteMsg('Time to end the game.');
  Self.FinishGame := True;
  Minimap.DisablePrayer();

  if Self.capeisred and not Self.RSW.AtTile([4610,4796], 16) then
    Self.RSW.WebWalk([4610,4796]);

  if Self.capeisblue and not Self.RSW.AtTile([4528,4791], 16) then
    Self.RSW.WebWalk([4528,4791]);

  Self.LowerHealth();
  Result := WaitUntil(not Self.PlayerNearby, 115, 35000);
end;

function TScript.ChatSafetyNet(): Boolean;
begin
  Exit(' is busy.' in Chat.GetMessage(5, [0]));
end;

procedure TScript.EndScript();
begin
  Self.WriteCommsLoops(3000, False, False, False, False, True, False, Self.WorldInt, 'Something is wrong, failed to write at end of script');
  Logout.ClickLogout();
  TerminateScript('Time to shutdown');
end;

procedure TScript.DoAntiban();
var
  attempts : Int32;
  AntibanTime : Int64;
begin
  if Role.Contains('Alt') then
    Exit;

  AntibanTime := Self.TrueRunTime.ElapsedTime();

  Self.TrueRunTime.Pause();

  if Self.TakeBreaks and ((Round(Antiban.Breaks[0].NextAtTime - AntibanTime)) <= 0) then
    Self.WriteCommsLoops(3000, False, True, False, False, False, False, Self.WorldInt, 'Something is wrong, failed to write at start of antiban');

  if Self.TakeSleeps and ((Round(Antiban.Sleeps[0].NextAtTime - AntibanTime)) <= 0) then
    Self.WriteCommsLoops(3000, False, False, True, False, False, False, Self.WorldInt, 'Something is wrong, failed to write at start of antiban');

  Antiban.DoAntiban();

  if (not GameClient.IsLoggedIn) then
    Login.LoginPlayer(False);

  if Self.DoFarmRuns and FarmRunner.ReadyTimer.IsFinished() and MinigameTPTimer.IsFinished() then
  begin
    Self.WriteCommsLoops(3000, False, True, False, False, False, False, Self.WorldInt, 'Something is wrong, failed to write at start of antiban');

    if Self.InsideStartZone then
    begin
      for attempts := 0 to 3 do
      begin
        if PBoostPortal.WalkClick(True, 5) then
          WaitUntil(Chat.GetChat.Contains('Yes.'), 115, 10000);

        Chat.ClickOption('Yes.');

        WaitUntil(not (MyPos := Self.RSW.GetMyPos()).InBox([4624,5060,4658,5880]), 115, 10000);
        if not (MyPos := Self.RSW.GetMyPos()).InBox([4624,5060,4658,5880]) then
        begin
          Self.WriteMsg('Outside starting zone');
          Break;
        end;
      end;
    end;

    FarmRunner.DoFarmRun;
    MinigameTPTimer.Init(ONE_MINUTE*21);
  end;

  if Self.DoBHRuns and BirdHouseRunner.ScriptIntervalTimer.IsFinished() and MinigameTPTimer.IsFinished() then
  begin
    Self.WriteCommsLoops(3000, False, True, False, False, False, False, Self.WorldInt, 'Something is wrong, failed to write at start of antiban');

    if Self.InsideStartZone then
    begin
      for attempts := 0 to 3 do
      begin
        if PBoostPortal.WalkClick(True, 5) then
          WaitUntil(Chat.GetChat.Contains('Yes.'), 115, 10000);

        Chat.ClickOption('Yes.');

        WaitUntil(not (MyPos := Self.RSW.GetMyPos()).InBox([4624,5060,4658,5880]), 115, 10000);
        if not (MyPos := Self.RSW.GetMyPos()).InBox([4624,5060,4658,5880]) then
        begin
          Self.WriteMsg('Outside starting zone');
          Break;
        end;
      end;
    end;

    BirdHouseRunner.DoBirdHouseRun();
    MinigameTPTimer.Init(ONE_MINUTE*21);
  end;

  Self.CheckWorld();

  Self.TrueRunTime.Resume();
  ABGameCount := 0;

  if (not ChatButtons.IsActive(EChatButton.ALL_CHAT)) then
    Chatbuttons.Open(EChatButton.ALL_CHAT);

  Self.WriteCommsLoops(3000, False, False, False, False, False, False, Self.WorldInt, 'Something is wrong, failed to write at start of antiban');
end;

procedure TScript.Report();
var
  RunTime: Int64;
begin
  Self.CurrCalc := Round(Self.ZealGains - Self.PrevCalc);

  Self.ProfitCalc := Round((Self.CurrCalc) * 2666);

  RunTime  := Self.TrueRunTime.ElapsedTime();

  WriteLn('|=============================|');
  WriteLn('|------- ~ Soul Wars ~ -------|');
  WriteLn('|=============================|');
  WriteLn(padR('| Runtime: ' + SRL.MsToTime(RunTime, Time_Short), 30, ' ') + '|');
  WriteLn(padR('| Games played: ' + IntToStr(GameCount), 30, ' ') + '|');
  WriteLn(padR('| Games/Hr: ' + IntToStr(Round(GameCount / (RunTime / 3600000))), 30, ' ') + '|');
  if Role.Contains('Zeal') then
  begin
    WriteLn(padR('| Zeal: ' + FloatToStr(Self.ZealGains), 30, ' ') + '|');
    WriteLn(padR('| Zeal/Hr: ' + FloatToStr(Round(Self.ZealGains / (RunTime / 3600000))), 30, ' ') + '|');
  end;
  if Self.TakeBreaks then
    WriteLn(padR('| Next break: ' + SRL.MsToTime(Max(0, Round(Antiban.Breaks[0].NextAtTime - RunTime)), Time_Short), 30, ' ') + '|');
  if Self.TakeSleeps then
    WriteLn(padR('| Next sleep: ' + SRL.MsToTime(Max(0, Round(Antiban.Sleeps[0].NextAtTime - RunTime)), Time_Short), 30, ' ') + '|');
  if Self.DoBHRuns then
    WriteLn(padR('| Next BH run: ' + SRL.MsToTime(BirdHouseRunner.ScriptIntervalTimer.TimeRemaining(), TTimeFormat.Time_Short), 30, ' ') + '|');
  if Self.DoFarmRuns then
    WriteLn(padR('| Next farm run: ' + SRL.MsToTime(FarmRunner.ReadyTimer.TimeRemaining(), TTimeFormat.Time_Short), 30, ' ') + '|');
  WriteLn(padR('| Shutdown: ' + ToStr(SRL.MsToTime(Self.ShutdownTime - GetTimeRunning, Time_Short)), 30, ' ') + '|');
  WriteLn('|=============================|');
  WriteLn('|=-=-=-=-= ~ Elixer ~ =-=-=-=-|');
  WriteLn('|=============================|');

  Self.PrevCalc := Round(Self.ZealGains);
end;

procedure TScript.Init();
var
  z: Int32;
begin
  if (not GameClient.IsLoggedIn()) then
    Login.LoginPlayer(False);

  Mouse.Speed                   := SRL.NormalRange(18, 24);
  Mouse.MissChance              := 3;
  Mouse.Distribution            := MOUSE_DISTRIBUTION_GAUSS;
  Self.SetupAntiban();
  Self.RSW.OnWalkingEvent       := @OnWalkEventSW;
  Self.RSW.AdaptiveWalk         := True;
  Self.RSW.EnableRunAtEnergy    := 25;
  Self.capeisred                := False;
  Self.capeisblue               := False;
  Self.FinishGame               := False;
  Self.ABGameCount              := 0;
  Self.WaitLoopInt              := 0;
  Self.ReturnLoopInt            := 0;
  Self.PrevCalc                 := 0;

  ReportTimer.Init(ONE_MINUTE*3);
  MinigameTPTimer.Init(ONE_MINUTE*21);

  RunTimeout.Init(2000);
  TrueRunTime.Start();

  XPBar.Read;

  Self.CheckWorld();

  Stats.Setup();
  Stats.GetLevel(ESkill.AGILITY);
  Stats.GetLevel(ESkill.PRAYER);

  Self.ClearChat();

  if (GameClient.Mode <> EClientMode.FIXED) then
    TerminateScript("Client must be in fixed-classic");

  if Self.DoBHRuns and Role.Contains('ReceivesZeal') then
    BirdhouseRunner.Init();

  Self.RSW.Setup('world');
  Self.RSW.WebGraph.LoadNodesFromString('');
  Self.RSW.WebGraph.LoadPathsFromString('');

  MyPos := Self.RSW.GetMyPos();

  z := Options.GetZoomLevel();
  if (not InRange(z, 20, 25)) then
    Options.SetZoomLevel(SRL.TruncatedGauss(20,25))
  else
    MM2MS.ZoomLevel := z;

  if Role.Contains('ReceivesZeal') then
    Options.SetPlayerAttackOption(EAttackOption.ALWAYS_LEFT_CLICK);

  if Role.Contains('Alt') then
  begin
    Options.SetPlayerAttackOption(EAttackOption.HIDDEN);
    Options.SetNPCAttackOption(EAttackOption.ALWAYS_LEFT_CLICK);
    Combat.SetAutoRetaliate(False);
    Self.setupDamageItem();
    Self.QuickPrayerSelector();
  end;

  if (not ChatButtons.IsActive(EChatButton.ALL_CHAT)) then
    Chatbuttons.Open(EChatButton.ALL_CHAT);

  Stats.Setup();
  Stats.GetLevel(ESkill.HITPOINTS);
  Stats.GetLevel(ESkill.PRAYER);

  SWBank.Setup(4, [[4594,5000]]);
  SWBank.SetupUpText(['Use ']);
  SWBank.Finder.Colors += CTS2(9540253, 23, 0.07, 0.11);

  PBoostPortal.Setup(4, [[4624,5072]]);
  PBoostPortal.SetupUpText(['Pass ']);
  PBoostPortal.Finder.Colors += CTS2(12205762, 18, 0.13, 1.56);

  BluePotions.Setup(4, [[4290,4834], [4290,4832], [4290,4836]]);
  BluePotions.SetupUpText(['Take-from ']);
  BluePotions.Finder.Colors += CTS2(4084572, 20, 0.07, 0.19);

  BlueBandages.Setup(4, [[4290,4806]]);
  BlueBandages.SetupUpText(['Take-from ']);
  BlueBandages.Finder.Colors += CTS2(4084572, 20, 0.07, 0.19);

  BlueBarrier.Setup(4, [[4288,4820]]);
  BlueBarrier.SetupUpText(['Pass ']);
  BlueBarrier.Finder.Colors += CTS2(12095613, 12, 0.36, 1.37);

  BluePortal.Setup(4, [[4321,4819], [4321,4821]]);
  BluePortal.SetupUpText(['Leave ']);
  BluePortal.Finder.Colors += CTS2(7167550, 13, 0.51, 1.22);

  RedBarrier.Setup(4, [[4861,4764]]);
  RedBarrier.SetupUpText(['Pass ']);
  RedBarrier.Finder.Colors += CTS2(5989578, 13, 0.05, 1.90);

  RedPotions.Setup(4, [[4860,4750], [4860,4752], [4860,4748]]);
  RedPotions.SetupUpText(['Take-from ']);
  RedPotions.Finder.Colors += CTS2(4084572, 20, 0.07, 0.19); //CTS2(9084217, 13, 0.09, 2.35);

  RedBandages.Setup(4, [[4858,4778]]);
  RedBandages.SetupUpText(['Take-from ']);
  RedBandages.Finder.Colors += CTS2(4084572, 20, 0.07, 0.19);

  RedPortal.Setup(4, [[4827,4763], [4827,4765], [4827,4767]]);
  RedPortal.SetupUpText(['Leave ']);
  RedPortal.Finder.Colors += CTS2(2896478, 10, 0.19, 0.77);

  Obelisk.Setup(4, [[4572,4792], [4572,4794], [4572,4796]]);
  Obelisk.SetupUpText(['Sacrifice-fragments ']);
  Obelisk.Finder.Colors += CTS2(6390414, 11, 0.02, 0.32);

  fsoulCol := CTS2(9082749, 8, 0.40, 0.29);
  fragmentCol := CTS2(11381167, 7, 2.43, 0.16); //CTS2(11315370, 6, 7.33, 0.33);
  redcapeCol := CTS2(1843274, 10, 0.17, 0.70);
  bluecapeCol := CTS2(4994332, 10, 0.11, 0.67);

  if Self.DoFarmRuns and Role.Contains('ReceivesZeal') then
    FarmRunner.Init();

  if FarmRunner.StartWithRun and Role.Contains('ReceivesZeal') and Self.DoFarmRuns then
  begin
    FarmRunner.ReadyTimer.Init(0);
    MinigameTPTimer.Init(0);
  end;

  if (BHIncludeGUIRunIntervalMinutes = 0) and Role.Contains('ReceivesZeal') then
    MinigameTPTimer.Init(0);

  if (FarmRunner.StartWithRun and Self.DoFarmRuns) or ((BHIncludeGUIRunIntervalMinutes = 0) and Self.DoBHRuns) and Role.Contains('ReceivesZeal') then
    Self.DoAntiban();

  if Length(Login.GetPlayer().Worlds) > 10 then
    WorldList := Login.GetPlayer().Worlds;
end;

function TScript.GetState(): EState;
var
  MyPos: TPoint;
begin
  MyPos := Self.RSW.GetMyPos();

  if (ABGameCount = Random(4,7)) and (MyPos := Self.RSW.GetMyPos()).InBox([4434,4950,4732,5182]) and Role.Contains('ReceivesZeal') then
    Exit(EState.DO_ANTIBAN);

  if Self.ChatSafetyNet then
    Exit(EState.TIME_TO_SHUTDOWN);

  if Self.Comms.Terminated then
    Exit(EState.TIME_TO_SHUTDOWN);

  if Role.Contains('Alt') then
  begin
    if Self.Comms.OnBreak or Self.Comms.OnSleep then
      Exit(EState.WAIT_FOR_RETURN);

    if (Self.WorldInt <> Self.Comms.CurrWorld) and (Self.Comms.CurrWorld <> 0) then
      Exit(EState.HOP_TO);
  end;

  if (MyPos := Self.RSW.GetMyPos()).InBox([4289,4799,4339,4873]) or (MyPos := Self.RSW.GetMyPos()).InBox([4834,4744,4858,4784]) then
  begin
    if Self.FinishGame and not Self.Comms.TurnedIn then
      Exit(EState.WAIT_SHORT);

    if Self.FinishGame and Self.Comms.TurnedIn then
      Exit(EState.EXIT_GAME);

    if (not Self.capeisred) and (not Self.capeisblue) then
      Exit(EState.DETERMINE_CAPE);

    if (not Inventory.ContainsItem('Potion of power(1..4)')) then
      Exit(EState.GRAB_POTIONS);

    if not Self.FinishGame then
      Exit(EState.LEAVE_SPAWN);
  end;

  if (MyPos := Self.RSW.GetMyPos()).InBox([4861,4759,4870,4768]) or (MyPos := Self.RSW.GetMyPos()).InBox([4273,4812,4287,4825]) then
  begin
    if Role.Contains('Alt') then
      Exit(EState.GO_TO_SOULS);

    Exit(EState.ZONECAPTURE_BOOST);
  end;

  if Inventory.ContainsItem('Potion of power(1..4)') and Role.Contains('Alt') then
  begin
    if Self.ItemDotDetected then
      Exit(EState.LOOT_FRAGS);

    if (Self.Comms.IsCappingPoint) then
      Exit(EState.DIE_IN_CENTER_BOOST);

    if (Minimap.GetPrayerLevel() <= (random(22,30))) then
      Exit(EState.RESTORE_PRAYER);

    Exit(EState.KILL_SOULS);
  end;

  if (MyPos := Self.RSW.GetMyPos()).InBox([4462, 4739, 4685, 4849]) and Role.Contains('ReceivesZeal') then
  begin
  if Inventory.ContainsItem('Soul fragment') then
    Exit(EState.TURN_IN_FRAGS_BOOST);

    if Self.ItemDotDetected then
      Exit(EState.LOOT_FRAGS);

    Exit(EState.KILL_FRAGS_BOOST);
  end;

  if (MyPos := Self.RSW.GetMyPos()).InBox([4434, 4950, 4732, 5182]) then
  begin
    if (Self.InsideStartZone) then
    begin
      if GameInterface.IsOpen then
        Exit(EState.HANDLE_CONFIRM);

      if Role.Contains('Alt') then
        Exit(EState.INITIATE_CHALLENGE);

      if Role.Contains('ReceivesZeal') then
        Exit(Estate.ACCEPT_CHALLENGE);
    end;

    Exit(Estate.START_AREA);
  end;
end;

function LoginIfNot(): Boolean;
begin
  if not GameClient.IsLoggedIn() and not Bot.Comms.OnBreak then
  begin
    if not Login.LoginPlayer(False) then
    begin
      TerminateScript("Could not log in player");
    end
    else
      Result := True;
  end;
end;

procedure TScript.Run();
begin
  while true do begin
    if RunTimeout.IsFinished then
    begin
      ReadCommunications();
      RunTimeout.Restart();
    end;

    if (Self.ShutdownTime > 0) and (GetTimeRunning() > Self.ShutdownTime) then
      Self.EndScript();

    if (Self.GameLimit > 0) and (Self.GameCount >= Self.GameLimit) then
      Self.EndScript();

    if ChatButtons.GetState(EChatButton.GAME_CHAT) <> EChatButtonState.ENABLED then
      ChatButtons.ChangeState(EChatButton.GAME_CHAT, EChatButtonState.ENABLED);

    LoginIfNot();
    Self.State := Self.GetState();
    case Self.State of
      EState.START_AREA: begin GameInterface.Close; Self.handleStartZoneEntrance(); end;
      EState.INITIATE_CHALLENGE: Self.InitiateChallenge();
      EState.ACCEPT_CHALLENGE: Self.AcceptChallenge();
      EState.HANDLE_CONFIRM: Self.HandleConfirmation();
      EState.EXIT_GAME: Self.AltExit();
      EState.WAIT_SHORT: Wait(1115,1885);
      EState.DETERMINE_CAPE: Self.CheckTeamSide();
      EState.GRAB_POTIONS: Self.GrabPotions();
      EState.LEAVE_SPAWN: Self.HandleGamePortal();
      EState.ZONECAPTURE_BOOST: Self.CaptureZones();
      EState.GO_TO_SOULS: Self.WalkToSouls();
      EState.RESTORE_PRAYER: Self.UsePotions();
      EState.KILL_SOULS: Self.AttackForgottenSoul();
      EState.LOOT_FRAGS: Self.CollectFragments;
      EState.DIE_IN_CENTER_BOOST: Self.AltEndGame();
      EState.KILL_FRAGS_BOOST: Self.KillAlt();
      Estate.TURN_IN_FRAGS_BOOST: Self.TurnInFrags();
      EState.TIME_TO_SHUTDOWN: Self.EndScript();
      EState.WAIT_FOR_RETURN: Self.WaitForReturn;
      EState.DO_ANTIBAN: Self.DoAntiban();
      EState.HOP_TO: begin WorldHopper.Hop([Self.Comms.CurrWorld]); Self.WorldInt := Self.Comms.CurrWorld; end;
    end;
  end;
end;

begin
  //WaspClient.CheckSubscription(True);
  SettingsHandler.CheckGPUPlugin();

  if (not DirectoryExists(AppPath+'\Resources\')) then
    CreateDirectory(AppPath+'\Resources');

  if (not FileExists(AppPath+'\Resources\SSWGUI.png')) then
    DownloadToFile('https://raw.githubusercontent.com/TwistedSlayerHelm/Images/refs/heads/main/gui/SSWGUI.png', AppPath+'\Resources\SSWGUI.png');

  if not FileExists(AppPath+'\Data\soul_wars.dat') then
    CloseFile(CreateFile(AppPath+'\Data\soul_wars.dat'));

  if FileExists(AppPath+'\Includes\Farm') then
    DeleteFile(AppPath+'\Includes\Farm');

  if FileExists(AppPath+'\Configs/StudentsSettings') then
    SWConfig.Init();

  GUI.Setup('Soul Wars', [750,466]);
  GUI.PageControl.SetAllChildsFontColor($800080);
  GUI.Run;

  {$IFNDEF SRL_DISABLE_REMOTEINPUT}
  if WLSettings.GetObject('remote_input').getBoolean('enabled', True) and (not GameClient.RemoteInput.IsSetup()) then GameClient.RemoteInput.Setup();
  {$ENDIF}

  SWConfig.Write();

  Bot.Init();
  Bot.Run();
end.

