    SetLeft(TControl.AdjustToDPI(562));
    SetTop(TControl.AdjustToDPI(230));
    SetName('box_bl');
    SetCaption('Min Shop Stock');
    SetToolTip('Buy until how many remain');
    SetText('100');
    SetFontColor($000000);
    end;

   with box_TL do
   begin
    Create(Result);
