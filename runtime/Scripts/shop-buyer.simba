procedure TScriptForm.Setup(caption: String = 'Script Form'; size: TPoint = [750, 500]; allowResize: Boolean = False); override;
var
  Img: TPicture;
  BGImg: TImage;
  SButton: TButton;
begin
  inherited;

  Img.init();

  try
    Img.LoadFromFile('Resources\SSB2GUI.png')
  except
    writeln('Could not load the gui image')
  finally
  end;

  with BGImg do
  begin
    Init(Self.PageControl);
    SetParent(Self.PageControl);
    SetBounds(0,0,Self.Form.getWidth,Self.Form.getHeight);
    SetPicture(Img);
  end;

  Self.Start.setVisible(False);
  with SButton do
  begin
    Create(Self.Form);
    SetBounds(Self.Form.GetRight-190, Self.Form.GetBottom-70, 180, 60);
    GetFont.SetName('Bahnschrift');
    GetFont.SetSize(15);
    SetCaption('Run');
    SetOnClick(@Self.StartScript);
  end;

  Self.AddTab(CreateSettingsTab());
  Self.CreateAccountManager();
end;

// Undo the bogged down version in WaspLib
function TChooseOption.Select(Text: TStringArray; MouseAction: Int32 = MOUSE_LEFT; CaseSensitive: Boolean = True; CloseIfNotFound: Boolean = True): Boolean; override;
var
  Choices: TChooseOption_OptionArray;
  I, J: Int32;
begin
  if Self.Open() then
  begin
    Wait(0, 750, wdLeft);

    Choices := GetOptions();

    for I := 0 to High(Choices) do
      for J := 0 to High(Text) do
        if (CaseSensitive and (Text[J] in Choices[I].Text)) or ((not CaseSensitive) and (Lowercase(Text[J]) in Lowercase(Choices[I].Text))) then
        begin
          Self.Select(Choices[I], MouseAction);
          Exit(True);
        end;

    if CloseIfNotFound then
    begin
      WaitEx(400, 150);

      Self.Close();
    end;
  end;
end;

function TMMDot._HoverHelper(attempts: Int32; trackTarget: Boolean): Boolean; override; //shutoff the camera swivel
var
  shouldExit: Boolean;
  attempt: Int32;
  atpa: T2DPointArray;
  tpa: TPointArray;
begin
  if Self.Filter.MinimapDot and (Minimap.GetDots(Self.DotType) = []) then
    Exit;

  Result := Self._UpTextCheck(shouldExit);
  if shouldExit then
    Exit;

  for attempt := 0 to attempts do
  begin
    if Self.Find(atpa) then
    begin
      if attempt < 2 then
        tpa := atpa[0]
      else if Length(atpa) > (attempt - 2) then
        tpa := atpa[attempt - 2]
      else
        tpa := atpa.RandomValue();

      if trackTarget then
        Mouse.OnMovingEx := @Self._UpdateTarget;

      if Self.DotType = EMinimapDot.ITEM then
        Mouse.Move(tpa.Mean())
      else
        Mouse.Move(tpa.RandomValue());

      if not Self.Filter.UpText then
        Exit(True);
    end;

    if MainScreen.IsUpText(Self.UpText) then
      Exit(True);
  end;
end;

function TGameObject._HoverHelper(attempts: Int32; trackTarget: Boolean): Boolean; override; // remove the camera rotation
var
  shouldExit: Boolean;
  attempt: Int32;
  atpa: T2DPointArray;
  tpa: TPointArray;
begin
  Result := Self._UpTextCheck(shouldExit);
  if shouldExit then
    Exit;

  for attempt := 0 to attempts do
  begin
    if Self.Find(atpa) then
    begin
      if attempt < 2 then
        tpa := atpa[0] // 0 for the closest one.
      else if Length(atpa) > (attempt - 2) then
        tpa := atpa[attempt - 2]
      else
        tpa := atpa[Random(0, High(atpa))];

      if trackTarget then
        Mouse.OnMovingEx := @Self._UpdateTarget;
      Mouse.Move(tpa[Random(0, High(tpa))]);

      if not Self.Filter.UpText then
        Exit(True);
    end;

    if MainScreen.IsUpText(Self.UpText) then
      Exit(True);
  end;
end;

procedure TScript.DoLoseFocus();
Var T: Int32;
begin
  T := SRL.NormalRange(1700,8000);
  Antiban.DebugLn('Losing focus for '+SRL.MsToTime(T, Time_Short));
  Antiban.LoseFocus(T);
end;

procedure TScript.DoAntiban();
begin
  Self.InactivityTimer.Pause();
  if GetTimeRunning() > Self.ShutdownTime then
    TerminateScript('Time to shutdown');
  Antiban.DoAntiban();
  Self.ShopCycles := 0;
  Self.InactivityTimer.Resume();
end;

procedure TScript.SetupAntiban();
begin
  Antiban.AddTask((ONE_MINUTE*1)*Self.ABTimeMod,  @Mouse.RandomMovement);
  Antiban.AddTask((ONE_MINUTE*4)*Self.ABTimeMod,  @Self.DoLoseFocus);
end;

function TScript.LowEnergy(): Boolean;
begin
  Result := not Minimap.HasStamina and (Minimap.GetRunEnergy < Antiban.GetUniqueDouble(35, 30, 40));
end;


procedure TScript.Report();
begin
  ProfitCalc := (ItemData.GetAverage(Self.ShopFor) * Self.BuyCount);

  WriteLn('|==============================|');
  WriteLn('|------- ~ Shop Buyer ~ -------|');
  WriteLn('|==============================|');
  WriteLn(padR('| Runtime: ' + SRL.MsToTime(GetTimeRunning, Time_Short), 31, ' ') + '|');
  WriteLn(padR('| Currently buying: ' + Self.ShopFor, 31, ' ') + '|');
  WriteLn(padR('| Bought: ' + IntToStr(BuyCount), 31, ' ') + '|');
  WriteLn(padR('| Bought/Hr: ' + IntToStr(Round(BuyCount / (GetTimeRunning() / 3600000))), 31, ' ') + '|');
  if Self.TakeBreaks then
    WriteLn(padR('| Next break: ' + SRL.MsToTime(Max(0, Round(Antiban.Breaks[0].NextAtTime - GetTimeRunning)), Time_Short), 31, ' ') + '|');
  if Self.TakeSleeps then
    WriteLn(padR('| Next sleep: ' + SRL.MsToTime(Max(0, Round(Antiban.Sleeps[0].NextAtTime - GetTimeRunning)), Time_Short), 31, ' ') + '|');
  WriteLn(padR('| Shutdown: ' + ToStr(SRL.MsToTime(Self.ShutdownTime - GetTimeRunning, Time_Short)), 31, ' ') + '|');
  WriteLn('|==============================|');
  WriteLn('|==============================|');
end;

procedure TMinimap.RotateWithinAngles(min, max: Int32);
var
  minMaxAvg: Int32 := Floor((min + max) div 2);
  preferredAngle: Int32 := SRL.SkewedRand(minMaxAvg, min, max);
begin
  if preferredAngle < 0 then
    preferredAngle := preferredAngle + 360;

  if InRange(self.getCompassAngle(True), min, max) then
    Exit;

  Minimap.SetCompassAngle(preferredAngle);
end;

function TScript.IsDoorOpenOC(Door, Anchor: TPointArray; Split: Double; Inverse: Boolean = False; UseMean: Boolean = False): EDoorState;
var
  p,q: Vector3;
  ptAnchor,ptDoor: TPoint;
begin
  // ensure no failure
  if (length(Anchor) = 0) or (length(Door) = 0) then Exit(dsUndefined);

  // find the point in the ledger that's closest to the door and vice versa
  // alternatively we could just use the mean and skip this step in many cases.
  if not UseMean then begin
    anchor.Sort(door.Mean());
    ptAnchor := anchor[0];
    door.Sort(ptAnchor);
    ptDoor := door[0];
  end else begin
    ptAnchor := anchor.Mean();
    ptDoor   := door.Mean();
  end;

  // convert to minimap to work in 2d space, so distance is always the same no matter position,
  // camera angle and zoom.
  p := MainScreen.PointToMM(ptDoor);
  q := MainScreen.PointToMM(ptAnchor);

  if (p.Distance(q) <= Split) xor inverse then
    Exit(dsOpen)
  else
    Exit(dsClosed);
end;

procedure TScript.FindDoorAndAnchor(WorldPos: TPoint; out Door, Anchor: TPointArray);
var
  ledger: TPointArray;
  ATPA: T2DPointArray;
  LeadgerSearchBox, DoorSearchBox: TBox;
begin
  // rough area of where the ledger and door is
  LeadgerSearchBox := RSW.GetTileMSEx(WorldPos, [8190,2716]).Expand(5).Bounds();
  DoorSearchBox    := RSW.GetTileMSEx(WorldPos, [8206,2718]).Expand(5).Bounds();

  DoorSearchBox.LimitTo(MainScreen.Bounds);
  LeadgerSearchBox.LimitTo(MainScreen.Bounds);

  // find the ledger, and the door tpas
  srl.FindColors(ledger, CTS2(2713656, 1, 2.85, 3.70),  LeadgerSearchBox);
  srl.FindColors(door,   CTS2(4811381, 3, 0.18, 0.16),  DoorSearchBox);

  // basic noise filtering
  ATPA := door.Erode(1).Grow(2).Cluster(2);
  door := ATPA.Biggest();

  // basic noise filtering, small object, so I dont erode noise.
  ATPA := ledger.Cluster(2);
  ledger := ATPA.Biggest();

  Anchor := Ledger;
end;

function TScript.HandleEntrance(): Boolean;
var
  Door,Anchor: TPointArray;
  attempts:int32;
begin
  Minimap.RotateWithinAngles(57, 113);

  Self.FindDoorAndAnchor(RSW.GetMyPos(), Door, Anchor);

  case Self.IsDoorOpenOC(Door, Anchor, 14.8, False, False) of
  dsOpen: ;

  dsClosed, dsUndefined:
  for attempts := 0 to 8 do
  begin
    ZaffDoor.Hover(10, False);

    if Mainscreen.IsUpText('pen Doo') then
    begin
      ZaffDoor.Click(True, 10);
      Wait(1450,1650);
      Minimap.WaitPlayerMoving(500,8000);
    end;

    if not Self.RSW.AtTile([8200,2720], 6) then
      Self.RSW.WalkBlind([8200,2720]);

    if Self.RSW.AtTile([8200,2720], 6) then
      Break;
  end;
  end;

  if not Self.RSW.AtTile([8200,2720], 6) then
    Self.RSW.WalkBlind([8200,2720]);

  Result := WaitUntil(Self.RSW.AtTile([8200,2720], 6), 115, 5000);

  if (Minimap.PercentBlack > 30) then
    TerminateScript('Clicked the ladder, shutting down for safety');
end;

function TScript.InsideStore(): Boolean;
var
  ZaffBox: TPointArray  := [[8210,2724], [8195,2724], [8195,2700], [8210,2700]];
begin
  Exit(SRL.PointInPoly(Self.RSW.GetMyPos(), ZaffBox));
end;

function TScript.HandleExit(): Boolean;
var
  Door,Anchor: TPointArray;
  attempts:int32;
begin
  Minimap.RotateWithinAngles(57, 113);

  Self.FindDoorAndAnchor(RSW.GetMyPos(), Door, Anchor);

  if not Self.RSW.AtTile([8208,2716], 6) then
    Self.RSW.WalkBlind([8208,2716]);

  case Self.IsDoorOpenOC(Door, Anchor, 14.8, False, False) of
  dsOpen: ;

  dsClosed, dsUndefined:
  for attempts := 0 to 8 do
  begin
    ZaffDoor.Hover(10, False);

    if Mainscreen.IsUpText('pen ') then
    begin
      ZaffDoor.Click(True, 10);
      Wait(1450,1650);
      Minimap.WaitPlayerMoving(500,8000);
    end;

    if not Self.RSW.AtTile([8216,2720], 6) then
      Self.RSW.WalkBlind([8216,2720]);

    if not Self.InsideStore then
      Break;

    if Self.InsideStore and (attempts > 7) then
      TerminateScript('Something is wrong, take a screenshot of your client');
  end;
  end;

  if not Self.RSW.AtTile([8216,2720], 6) and not Self.InsideStore then
    Self.RSW.WalkBlind([8216,2720]);

  Result := WaitUntil(Self.RSW.AtTile([8216,2720], 6), 115, 5000);
end;

function TScript.HandleWalking(Destination: String; Force:Boolean=False): Boolean;
var
  attempt: Int32;
begin
  case Destination of
    'Shop':
     if (not Self.RSW.AtTile(Self.ShopTile, 24)) and (not Self.NoShopTile) then
     begin
       if (Self.ShopFor.Contains('Battlestaff')) then
       begin
         Self.RSW.WebWalk(Self.ShopTile);
         Self.HandleEntrance();
         Exit;
       end;

       if Self.Location.ContainsAny(['Baba', 'Aldarin', 'Lands', 'Ape']) then
         Result := Self.RSW.WalkBlind(Self.ShopTile)
       else
         Result := Self.RSW.WebWalk(Self.ShopTile);
     end;

    'Bank':
     if Inventory.IsFull() and not Self.RSW.AtTile(Self.BankTile, 16) or Force then
     begin
       if (Self.ShopFor.Contains('Battlestaff')) then
       begin
         for attempt := 0 to 8 do
         begin
           if Self.InsideStore then
             Self.HandleExit();
         end;

         if Self.InsideStore then
           Exit;

         Self.RSW.WebWalk([8208,2732]);
         Self.RSW.WebWalk(Self.BankTile);

         if (Self.BankObj.IsVisible) then
           Result := Bank.WalkOpen(BankObj);
         Exit;
       end;

       if (Self.BankObj.IsVisible) then
         Result := Bank.WalkOpen(BankObj)
       else
       if Self.Location.ContainsAny(['Baba', 'Aldarin', 'Lands', 'Ape']) then
         Result := Self.RSW.WalkBlind(Self.BankTile)
       else
         Result := Self.RSW.WebWalk(Self.BankTile);
     end;
  end;
end;

procedure TScript.DepositPeer();
var
  attempt: Int32;
begin
  if (not Store.Close) then
    Exit;

  Self.HandleWalking('Bank');

  Self.WriteMsg ('Finding Peer');
  Inc(Self.BuyCount, Inventory.CountItem(Self.ShopFor));

  for attempt := 1 to 3 do
  begin
    SRL.FindColors(tpa, PeerCol, Mainscreen.GetPlayerBox().Expand(65, 65));
    Mouse.move(tpa);

    if not ChooseOption.select(['Deposit-items']) then
      Exit;

    WaitUntil(GameInterface.IsOpen(EInterfaceType.ANY), 315, 8000);

    if GameInterface.IsOpen(EInterfaceType.ANY) then
    begin
      InactivityTimer.Restart;
      Break;
    end;
  end;

  if DepositBox.IsOpen then
  begin
    DepositBox.ClickInventoryItem('Raw sardine');
    WaitUntil(not Inventory.ContainsItem(Self.Shopfor), 215, 5100);
    ClearDebug();
    Self.Report();
    InactivityTimer.Restart;
  end;

  if (not DepositBox.close) then
    Exit;

  WaitUntil(not DepositBox.IsOpen, 425, 3500);
end;

function TScript.boxDepositHelper(Item: TItem; useQuantityButtons: Boolean): Boolean;
var
  attempts: Int32;
begin
  for attempts := 0 to 3 do begin
    DepositBox.DepositItem(Item, useQuantityButtons);
    WaitUntil(not Inventory.ContainsItem(Item), 115, 3000);

    if not Inventory.ContainsItem(Item) then
      Result := True;

    if Result then
      Break;

    if attempts >= 3 then
      TerminateScript('Something is wrong, we cannot deposit an item');
  end;
end;

procedure TScript.DoBanking();
var
  attempt: Int32;
begin
  if (not Store.Close(True)) then
    Exit;

  if not (Bank.IsOpen or DepositBox.IsOpen) then
    Self.HandleWalking('Bank');

  if Self.What.Contains('Mithril items') then
  begin
    for attempt := 0 to 3 do
    begin
      if FremBank.SelectOption(['Bank Magnus']) then
        Bank.IsOpen(8000);
      InactivityTimer.Restart;
      Break;
    end;
  end
  else if Self.Location.Contains('Catherby charter') then
  begin
    for attempt := 0 to 3 do
    begin
      if Bank.WalkOpen(BankObj) then
        DepositBox.IsOpen(15000);
      InactivityTimer.Restart;
      Break;
    end;
  end
  else if (Self.BankObj.UpText.Len > 0) then
    Bank.WalkOpen(Self.BankObj)
  else
  begin
    for attempt := 1 to 3 do
    begin
      if Bank.WalkOpen() then
        Bank.IsOpen(15000);
      InactivityTimer.Restart;
      Break;
    end;
  end;

  if DepositBox.IsOpen then
  begin
    Inc(Self.BuyCount, DepositBox.CountInventoryItem(Self.ShopFor));
    Self.boxDepositHelper(Self.ShopFor, false);
  end else if Bank.IsOpen then
  begin
    Inc(Self.BuyCount, Inventory.CountItem(Self.ShopFor));
    Bank.DepositRandomItems(['Coins']);
  end;

  Self.ShopCycles += 1;
  ClearDebug();
  Self.Report();

  if Self.Restore and self.LowEnergy then
  begin
    Bank.WithdrawConsumable(EConsumable.ENERGY);
    Inventory.Consume(EConsumable.ENERGY);
    WaitEx(250, 50);

    Bank.DepositRandomItems(['Coins']);
  end;

  DepositBox.Close();
  Bank.Close();
end;

procedure TScript.HandlePacks();
var
  Slot : Int32;
  Slots : TIntegerArray;
begin
  if not (Self.ShopFor.Contains('pack') and Inventory.FindItem(Self.ShopFor, Slots)) then
    Exit;

  Store.Close(True);

  for Slot in Slots do begin
    if not Inventory.IsSlotUsed(Slot) then
      Continue;

    Inventory.ClickSlot(Slot);
    Wait(33, 130, wdMean);

    if SRL.Dice(0.5) then
      Wait(1000, 7000, wdLeft);
  end;
end;

procedure TScript.Handleshop();
var
  attempts: int32;
begin
    Case location of
  'Culinaromancers chest':
  begin
    Self.WriteMsg('Finding shop');
    if not CulChest.SelectOption(['Buy-food Chest']) then
      Exit;
    if Store.IsOpen(12000) then
    begin
      InactivityTimer.Restart;
      Exit;
    end;
  end;
  end;

  if (not Self.NoShopTile) and ((Self.TaskMode='Bank') or (Self.TaskMode='Peer')) then
  begin
    Self.HandleWalking('Shop');

    if (Self.ShopFor.Contains('Battlestaff')) and not Self.InsideStore() then
     Self.HandleEntrance();

    Self.WriteMsg ('Finding Shop');

    for attempts := 0 to 8 do
    begin
      if attempts > 6 then
      begin
        Mouse.Click(MainScreen.GetPlayerBox.Expand(-5), MOUSE_RIGHT);
        if not ChooseOption.Select('rade ', MOUSE_LEFT) then
          Exit;
      end;

      if not OurNPC.SelectOption(['rade '], 10) then
        Break;

      if Store.IsOpen(12000) then
      begin
        InactivityTimer.Restart;
        Exit;
      end;
    end;
  end;


  Self.WriteMsg ('Finding shop');
  for attempts := 0 to 8 do
  begin
    if attempts > 6 then
    begin
      Mouse.Click(MainScreen.GetPlayerBox.Expand(-5), MOUSE_RIGHT);
      if not ChooseOption.Select('rade ', MOUSE_LEFT) then
        Exit;
    end;

    if not OurNPC.SelectOption(['rade '], 10) then
      Break;

    if Store.IsOpen(12000) then
    begin
      InactivityTimer.Restart;
      Exit;
    end;
  end;
end;

procedure TScript.HandleBuying();
var
  attempt: Int32;
begin
  Self.WriteMsg('Buying '+Self.ShopFor);
  InitialAmount := Store.CountItemStack(Self.ShopFor);

  if (Self.ShopFor.Contains('pack')) then
  begin
    for attempt := 1 to 2 do
    begin
      Store.ClickItem(Self.ShopFor, 'Buy 50');

      WaitUntil(Inventory.ContainsItem(Self.ShopFor), 415, 2100);

      WaitUntil((Store.CountItemStack(Self.ShopFor) >= 0) and (Store.CountItemStack(Self.ShopFor) < InitialAmount), 10, 5000);
      StoreCache := Store.CountItemStack(Self.ShopFor);
      Store.Close(True);
      Exit;
    end;
  end;

  if Self.Location = 'Aldarin pub' then
  begin
    for attempt := 1 to 2 do
    begin
      Store.ClickItem(Self.ShopFor, 'Buy 10');
      Exit;
    end;
  end;

  Store.ClickItem(Self.ShopFor, 'Buy 50');
  InactivityTimer.Restart;
  WaitUntil(Inventory.ContainsItem(Self.ShopFor), 215, 2100);
  WaitUntil((Store.CountItemStack(Self.ShopFor) >= 0) and (Store.CountItemStack(Self.ShopFor) < InitialAmount), 10, 5000);
  StoreCache := Store.CountItemStack(Self.ShopFor);
end;

procedure TScript.ShopOverstocked();
begin
  Self.WriteMsg ("Store is overstocked, moving on");
  Store.Close(True);

  if not Store.IsOpen() then
    Waituntil(WorldHopper.Hop(WorldList), 115, 12000);
end;

procedure TScript.ShopHasntEnough();
begin
  Self.WriteMsg ("Store doesn't have enough stock");
  Store.Close(True)

  if not Store.IsOpen() then
    Waituntil(WorldHopper.Hop(WorldList), 115, 12000);
end;

procedure TScript.EndScript
begin
  Logout.ClickLogout();
  TerminateScript('Time to shutdown');
end;

procedure TScript.SafetyNetEndScript();
begin
  Logout.ClickLogout();
  TerminateScript('Triggered safety net');
end;

procedure TScript.Init();
var
  z: Int32;
begin
  Self.Version            := 'Rev '+{$MACRO SCRIPT_REVISION};
  Mouse.Speed             := SRL.NormalRange(18, 21);
  Mouse.MissChance        := 3;
  Mouse.Distribution      := MOUSE_DISTRIBUTION_GAUSS;
  Self.ShopCycles         := 0;
  Self.SetupAntiban();
  ABTimeMod               := Random(1,3);
  Self.NoShopTile         := False;
  ItemData.GetAverage(Self.ShopFor);

  if (not GameClient.IsLoggedIn) then
    Login.LoginPlayer(False);

  z := Options.GetZoomLevel();
  EnergyHandler.MinInvPoints := 1;
  RSW.EnableRunAtEnergy      := 35;
  RSW.AdaptiveWalk           := True;

  if (GameClient.Mode <> EClientMode.FIXED) then
    TerminateScript("Client must be in fixed-classic");

  Self.RSW.Setup('world');

  case Location of
  'Aldarin pub':
  begin
    if (not InRange(z,35,45)) then
      Options.SetZoomLevel(SRL.TruncatedGauss(35,45))
    else
      MM2MS.ZoomLevel := z;
    Self.RSW.AddRegionFromURL('https://raw.githubusercontent.com/TwistedSlayerHelm/Images/refs/heads/main/gui/vcWI7N8.png', [0,0], 'Aldarin.png');
    ShopTile                   := [504,332];
    BankTile                   := [580,332];
    BankObj.Setup(4, [[588,326], [588,342]]);
    BankObj.SetupUpText(['ank', 'ank tabl']);
    BankObj.Finder.Colors += CTS2(9803168, 7, 0.30, 0.26);
    OurNPC.SetupUpText(['de', 'artender']);
    OurNPC.Finder.ColorClusters += [CTS2(2378074, 6, 0.09, 0.53), CTS2(6591929, 8, 0.05, 1.24), 5];
    if (Self.BuyLimit <> 0) then
      TerminateScript('This shop only sells 1 wine, so you have to make your minimum shop stock 0');
  end;

  'Port Sarim Fishing Shop':
  begin
    if (not InRange(z, 0, 5)) then
      Options.SetZoomLevel(SRL.TruncatedGauss(0,5))
    else
