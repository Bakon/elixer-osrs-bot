function TScript.GetState(): EState;
begin
  if not (not Self.NoShopTile) then
    Self.RSW.GetMyPos();

  if not GameClient.IsLoggedIn() then
    Exit(EState.LOGIN_PLAYER);

  if InactivityTimer.isFinished then
    Exit(EState.END_SCRIPT_NET);

  if InRange(Inventory.CountItemStack('Coins'), 1, 5000) then
  begin
    Self.WriteMsg('Coin stack low: '+ToStr(Inventory.CountItemStack('Coins')));
    Exit(EState.END_SCRIPT);
  end;

  if ChatButtons.GetState(EChatButton.GAME_CHAT) <> EChatButtonState.ENABLED then
    Exit(EState.CHANGE_CHAT_FILTER);

  if not ChatButtons.IsActive(EChatButton.GAME_CHAT) then
    Exit(EState.OPEN_CHAT);

  if 'may not buy items that are overstocked' in Chat.GetMessage(7, [CHAT_COLOR_BLACK]) then
  begin
    Exit(EState.SHOP_OVERSTOCKED);
  end;

  if (Self.ShopCycles = Random(15,25)) then
    Exit(EState.DO_ANTIBAN);

  if (Self.BuyLimit <> 0) then
  begin
  if (Store.IsOpen() and (Store.CountItemStack(Self.ShopFor) > Self.BuyLimit)) and (not inventory.IsFull) then
    Exit(EState.BUY_ITEMS);

  if (Store.IsOpen() and (Self.StoreCache < Self.BuyLimit)) then
    Exit(EState.SHOP_LIMIT);

  if (Store.IsOpen() and (Store.CountItemStack(Self.ShopFor) < Self.BuyLimit)) then
    Exit(EState.SHOP_LIMIT);
  end;

  if (Self.BuyLimit = 0) then
  begin
  if (Store.IsOpen() and (Store.CountItemStack(Self.ShopFor) > Self.BuyLimit) and (not inventory.IsFull)) or (Store.IsOpen() and (Self.Location = 'Aldarin pub') and (not inventory.IsFull)) then
    Exit(EState.BUY_ITEMS);

  if (Store.IsOpen() and (Self.StoreCache <= Self.BuyLimit)) and not (Self.Location = 'Aldarin pub') then
    Exit(EState.SHOP_LIMIT);

  if (Store.IsOpen() and (Store.CountItemStack(Self.ShopFor) <= Self.BuyLimit)) and not (Self.Location = 'Aldarin pub') then
    Exit(EState.SHOP_LIMIT);
  end;

  if Inventory.IsFull() then
  begin
    if Self.TaskMode = 'Bank' then
      Exit(EState.HANDLE_BANK)
    else
    if Self.TaskMode = 'Hop' then
      Exit(EState.HANDLE_PACKS)
    else
    if Self.TaskMode = 'Peer' then
      Exit(EState.DEPOSIT_PEER);
  end;

  Result := EState.HANDLE_SHOP;
end;

procedure TScript.Run();
begin
  while true do
  begin
    if (Self.ShutdownTime > 0) and (GetTimeRunning() > Self.ShutdownTime) then
      Self.EndScript();

    if (Self.Totallimit > 0) and (Self.BuyCount >= Self.Totallimit) then
      Self.EndScript();

    Self.State := Self.GetState();
    case Self.State of
      EState.OPEN_CHAT: ChatButtons.Open(EChatButton.GAME_CHAT);
      EState.CHANGE_CHAT_FILTER: ChatButtons.ChangeState(EChatButton.GAME_CHAT, EChatButtonState.ENABLED);
      EState.LOGIN_PLAYER: if not Login.LoginPlayer(False) then Break;
      EState.HANDLE_BANK: Self.DoBanking();
      EState.HANDLE_SHOP: Self.Handleshop();
      EState.HANDLE_PACKS: Self.HandlePacks();
      EState.DEPOSIT_PEER: Self.DepositPeer();
      EState.BUY_ITEMS: Self.HandleBuying();
      EState.SHOP_LIMIT: Self.ShopHasntEnough();
      EState.SHOP_OVERSTOCKED: Self.ShopOverstocked();
      EState.DO_ANTIBAN: Self.DoAntiban();
      EState.END_SCRIPT_NET: Self.SafetyNetEndScript();
      EState.END_SCRIPT: Self.EndScript();
    end;
  end;
end;

begin
  SettingsHandler.CheckGPUPlugin();

  if (not DirectoryExists(AppPath+'\Resources\')) then
    CreateDirectory(AppPath+'\Resources');

  if (not FileExists(AppPath+'\Resources\SSB2GUI.png')) then
    DownloadToFile('https://raw.githubusercontent.com/TwistedSlayerHelm/Images/refs/heads/main/gui/SSB2GUI.png', AppPath+'\Resources\SSB2GUI.png');

  GUI.Setup('Shop Buyer', [750,466]);
  GUI.PageControl.SetAllChildsFontColor($000000);
  GUI.Run;

  {$IFNDEF SRL_DISABLE_REMOTEINPUT}
  if WLSettings.GetObject('remote_input').getBoolean('enabled', True) and (not GameClient.RemoteInput.IsSetup()) then GameClient.RemoteInput.Setup();
  {$ENDIF}

  Bot.Init();
  Bot.Run();
end.
