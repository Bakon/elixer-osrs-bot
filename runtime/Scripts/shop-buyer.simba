    SetTop(TControl.AdjustToDPI(270));
    SetName('box_tl');
    SetCaption('Total buy limit');
    SetToolTip('How many to buy');
    SetText('2000');
    SetMaxLength(5);
    SetFontColor($000000);
    end;

  with cb_Sleeps do
