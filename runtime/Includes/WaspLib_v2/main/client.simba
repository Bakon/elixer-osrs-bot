(*
# GameClient
Extensions to TGameClient.

One thing to keep in mind is that WaspLib enforces the use of Remote Input by default.

To disable it you have to use either of this snippets in your scripts:

```pascal
{$DEFINE SRL_DISABLE_REMOTEINPUT}
//or
begin
WLSettings.RemoteInput.Enabled := False;
end;
*)
{$DEFINE WL_GameClient_INCLUDED}
{$IFNDEF WL_MAIN}
  {$I WaspLib/main.simba}
{$ENDIF}

procedure TGameClient.Setup(); override;
begin
  Self.Name := 'GameClient';

  if not Self.Revalidate() then
    TerminateScript('Please refocus the client!');

  {$IFNDEF SRL_DISABLE_REMOTEINPUT}
    {$IFNDEF SCRIPT_GUI}
      Self.RemoteInput.Setup();
    {$ENDIF}
  {$ENDIF}

  Self.Mode := Self.DetectClientMode(True);
  if Self.Mode = EClientMode.UNKNOWN then
    Self.Mode := EClientMode.FIXED; // Fixed as default so we can login if needed
  Self.ClientModeChanged();
end;

function TOptions.HideRoofs(): Boolean;
begin
  //overriden later in options file.
  Result := True;
end;

procedure TGameClient.CheckClientSettings();
var
  userB: TBox;
begin
  if not MainScreen.HighestPitch then MainScreen.SetHighestPitch();

  if not WL.GameSettings.MaxBrightness then
  begin
    WL.GameSettings.MaxBrightness := Options.SetMaxBrightness();

    if (MM2MS.ZoomLevel = -1) and Options.IsOpen() and (Options.GetCurrentTab() = EOptionsTab.DISPLAY) then
      MM2MS.ZoomLevel := Options.GetZoomLevel();
  end;

  if not WL.GameSettings.RoofsHidden then
    WL.GameSettings.RoofsHidden := Options.HideRoofs();

  if XPBar.Tracker.Current = 0 then
    XPBar.Read();

  if WLSettings.GetObject('video').getBoolean('enabled') and not WL.IsRecording then
  begin
    userB := Chat.GetDisplayNameBox();
    if userB = Chat.LineBoxes[CHAT_INPUT_LINE] then
      userB := [];

    Recorder.Start(WLSettings.GetObject('video').GetInt('time'), WL_DATAPATH + 'videos', userB, XPBar.Bounds);
  end;
end;

function TGameClient.IsLoggedIn(): Boolean; override;
var
  park: Boolean;
  timeout: UInt64;
begin
  Result := inherited;

  // osrs-bot: the opt-in AFK mouse-park (antiban.park_mouse) rests the cursor
  // off-client every antiban cycle. DetectClientMode then occasionally reads
  // the music-tab pixel as UNKNOWN right before BaseScript's post-antiban login
  // check, which is a false "logged out" and triggers a 40s LoginPlayer timeout
  // that spams the console. When the park is on, re-confirm a logged-out read
  // for up to 1.5s before believing it (the misread is transient; a real logout
  // still resolves, just slightly later). The logged-in fast path is untouched,
  // so runs without the AFK park behave exactly as before.
  if not Result then
  begin
    park := False;
    try park := WLSettings.GetObject('antiban').getBoolean('park_mouse'); except end;
    if park then
    begin
      timeout := GetTickCount() + 1500;
      while (not Result) and (GetTickCount() < timeout) do
      begin
        Wait(150);
        Result := inherited;
      end;
    end;
  end;

  if Result then
    Self.CheckClientSettings();
end;
