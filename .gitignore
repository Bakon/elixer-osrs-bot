# ==========================================================
#  osrs-bot monorepo — .gitignore
#  Git tracks SOURCE + everything needed to run: scripts, the
#  vendored libraries, their plugins, and the Simba engine.
#  It does NOT track build output, caches, or per-user config.
# ==========================================================

# ---------- Launcher build output ----------
launcher/src-tauri/target/
launcher/node_modules/
launcher/.tools/
launcher/.svelte-kit/
launcher/build/
launcher/.vite/

# ---------- Simba runtime data: caches only; track Data/64 (OpenSSL dlls) ----------
runtime/Data/*
!runtime/Data/64/
runtime/.wasplib-backup/
runtime/Screenshots/
runtime/Scripts/_audit/

# ---------- Binaries: ignore stray ones, but KEEP the engine + its dlls ----------
*.exe
*.dll
*.jar
!runtime/Simba64.exe
!runtime/libcrypto-1_1-x64.dll
!runtime/libssl-1_1-x64.dll
!runtime/Data/64/**
# (the vendored plugin binaries under Includes/*/plugins/ are force-tracked)

# ---------- Upstream doc images (not needed to run) ----------
**/docs/images/

# ---------- secrets & stray runtime files (NEVER commit) ----------
runtime/credentials.simba
*.bmp

# ---------- per-user state (auth token, script settings) ----------
runtime/Configs/launcher.json
runtime/Configs/BASettings.ini

# ---------- secrets: AI chat API key (NEVER commit) ----------
runtime/Configs/elixer.ini

# ---------- misc ----------
*.log
Thumbs.db
.DS_Store
runtime/Logs/
